# Copy to .env and fill in. Never commit .env.

# ── Cloudflare D1 (database) ────────────────────────────────
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID=
D1_DATABASE_ID=

# ── Cloudflare R2 (photos, gallery, e-mail artwork) ─────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sweetheart
PUBLIC_R2_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ── Admin login (/admin/login) ──────────────────────────────
ADMIN_USERNAME=
# Use a long random password; changing it logs everyone out
ADMIN_PASSWORD=

# ── Signing secret for links in e-mails & sessions (long random string) ──
APP_SECRET=

# ── E-mail (MailerSend) ─────────────────────────────────────
MAILERSEND_API_KEY=
# Sender must be on a domain verified in MailerSend
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Sweetheart
# Who receives "nieuwe aanvraag" alerts (comma-separated)
ADMIN_NOTIFY_EMAIL=
# Set to false to switch all e-mail off
MAIL_ENABLED=true

# ── Public site URL used in e-mails ─────────────────────────
SITE_URL=https://sweetheart-taart.com

# ── Background jobs (review mails, reminders, privacy clean-up) ──
# Runs automatically on the live site; set true to also run on your dev machine
REVIEW_SCHEDULER=
