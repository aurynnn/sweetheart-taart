# Copy to .env and fill in. Never commit .env.
# Live site (Cloudflare Worker): add the same keys under Settings → Variables and
# Secrets, or with `npx wrangler secret put NAME`. They are read at runtime.

# ── Cloudflare D1 (database) ────────────────────────────────
CLOUDFLARE_API_TOKEN=
CF_ACCOUNT_ID=
D1_DATABASE_ID=

# ── Cloudflare R2 (photos, gallery, e-mail artwork) ─────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=sweetheart
PUBLIC_R2_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ── Admin login (/admin/login) ──────────────────────────────
ADMIN_USERNAME=
# Use a long random password; changing it logs everyone out
ADMIN_PASSWORD=

# ── Signing secret for links in e-mails & sessions (long random string) ──
APP_SECRET=

# ── E-mail (MailerSend) ─────────────────────────────────────
MAILERSEND_API_KEY=
# Sender must be on a domain verified in MailerSend
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Nathalie van Sweetheart
# Who receives "nieuwe aanvraag" alerts (comma-separated)
ADMIN_NOTIFY_EMAIL=
# Set to false to switch all e-mail off
MAIL_ENABLED=true

# ── Google Agenda: OPTIONAL direct koppeling ────────────────
# Not needed: without these the admin offers a one-click agenda subscription
# (Admin → Beschikbaarheid → "Toevoegen aan Google Agenda"). Set them only if new
# orders must appear instantly instead of after Google's own refresh (a few times a day).
# Google Cloud Console → APIs & Services: enable "Google Calendar API", create an
# OAuth client of type "Web application" with redirect URI
#   https://sweetheart-taart.com/admin/api/calendar/callback
# and set the consent screen to "In production" (in "Testing" the link expires after 7 days).
# Then Admin → Beschikbaarheid → "Verbind Google Agenda".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if the callback URL differs from <site>/admin/api/calendar/callback
GOOGLE_REDIRECT_URI=

# ── Public site URL used in e-mails ─────────────────────────
SITE_URL=https://sweetheart-taart.com

# ── Background jobs (review mails, reminders, privacy clean-up) ──
# Runs on the live site via the hourly cron trigger in wrangler.toml; false = off
REVIEW_SCHEDULER=
