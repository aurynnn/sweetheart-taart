---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactCTA from '../components/ContactCTA.astro';
import GalleryModal from '../components/GalleryModal.svelte';

const galleryImages = [
  { src: '/images/mini-collectie/cupcakes1.png', alt: 'Cupcakes', caption: 'Prachtig versierde cupcakes' },
  { src: '/images/feestcollectie/41908692-270229280276676-3216813078232314041-n-2.jpg', alt: 'Mini taarten', caption: 'Luchtige schuimgebakjes' },
  { src: '/images/mini-collectie/mini_flamingos_thumb.jpg', alt: 'Flamingo cupcakes', caption: 'Flamingo flamingo cupcakes' },
  { src: '/images/koekjescollectie/pecanpeggy.jpg', alt: 'Pecan koekjes', caption: 'Knapperige pecan koekjes' },
  { src: '/images/feestcollectie/IMG_8459-scaled.jpg', alt: 'Mini gebak', caption: 'Assortiment mini gebak' },
  { src: '/images/koekjescollectie/koek_wit_thumb.jpg', alt: 'Witte koekjes', caption: 'Zachte witte koekjes' },
  { src: '/images/koekjescollectie/koekejs.png', alt: 'Koekjes collectie', caption: 'Versierde koekjes op stok' },
  { src: '/images/feestcollectie/ED3ECB1E-2A63-4BC2-BF3E-ADA09B099148.jpeg', alt: 'Traktatie', caption: 'Feestelijke traktaties' }
];
---

<Layout title="Mini-collectie" description="Klein maar fijn! Cupcakes, tartelettes en kleine pavlova's. Op maat te maken met heerlijke smaken zoals lavendel, rozentoets of koffielikeur.">
  <Header />

  <main id="mini-main">
    <!-- Hero Section -->
          </span>
          <h1 id="mini-title" class="font-heading text-4xl md:text-5xl lg:text-6xl font-semibold text-[var(--color-text)] mb-6 animate-on-scroll">
            Klein maar fijn
          </h1>
          <p id="mini-subtitle" class="text-lg text-[var(--color-text-muted)] animate-on-scroll stagger-1">
            Deze minis kunnen naar smaak en afwerking gemaakt worden volgens wens. Perfect voor een elegante traktatie of als bijzondere attentie.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section id="mini-content" class="section">
      <div id="mini-content-inner" class="container">
        <div id="mini-grid" class="grid lg:grid-cols-2 gap-16 items-start">
          <!-- Products Column -->
          <div id="mini-products">
            <h2 id="mini-products-title" class="font-heading text-2xl md:text-3xl font-semibold text-[var(--color-text)] mb-6 animate-on-scroll">
              Wat we maken
            </h2>

            <div id="mini-products-list" class="grid grid-cols-1 gap-6">
              <!-- Cupcakes -->
              <div id="mini-cupcakes" class="card p-6 flex gap-4">
                <div id="mini-cupcakes-icon" class="w-16 h-16 rounded-xl bg-gradient-to-br from-[#FFD93D] to-[#FF6B9D] flex items-center justify-center flex-shrink-0 shadow-md">
                  <span id="mini-cupcakes-emoji">🧁</span>
                </div>
                <div id="mini-cupcakes-content">
                  <h3 id="mini-cupcakes-title" class="font-heading text-xl font-semibold text-[var(--color-text)] mb-2">Cupcakes</h3>
                  <p id="mini-cupcakes-text" class="text-[var(--color-text-muted)] text-sm">
                    Prachtig versierd en vol smaak. Perfect voor feestjes of als attentie.
                  </p>
                </div>
              </div>

              <!-- Tartelettes -->
              <div id="mini-tartelettes" class="card p-6 flex gap-4">
                <div id="mini-tartelettes-icon" class="w-16 h-16 rounded-xl bg-gradient-to-br from-[#CD853F] to-[#DEB887] flex items-center justify-center flex-shrink-0 shadow-md">
                  <span id="mini-tartelettes-emoji">🥧</span>
                </div>
                <div id="mini-tartelettes-content">
                  <h3 id="mini-tartelettes-title" class="font-heading text-xl font-semibold text-[var(--color-text)] mb-2">Tartelettes</h3>
                  <p id="mini-tartelettes-text" class="text-[var(--color-text-muted)] text-sm">
                    Mini-taartjes met een knapperig korstje en heerlijke vulling.
                  </p>
                </div>
              </div>

              <!-- Pavlova's -->
              <div id="mini-pavlova" class="card p-6 flex gap-4">
                <div id="mini-pavlova-icon" class="w-16 h-16 rounded-xl bg-gradient-to-br from-[#F8BBC0] to-[#F5DEB3] flex items-center justify-center flex-shrink-0 shadow-md">
                  <span id="mini-pavlova-emoji">🍰</span>
                </div>
                <div id="mini-pavlova-content">
                  <h3 id="mini-pavlova-title" class="font-heading text-xl font-semibold text-[var(--color-text)] mb-2">Pavlova's</h3>
                  <p id="mini-pavlova-text" class="text-[var(--color-text-muted)] text-sm">
                    Luchtige schuimgebakjes met verse vruchten en room.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Gallery & Flavors Column -->
          <div id="mini-gallery-flavors">
            <!-- Gallery Section -->
            <div id="mini-gallery-wrapper">
              <GalleryModal 
                client:load 
                images={galleryImages}
                triggerText="Bekijk foto's"
              />
            </div>

            <!-- Flavors Card -->
            <div id="mini-flavors-card" class="card p-8 bg-[var(--color-surface)]">
              <h3 id="mini-flavors-title" class="font-heading text-xl font-semibold text-[var(--color-text)] mb-6 flex items-center gap-3">
                <span id="mini-flavors-icon">✨</span>
                Smaakopties
              </h3>

              <p id="mini-flavors-intro" class="text-[var(--color-text-muted)] mb-6">
                Denk voor smaken aan多样化 opties. Alles is op maat te maken!
              </p>

              <div id="mini-flavors-list" class="space-y-4">
                <div id="mini-flavors-sweet">
                  <h4 id="mini-flavors-sweet-title" class="font-semibold text-[var(--color-text)] mb-2">Zoet</h4>
                  <div id="mini-flavors-sweet-tags" class="flex flex-wrap gap-2">
                    <span id="mini-flavor-chocolate" class="px-3 py-1 bg-[var(--color-secondary)] text-[var(--color-primary-dark)] text-sm rounded-full">Chocolade</span>
                    <span id="mini-flavor-nuts" class="px-3 py-1 bg-[var(--color-secondary)] text-[var(--color-primary-dark)] text-sm rounded-full">Noten</span>
                    <span id="mini-flavor-caramel" class="px-3 py-1 bg-[var(--color-secondary)] text-[var(--color-primary-dark)] text-sm rounded-full">Karamel</span>
                    <span id="mini-flavor-fruit" class="px-3 py-1 bg-[var(--color-secondary)] text-[var(--color-primary-dark)] text-sm rounded-full">Fruit</span>
                    <span id="mini-flavor-vanilla" class="px-3 py-1 bg-[var(--color-secondary)] text-[var(--color-primary-dark)] text-sm rounded-full">Vanille</span>
                  </div>
                </div>

                <div id="mini-flavors-special">
                  <h4 id="mini-flavors-special-title" class="font-semibold text-[var(--color-text)] mb-2">Speciaal</h4>
                  <div id="mini-flavors-special-tags" class="flex flex-wrap gap-2">
                    <span id="mini-flavor-lavender" class="px-3 py-1 bg-[var(--color-accent)]/10 text-[var(--color-primary-dark)] text-sm rounded-full border border-[var(--color-accent)]/30">Lavendel</span>
                    <span id="mini-flavor-rose" class="px-3 py-1 bg-[var(--color-accent)]/10 text-[var(--color-primary-dark)] text-sm rounded-full border border-[var(--color-accent)]/30">Rozentoets</span>
                    <span id="mini-flavor-coffee" class="px-3 py-1 bg-[var(--color-accent)]/10 text-[var(--color-primary-dark)] text-sm rounded-full border border-[var(--color-accent)]/30">Koffielikeur</span>
                    <span id="mini-flavor-almond" class="px-3 py-1 bg-[var(--color-accent)]/10 text-[var(--color-primary-dark)] text-sm rounded-full border border-[var(--color-accent)]/30">Amandellikeur</span>
                  </div>
                </div>
              </div>

              <div id="mini-flavors-note" class="mt-8 p-4 bg-[var(--color-secondary)]/50 rounded-xl">
                <p id="mini-flavors-note-text" class="text-sm text-[var(--color-text-muted)]">
                  <strong id="mini-flavors-note-strong">Let op:</strong> De prijs hangt af van de gebruikte producten. Neem contact op voor een offerte.
                </p>
              </div>

              <div id="mini-flavors-button-wrapper" class="mt-6">
                <a id="mini-flavors-button" href="/bestellen" class="btn btn-primary w-full justify-center">
                  Vraag offerte aan
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ContactCTA id="mini-contact" />
  </main>

  <Footer id="mini-footer" />
</Layout>