---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactCTA from '../components/ContactCTA.astro';
import GalleryModal from '../components/GalleryModal.svelte';
import CollectionHero from '../components/collection/CollectionHero.astro';
import FeatureCard from '../components/collection/FeatureCard.astro';
import { listMedia } from '../lib/r2';

const R2 = (import.meta.env.PUBLIC_R2_BASE_URL || '').replace(/\/$/, '');
const mini = (key: string) => `${R2}/mini-collectie/images/${key}`;

const galleryImages = await listMedia('mini-collectie');

const products = [
  { title: 'Cupcakes', text: 'Prachtig versierd en vol smaak. Perfect voor feestjes, als traktatie of met je logo.', icon: 'fa-cake-candles', image: mini('sweetheart.taart_1617047349_2540299746153756543_8631104567.jpg') },
  { title: 'Tartelettes', text: 'Mini-taartjes met een knapperig korstje en een heerlijke vulling.', icon: 'fa-chart-pie', image: `${R2}/koekjescollectie/images/pecanpeggy.jpg` },
  { title: "Pavlova's", text: 'Luchtige schuimgebakjes met verse vruchten en room.', icon: 'fa-cloud', tone: 'lilac' as const },
];

const sweet = ['Chocolade', 'Noten', 'Karamel', 'Fruit', 'Vanille'];
const special = ['Lavendel', 'Rozentoets', 'Koffielikeur', 'Amandellikeur'];
---

<Layout title="Mini-collectie" description="Klein maar fijn! Cupcakes, tartelettes en kleine pavlova's. Op maat te maken met heerlijke smaken zoals lavendel, rozentoets of koffielikeur." bodyClass="collection-page">
  <Header />

  <main id="mini-main" class="collection">
    <CollectionHero
      id="mini-hero"
      badge="Mini-collectie"
      title="Klein maar fijn"
      subtitle="Deze mini's worden naar smaak en afwerking gemaakt volgens jouw wens. Perfect voor een elegante traktatie of als bijzondere attentie."
      product="mini-gebak"
      ctaLabel="Bestellen"
      photos={[mini('sweetheart.taart_1649007620_2808401931351114500_8631104567.jpg'), mini('mini_flamingos_thumb.jpg'), mini('sweetheart.taart_1643280926_2760362935501354155_8631104567.jpg')]}
      highlights={[{ icon: 'fa-wand-magic-sparkles', label: 'Volledig op maat' }, { icon: 'fa-print', label: 'Met foto of logo' }, { icon: 'fa-euro-sign', label: 'Vanaf €9 per 12' }]}
    />

    <!-- Products -->
    <section id="mini-producten" class="section c-section">
      <div class="container">
        <header class="c-head">
          <span class="eyebrow animate-on-scroll">Wat we maken</span>
          <h2 class="section-title" data-split>Mini's voor elk feest</h2>
        </header>
        <div class="c-grid-3">
          {products.map((p, i) => <FeatureCard {...p} index={i} />)}
        </div>
      </div>
    </section>

    <!-- Gallery -->
    <section id="creaties" class="section c-section">
      <div class="container">
        <header class="c-head">
          <span class="eyebrow animate-on-scroll">Inspiratie</span>
          <h2 class="section-title" data-split>Bekijk onze mini's</h2>
        </header>
        <div class="animate-on-scroll">
          <GalleryModal client:visible images={galleryImages} />
        </div>
      </div>
    </section>

    <!-- Flavors -->
    <section id="mini-smaken" class="section c-section">
      <div class="container">
        <div class="c-price-card animate-on-scroll" data-tilt="3">
          <div class="c-price">
            <span class="c-price-label">Smaken</span>
            <span class="c-price-amount"><i class="fa-solid fa-wand-magic-sparkles" style="font-size:3.5rem" aria-hidden="true"></i></span>
            <span class="c-price-unit">Alles op maat</span>
            <small>Denk gerust mee met opties</small>
          </div>
          <div class="c-price-body">
            <h3>Smaakopties</h3>
            <p class="mini-label">Zoet</p>
            <div class="c-chips">
              {sweet.map((s) => <span class="c-chip">{s}</span>)}
            </div>
            <p class="mini-label">Speciaal</p>
            <div class="c-chips">
              {special.map((s) => <span class="c-chip special">{s}</span>)}
            </div>
            <p class="mini-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> De prijs hangt af van de gebruikte producten — je krijgt de definitieve prijs na je aanvraag.</p>
            <a href="/aanvraag?product=mini-gebak" class="btn btn-primary btn-shine c-cta-wide" data-magnetic="0.15">
              Vraag je mini's aan <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <ContactCTA id="mini-contact" />
  </main>

  <Footer id="mini-footer" />
</Layout>

<style>
  .mini-label { font-weight: 700; margin: 1.1rem 0 0.5rem; font-size: 0.9rem; }
  .mini-note { margin: 1.5rem 0 1.25rem; padding: 0.9rem 1rem; border-radius: 0.9rem; background: var(--color-secondary); color: var(--color-text-muted); font-size: 0.88rem; }
  .mini-note i { color: var(--color-primary); margin-right: 0.35rem; }
</style>
