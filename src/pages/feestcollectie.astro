---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactCTA from '../components/ContactCTA.astro';
import GalleryModal from '../components/GalleryModal.svelte';
import CollectionHero from '../components/collection/CollectionHero.astro';
import feestcollectieMedia from '../data/feestcollectie-media.json';
import { listMedia, type MediaItem } from '../lib/r2';

// Live from R2 (cached), with the checked-in list as fallback when R2 is unreachable
const galleryImages = await listMedia('feestcollectie', feestcollectieMedia as MediaItem[]);
// Two recent creations for the hero collage (the very newest is the same wedding cake as trouwtaart.png)
const recent = galleryImages.filter((m) => m.type === 'image');
const heroPhotos = [recent[3], recent[5]].filter(Boolean).map((m) => m.src);

const features = [
  { icon: 'fa-user-group', title: 'Vanaf 8 personen', text: 'Eénlaagstaart' },
  { icon: 'fa-layer-group', title: 'Vanaf 15 personen', text: 'Stapeltaart' },
  { icon: 'fa-ruler-vertical', title: '8 cm hoog', text: 'Ruime porties' },
  { icon: 'fa-wand-magic-sparkles', title: 'Op maat', text: 'Per laag een andere smaak' },
];

const layers = [
  { icon: 'fa-cake-candles', title: 'Luchtige biscuit', text: 'De basis van elke feesttaart, vers gebakken met speltbloem en bio-eitjes.' },
  { icon: 'fa-ice-cream', title: 'Mousse-vulling', text: 'Aardbeien, frambozen, bananen of bosvruchten — of een rijke chocolademousse.' },
  { icon: 'fa-brush', title: 'Afwerking', text: 'Afgesmeerd met botercrème of chocoladeganache en versierd volgens jouw thema.' },
];

const knowHow = [
  'Taarten worden meegegeven in aangepaste dozen',
  'Bewaren: koel en droog',
  'Per laag kan een verschillende smaak gekozen worden',
  'Allergieën? Ik denk graag mee!',
];
---

<Layout title="Feestcollectie" description="Feestelijke taarten voor elke gelegenheid. Van verjaardag tot jubileum, met heerlijke mousse-vullingen en ambachtelijke afwerking." bodyClass="collection-page">
  <Header />

  <main id="feestcollectie-main" class="collection">
    <CollectionHero
      id="feestcollectie-hero"
      badge="Feestcollectie"
      title="De prachtigste feesttaarten"
      subtitle="Mijn mooie, vrolijke feesttaarten bestaan uit een luchtige biscuit met heerlijke mousse-vullingen — volledig in het thema van jouw feest."
      product="feesttaart"
      ctaLabel="Bestellen"
      photos={['/images/trouwtaart.png', ...heroPhotos]}
    />

    <!-- Key facts -->
    <section id="feestcollectie-features" class="section c-section">
      <div class="container">
        <div class="c-grid-4">
          {features.map((f, i) => (
            <div class={`fact animate-on-scroll stagger-${i + 1}`} data-tilt="10">
              <span class="fact-icon"><i class={`fa-solid ${f.icon}`} aria-hidden="true"></i></span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What's inside: stacked layers -->
    <section id="feestcollectie-lagen" class="section c-section">
      <div class="container layers-grid">
        <div>
          <span class="eyebrow animate-on-scroll">Wat zit erin?</span>
          <h2 class="section-title" data-split>Laag voor laag lekker</h2>
          <p class="text-[var(--color-text-muted)] leading-relaxed animate-on-scroll stagger-1">
            Ze worden gevuld met een heerlijke vruchten- of chocolademousse. Als basis bied ik aardbeien-, frambozen-, bananen- of bosvruchtenmousse aan. Dit geheel wordt afgesmeerd met botercrème of chocoladeganache voor een perfecte afwerking.
          </p>
        </div>
        <ol class="layers">
          {layers.map((l, i) => (
            <li class={`layer animate-on-scroll stagger-${i + 1}`} style={`--i:${i}`}>
              <span class="layer-icon"><i class={`fa-solid ${l.icon}`} aria-hidden="true"></i></span>
              <div>
                <h3>{l.title}</h3>
                <p>{l.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Gallery -->
    <section id="creaties" class="section c-section">
      <div class="container">
        <header class="c-head">
          <span class="eyebrow animate-on-scroll">Inspiratie</span>
          <h2 class="section-title" data-split>Bekijk onze creaties</h2>
        </header>
        <div id="feestcollectie-gallery-modal" class="animate-on-scroll">
          <GalleryModal client:visible images={galleryImages} />
        </div>
      </div>
    </section>

    <!-- Aanvragen -->
    <section id="feestcollectie-order" class="section c-section">
      <div class="container">
        <div class="c-price-card animate-on-scroll" data-tilt="3">
          <div class="c-price">
            <span class="c-price-label">Vanaf</span>
            <span class="c-price-amount">€<span data-counter="45" data-counter-from="0">45</span></span>
            <span class="c-price-unit">per feesttaart</span>
            <small>indicatie · definitieve prijs na bevestiging</small>
          </div>
          <div class="c-price-body">
            <h3>Goed om te weten</h3>
            <p class="order-intro">Vraag je taart aan zodra je feest gepland is — ik neem aanvragen aan volgens mijn agenda.</p>
            <ul class="c-factors">
              {knowHow.map((k, i) => (
                <li class={`animate-on-scroll stagger-${i + 1}`}><span><i class="fa-solid fa-check" aria-hidden="true"></i></span>{k}</li>
              ))}
            </ul>
            <a href="/aanvraag?product=feesttaart" class="btn btn-primary btn-shine c-cta-wide" data-magnetic="0.15">
              Vraag je feesttaart aan <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <ContactCTA id="feestcollectie-contact" />
  </main>

  <Footer id="feestcollectie-footer" />
</Layout>

<style>
  .fact {
    text-align: center; padding: 1.75rem 1rem; border-radius: 1.25rem; background: #fff;
    border: 1px solid var(--color-border-light); box-shadow: var(--shadow-md);
  }
  .fact-icon {
    width: 3.5rem; height: 3.5rem; margin: 0 auto 0.9rem; border-radius: 1.1rem; display: grid; place-items: center;
    background: linear-gradient(135deg, #F2A0AA, #E8788A); color: #fff; font-size: 1.35rem;
    box-shadow: 0 12px 24px -12px rgba(212, 90, 106, 0.8); transition: transform 600ms var(--ease-spring);
  }
  .fact:hover .fact-icon { transform: rotate(-10deg) scale(1.1); }
  .fact h3 { font-family: var(--font-body); font-weight: 800; font-size: 1rem; margin: 0; }
  .fact p { margin: 0.25rem 0 0; font-size: 0.85rem; color: var(--color-text-muted); }

  .layers-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
  .layers { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .layer {
    display: flex; gap: 1rem; align-items: flex-start; padding: 1.25rem 1.4rem; border-radius: 1.25rem;
    background: #fff; border: 1px solid var(--color-border-light); box-shadow: var(--shadow-md);
    margin-left: calc(var(--i) * 1.5rem);
  }
  .layer-icon { width: 3rem; height: 3rem; border-radius: 50%; display: grid; place-items: center; flex-shrink: 0; background: var(--color-secondary); color: var(--color-primary-dark); font-size: 1.2rem; }
  .layer h3 { font-family: var(--font-heading); font-size: 1.5rem; margin: 0; }
  .layer p { margin: 0.2rem 0 0; color: var(--color-text-muted); font-size: 0.92rem; line-height: 1.6; }
  .order-intro { color: var(--color-text-muted); margin: 0 0 1.25rem; }

  @media (max-width: 900px) {
    .layers-grid { grid-template-columns: 1fr; gap: 2rem; }
    .layer { margin-left: 0; }
  }
</style>
