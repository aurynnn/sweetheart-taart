---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SprinkleField from '../components/SprinkleField.astro';
import AanvraagWizard from '../components/aanvraag/AanvraagWizard.svelte';
import { SITE } from '../config/site';

const faqs = [
  {
    q: 'Moet ik nu al betalen?',
    a: 'Nee. Je aanvraag is vrijblijvend. Nathalie bekijkt je wensen en bevestigt daarna de definitieve prijs per mail of telefoon.',
  },
  {
    q: 'Hoe lang op voorhand moet ik aanvragen?',
    a: 'Hoe vroeger hoe beter — de kalender toont enkel dagen die nog vrij zijn. Voor een grote feesttaart plan je best enkele weken vooruit.',
  },
  {
    q: 'Kunnen jullie rekening houden met allergieën?',
    a: 'Zeker. Lactose-intolerantie, glutenallergie of diabetes? Vermeld het bij je product en we zoeken samen naar een lekkere oplossing.',
  },
  {
    q: 'Waar haal ik mijn bestelling op?',
    a: `In ons bakatelier aan de ${SITE.address.street} in ${SITE.address.city}, op het ophaalmoment dat je kiest. Levering is in overleg mogelijk.`,
  },
];
---

<Layout title="Aanvraag" description="Vraag je feesttaart, koekjes of mini-gebak aan bij Sweetheart in Oostende. In 4 eenvoudige stappen, vrijblijvend en zonder betaling vooraf.">
  <Header />

  <main id="aanvraag-main">
    <!-- Hero -->
    <section id="aanvraag-hero" class="aanvraag-hero grain">
      <SprinkleField cupcakes={6} hearts={20} seed={11} mask="center" />
      <div class="container relative z-10 text-center">
        <span class="hero-pill animate-on-scroll">
          <i class="fa-solid fa-heart" aria-hidden="true"></i> Vrijblijvend · in 2 minuten
        </span>
        <h1 class="aanvraag-title" data-split>Vraag jouw taart aan</h1>
        <p class="aanvraag-sub animate-on-scroll stagger-2">
          Stel je product samen, kies een ophaalmoment en Nathalie neemt snel contact met je op.
        </p>
        <ul class="trust animate-on-scroll stagger-3" aria-label="Goed om te weten">
          <li><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Volledig op maat</li>
          <li><i class="fa-solid fa-leaf" aria-hidden="true"></i> Speltbloem & bio-eitjes</li>
          <li><i class="fa-solid fa-euro-sign" aria-hidden="true"></i> Nu nog niets betalen</li>
        </ul>
      </div>
      <svg class="hero-wave" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,40 C240,90 480,0 720,30 C960,60 1200,10 1440,40 L1440,80 L0,80 Z" fill="#FFF9FA" />
      </svg>
    </section>

    <!-- Wizard -->
    <section id="aanvraag-form" class="aanvraag-form-section">
      <div class="container">
        <div class="wizard-card animate-on-scroll">
          <AanvraagWizard client:load />
        </div>
      </div>
    </section>

    <!-- FAQ + contact -->
    <section id="aanvraag-faq" class="section">
      <div class="container">
        <div class="faq-grid">
          <div class="animate-on-scroll">
            <span class="eyebrow">Goed om te weten</span>
            <h2 class="section-title" data-split>Veelgestelde vragen</h2>
            <p class="text-[var(--color-text-muted)] mb-6">Twijfel je of heb je een speciale vraag? Bel gerust even, dan bekijken we het samen.</p>
            <a href={SITE.phone.href} class="call-card" data-magnetic="0.15">
              <span class="call-icon"><i class="fa-solid fa-phone" aria-hidden="true"></i></span>
              <span>
                <small>Bel Nathalie</small>
                <strong>{SITE.phone.display}</strong>
              </span>
            </a>
          </div>

          <div class="faq-list">
            {faqs.map((f, i) => (
              <details class={`faq animate-on-scroll stagger-${i + 1}`}>
                <summary>
                  {f.q}
                  <i class="fa-solid fa-plus" aria-hidden="true"></i>
                </summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .aanvraag-hero {
    position: relative;
    overflow: hidden;
    padding: 9rem 0 7rem;
background: var(--hero-bg);
  }
  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(8px);
    color: var(--color-primary-dark);
    font-weight: 700;
    font-size: 0.85rem;
    box-shadow: 0 6px 20px -8px rgba(212, 90, 106, 0.4);
  }
  .aanvraag-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 1.05;
    margin: 1.25rem 0 1rem;
  }
  .aanvraag-sub {
    max-width: 38rem;
    margin: 0 auto;
    font-size: 1.15rem;
    color: #3d272a;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    font-weight: 600;
    font-size: 0.9rem;
    color: #3d272a;
  }
  .trust i { color: var(--color-primary-dark); margin-right: 0.35rem; }
  .hero-wave { position: absolute; bottom: -1px; left: 0; width: 100%; height: 60px; z-index: 5; }

  .aanvraag-form-section { position: relative; z-index: 10; margin-top: -4.5rem; padding-bottom: 4rem; }
  .wizard-card {
    max-width: 56rem;
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 2.75rem);
    border-radius: 1.75rem;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(18px) saturate(1.3);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 40px 100px -40px rgba(212, 90, 106, 0.45), 0 2px 0 rgba(255, 255, 255, 0.8) inset;
  }

  .faq-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 3rem; align-items: start; }
  .eyebrow { display: inline-block; font-size: 0.75rem; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700; color: var(--color-accent); margin-bottom: 0.5rem; }
  .call-card {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 1.4rem 0.9rem 0.9rem;
    border-radius: 999px;
    background: white;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    color: var(--color-text);
  }
  .call-card small { display: block; color: var(--color-text-muted); font-size: 0.75rem; }
  .call-card strong { font-size: 1.15rem; }
  .call-icon { width: 3rem; height: 3rem; border-radius: 50%; display: grid; place-items: center; background: var(--color-primary); color: white; }

  .faq-list { display: grid; gap: 0.75rem; }
  .faq { background: white; border: 1px solid var(--color-border); border-radius: 1.1rem; padding: 0 1.25rem; transition: box-shadow 300ms ease, border-color 300ms ease; }
  .faq[open] { border-color: var(--color-primary-light); box-shadow: var(--shadow-lg); }
  .faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 1.1rem 0; font-weight: 700; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary i { color: var(--color-primary); transition: transform 400ms var(--ease-spring); }
  .faq[open] summary i { transform: rotate(135deg); }
  .faq p { margin: 0 0 1.1rem; color: var(--color-text-muted); line-height: 1.7; }

  @media (max-width: 860px) {
    .faq-grid { grid-template-columns: 1fr; gap: 2rem; }
    .aanvraag-hero { padding: 7.5rem 0 6rem; }
  }
</style>
