---
import AdminLayout from '../../layouts/admin/AdminLayout.astro';
import CalendarPicker from '../../components/CalendarPicker.astro';

// Feature flag — set to true to enable Google Calendar integration
const GOOGLE_CALENDAR_ENABLED = false;

// Check connection status from URL
const url = Astro.url;
const connected = url.searchParams.get('connected') === 'true';
const disconnected = url.searchParams.get('disconnected') === 'true';
const error = url.searchParams.get('error');

const settings = {
  maxOrdersPerDay: 3,
  googleConnected: connected || false,
  recurringUnavailableDays: [0],
  availableDays: [1, 2, 3, 4, 5, 6]
};

// Get current month's weeks for display
const today = new Date();
const currentYear = today.getFullYear();
const currentMonth = today.getMonth();
const monthNames = ['Januari', 'Februari', 'Maart', 'April', 'Mei', 'Juni', 'Juli', 'Augustus', 'September', 'Oktober', 'November', 'December'];

// Generate weeks for current month
function getMonthWeeks(year: number, month: number) {
  const firstDay = new Date(year, month, 1);
  const lastDay = new Date(year, month + 1, 0);
  const daysInMonth = lastDay.getDate();
  let startDay = firstDay.getDay() - 1;
  if (startDay < 0) startDay = 6;
  
  const weeks: (number | null)[][] = [];
  let currentWeek: (number | null)[] = [];
  
  for (let i = 0; i < startDay; i++) {
    currentWeek.push(null);
  }
  
  for (let day = 1; day <= daysInMonth; day++) {
    currentWeek.push(day);
    if (currentWeek.length === 7) {
      weeks.push(currentWeek);
      currentWeek = [];
    }
  }
  
  if (currentWeek.length > 0) {
    while (currentWeek.length < 7) currentWeek.push(null);
    weeks.push(currentWeek);
  }
  
  return weeks;
}

const weeks = getMonthWeeks(currentYear, currentMonth);
---

<AdminLayout title="Beschikbaarheid">
  <div class="page-header">
    <div class="header-left">
      <p class="header-subtitle">Beheer je beschikbaarheid voor online boekingen</p>
    </div>
    <div class="header-actions">
      <button class="btn btn-primary" onclick="saveSettings()">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
          <polyline points="17 21 17 13 7 13 7 21"></polyline>
          <polyline points="7 3 7 8 15 8"></polyline>
        </svg>
        Opslaan
      </button>
    </div>
  </div>

  <!-- Alert Messages -->
  {connected && (
    <div class="alert alert-success">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <span><strong>Succes!</strong> Je Google Agenda is succesvol verbonden.</span>
    </div>
  )}

  {error && (
    <div class="alert alert-error">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="15" y1="9" x2="9" y2="15"></line>
        <line x1="9" y1="9" x2="15" y2="15"></line>
      </svg>
      <span><strong>Fout:</strong> Er ging iets mis bij het verbinden.</span>
    </div>
  )}

  {/* Google Calendar integration — hidden but code preserved. Set GOOGLE_CALENDAR_ENABLED = true to re-enable. */}
  {GOOGLE_CALENDAR_ENABLED && (
  <div class="connection-card">
    <div class="connection-info">
      <div class={`connection-icon ${settings.googleConnected ? 'connected' : ''}`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <div>
        <strong>Google Agenda {settings.googleConnected ? 'verbonden' : 'niet verbonden'}</strong>
        <p>{settings.googleConnected ? 'Je agenda wordt automatisch gesynchroniseerd.' : 'Verbind om events automatisch te blokkeren.'}</p>
      </div>
    </div>
    <div class="connection-actions">
      {settings.googleConnected ? (
        <form method="POST" action="/admin/api/calendar/disconnect">
          <button type="submit" class="btn btn-secondary">Ontkoppelen</button>
        </form>
      ) : (
        <a href="/admin/api/calendar/connect" class="btn btn-primary">Verbinden</a>
      )}
    </div>
  </div>
  )}

  <!-- Month Overview -->
  <div>
    <div class="month-overview">
      <div class="month-header">
        <h3>{monthNames[currentMonth]} {currentYear}</h3>
        <div class="month-nav">
          <button class="nav-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
          <button class="nav-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Bulk Action Bar (hidden until dates selected) -->
      <div id="bulk-bar" class="bulk-bar" style="display:none">
        <span id="bulk-count">0 dagen geselecteerd</span>
        <div class="bulk-actions">
          <button class="btn btn-sm" type="button" onclick="setBulkAvail('open')">🟢 Open</button>
          <button class="btn btn-sm" type="button" onclick="setBulkAvail('beperkt')">🟡 Beperkt</button>
          <button class="btn btn-sm" type="button" onclick="setBulkAvail('vol')">🔴 Vol</button>
          <button class="btn btn-sm" type="button" onclick="setBulkAvail('geblokkeerd')">⚫ Geblokkeerd</button>
          <button class="btn btn-sm btn-secondary" type="button" onclick="clearSelection()">Wissen</button>
        </div>
      </div>

      <div class="calendar-grid">
        <div class="day-headers">
          <span>Ma</span><span>Di</span><span>Wo</span><span>Do</span><span>Vr</span><span>Za</span><span>Zo</span>
        </div>
        <div class="days-grid" id="availability-calendar">
          {weeks.map((week) => {
            // Compute the Sunday date of this week's Sunday to derive adjacent-month days
            // First, find the first day of the visible month grid
            const firstOfMonth = new Date(currentYear, currentMonth, 1);
            // Monday-first: 0=Mon,...,6=Sun. getDay() is 0=Sun,...,6=Sat
            const firstDow = (firstOfMonth.getDay() + 6) % 7; // Mon-based index of month start
            // Find the date of the Monday before (or of) the 1st of month
            const mondayOfFirstWeek = new Date(firstOfMonth);
            mondayOfFirstWeek.setDate(1 - firstDow);

            return (
              <div class="week-row">
                {week.map((day) => {
                  if (day === null) {
                    return <div class="day-cell empty"><div class="day-content"><span class="day-number"></span></div></div>;
                  }
                  // Compute absolute day index from start of first week
                  const weekIndex = weeks.indexOf(week);
                  const dayIndex = week.indexOf(day);
                  const d = new Date(mondayOfFirstWeek);
                  d.setDate(d.getDate() + weekIndex * 7 + dayIndex);
                  const isoDate = d.toISOString().split('T')[0];
                  const isCurrentMonth = d.getMonth() === currentMonth;
                  return (
                    <div class={`day-cell ${!isCurrentMonth ? 'other-month' : ''}`}>
                      <button
                        class="day-content day-editable"
                        data-date={isoDate}
                        onclick="toggleDateSelect(this, event)"
                        type="button"
                      >
                        <span class="day-number">{d.getDate()}</span>
                        <div class="day-status">
                          <div class="status-bar">
                            <div class="status-fill" style="width:0%"></div>
                          </div>
                          <span class="status-text">0/3</span>
                        </div>
                        <span class="selected-check" style="display:none">✓</span>
                      </button>
                    </div>
                  );
                })}
              </div>
            );
          })}
        </div>
      </div>
      
      <div class="month-legend">
        <div class="legend-item">
          <span class="dot green"></span>
          <span>Beschikbaar</span>
        </div>
        <div class="legend-item">
          <span class="dot yellow"></span>
          <span>Beperkt</span>
        </div>
        <div class="legend-item">
          <span class="dot red"></span>
          <span>Vol</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Werkuren & Max Orders — below calendar -->
  <div class="work-days-section">
    <div class="week-grid">
      <div class="day-setting">
        <label>Maandag</label>
        <div class="day-toggle active">
          <input type="checkbox" checked data-day="1" onchange="toggleDay(this)" />
          <span class="toggle-slider"></span>
        </div>
      </div>
      <div class="day-setting">
        <label>Dinsdag</label>
        <div class="day-toggle active">
          <input type="checkbox" checked data-day="2" onchange="toggleDay(this)" />
          <span class="toggle-slider"></span>
        </div>
      </div>
      <div class="day-setting">
        <label>Woensdag</label>
        <div class="day-toggle active">
          <input type="checkbox" checked data-day="3" onchange="toggleDay(this)" />
          <span class="toggle-slider"></span>
        </div>
      </div>
      <div class="day-setting">
        <label>Donderdag</label>
        <div class="day-toggle active">
          <input type="checkbox" checked data-day="4" onchange="toggleDay(this)" />
          <span class="toggle-slider"></span>
        </div>
      </div>
      <div class="day-setting">
        <label>Vrijdag</label>
        <div class="day-toggle active">
          <input type="checkbox" checked data-day="5" onchange="toggleDay(this)" />
          <span class="toggle-slider"></span>
        </div>
      </div>
      <div class="day-setting">
        <label>Zaterdag</label>
        <div class="day-toggle active">
          <input type="checkbox" checked data-day="6" onchange="toggleDay(this)" />
          <span class="toggle-slider"></span>
        </div>
      </div>
      <div class="day-setting">
        <label>Zondag</label>
        <div class="day-toggle">
          <input type="checkbox" data-day="0" onchange="toggleDay(this)" />
          <span class="toggle-slider"></span>
        </div>
      </div>
    </div>
    <div class="max-orders-setting">
      <h4>Maximale bestellingen per dag</h4>
      <div class="number-input">
        <button type="button" onclick="adjustMaxOrders(-1)">−</button>
        <input type="number" id="maxOrders" value={settings.maxOrdersPerDay} min="1" max="20" />
        <button type="button" onclick="adjustMaxOrders(1)">+</button>
      </div>
    </div>
  </div>

  <!-- Single Date Edit Modal -->
  <!-- Confirm Popup -->
  <div id="confirm-modal" class="modal-overlay" style="display:none">
    <div class="modal-card" style="width:360px;">
      <div class="modal-header">
        <h3 id="confirm-title">Waarschuwing</h3>
        <button class="modal-close" onclick="closeConfirmModal()" type="button">✕</button>
      </div>
      <div class="modal-body">
        <p id="confirm-message" style="margin:0;font-size:0.9rem;color:#475569;"></p>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeConfirmModal()" type="button">Annuleer</button>
        <button class="btn btn-danger" id="confirm-btn" onclick="confirmAction()" type="button">Bevestig</button>
      </div>
    </div>
  </div>

  <div id="date-modal" class="modal-overlay" style="display:none">
    <div class="modal-card">
      <div class="modal-header">
        <h3 id="modal-date-title">Datum bewerken</h3>
        <button class="modal-close" onclick="closeDateModal()" type="button">✕</button>
      </div>
      <div class="modal-body">
        <p class="modal-date-display" id="modal-date-display"></p>

        <div class="modal-section">
          <label class="modal-label">Beschikbaarheid</label>
          <div class="modal-availability-options">
            <button class="avail-btn" id="avail-open" onclick="setAvail('open')" type="button">
              <span class="avail-dot green"></span>Open
            </button>
            <button class="avail-btn" id="avail-beperkt" onclick="setAvail('beperkt')" type="button">
              <span class="avail-dot yellow"></span>Beperkt (1 plek)
            </button>
            <button class="avail-btn" id="avail-vol" onclick="setAvail('vol')" type="button">
              <span class="avail-dot red"></span>Vol
            </button>
            <button class="avail-btn" id="avail-geblokkeerd" onclick="setAvail('geblokkeerd')" type="button">
              <span class="avail-dot gray"></span>Geblokkeerd
            </button>
          </div>
        </div>

        <div class="modal-section">
          <label class="modal-label">Of aangepast aantal beschikbaar</label>
          <div class="number-input">
            <button type="button" onclick="adjustModalOrders(-1)">−</button>
            <input type="number" id="modal-orders" value="3" min="0" max="20" />
            <button type="button" onclick="adjustModalOrders(1)">+</button>
          </div>
          <p class="modal-hint">Gebruik dit om een specifiek aantal plaatsen in te stellen.</p>
        </div>

        <div class="modal-section">
          <label class="modal-label">Reden (optioneel)</label>
          <input type="text" id="modal-reason" class="modal-input" placeholder="Bijv. Vakantie, bezet, ..." />
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeDateModal()" type="button">Annuleer</button>
        <button class="btn btn-primary" onclick="saveDateModal()" type="button">Opslaan</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // --- Toast Notifications ---
  function showToast(message: string, type: 'success' | 'error' | 'info' = 'success') {
    const container = document.getElementById('toast-container')!;
    const icons = { success: '✓', error: '✕', info: 'ℹ' };
    const toast = document.createElement('div');
    toast.className = `toast toast-${type}`;
    toast.innerHTML = `<span class="toast-icon">${icons[type]}</span><span>${message}</span>`;
    container.appendChild(toast);
    setTimeout(() => {
      toast.style.animation = 'toastOut 0.2s ease forwards';
      setTimeout(() => toast.remove(), 200);
    }, 3000);
  }

  // --- Confirm Dialog ---
  let confirmResolve: ((value: boolean) => void) | null = null;

  (window as any).closeConfirmModal = function() {
    document.getElementById('confirm-modal')!.style.display = 'none';
    if (confirmResolve) { confirmResolve(false); confirmResolve = null; }
  };

  (window as any).confirmAction = async function() {
    document.getElementById('confirm-modal')!.style.display = 'none';
    if (confirmResolve) { confirmResolve(true); confirmResolve = null; }
  };

  function showConfirm(title: string, message: string): Promise<boolean> {
    return new Promise(resolve => {
      confirmResolve = resolve;
      document.getElementById('confirm-title')!.textContent = title;
      document.getElementById('confirm-message')!.textContent = message;
      document.getElementById('confirm-modal')!.style.display = 'flex';
    });
  }

  // --- Tab switching ---
  function adjustMaxOrders(delta: number) {
    const input = document.getElementById('maxOrders') as HTMLInputElement;
    const newValue = Math.min(20, Math.max(1, parseInt(input.value) + delta));
    input.value = String(newValue);
  }

  function toggleDay(checkbox: HTMLInputElement) {
    const toggle = checkbox.closest('.day-toggle');
    toggle?.classList.toggle('active', checkbox.checked);
    // Immediately save the day toggle and refresh the calendar
    window.saveSettings(true);
  }


  // --- Multi-select state ---
  let selectedDates: Set<string> = new Set();
  let slotOverrides: Record<string, { mode: string; orders: number; reason?: string }> = {};

  (window as any).toggleDateSelect = function(el: HTMLElement, event: MouseEvent) {
    event.stopPropagation();
    const dateStr = el.dataset.date || '';
    if (!dateStr) return;

    if (selectedDates.has(dateStr)) {
      selectedDates.delete(dateStr);
      el.classList.remove('selected');
      el.querySelector<HTMLElement>('.selected-check')!.style.display = 'none';
    } else {
      selectedDates.add(dateStr);
      el.classList.add('selected');
      el.querySelector<HTMLElement>('.selected-check')!.style.display = 'flex';
    }

    updateBulkBar();
  };

  function updateBulkBar() {
    const bar = document.getElementById('bulk-bar')!;
    const count = document.getElementById('bulk-count')!;
    if (selectedDates.size === 0) {
      bar.style.display = 'none';
    } else {
      bar.style.display = 'flex';
      count.textContent = `${selectedDates.size} ${selectedDates.size === 1 ? 'dag' : 'dagen'} geselecteerd`;
    }
  }

  (window as any).clearSelection = function() {
    selectedDates.clear();
    document.querySelectorAll('.day-editable.selected').forEach(el => {
      el.classList.remove('selected');
      el.querySelector<HTMLElement>('.selected-check')!.style.display = 'none';
    });
    updateBulkBar();
  };

  (window as any).setBulkAvail = async function(mode: string) {
    if (selectedDates.size === 0) return;

    selectedDates.forEach(date => {
      if (mode === 'open') {
        delete slotOverrides[date];
      } else {
        const orders = mode === 'vol' || mode === 'geblokkeerd' ? 0
          : mode === 'beperkt' ? 3 // will be decremented in loadAvailability
          : 3;
        slotOverrides[date] = { mode, orders };
      }
    });

    await persistOverrides();
    clearSelection();
    loadAvailability();
  };

  async function persistOverrides() {
    await fetch('/api/availability', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        maxOrdersPerDay: parseInt((document.getElementById('maxOrders') as HTMLInputElement).value),
        slotOverrides
      })
    });
  }

  (window as any).saveSettings = async function(silent = false) {
    const maxOrders = parseInt((document.getElementById('maxOrders') as HTMLInputElement).value);
    const availableDays: number[] = [];
    const allDays = [0, 1, 2, 3, 4, 5, 6];
    document.querySelectorAll<HTMLInputElement>('[data-day]').forEach(el => {
      if (el.checked) {
        availableDays.push(parseInt(el.dataset.day || '0'));
      }
    });
    const recurringUnavailableDays = allDays.filter(d => !availableDays.includes(d));
    try {
      const res = await fetch('/api/availability', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          maxOrdersPerDay: maxOrders,
          availableDays,
          recurringUnavailableDays,
          slotOverrides
        })
      });
      const data = await res.json();
      if (!silent) {
        showToast(data.success ? 'Instellingen opgeslagen!' : 'Opgeslagen!', 'success');
      }
    } catch {
      if (!silent) showToast('Fout bij opslaan', 'error');
    }
    // Refresh the calendar to reflect the new recurring day settings
    loadAvailability();
  };

  // --- Single date modal ---
  let currentEditDate: string | null = null;
  let currentAvailMode = 'open';

  (window as any).openDateModal = function(el: HTMLElement) {
    const dateStr = el.dataset.date || '';
    currentEditDate = dateStr;
    currentAvailMode = 'open';

    const d = new Date(dateStr + 'T00:00:00');
    const modal = document.getElementById('date-modal')!;
    document.getElementById('modal-date-title')!.textContent = 'Datum bewerken';
    document.getElementById('modal-date-display')!.textContent = d.toLocaleDateString('nl-BE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
    (document.getElementById('modal-reason') as HTMLInputElement).value = '';
    (document.getElementById('modal-orders') as HTMLInputElement).value = '3';

    const override = slotOverrides[dateStr];
    if (override) {
      currentAvailMode = override.mode;
      (document.getElementById('modal-orders') as HTMLInputElement).value = String(override.orders);
      if (override.reason) (document.getElementById('modal-reason') as HTMLInputElement).value = override.reason;
    }
    updateAvailButtons(currentAvailMode);
    modal.style.display = 'flex';
  };

  (window as any).closeDateModal = function() {
    document.getElementById('date-modal')!.style.display = 'none';
    currentEditDate = null;
  };

  function updateAvailButtons(mode: string) {
    document.querySelectorAll('.avail-btn').forEach(b => b.classList.remove('active'));
    const idMap: Record<string, string> = {
      'open': 'avail-open',
      'beperkt': 'avail-beperkt',
      'vol': 'avail-vol',
      'geblokkeerd': 'avail-geblokkeerd',
      'custom': 'avail-beperkt'
    };
    const btn = document.getElementById(idMap[mode] || 'avail-open');
    btn?.classList.add('active');
  }

  (window as any).setAvail = function(mode: string) {
    currentAvailMode = mode;
    updateAvailButtons(mode);
  };

  (window as any).adjustModalOrders = function(delta: number) {
    const input = document.getElementById('modal-orders') as HTMLInputElement;
    input.value = String(Math.min(20, Math.max(0, parseInt(input.value) + delta)));
    currentAvailMode = 'custom';
    updateAvailButtons('custom');
  };

  (window as any).saveDateModal = async function() {
    if (!currentEditDate) return;
    const orders = parseInt((document.getElementById('modal-orders') as HTMLInputElement).value);
    const reason = (document.getElementById('modal-reason') as HTMLInputElement).value.trim();

    if (currentAvailMode === 'open') {
      delete slotOverrides[currentEditDate];
    } else {
      slotOverrides[currentEditDate] = {
        mode: currentAvailMode === 'custom' ? 'custom' : currentAvailMode,
        orders,
        reason
      };
    }

    await persistOverrides();
    closeDateModal();
    loadAvailability();
  };

  // Also wire double-click on calendar cell to open modal
  document.addEventListener('dblclick', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('.day-editable');
    if (btn) openDateModal(btn);
  });

  // --- Load availability from API ---
  async function loadAvailability() {
    try {
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      const endDate = new Date(today);
      endDate.setMonth(endDate.getMonth() + 2);

      const res = await fetch(`/api/availability?startDate=${today.toISOString().split('T')[0]}&endDate=${endDate.toISOString().split('T')[0]}`);
      const data = await res.json();

      if (data.settings?.slotOverrides) {
        slotOverrides = data.settings.slotOverrides;
      }

      // Apply settings to UI: day toggles and max orders
      if (data.settings) {
        const { availableDays, maxOrdersPerDay, recurringUnavailableDays } = data.settings;
        // Set max orders input
        const maxInput = document.getElementById('maxOrders') as HTMLInputElement;
        if (maxInput && maxOrdersPerDay) maxInput.value = String(maxOrdersPerDay);

        // Build the set of available days (0=Sun..6=Sat)
        const availSet = new Set(availableDays ?? []);

        // Set checkboxes — all days start unchecked, then check the available ones
        document.querySelectorAll<HTMLInputElement>('[data-day]').forEach(el => {
          const day = parseInt(el.dataset.day || '0');
          el.checked = availSet.has(day);
          const toggle = el.closest('.day-toggle');
          if (toggle) toggle.classList.toggle('active', availSet.has(day));
        });
      }

      if (data.availability) {
        data.availability.forEach((slot: any) => {
          const dayContent = document.querySelector<HTMLElement>(`.day-editable[data-date="${slot.date}"]`);
          if (!dayContent) return;

          const bar = dayContent.querySelector<HTMLElement>('.status-fill');
          const text = dayContent.querySelector<HTMLElement>('.status-text');
          const cell = dayContent.closest<HTMLElement>('.day-cell');

          let displayOrders = slot.orders;
          let displayMax = slot.maxOrders;
          let available = slot.available;
          const override = slotOverrides[slot.date];

          if (override) {
            if (override.mode === 'geblokkeerd') {
              available = false;
              displayOrders = 0; displayMax = 0;
            } else if (override.mode === 'vol') {
              available = false;
              displayOrders = displayMax;
            } else if (override.mode === 'beperkt') {
              available = true;
              displayOrders = Math.max(0, displayMax - 1);
            } else if (override.mode === 'custom') {
              available = override.orders > 0;
              displayOrders = override.orders;
            }
          }

          if (bar && text && cell) {
            bar.style.width = displayMax > 0 ? `${(displayOrders / displayMax) * 100}%` : '0%';
            text.textContent = `${displayOrders}/${displayMax}`;
            cell.classList.remove('available', 'limited', 'full', 'blocked', 'other-month');
            if (!available) {
              cell.classList.add('full');
              if (override?.mode === 'geblokkeerd') cell.classList.add('blocked');
            } else if (displayMax - displayOrders <= 1) {
              cell.classList.add('limited');
            } else {
              cell.classList.add('available');
            }
          }
        });
      }
    } catch (err) {
      console.log('Could not load availability:', err);
    }
  }

  loadAvailability();
</script>

