---
import AdminLayout from '../../layouts/admin/AdminLayout.astro';

// Check for connection status from URL params (mock - in production check database)
const url = Astro.url;
const connected = url.searchParams.get('connected') === 'true';
const disconnected = url.searchParams.get('disconnected') === 'true';
const error = url.searchParams.get('error');

// Settings - in production, load from database
const settings = {
  maxOrdersPerDay: 3,
  googleConnected: connected || false
};

// Mock orders for this week (in production, fetch from database)
const weeklyOrders = [
  { date: '2026-04-02', count: 2 },
  { date: '2026-04-03', count: 1 },
  { date: '2026-04-04', count: 0 },
  { date: '2026-04-05', count: 3 }, // Full
  { date: '2026-04-06', count: 0 },
  { date: '2026-04-07', count: 0 },
  { date: '2026-04-08', count: 1 },
];
---

<AdminLayout title="Beschikbaarheid">
  <div class="page-header">
    <div class="header-left">
      <p class="header-subtitle">Beheer je beschikbaarheid voor online boekingen</p>
    </div>
    <div class="header-actions">
      <button class="btn btn-primary" onclick="saveSettings()">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
          <polyline points="17 21 17 13 7 13 7 21"></polyline>
          <polyline points="7 3 7 8 15 8"></polyline>
        </svg>
        Opslaan
      </button>
    </div>
  </div>

  <!-- Connection Status / Alert -->
  {connected && (
    <div class="alert alert-success">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <span><strong>Succes!</strong> Je Google Agenda is succesvol verbonden.</span>
    </div>
  )}

  {disconnected && (
    <div class="alert alert-info">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <span>Je Google Agenda is ontkoppeld.</span>
    </div>
  )}

  {error && (
    <div class="alert alert-error">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="15" y1="9" x2="9" y2="15"></line>
        <line x1="9" y1="9" x2="15" y2="15"></line>
      </svg>
      <span><strong>Fout:</strong> Er ging iets mis bij het verbinden met Google Agenda. Probeer opnieuw.</span>
    </div>
  )}

  <!-- Google Calendar Connection -->
  <div class="connection-card">
    <div class="connection-info">
      <div class={`connection-icon ${settings.googleConnected ? 'connected' : ''}`}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      </div>
      <div>
        <strong>Google Agenda {settings.googleConnected ? 'verbonden' : 'niet verbonden'}</strong>
        <p>
          {settings.googleConnected 
            ? 'Je agenda wordt automatisch gesynchroniseerd met je Google Agenda events.'
            : 'Verbind je Google Agenda om events automatisch te blokkeren als je bezet bent.'}
        </p>
      </div>
    </div>
    <div class="connection-actions">
      {settings.googleConnected ? (
        <form method="POST" action="/admin/api/calendar/disconnect">
          <button type="submit" class="btn btn-secondary">Ontkoppelen</button>
        </form>
      ) : (
        <a href="/admin/api/calendar/connect" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
          Verbinden
        </a>
      )}
    </div>
  </div>

  <!-- Max Orders Per Day Setting -->
  <div class="settings-card">
    <h2>Maximale bestellingen per dag</h2>
    <p class="card-description">
      Stel in hoeveel bestellingen je per dag kunt verwerken. Dit bepaalt je beschikbaarheid voor klanten.
    </p>
    
    <div class="setting-row">
      <div class="setting-info">
        <label for="maxOrders" class="setting-label">Bestellingen per dag</label>
        <span class="setting-hint">Klanten kunnen alleen boeken op dagen waar nog capaciteit is.</span>
      </div>
      <div class="number-input-group">
        <button type="button" class="number-btn" onclick="adjustMaxOrders(-1)">−</button>
        <input type="number" id="maxOrders" value={settings.maxOrdersPerDay} min="1" max="20" class="number-input" />
        <button type="button" class="number-btn" onclick="adjustMaxOrders(1)">+</button>
      </div>
    </div>
  </div>

  <!-- Availability Calendar -->
  <div class="availability-section">
    <h2>Beschikbaarheid deze week</h2>
    <p class="card-description">
      Bekijk welke dagen nog beschikbaar zijn op basis van je huidige bestellingen.
    </p>
    
    <div class="week-grid">
      <div class="week-header">
        <span>Datum</span>
        <span>Bestellingen</span>
        <span>Status</span>
        <span>Actie</span>
      </div>
      {weeklyOrders.map((day) => {
        const isFull = day.count >= settings.maxOrdersPerDay;
        const date = new Date(day.date);
        const dayName = date.toLocaleDateString('nl-BE', { weekday: 'short' });
        const dayNum = date.getDate();
        const monthName = date.toLocaleDateString('nl-BE', { month: 'short' });
        const remaining = settings.maxOrdersPerDay - day.count;
        
        return (
          <div class={`week-row ${isFull ? 'full' : 'available'}`}>
            <div class="date-cell">
              <span class="day-name">{dayName}</span>
              <span class="day-num">{dayNum} {monthName}</span>
            </div>
            <div class="orders-cell">
              <div class="orders-bar">
                <div class="orders-fill" style={`width: ${(day.count / settings.maxOrdersPerDay) * 100}%`}></div>
              </div>
              <span class="orders-text">{day.count} / {settings.maxOrdersPerDay}</span>
            </div>
            <div class="status-cell">
              {isFull ? (
                <span class="status-badge full">Vol</span>
              ) : (
                <span class="status-badge available">{remaining} plaats</span>
              )}
            </div>
            <div class="action-cell">
              <button class="btn btn-sm btn-secondary" onclick={`toggleDayAvailability('${day.date}')`}>
                {isFull ? 'Openstellen' : 'Blokkeren'}
              </button>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Blocked Dates -->
  <div class="blocked-section">
    <h2>Geblokkeerde data</h2>
    <p class="card-description">
      Data die je handmatig hebt geblokkeerd. Klanten kunnen niet boeken op deze dagen.
    </p>
    
    <div class="blocked-list">
      <div class="blocked-item">
        <div class="blocked-date">
          <span class="blocked-day">Za</span>
          <span class="blocked-num">12 april 2026</span>
        </div>
        <div class="blocked-reason">Persoonlijke reden</div>
        <button class="btn btn-sm btn-secondary">Deblokkeren</button>
      </div>
      <div class="blocked-item">
        <div class="blocked-date">
          <span class="blocked-day">Zo</span>
          <span class="blocked-num">20 april 2026</span>
        </div>
        <div class="blocked-reason">Vakantie</div>
        <button class="btn btn-sm btn-secondary">Deblokkeren</button>
      </div>
    </div>
    
    <button class="btn btn-secondary add-blocked">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      Datum blokkeren
    </button>
  </div>
</AdminLayout>

<script>
  function adjustMaxOrders(delta: number) {
    const input = document.getElementById('maxOrders') as HTMLInputElement;
    const newValue = Math.min(20, Math.max(1, parseInt(input.value) + delta));
    input.value = String(newValue);
  }

  function saveSettings() {
    const maxOrders = (document.getElementById('maxOrders') as HTMLInputElement).value;
    console.log('Saving settings:', { maxOrdersPerDay: maxOrders });
    alert('Instellingen opgeslagen!');
  }

  function toggleDayAvailability(date: string) {
    console.log('Toggling availability for:', date);
    // In production, call API to toggle
  }
</script>

<style>
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.header-subtitle {
  margin: 0;
  color: #64748b;
  font-size: 0.875rem;
}

.header-actions {
  display: flex;
  gap: 0.75rem;
}

/* Alerts */
.alert {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1rem 1.25rem;
  border-radius: 0.75rem;
  margin-bottom: 1.5rem;
  font-size: 0.875rem;
}

.alert-success {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  color: #166534;
}

.alert-info {
  background: #eff6ff;
  border: 1px solid #bfdbfe;
  color: #1e40af;
}

.alert-error {
  background: #fef2f2;
  border: 1px solid #fecaca;
  color: #991b1b;
}

/* Connection Card */
.connection-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}

.connection-info {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.connection-icon {
  width: 3rem;
  height: 3rem;
  border-radius: 50%;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
}

.connection-icon.connected {
  background: #dcfce7;
  color: #16a34a;
}

.connection-info strong {
  display: block;
  margin-bottom: 0.25rem;
}

.connection-info p {
  margin: 0;
  font-size: 0.875rem;
  color: #64748b;
}

/* Settings Card */
.settings-card {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}

.settings-card h2 {
  font-size: 1.125rem;
  font-weight: 600;
  color: #0f172a;
  margin: 0 0 0.5rem 0;
}

.card-description {
  font-size: 0.875rem;
  color: #64748b;
  margin: 0 0 1.5rem 0;
}

.setting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.setting-label {
  font-weight: 500;
  color: #1e293b;
  display: block;
  margin-bottom: 0.25rem;
}

.setting-hint {
  font-size: 0.75rem;
  color: #94a3b8;
}

.number-input-group {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.number-btn {
  width: 2.5rem;
  height: 2.5rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.5rem;
  background: white;
  font-size: 1.25rem;
  color: #64748b;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.number-btn:hover {
  background: #f1f5f9;
  border-color: #e11d48;
  color: #e11d48;
}

.number-input {
  width: 4rem;
  height: 2.5rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.5rem;
  text-align: center;
  font-size: 1rem;
  font-weight: 600;
}

.number-input:focus {
  outline: none;
  border-color: #e11d48;
}

/* Availability Section */
.availability-section {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
  padding: 1.5rem;
  margin-bottom: 1.5rem;
}

.availability-section h2 {
  font-size: 1.125rem;
  font-weight: 600;
  color: #0f172a;
  margin: 0 0 0.5rem 0;
}

.week-grid {
  border: 1px solid #e2e8f0;
  border-radius: 0.75rem;
  overflow: hidden;
}

.week-header {
  display: grid;
  grid-template-columns: 140px 1fr 120px 120px;
  gap: 1rem;
  padding: 0.75rem 1rem;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #64748b;
}

.week-row {
  display: grid;
  grid-template-columns: 140px 1fr 120px 120px;
  gap: 1rem;
  padding: 1rem;
  border-bottom: 1px solid #f1f5f9;
  align-items: center;
}

.week-row:last-child {
  border-bottom: none;
}

.week-row.full {
  background: #fef2f2;
}

.week-row.available {
  background: #f0fdf4;
}

.date-cell {
  display: flex;
  flex-direction: column;
}

.day-name {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  color: #64748b;
}

.day-num {
  font-weight: 600;
  color: #1e293b;
}

.orders-cell {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.orders-bar {
  height: 8px;
  background: #e2e8f0;
  border-radius: 4px;
  overflow: hidden;
}

.orders-fill {
  height: 100%;
  background: #e11d48;
  border-radius: 4px;
  transition: width 0.3s;
}

.orders-text {
  font-size: 0.75rem;
  color: #64748b;
}

.status-badge {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.75rem;
  font-weight: 600;
}

.status-badge.available {
  background: #dcfce7;
  color: #166534;
}

.status-badge.full {
  background: #fee2e2;
  color: #991b1b;
}

/* Blocked Section */
.blocked-section {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
  padding: 1.5rem;
}

.blocked-section h2 {
  font-size: 1.125rem;
  font-weight: 600;
  color: #0f172a;
  margin: 0 0 0.5rem 0;
}

.blocked-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.blocked-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.75rem 1rem;
  background: #fef2f2;
  border-radius: 0.5rem;
}

.blocked-date {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  min-width: 140px;
}

.blocked-day {
  width: 2rem;
  height: 2rem;
  background: #fee2e2;
  border-radius: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 600;
  color: #dc2626;
}

.blocked-num {
  font-weight: 500;
  color: #1e293b;
}

.blocked-reason {
  flex: 1;
  font-size: 0.875rem;
  color: #64748b;
}

.add-blocked {
  width: 100%;
  justify-content: center;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 1rem;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s;
  cursor: pointer;
  border: none;
}

.btn-sm {
  padding: 0.375rem 0.75rem;
  font-size: 0.75rem;
}

.btn-primary {
  background: #e11d48;
  color: white;
}

.btn-primary:hover {
  background: #be123c;
}

.btn-secondary {
  background: #f1f5f9;
  color: #334155;
}

.btn-secondary:hover {
  background: #e2e8f0;
}
</style>
