---
import AdminLayout from '../../layouts/admin/AdminLayout.astro';
import CalendarHeader from '../../components/admin/calendar/CalendarHeader.astro';
import CalendarAlerts from '../../components/admin/calendar/CalendarAlerts.astro';
import CalendarTabs from '../../components/admin/calendar/CalendarTabs.astro';
import CalendarMonthView from '../../components/admin/calendar/CalendarMonthView.astro';
import CalendarBlockView from '../../components/admin/calendar/CalendarBlockView.astro';
import CalendarHoursView from '../../components/admin/calendar/CalendarHoursView.astro';
import { readFileSync, existsSync } from 'fs';
import { join } from 'path';

const DATA_DIR = join(process.cwd(), 'data');
const SETTINGS_FILE = join(DATA_DIR, 'settings.json');

const url = Astro.url;
const connected = url.searchParams.get('connected') === 'true';
const disconnected = url.searchParams.get('disconnected') === 'true';
const error = url.searchParams.get('error');

function loadSettings() {
  if (!existsSync(SETTINGS_FILE)) {
    return { maxOrdersPerDay: 3, googleConnected: false, recurringUnavailableDays: [0], availableDays: [1, 2, 3, 4, 5, 6] };
  }
  try {
    const data = readFileSync(SETTINGS_FILE, 'utf-8');
    const s = JSON.parse(data);
    return {
      maxOrdersPerDay: s.maxOrdersPerDay || 3,
      googleConnected: s.googleConnected || false,
      recurringUnavailableDays: s.recurringUnavailableDays || [0],
      availableDays: s.availableDays || [1, 2, 3, 4, 5, 6]
    };
  } catch {
    return { maxOrdersPerDay: 3, googleConnected: false, recurringUnavailableDays: [0], availableDays: [1, 2, 3, 4, 5, 6] };
  }
}

const settings = loadSettings();
---

<AdminLayout title="Beschikbaarheid">
  <CalendarHeader />
  <CalendarAlerts connected={connected} disconnected={disconnected} error={error} />
  <CalendarTabs />
  <CalendarMonthView />
  <CalendarBlockView />
  <CalendarHoursView maxOrdersPerDay={settings.maxOrdersPerDay} availableDays={settings.availableDays} />
</AdminLayout>

<style is:global>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .header-subtitle {
    margin: 0;
    color: #64748b;
    font-size: 0.875rem;
  }

  .header-actions {
    display: flex;
    gap: 0.75rem;
  }

  /* Alerts */
  .alert {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }

  .alert-success {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    color: #166534;
  }

  .alert-error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
  }

  .alert-warning {
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #92400e;
  }

  /* Connection Card */
  .connection-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .connection-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .connection-icon {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #64748b;
  }

  .connection-icon.connected {
    background: #dcfce7;
    color: #16a34a;
  }

  .connection-info strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .connection-info p {
    margin: 0;
    font-size: 0.875rem;
    color: #64748b;
  }

  /* Tabs */
  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    background: white;
    padding: 0.5rem;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
  }

  .tab-btn {
    flex: 1;
    padding: 0.75rem 1rem;
    border: none;
    background: none;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #64748b;
    cursor: pointer;
    transition: all 0.2s;
  }

  .tab-btn:hover {
    background: #f8fafc;
  }

  .tab-btn.active {
    background: #E8788A;
    color: white;
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  /* Month Overview */
  .month-overview {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .month-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .month-header h3 {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .month-nav {
    display: flex;
    gap: 0.5rem;
  }

  .nav-btn {
    width: 2rem;
    height: 2rem;
    border: 1px solid #e2e8f0;
    background: white;
    border-radius: 0.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .calendar-grid {
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .day-headers {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .day-headers span {
    padding: 0.75rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
  }

  .days-grid {
    display: flex;
    flex-direction: column;
  }

  .week-row {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    border-bottom: 1px solid #f1f5f9;
  }

  .week-row:last-child {
    border-bottom: none;
  }

  .day-cell {
    min-height: 60px;
    padding: 0.5rem;
    border-right: 1px solid #f1f5f9;
  }

  .day-cell:last-child {
    border-right: none;
  }

  .day-cell.empty {
    background: #f8fafc;
  }

  .day-cell.available {
    background: #f0fdf4;
  }

  .day-cell.limited {
    background: #fef3c7;
  }

  .day-cell.full {
    background: #fef2f2;
  }

  .day-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .day-number {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1e293b;
  }

  .day-status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-bar {
    flex: 1;
    height: 4px;
    background: #e2e8f0;
    border-radius: 2px;
    overflow: hidden;
  }

  .status-fill {
    height: 100%;
    background: #22c55e;
    transition: width 0.3s;
  }

  .status-text {
    font-size: 0.625rem;
    color: #64748b;
  }

  .month-legend {
    display: flex;
    gap: 1.5rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #f1f5f9;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: #64748b;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot.green {
    background: #22c55e;
  }

  .dot.yellow {
    background: #f59e0b;
  }

  .dot.red {
    background: #ef4444;
  }

  /* Block Section */
  .block-section {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .block-section h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .block-section > p {
    margin: 0 0 1.5rem 0;
    color: #64748b;
    font-size: 0.875rem;
  }

  .block-calendar {
    display: flex;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .blocked-list h4 {
    margin: 0 0 1rem 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .blocked-items {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .blocked-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem;
    background: #fef2f2;
    border-radius: 0.5rem;
  }

  .blocked-date {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 140px;
  }

  .blocked-day {
    width: 2rem;
    height: 2rem;
    background: #fee2e2;
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 600;
    color: #dc2626;
  }

  .blocked-reason {
    flex: 1;
    font-size: 0.875rem;
    color: #64748b;
  }

  /* Hours Section */
  .hours-section {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.5rem;
  }

  .hours-section h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.125rem;
    font-weight: 600;
  }

  .hours-section > p {
    margin: 0 0 1.5rem 0;
    color: #64748b;
    font-size: 0.875rem;
  }

  .week-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .day-setting {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: #f8fafc;
    border-radius: 0.75rem;
  }

  .day-setting label {
    font-weight: 500;
    font-size: 0.875rem;
  }

  .day-toggle {
    position: relative;
    width: 44px;
    height: 24px;
  }

  .day-toggle input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #cbd5e1;
    transition: 0.3s;
    border-radius: 24px;
  }

  .toggle-slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: 0.3s;
    border-radius: 50%;
  }

  .day-toggle input:checked + .toggle-slider {
    background-color: #E8788A;
  }

  .day-toggle input:checked + .toggle-slider:before {
    transform: translateX(20px);
  }

  .max-orders-setting h4 {
    margin: 0 0 0.5rem 0;
    font-size: 1rem;
    font-weight: 600;
  }

  .max-orders-setting > p {
    margin: 0 0 1rem 0;
    color: #64748b;
    font-size: 0.875rem;
  }

  .number-input {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .number-input button {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid #e2e8f0;
    background: white;
    border-radius: 0.5rem;
    font-size: 1.25rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .number-input button:hover {
    background: #f8fafc;
  }

  .number-input input {
    width: 4rem;
    height: 2.5rem;
    text-align: center;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
    border: none;
  }

  .btn-sm {
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
  }

  .btn-primary {
    background: #E8788A;
    color: white;
  }

  .btn-primary:hover {
    background: #d66b7a;
  }

  .btn-secondary {
    background: #f1f5f9;
    color: #334155;
  }

  .btn-secondary:hover {
    background: #e2e8f0;
  }

  .status-message {
    font-size: 0.875rem;
    color: #64748b;
    margin: 0.5rem 0 0 0;
  }

  .input-field {
    width: 100%;
    padding: 0.625rem 1rem;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    box-sizing: border-box;
  }

  .input-field:focus {
    outline: none;
    border-color: #E8788A;
  }

  .block-form {
    margin-bottom: 2rem;
  }

  .block-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>

<script is:inline>
  function switchTab(tab) {
    document.querySelectorAll('.tab-btn').forEach(function(btn){btn.classList.remove('active')});
    document.querySelectorAll('.tab-content').forEach(function(c){c.classList.remove('active')});
    var btn = document.querySelector('[onclick="switchTab(\'' + tab + '\')"]');
    if (btn) btn.classList.add('active');
    var content = document.getElementById('tab-' + tab);
    if (content) content.classList.add('active');
  }

  function adjustMaxOrders(delta) {
    var input = document.getElementById('maxOrders');
    if (input) {
      var newVal = Math.min(20, Math.max(1, parseInt(input.value) + delta));
      input.value = String(newVal);
    }
  }

  function toggleDay(cb) {
    var tgl = cb.closest ? cb.closest('.day-toggle') : null;
    if (tgl) tgl.classList.toggle('active', cb.checked);
  }

  function removeBlockedDate(btn) {
    var item = btn.closest('.blocked-item');
    if (item) item.remove();
  }

  function saveSettings() {
    var maxOrdersEl = document.getElementById('maxOrders');
    var maxOrders = maxOrdersEl ? parseInt(maxOrdersEl.value) : 3;
    var workDaysInput = document.getElementById('work-days-input');
    var availableDays = workDaysInput ? JSON.parse(workDaysInput.value) : (window._selectedWorkDays || [1,2,3,4,5,6]);
    if (!workDaysInput) {
      window._selectedWorkDays = availableDays;
    }
    // Collect newly blocked dates from the picker
    var blockDateInput = document.getElementById('block-date');
    var newBlockedDates = [];
    if (blockDateInput && blockDateInput.value && blockDateInput.value !== '[]') {
      try { newBlockedDates = JSON.parse(blockDateInput.value); } catch(e) {}
    }
    // Collect dates removed via Verwijder (locally staged, committed on Opslaan)
    var removedBlockedDates = Array.from(window._removedBlockedDates || []);
    var btn = document.querySelector('.header-actions .btn-primary');
    var orig = btn ? btn.textContent.trim() : '';
    if (btn) { btn.textContent = 'Bezig...'; btn.disabled = true; }
    fetch('/api/availability', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        maxOrdersPerDay: maxOrders,
        availableDays: availableDays,
        newBlockedDates: newBlockedDates,
        removedBlockedDates: removedBlockedDates
      })
    }).then(function(res){
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return res.json();
    }).then(function(data){
      if (data.success) {
        if (btn) { btn.textContent = '✓ Opgeslagen!'; btn.style.background = '#16a34a'; btn.disabled = false; }
        setTimeout(function(){ if(btn){btn.textContent=orig;btn.style.background='';} }, 2500);
        // Clear the picker selection
        if (typeof clearSelectedDatesblock_date === 'function') clearSelectedDatesblock_date();
        // Clear removed dates staging and reload from DB
        window._removedBlockedDates = new Set();
        // Reload blocked dates list and refresh calendar
        if (typeof loadBlockedDates === 'function') loadBlockedDates();
        loadAvailability();
      } else {
        if (btn) { btn.textContent = orig; btn.style.background = ''; btn.disabled = false; }
        alert('Fout bij opslaan: ' + (data.error || 'onbekend'));
      }
    }).catch(function(e){
      console.error('saveSettings error:', e);
      if (btn) { btn.textContent = orig; btn.style.background = ''; btn.disabled = false; }
      alert('Fout bij opslaan. Controleer de console voor details.');
    });
  }

  function addBlockedDateLocal() {
    var inp = document.getElementById('block-reason');
    var status = document.getElementById('block-status');
    if (!inp || !inp.value) { if (status) status.textContent = 'Vul een reden in.'; return; }
    var list = document.getElementById('blocked-dates-list');
    if (list) {
      var item = document.createElement('div');
      item.className = 'blocked-item';
      item.innerHTML = '<div class="blocked-date"><span class="blocked-day">Nieuw</span><span>Vandaag</span></div><div class="blocked-reason">' + inp.value + '</div><button class="btn btn-sm btn-secondary" onclick="removeBlockedDate(this)">Verwijder</button>';
      list.appendChild(item);
      inp.value = '';
      if (status) status.textContent = 'Datum toegevoegd (lokaal).';
    }
  }

  function addBlockedDateGoogle() {
    var status = document.getElementById('block-status');
    if (status) status.textContent = 'Google Calendar integratie coming soon.';
  }

  // Format date as YYYY-MM-DD in local time
  function toLocalDateStr(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  async function loadAvailability() {
    try {
      var today = new Date();
      var endDate = new Date(today.getFullYear(), today.getMonth() + 2, 0);
      var resp = await fetch('/api/availability?startDate=' + toLocalDateStr(today) + '&endDate=' + toLocalDateStr(endDate) + '&_=' + Date.now());
      var data = await resp.json();
      if (data.availability) {
        data.availability.forEach(function(slot) {
          // Match by full date string, not day number
          var dayContent = document.querySelector('[data-date="' + slot.date + '"]');
          if (dayContent) {
            var bar = dayContent.querySelector('.status-fill');
            var text = dayContent.querySelector('.status-text');
            var cell = dayContent.closest('.day-cell');
            if (bar && text && cell) {
              var pct = (slot.orders / slot.maxOrders) * 100;
              bar.style.width = pct + '%';
              text.textContent = slot.orders + '/' + slot.maxOrders;
              cell.classList.remove('available','limited','full');
              if (!slot.available) cell.classList.add('full');
              else if (slot.remaining <= 1) cell.classList.add('limited');
              else cell.classList.add('available');
            }
          }
        });
      }
    } catch(e) { console.log('Could not load availability:', e); }
  }
  loadAvailability();
</script>
