          </div>
          <div class="blocked-item">
            <div class="blocked-date">
              <span class="blocked-day">Zo</span>
              <span>20 april 2026</span>
            </div>
            <div class="blocked-reason">Vakantie</div>
            <button class="btn btn-sm btn-secondary" onclick="removeBlockedDate(this)">Verwijder</button>
