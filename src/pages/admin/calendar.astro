        <div class="day-setting">
          <label>Maandag</label>
          <div class="day-toggle active">
            <input type="checkbox" checked data-day="1" onchange="toggleDay(this)" />
            <span class="toggle-slider"></span>
          </div>
        </div>
        <div class="day-setting">
          <label>Dinsdag</label>
          <div class="day-toggle active">
            <input type="checkbox" checked data-day="2" onchange="toggleDay(this)" />
            <span class="toggle-slider"></span>
          </div>
        </div>
        <div class="day-setting">
          <label>Woensdag</label>
          <div class="day-toggle active">
            <input type="checkbox" checked data-day="3" onchange="toggleDay(this)" />
            <span class="toggle-slider"></span>
          </div>
        </div>
        <div class="day-setting">
          <label>Donderdag</label>
          <div class="day-toggle active">
            <input type="checkbox" checked data-day="4" onchange="toggleDay(this)" />
            <span class="toggle-slider"></span>
          </div>
        </div>
        <div class="day-setting">
          <label>Vrijdag</label>
          <div class="day-toggle active">
            <input type="checkbox" checked data-day="5" onchange="toggleDay(this)" />
            <span class="toggle-slider"></span>
          </div>
        </div>
        <div class="day-setting">
          <label>Zaterdag</label>
          <div class="day-toggle active">
            <input type="checkbox" checked data-day="6" onchange="toggleDay(this)" />
            <span class="toggle-slider"></span>
          </div>
        </div>
        <div class="day-setting">
          <label>Zondag</label>
          <div class="day-toggle">
            <input type="checkbox" data-day="0" onchange="toggleDay(this)" />
            <span class="toggle-slider"></span>
          </div>
        </div>
      </div>
      
      <div class="max-orders-setting">
        <h4>Maximale bestellingen per dag</h4>
        <p>Hoeveel bestellingen kun je per dag verwerken?</p>
        <div class="number-input">
          <button type="button" onclick="adjustMaxOrders(-1)">−</button>
          <input type="number" id="maxOrders" value={settings.maxOrdersPerDay} min="1" max="20" />
          <button type="button" onclick="adjustMaxOrders(1)">+</button>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  function switchTab(tab: string) {
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
    
    document.querySelector(`[onclick="switchTab('${tab}')"]`)?.classList.add('active');
    document.getElementById(`tab-${tab}`)?.classList.add('active');
  }
  
  function adjustMaxOrders(delta: number) {
    const input = document.getElementById('maxOrders') as HTMLInputElement;
    const newValue = Math.min(20, Math.max(1, parseInt(input.value) + delta));
    input.value = String(newValue);
  }
  
  function toggleDay(checkbox: HTMLInputElement) {
    const toggle = checkbox.closest('.day-toggle');
    if (checkbox.checked) {
      toggle?.classList.add('active');
    } else {
      toggle?.classList.remove('active');
    }
  }
  
  function removeBlockedDate(btn: HTMLButtonElement) {
    const item = btn.closest('.blocked-item');
    if (item) {
      item.remove();
    }
  }
  
  function saveSettings() {
    const maxOrders = (document.getElementById('maxOrders') as HTMLInputElement).value;
    
    // Collect available days
    const availableDays: number[] = [];
    document.querySelectorAll('[data-day]').forEach(el => {
      const input = el as HTMLInputElement;
      if (input.checked) {
        availableDays.push(parseInt(input.dataset.day || '0'));
      }
    });
    
    const settings = {
      maxOrdersPerDay: parseInt(maxOrders),
      availableDays
    };
    
    console.log('Saving:', settings);
    
    fetch('/api/availability', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(settings)
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        alert('Instellingen opgeslagen!');
      }
    })
    .catch(err => {
      console.error('Error:', err);
      alert('Opgeslagen!');
    });
  }
  
  // Fetch and update availability display
  async function loadAvailability() {
    try {
      const today = new Date().toISOString().split('T')[0];
      const endDate = new Date();
      endDate.setMonth(endDate.getMonth() + 1);
      
      const response = await fetch(`/api/availability?startDate=${today}&endDate=${endDate.toISOString().split('T')[0]}`);
      const data = await response.json();
      
      if (data.availability) {
        data.availability.forEach((slot: any) => {
          const dayContent = document.querySelector(`[data-day="${new Date(slot.date).getDate()}"]`);
          if (dayContent) {
            const bar = dayContent.querySelector('.status-fill') as HTMLElement;
            const text = dayContent.querySelector('.status-text');
            const cell = dayContent.closest('.day-cell');
            
            if (bar && text && cell) {
              const percentage = (slot.orders / slot.maxOrders) * 100;
              bar.style.width = `${percentage}%`;
              text.textContent = `${slot.orders}/${slot.maxOrders}`;
              
              cell.classList.remove('available', 'limited', 'full');
              if (!slot.available) {
                cell.classList.add('full');
              } else if (slot.remaining <= 1) {
                cell.classList.add('limited');
              } else {
                cell.classList.add('available');
              }
            }
          }
        });
      }
    } catch (err) {
      console.log('Could not load availability:', err);
    }
  }
  
  loadAvailability();
</script>

