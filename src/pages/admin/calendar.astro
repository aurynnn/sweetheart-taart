  </div>

  <!-- Tabs -->
  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('maand')">Maandoverzicht</button>
    <button class="tab-btn" onclick="switchTab('blockeren')">Datum Blokkeren</button>
    <button class="tab-btn" onclick="switchTab('uren')">Werkuren</button>
  </div>

  <!-- Tab: Month Overview -->
