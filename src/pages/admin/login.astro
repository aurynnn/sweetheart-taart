---
import '../../styles/tokens.css';
import {
  checkCredentials, credentialsConfigured, clearFailures, isLockedOut, isSecureRequest,
  readSession, registerFailure, setSessionCookie, SESSION_COOKIE, clientIp,
} from '../../lib/auth';

// Only redirect to our own admin pages (never to another site)
const rawNext = Astro.url.searchParams.get('next') ?? '/admin';
const next = rawNext.startsWith('/admin') && !rawNext.startsWith('//') ? rawNext : '/admin';

if (readSession(Astro.cookies.get(SESSION_COOKIE)?.value)) return Astro.redirect(next);

const ip = clientIp(Astro.request, Astro.clientAddress);
let error = '';
let username = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  username = String(form.get('username') ?? '').slice(0, 100);
  const password = String(form.get('password') ?? '').slice(0, 200);

  if (!credentialsConfigured()) {
    error = 'Inloggen is nog niet ingesteld (ADMIN_USERNAME / ADMIN_PASSWORD in .env).';
  } else if (isLockedOut(ip)) {
    error = 'Te veel mislukte pogingen. Probeer het over 15 minuten opnieuw.';
  } else if (checkCredentials(username, password)) {
    clearFailures(ip);
    setSessionCookie(Astro.cookies, username.trim(), isSecureRequest(Astro.request, Astro.url));
    return Astro.redirect(next);
  } else {
    registerFailure(ip);
    // Small delay slows down guessing further
    await new Promise((r) => setTimeout(r, 600));
    error = 'Gebruikersnaam of wachtwoord klopt niet.';
  }
}
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<!doctype html>
<html lang="nl-BE">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Inloggen | Sweetheart Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Caveat:wght@700&display=swap" rel="stylesheet" />
</head>
<body>
  <main class="wrap">
    <form method="post" class="card" autocomplete="on">
      <div class="brand">
        <span class="logo" aria-hidden="true">🎂</span>
        <h1>Sweetheart</h1>
        <p>Beheer — log in om verder te gaan</p>
      </div>

      {error && <p class="error" role="alert">{error}</p>}

      <label>
        <span>Gebruikersnaam</span>
        <input name="username" type="text" autocomplete="username" required autofocus value={username} />
      </label>
      <label>
        <span>Wachtwoord</span>
        <div class="pw">
          <input name="password" id="pw" type="password" autocomplete="current-password" required />
          <button type="button" id="togglePw" aria-label="Wachtwoord tonen">👁</button>
        </div>
      </label>

      <button type="submit" class="submit">Inloggen</button>
      <a href="/" class="back">← Naar de website</a>
    </form>
  </main>

  <script>
    const pw = document.getElementById('pw') as HTMLInputElement;
    const btn = document.getElementById('togglePw') as HTMLButtonElement;
    btn.addEventListener('click', () => {
      const show = pw.type === 'password';
      pw.type = show ? 'text' : 'password';
      btn.setAttribute('aria-label', show ? 'Wachtwoord verbergen' : 'Wachtwoord tonen');
    });
  </script>

  <style>
    body { margin: 0; font-family: 'Inter', system-ui, sans-serif; background: radial-gradient(60% 60% at 20% 10%, #ffe4e9, transparent 60%), linear-gradient(160deg, #fdf2f4, #f8fafc); min-height: 100vh; }
    .wrap { min-height: 100vh; display: grid; place-items: center; padding: 1.5rem; }
    .card { width: 100%; max-width: 24rem; display: grid; gap: 1rem; padding: 2rem; border-radius: 1.5rem; background: #fff; border: 1px solid #f1e4e7; box-shadow: 0 30px 60px -30px rgba(212, 90, 106, 0.45); }
    .brand { text-align: center; margin-bottom: 0.5rem; }
    .logo { font-size: 2.2rem; }
    h1 { margin: 0.25rem 0 0; font-family: 'Caveat', cursive; font-size: 2.4rem; color: #d45a6a; }
    .brand p { margin: 0.2rem 0 0; color: #64748b; font-size: 0.9rem; }
    label { display: grid; gap: 0.35rem; font-size: 0.85rem; font-weight: 600; color: #334155; }
    input { width: 100%; box-sizing: border-box; padding: 0.75rem 0.9rem; border: 1px solid #e2e8f0; border-radius: 0.75rem; font: inherit; font-size: 1rem; }
    input:focus { outline: none; border-color: #e8788a; box-shadow: 0 0 0 3px rgba(232, 120, 138, 0.18); }
    .pw { position: relative; }
    .pw input { padding-right: 3rem; }
    .pw button { position: absolute; right: 0.4rem; top: 50%; transform: translateY(-50%); border: 0; background: none; cursor: pointer; font-size: 1.1rem; opacity: 0.6; }
    .submit { margin-top: 0.5rem; padding: 0.85rem; border: 0; border-radius: 0.8rem; background: linear-gradient(135deg, #f2a0aa, #e8788a 55%, #d45a6a); color: #fff; font: inherit; font-weight: 700; font-size: 1rem; cursor: pointer; box-shadow: 0 12px 24px -12px rgba(212, 90, 106, 0.8); }
    .submit:hover { filter: brightness(1.05); }
    .error { margin: 0; padding: 0.75rem 0.9rem; border-radius: 0.75rem; background: #fef2f2; color: #991b1b; font-size: 0.875rem; }
    .back { text-align: center; color: #94a3b8; font-size: 0.85rem; text-decoration: none; }
    .back:hover { color: #d45a6a; }
  </style>
</body>
</html>
