---
import AdminLayout from '../../layouts/admin/AdminLayout.astro';

// Current settings (would come from database)
const settings = {
  business: {
    name: 'Sweetheart Taart',
    tagline: 'Op maat gemaakte taarten voor jouw speciale momenten',
    phone: '+32 xxx xx xx xx',
    email: 'info@sweethearttaart.be'
  },
  availability: {
    maxOrdersPerDay: 3,
    availableDays: [1, 2, 3, 4, 5, 6] // Mon-Sat
  },
  notifications: {
    email: true,
    sms: false,
    dailySummary: true
  },
  googleCalendar: {
    connected: false
  }
};

const dayNames = ['Zondag', 'Maandag', 'Dinsdag', 'Woensdag', 'Donderdag', 'Vrijdag', 'Zaterdag'];
---

<AdminLayout title="Instellingen">
  <div class="settings-layout">
    <!-- Live Preview Panel -->
    <div class="preview-panel">
      <div class="preview-header">
        <h3>Live Preview</h3>
        <span class="preview-badge">Real-time</span>
      </div>
      <div class="preview-container">
        <div class="widget-preview">
          <div class="widget-header">
            <div class="widget-avatar" id="preview-avatar">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </div>
            <div class="widget-info">
              <span class="widget-name" id="preview-name">{settings.business.name}</span>
              <span class="widget-tagline" id="preview-tagline">{settings.business.tagline}</span>
            </div>
          </div>
          <div class="widget-body" id="preview-body">
            <div class="chat-message bot">
              <div class="message-content">
                Hallo! 👋 Welkom bij {settings.business.name}. Waar kan ik je mee helpen?
              </div>
            </div>
            <div class="chat-message user">
              <div class="message-content">
                Ik wil een taart bestellen
              </div>
            </div>
            <div class="chat-message bot">
              <div class="message-content">
                Geweldig! 🎂 Laat me je helpen met je bestelling. Welk type taart heb je in gedachten?
              </div>
            </div>
          </div>
          <div class="widget-input">
            <input type="text" placeholder="Type een bericht..." disabled />
            <button class="send-btn">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Settings Panel -->
    <div class="settings-panel">
      <!-- Tabs -->
      <div class="settings-tabs">
        <button class="tab-btn active" data-tab="business">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          Bedrijf
        </button>
        <button class="tab-btn" data-tab="availability">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          Beschikbaarheid
        </button>
        <button class="tab-btn" data-tab="notifications">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
          </svg>
          Notificaties
        </button>
        <button class="tab-btn" data-tab="calendar">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          Agenda
        </button>
      </div>

      <!-- Tab Content -->
      <div class="tab-content active" id="tab-business">
        <h2>Bedrijfsinformatie</h2>
        <p class="tab-description">Pas je bedrijfsgegevens aan. Deze worden getoond in de widget.</p>
        
        <div class="form-group">
          <label for="business-name">Bedrijfsnaam</label>
          <input type="text" id="business-name" value={settings.business.name} oninput="updatePreview('name', this.value)" />
        </div>
        
        <div class="form-group">
          <label for="business-tagline">Tagline</label>
          <input type="text" id="business-tagline" value={settings.business.tagline} oninput="updatePreview('tagline', this.value)" />
        </div>
        
        <div class="form-group">
          <label for="business-phone">Telefoon</label>
          <input type="text" id="business-phone" value={settings.business.phone} />
        </div>
        
        <div class="form-group">
          <label for="business-email">E-mail</label>
          <input type="email" id="business-email" value={settings.business.email} />
        </div>

        <h3>Widget Kleur</h3>
        <div class="color-options">
          <button type="button" class="color-btn active" style="background: #E8788A;" onclick="setWidgetColor('#E8788A')"></button>
          <button type="button" class="color-btn" style="background: #8B5CF6;" onclick="setWidgetColor('#8B5CF6')"></button>
          <button type="button" class="color-btn" style="background: #3B82F6;" onclick="setWidgetColor('#3B82F6')"></button>
          <button type="button" class="color-btn" style="background: #10B981;" onclick="setWidgetColor('#10B981')"></button>
          <button type="button" class="color-btn" style="background: #F59E0B;" onclick="setWidgetColor('#F59E0B')"></button>
        </div>
      </div>

      <div class="tab-content" id="tab-availability">
        <h2>Beschikbaarheid</h2>
        <p class="tab-description">Stel in hoeveel bestellingen je per dag kunt verwerken.</p>
        
        <div class="form-group">
          <label for="max-orders">Maximale bestellingen per dag</label>
          <div class="number-input">
            <button type="button" onclick="adjustNumber('max-orders', -1)">−</button>
            <input type="number" id="max-orders" value={settings.availability.maxOrdersPerDay} min="1" max="20" />
            <button type="button" onclick="adjustNumber('max-orders', 1)">+</button>
          </div>
        </div>

        <h3>Wekelijks Schema</h3>
        <p class="tab-description">Selecteer de dagen waarop je open bent.</p>
        
        <div class="week-schedule">
          {dayNames.map((day, i) => (
            <label class={`day-toggle ${settings.availability.availableDays.includes(i) ? 'active' : ''}`}>
              <input type="checkbox" checked={settings.availability.availableDays.includes(i)} onchange="toggleDay(this, {i})" />
              <span class="toggle-slider"></span>
              <span class="day-name">{day}</span>
            </label>
          ))}
        </div>
      </div>

      <div class="tab-content" id="tab-notifications">
        <h2>Notificaties</h2>
        <p class="tab-description">Kies hoe je meldingen wilt ontvangen.</p>
        
        <div class="toggle-setting">
          <div class="toggle-info">
            <strong>E-mail notificaties</strong>
            <span>Ontvang een e-mail bij elke nieuwe bestelling</span>
          </div>
          <label class="toggle">
            <input type="checkbox" checked={settings.notifications.email} />
            <span class="toggle-slider"></span>
          </label>
        </div>
        
        <div class="toggle-setting">
          <div class="toggle-info">
            <strong>SMS notificaties</strong>
            <span>Ontvang een SMS bij spoedbestellingen</span>
          </div>
          <label class="toggle">
            <input type="checkbox" checked={settings.notifications.sms} />
            <span class="toggle-slider"></span>
          </label>
        </div>
        
        <div class="toggle-setting">
          <div class="toggle-info">
            <strong>Dagelijkse samenvatting</strong>
            <span>Ontvang elke ochtend een overzicht van de dag</span>
          </div>
          <label class="toggle">
            <input type="checkbox" checked={settings.notifications.dailySummary} />
            <span class="toggle-slider"></span>
          </label>
        </div>
      </div>

      <div class="tab-content" id="tab-calendar">
        <h2>Google Agenda</h2>
        <p class="tab-description">Verbind je Google Agenda om beschikbaarheid automatisch te synchroniseren.</p>
        
        <div class="connection-card">
          <div class="connection-status">
            <div class={`status-dot ${settings.googleCalendar.connected ? 'connected' : ''}`}></div>
            <span>{settings.googleCalendar.connected ? 'Verbonden' : 'Niet verbonden'}</span>
          </div>
          <a href="/admin/api/calendar/connect" class={`btn ${settings.googleCalendar.connected ? 'btn-secondary' : 'btn-primary'}`}>
            {settings.googleCalendar.connected ? 'Ontkoppelen' : 'Verbinden'}
          </a>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(`tab-${btn.dataset.tab}`)?.classList.add('active');
    });
  });

  // Live preview updates
  function updatePreview(field, value) {
    if (field === 'name') {
      document.getElementById('preview-name').textContent = value;
    } else if (field === 'tagline') {
      document.getElementById('preview-tagline').textContent = value;
    }
  }

  function setWidgetColor(color) {
    document.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
    event.target.classList.add('active');
    
    document.querySelector('.widget-header').style.background = color;
    document.querySelector('.send-btn').style.background = color;
    document.querySelectorAll('.chat-message.bot .message-content').forEach(m => {
      m.style.background = color;
    });
  }

  function adjustNumber(id, delta) {
    const input = document.getElementById(id);
    const newValue = Math.min(20, Math.max(1, parseInt(input.value) + delta));
    input.value = String(newValue);
  }

  function toggleDay(checkbox, dayNum) {
    checkbox.closest('.day-toggle').classList.toggle('active', checkbox.checked);
  }
</script>

<style>
.settings-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  height: calc(100vh - 140px);
}

@media (max-width: 1024px) {
  .settings-layout {
    grid-template-columns: 1fr;
    height: auto;
  }
}

/* Preview Panel */
.preview-panel {
  background: white;
  border-radius: 1rem;
  border: 1px solid #e2e8f0;
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
}

.preview-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.preview-header h3 {
  margin: 0;
  font-size: 1rem;
  font-weight: 600;
}

.preview-badge {
  font-size: 0.625rem;
  padding: 0.25rem 0.5rem;
  background: #dcfce7;
  color: #16a34a;
  border-radius: 9999px;
  font-weight: 600;
}

.preview-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border-radius: 0.75rem;
  padding: 1rem;
}

/* Widget Preview */
.widget-preview {
  width: 100%;
  max-width: 320px;
  background: white;
  border-radius: 1rem;
  box-shadow: 0 4px 20px rgba(0,0,0,0.1);
  overflow: hidden;
}

.widget-header {
  background: #E8788A;
  padding: 1rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.widget-avatar {
  width: 2.5rem;
  height: 2.5rem;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.widget-info {
  display: flex;
  flex-direction: column;
}

.widget-name {
  font-weight: 600;
  color: white;
  font-size: 0.875rem;
}

.widget-tagline {
  font-size: 0.625rem;
  color: rgba(255,255,255,0.8);
}

.widget-body {
  padding: 1rem;
  min-height: 200px;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.chat-message {
  display: flex;
  flex-direction: column;
  max-width: 80%;
}

.chat-message.bot {
  align-self: flex-start;
}

.chat-message.user {
  align-self: flex-end;
}

.message-content {
  padding: 0.625rem 0.875rem;
  border-radius: 1rem;
  font-size: 0.8125rem;
  line-height: 1.4;
}

.chat-message.bot .message-content {
  background: #E8788A;
  color: white;
  border-bottom-left-radius: 0.25rem;
}

.chat-message.user .message-content {
  background: #f1f5f9;
  color: #1e293b;
  border-bottom-right-radius: 0.25rem;
}

.widget-input {
  padding: 0.75rem;
  border-top: 1px solid #f1f5f9;
  display: flex;
  gap: 0.5rem;
}

.widget-input input {
  flex: 1;
  padding: 0.5rem 0.75rem;
  border: 1px solid #e2e8f0;
  border-radius: 9999px;
  font-size: 0.75rem;
}

.widget-input input:focus {
  outline: none;
  border-color: #E8788A;
}

.send-btn {
  width: 2rem;
  height: 2rem;
  background: #E8788A;
  border: none;
  border-radius: 50%;
  color: white;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Settings Panel */
.settings-panel {
  background: white;
  border-radius: 1rem;
  border: 1px solid #e2e8f0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.settings-tabs {
  display: flex;
  border-bottom: 1px solid #e2e8f0;
  overflow-x: auto;
}

.tab-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 1rem 1.25rem;
  border: none;
  background: none;
  font-size: 0.8125rem;
  font-weight: 500;
  color: #64748b;
  cursor: pointer;
  white-space: nowrap;
  transition: all 0.2s;
}

.tab-btn:hover {
  color: #1e293b;
  background: #f8fafc;
}

.tab-btn.active {
  color: #E8788A;
  border-bottom: 2px solid #E8788A;
}

.tab-content {
  display: none;
  padding: 1.5rem;
  overflow-y: auto;
  flex: 1;
}

.tab-content.active {
  display: block;
}

.tab-content h2 {
  margin: 0 0 0.25rem 0;
  font-size: 1.125rem;
  font-weight: 600;
}

.tab-content h3 {
  margin: 1.5rem 0 0.75rem 0;
  font-size: 0.875rem;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.tab-description {
  font-size: 0.8125rem;
  color: #94a3b8;
  margin: 0 0 1.5rem 0;
}

.form-group {
  margin-bottom: 1rem;
}

.form-group label {
  display: block;
  font-size: 0.8125rem;
  font-weight: 500;
  color: #374151;
  margin-bottom: 0.375rem;
}

.form-group input[type="text"],
.form-group input[type="email"],
.form-group input[type="tel"] {
  width: 100%;
  padding: 0.625rem 0.875rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.5rem;
  font-size: 0.875rem;
}

.form-group input:focus {
  outline: none;
  border-color: #E8788A;
  box-shadow: 0 0 0 3px rgba(232, 120, 138, 0.1);
}

/* Number Input */
.number-input {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.number-input button {
  width: 2.5rem;
  height: 2.5rem;
  border: 1px solid #e2e8f0;
  background: white;
  border-radius: 0.5rem;
  font-size: 1.25rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.number-input button:hover {
  background: #f8fafc;
}

.number-input input {
  width: 4rem;
  height: 2.5rem;
  text-align: center;
  border: 1px solid #e2e8f0;
  border-radius: 0.5rem;
  font-size: 1rem;
  font-weight: 600;
}

/* Color Options */
.color-options {
  display: flex;
  gap: 0.75rem;
}

.color-btn {
  width: 2.5rem;
  height: 2.5rem;
  border: 3px solid transparent;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.2s;
}

.color-btn:hover {
  transform: scale(1.1);
}

.color-btn.active {
  border-color: #1e293b;
}

/* Week Schedule */
.week-schedule {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 0.75rem;
}

.day-toggle {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.75rem;
  cursor: pointer;
  transition: all 0.2s;
}

.day-toggle input {
  display: none;
}

.day-toggle.active {
  background: #fdf2f8;
  border-color: #E8788A;
}

.day-name {
  font-size: 0.8125rem;
  font-weight: 500;
}

.toggle-slider {
  position: relative;
  width: 36px;
  height: 20px;
  background: #cbd5e1;
  border-radius: 10px;
  transition: 0.2s;
}

.toggle-slider:before {
  content: "";
  position: absolute;
  width: 16px;
  height: 16px;
  left: 2px;
  bottom: 2px;
  background: white;
  border-radius: 50%;
  transition: 0.2s;
}

.day-toggle.active .toggle-slider,
.toggle input:checked + .toggle-slider {
  background: #E8788A;
}

.day-toggle.active .toggle-slider:before,
.toggle input:checked + .toggle-slider:before {
  transform: translateX(16px);
}

/* Toggle Settings */
.toggle-setting {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.75rem;
  margin-bottom: 0.75rem;
}

.toggle-info {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.toggle-info strong {
  font-size: 0.875rem;
  font-weight: 500;
}

.toggle-info span {
  font-size: 0.75rem;
  color: #94a3b8;
}

/* Toggle Switch */
.toggle {
  position: relative;
  width: 44px;
  height: 24px;
}

.toggle input {
  opacity: 0;
  width: 0;
  height: 0;
}

.toggle-slider {
  position: absolute;
  cursor: pointer;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #cbd5e1;
  transition: 0.3s;
  border-radius: 24px;
}

.toggle-slider:before {
  position: absolute;
  content: "";
  height: 18px;
  width: 18px;
  left: 3px;
  bottom: 3px;
  background-color: white;
  transition: 0.3s;
  border-radius: 50%;
}

input:checked + .toggle-slider {
  background-color: #E8788A;
}

input:checked + .toggle-slider:before {
  transform: translateX(20px);
}

/* Connection Card */
.connection-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1rem;
  background: #f8fafc;
  border-radius: 0.75rem;
}

.connection-status {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.status-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #cbd5e1;
}

.status-dot.connected {
  background: #22c55e;
}

/* Buttons */
.btn {
  padding: 0.5rem 1rem;
  border-radius: 0.5rem;
  font-size: 0.8125rem;
  font-weight: 500;
  text-decoration: none;
  cursor: pointer;
  border: none;
  transition: all 0.2s;
}

.btn-primary {
  background: #E8788A;
  color: white;
}

.btn-primary:hover {
  background: #d66b7a;
}

.btn-secondary {
  background: #f1f5f9;
  color: #475569;
}

.btn-secondary:hover {
  background: #e2e8f0;
}
</style>
