---
import AdminLayout from '../../layouts/admin/AdminLayout.astro';
import OrderModal from '../../components/admin/orders/OrderModal.astro';
import { listOrders, type FullOrder } from '../../lib/orderRepo';
import { toLocalDateStr } from '../../lib/availability';
import { productName, itemSummary, type AanvraagItem } from '../../lib/catalog';

// Everything that is confirmed and still has to be made, grouped per pickup day
let orders: FullOrder[] = [];
let loadError = false;
try {
  orders = (await listOrders({ status: 'approved' }))
    .sort((a, b) => (a.date + (a.time ?? '')).localeCompare(b.date + (b.time ?? '')));
} catch (e) {
  console.error('[admin/todo] Failed to load orders:', e);
  loadError = true;
}

const today = toLocalDateStr(new Date());
const tomorrowDate = new Date(); tomorrowDate.setDate(tomorrowDate.getDate() + 1);
const tomorrow = toLocalDateStr(tomorrowDate);

const dayLabel = (iso: string) => {
  if (iso < today) return 'Achterstallig';
  if (iso === today) return 'Vandaag';
  if (iso === tomorrow) return 'Morgen';
  return new Date(iso + 'T00:00:00').toLocaleDateString('nl-BE', { weekday: 'long', day: 'numeric', month: 'long' });
};

const groups = orders.reduce<Array<{ key: string; label: string; tone: string; orders: FullOrder[] }>>((acc, o) => {
  const key = o.date < today ? 'overdue' : o.date;
  let group = acc.find((g) => g.key === key);
  if (!group) {
    group = { key, label: dayLabel(o.date), tone: o.date < today ? 'overdue' : o.date === today ? 'today' : o.date === tomorrow ? 'tomorrow' : '', orders: [] };
    acc.push(group);
  }
  group.orders.push(o);
  return acc;
}, []);

const customerName = (o: FullOrder) => [o.customer.firstname, o.customer.lastname].filter(Boolean).join(' ') || 'Onbekend';
const itemLine = (i: FullOrder['items'][number]) => {
  const detail = itemSummary(i as AanvraagItem);
  return `${productName(i.product)}${detail ? ` · ${detail}` : ''}`;
};
---

<AdminLayout title="Te maken">
  <div class="todo-toolbar">
    <p class="subtitle">
      {orders.length === 0 ? 'Niets te maken — alles is klaar!' : `${orders.length} bevestigde aanvra${orders.length === 1 ? 'ag' : 'gen'} om te maken. Klik op een aanvraag voor alle details.`}
    </p>
    {orders.length > 0 && (
      <div class="toolbar-actions">
        <label class="select-all"><input type="checkbox" id="selectAll" /> Alles selecteren</label>
        <button type="button" class="btn-pdf" id="pdfBtn" disabled>
          <i class="fa-solid fa-file-pdf" aria-hidden="true"></i> <span id="pdfLabel">PDF</span>
        </button>
      </div>
    )}
  </div>

  {loadError && <div class="alert">De aanvragen konden niet geladen worden.</div>}

  {groups.map((g) => (
    <section class={`day ${g.tone}`}>
      <h2 class="day-title">
        <span>{g.label}</span>
        <small>{g.orders.length} aanvra{g.orders.length === 1 ? 'ag' : 'gen'}</small>
      </h2>
      <div class="cards">
        {g.orders.map((o) => {
          const photo = o.items.find((i) => i.image)?.image;
          const allergies = o.items.map((i) => i.allergies).filter(Boolean);
          return (
            <article class="card" data-order-id={o.id}>
              <label class="pick" title="Selecteer voor PDF">
                <input type="checkbox" class="pick-box" value={o.id} aria-label={`Selecteer ${o.id} voor PDF`} />
              </label>
              <button type="button" class="card-main" data-open={o.id}>
                <span class="time">
                  <b>{o.time ?? '—'}</b>
                  {g.key === 'overdue' && <small>{new Date(o.date + 'T00:00:00').toLocaleDateString('nl-BE', { day: 'numeric', month: 'short' })}</small>}
                </span>
                <span class="body">
                  <span class="who">{customerName(o)} <small>#{o.id}</small></span>
                  <ul class="items">
                    {o.items.map((i) => <li>{itemLine(i)}</li>)}
                  </ul>
                  <span class="flags">
                    {allergies.length > 0 && <em class="flag allergy" title={allergies.join(' · ')}><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {allergies.join(' · ')}</em>}
                    {o.message && <em class="flag note"><i class="fa-regular fa-comment" aria-hidden="true"></i> notitie</em>}
                  </span>
                </span>
                {photo && (
                  <img class="thumb" src={`/admin/api/upload?key=${encodeURIComponent(photo)}`} alt="Voorbeeldfoto" loading="lazy" />
                )}
              </button>
              <button type="button" class="done-btn" data-done={o.id} title="Markeer als voltooid" aria-label={`Markeer ${o.id} als voltooid`}>
                <i class="fa-solid fa-check" aria-hidden="true"></i>
              </button>
            </article>
          );
        })}
      </div>
    </section>
  ))}

  <script type="application/json" id="todo-data" set:html={JSON.stringify(orders).replace(/</g, "\\u003c")} />
</AdminLayout>

<OrderModal />

<script>
  import { initOrderModal, openOrderModal } from '../../scripts/admin/orderModal';
  import { updateStatus, toast } from '../../scripts/admin/toast';

  const orders: any[] = JSON.parse(document.getElementById('todo-data')?.textContent || '[]');
  const byId = new Map(orders.map((o) => [o.id, o]));

  const removeCard = (id: string) => {
    const card = document.querySelector<HTMLElement>(`.card[data-order-id="${CSS.escape(id)}"]`);
    card?.classList.add('leaving');
    setTimeout(() => card?.remove(), 400);
  };

  initOrderModal({ onStatusChanged: (id, status) => { if (status !== 'approved') removeCard(id); } });

  document.addEventListener('click', async (e) => {
    const t = e.target as Element;
    const open = t.closest<HTMLElement>('[data-open]');
    if (open) { const o = byId.get(open.dataset.open!); if (o) openOrderModal(o); return; }
    const done = t.closest<HTMLButtonElement>('[data-done]');
    if (done) {
      done.disabled = true;
      if (await updateStatus(done.dataset.done!, 'completed')) removeCard(done.dataset.done!);
      else done.disabled = false;
    }
  });

  // ── PDF selection ─────────────────────────────────────────────────────
  const boxes = () => Array.from(document.querySelectorAll<HTMLInputElement>('.pick-box'));
  const selectAll = document.getElementById('selectAll') as HTMLInputElement | null;
  const pdfBtn = document.getElementById('pdfBtn') as HTMLButtonElement | null;
  const pdfLabel = document.getElementById('pdfLabel');

  function syncSelection() {
    const picked = boxes().filter((b) => b.checked);
    boxes().forEach((b) => b.closest('.card')?.classList.toggle('picked', b.checked));
    if (pdfBtn) pdfBtn.disabled = picked.length === 0;
    if (pdfLabel) pdfLabel.textContent = picked.length ? `PDF van ${picked.length} aanvra${picked.length === 1 ? 'ag' : 'gen'}` : 'Selecteer aanvragen voor PDF';
    if (selectAll) selectAll.checked = picked.length > 0 && picked.length === boxes().length;
  }
  document.addEventListener('change', (e) => { if ((e.target as Element).classList.contains('pick-box')) syncSelection(); });
  selectAll?.addEventListener('change', () => { boxes().forEach((b) => (b.checked = selectAll.checked)); syncSelection(); });
  syncSelection();

  pdfBtn?.addEventListener('click', async () => {
    const orderIds = boxes().filter((b) => b.checked).map((b) => b.value);
    pdfBtn.disabled = true;
    const label = pdfLabel?.textContent;
    if (pdfLabel) pdfLabel.textContent = 'PDF maken…';
    try {
      const res = await fetch('/admin/api/print', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderIds }),
      });
      if (!res.ok) throw new Error();
      const url = URL.createObjectURL(await res.blob());
      const a = document.createElement('a');
      a.href = url;
      a.download = `sweetheart-te-maken-${new Date().toISOString().slice(0, 10)}.pdf`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    } catch {
      toast('Kon de PDF niet maken. Probeer opnieuw.', 'error');
    } finally {
      if (pdfLabel && label) pdfLabel.textContent = label;
      pdfBtn.disabled = false;
    }
  });
</script>

<style>
  .todo-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .subtitle { margin: 0; color: #64748b; }
  .toolbar-actions { display: flex; align-items: center; gap: 1rem; }
  .select-all { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.875rem; color: #475569; cursor: pointer; }
  .select-all input, .pick input { width: 1.1rem; height: 1.1rem; accent-color: #e8788a; cursor: pointer; }
  .btn-pdf { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.65rem 1.1rem; border-radius: 0.7rem; border: 0; background: #e8788a; color: #fff; font-weight: 700; cursor: pointer; transition: opacity 200ms, transform 200ms; }
  .btn-pdf:disabled { opacity: 0.45; cursor: default; }
  .btn-pdf:not(:disabled):hover { transform: translateY(-1px); }
  .alert { padding: 1rem; border-radius: 0.8rem; background: #fef2f2; color: #991b1b; margin-bottom: 1rem; }

  .day { margin-bottom: 2rem; }
  .day-title { display: flex; align-items: baseline; gap: 0.6rem; margin: 0 0 0.8rem; font-size: 1rem; font-weight: 800; color: #0f172a; text-transform: capitalize; }
  .day-title small { font-weight: 500; color: #94a3b8; text-transform: none; }
  .day.today .day-title span { color: #d45a6a; }
  .day.overdue .day-title span { color: #b91c1c; }
  .cards { display: grid; gap: 0.6rem; }

  .card { position: relative; display: flex; align-items: stretch; background: #fff; border: 1px solid #e2e8f0; border-radius: 1rem; overflow: hidden; transition: border-color 200ms, box-shadow 200ms, opacity 400ms, transform 400ms; animation: cardIn 450ms cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes cardIn { from { opacity: 0; } }
  .card:hover { border-color: #fbd5db; box-shadow: 0 10px 24px -16px rgba(212, 90, 106, 0.55); }
  .card.picked { border-color: #e8788a; box-shadow: 0 0 0 2px rgba(232, 120, 138, 0.25); }
  .card.leaving { opacity: 0; transform: translateX(40px); }
  .day.today .card { border-left: 4px solid #e8788a; }
  .day.overdue .card { border-left: 4px solid #ef4444; }
  .pick { display: grid; place-items: center; padding: 0 0.3rem 0 1rem; }
  .card-main { flex: 1; display: flex; align-items: center; gap: 1rem; min-width: 0; padding: 0.9rem 0.5rem; border: 0; background: none; font: inherit; color: inherit; text-align: left; cursor: pointer; }
  .time { display: grid; place-items: center; width: 4rem; flex-shrink: 0; padding: 0.5rem 0; border-radius: 0.7rem; background: #fdf2f4; line-height: 1.1; }
  .time b { font-size: 1.05rem; color: #d45a6a; font-variant-numeric: tabular-nums; }
  .time small { font-size: 0.68rem; color: #94a3b8; font-weight: 600; }
  .body { display: grid; gap: 0.25rem; min-width: 0; flex: 1; }
  .who { font-weight: 700; color: #0f172a; }
  .who small { font-weight: 500; color: #94a3b8; font-family: monospace; margin-left: 0.3rem; }
  .items { list-style: none; margin: 0; padding: 0; color: #475569; font-size: 0.85rem; }
  .items li { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .flags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .flag { display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.1rem 0.55rem; border-radius: 999px; font-style: normal; font-size: 0.7rem; font-weight: 700; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .flag.allergy { background: #fffbeb; color: #b45309; }
  .flag.note { background: #f1f5f9; color: #475569; }
  .thumb { width: 4.5rem; height: 4.5rem; flex-shrink: 0; border-radius: 0.7rem; object-fit: cover; border: 2px solid #fdf2f4; }
  .done-btn { width: 3.5rem; flex-shrink: 0; border: 0; border-left: 1px solid #f1f5f9; background: #fff; color: #15803d; font-size: 1.1rem; cursor: pointer; transition: background 200ms, color 200ms; }
  .done-btn:hover { background: #22c55e; color: #fff; }
  .done-btn:disabled { opacity: 0.4; cursor: wait; }

  @media (max-width: 640px) {
    .thumb { width: 3.2rem; height: 3.2rem; }
    .time { width: 3.4rem; }
    .toolbar-actions { width: 100%; justify-content: space-between; }
  }
</style>
