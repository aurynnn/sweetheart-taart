---
import AdminLayout from '../../layouts/admin/AdminLayout.astro';
import StatCard from '../../components/admin/StatCard.astro';
import OrderModal from '../../components/admin/orders/OrderModal.astro';
import { d1Query } from '../../lib/d1';

// Fetch real stats from D1
let stats = { totalOrders: 0, pendingOrders: 0, monthlyRevenue: '€0', avgOrderValue: '€0' };
let recentOrders: any[] = [];
let upcomingOrders: any[] = [];

try {
  const countRes = await d1Query('SELECT COUNT(*) as cnt FROM orders');
  const totalOrders = (countRes.results?.[0]?.cnt as number) ?? 0;

  const pendingRes = await d1Query("SELECT COUNT(*) as cnt FROM orders WHERE status = 'pending'");
  const pendingOrders = (pendingRes.results?.[0]?.cnt as number) ?? 0;

  const monthRes = await d1Query(
    "SELECT SUM(total) as sum FROM orders WHERE status != 'cancelled' AND date >= date('now', 'start of month')"
  );
  const monthlyRevenue = monthRes.results?.[0]?.sum as number ?? 0;

  const avgRes = await d1Query(
    "SELECT AVG(total) as avg FROM orders WHERE status != 'cancelled'"
  );
  const avgOrderValue = avgRes.results?.[0]?.avg as number ?? 0;

  stats = {
    totalOrders,
    pendingOrders,
    monthlyRevenue: `€${monthlyRevenue.toFixed(2)}`,
    avgOrderValue: `€${avgOrderValue.toFixed(2)}`
  };

  // Upcoming orders — next 14 days, sorted by delivery date ascending
  try {
    const upcomingRes = await d1Query(`
      SELECT o.id, o.date, o.status, o.total, c.name as customer,
             (SELECT product FROM order_items WHERE order_id = o.id LIMIT 1) as product
      FROM orders o
      JOIN customers c ON o.customer_id = c.id
      WHERE o.date >= date('now') AND o.date <= date('now', '+14 days')
        AND o.status NOT IN ('completed', 'cancelled')
      ORDER BY o.date ASC
      LIMIT 10
    `);
    upcomingOrders = (upcomingRes.results || []).map((row: any) => ({
      id: row.id,
      customer: row.customer || 'Onbekend',
      product: row.product || '—',
      date: row.date,
      total: row.total ? `€${Number(row.total).toFixed(2)}` : '€0.00',
      status: row.status
    }));
  } catch (e) { /* ignore */ }

  const ordersRes = await d1Query(`
    SELECT o.id, o.date, o.status, o.total, c.name as customer,
           (SELECT product FROM order_items WHERE order_id = o.id LIMIT 1) as product
    FROM orders o
    JOIN customers c ON o.customer_id = c.id
    ORDER BY o.created_at DESC
    LIMIT 5
  `);
  recentOrders = (ordersRes.results || []).map((row: any) => {
    const totalRaw = row.total;
    // row.total may already be a string like '€57.00' or a number
    let totalFormatted = '€0.00';
    if (totalRaw !== null && totalRaw !== undefined && totalRaw !== '') {
      const numeric = typeof totalRaw === 'string' ? parseFloat(totalRaw.replace(/[^0-9.]/g, '')) : Number(totalRaw);
      totalFormatted = isNaN(numeric) ? String(totalRaw) : `€${numeric.toFixed(2)}`;
    }
    return {
      id: row.id,
      customer: row.customer || 'Onbekend',
      date: row.date || '—',
      total: totalFormatted,
      status: row.status
    };
  });
} catch (e) {
  // D1 not available — stats stay at 0
}

const statusBadge = (status: string) => {
  const styles = {
    pending: 'background: #fef3c7; color: #92400e;',
    completed: 'background: #dcfce7; color: #166534;',
    cancelled: 'background: #fee2e2; color: #991b1b;'
  };
  return `<span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; ${styles[status as keyof typeof styles] || styles.pending}">${status === 'pending' ? 'In afwachting' : status === 'completed' ? 'Voltooid' : 'Geannuleerd'}</span>`;
};
---

<AdminLayout title="Dashboard">
  <div class="stats-grid">
    <StatCard 
      title="Totale Bestellingen"
      value={stats.totalOrders}
      subtitle="Alle tijd"
      icon={`<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>`}
      color="pink"
      trend={{ value: 12, positive: true }}
    />
    
    <StatCard 
      title="Openstaand"
      value={stats.pendingOrders}
      subtitle="Wachten op bevestiging"
      icon={`<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`}
      color="orange"
    />
    
    <StatCard 
      title="Maandelijkse Omzet"
      value={stats.monthlyRevenue}
      subtitle="Maart 2026"
      icon={`<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>`}
      color="green"
      trend={{ value: 8, positive: true }}
    />
    
    <StatCard 
      title="Gem. Bestelwaarde"
      value={stats.avgOrderValue}
      subtitle="Per order"
      icon={`<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path></svg>`}
      color="blue"
      trend={{ value: 3, positive: true }}
    />
  </div>
  
  {upcomingOrders.length > 0 && (
    <div class="upcoming-orders">
      <div class="section-header">
        <h2>Opkomend <span class="badge">{upcomingOrders.length}</span></h2>
        <a href="/admin/orders" class="view-all">Bekijk alles →</a>
      </div>

      <div class="upcoming-cards">
        {upcomingOrders.map(order => (
          <a href={`/admin/orders/${order.id}`} class="upcoming-card">
            <div class="upcoming-date">
              <span class="date-day">{new Date(order.date + 'T00:00:00').getDate()}</span>
              <span class="date-month">{new Date(order.date + 'T00:00:00').toLocaleDateString('nl-BE', { month: 'short' })}</span>
            </div>
            <div class="upcoming-info">
              <strong>{order.customer}</strong>
              <span>{order.product}</span>
            </div>
            <div class="upcoming-total">{order.total}</div>
            <div class="upcoming-status"><Fragment set:html={statusBadge(order.status)} /></div>
          </a>
        ))}
      </div>
    </div>
  )}

  <div class="recent-orders">
    <div class="section-header">
      <h2>Recente Bestellingen</h2>
      <a href="/admin/orders" class="view-all">Bekijk alles →</a>
    </div>
    
    <table class="orders-table">
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Klant</th>
          <th>Datum</th>
          <th>Totaal</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {recentOrders.map(order => (
          <tr class="clickable-row" data-order-id={order.id}>
            <td class="order-id">{order.id}</td>
            <td>{order.customer}</td>
            <td>{order.date}</td>
            <td class="order-total">{order.total}</td>
            <td><Fragment set:html={statusBadge(order.status)} /></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  
  <div class="quick-actions">
    <h2>Snelle Acties</h2>
    <div class="actions-grid">
      <a href="/admin/orders/new" class="action-card">
        <div class="action-icon pink">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        </div>
        <span>Nieuwe Bestelling</span>
      </a>
      
      <a href="/admin/calendar" class="action-card">
        <div class="action-icon blue">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </div>
        <span>Beschikbaarheid</span>
      </a>
      
      <a href="/admin/settings" class="action-card">
        <div class="action-icon green">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </div>
        <span>Instellingen</span>
      </a>
    </div>
  </div>
</AdminLayout>

<OrderModal />

<script>
  import { STATUS_CONFIG, renderOrderDetail } from '../../lib/orders';

  (window as any).STATUS_CONFIG = STATUS_CONFIG;

  let allOrders: any[] = [];

  async function loadDashboardOrders() {
    try {
      const res = await fetch('/api/orders');
      allOrders = await res.json();
    } catch (e) {
      console.error('Failed to load orders for modal');
    }
  }

  function openModal(orderId: string) {
    const order = allOrders.find((o: any) => o.id === orderId);
    if (!order) return;
    const subtitle = document.getElementById('modalOrderId');
    if (subtitle) {
      const d = order.date ? new Date(order.date + 'T00:00:00') : null;
      if (d && !isNaN(d.getTime())) {
        const formatted = d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
        subtitle.textContent = `#${order.id} · Ophaaldatum: ${formatted}`;
      } else if (order.createdAt) {
        const created = new Date(order.createdAt);
        const createdStr = created.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
        subtitle.textContent = `#${order.id} · Geplaatst: ${createdStr}`;
      } else {
        subtitle.textContent = `#${order.id}`;
      }
    }
    const badge = document.getElementById('modalStatusBadge');
    if (badge) {
      const sc = STATUS_CONFIG[order.status] || STATUS_CONFIG.pending;
      const hexToRgba = (hex: string, alpha: number) => {
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        return `rgba(${r}, ${g}, ${b}, ${alpha})`;
      };
      badge.innerHTML = `<span class="dot" style="background:${sc.dot}"></span>${sc.label}`;
      badge.style.background = hexToRgba(sc.bg, 0.25);
      badge.style.color = sc.color;
      badge.style.borderColor = hexToRgba(sc.color, 0.4);
    }
    const body = document.getElementById('orderModalBody');
    if (body) body.innerHTML = renderOrderDetail(order);
    document.getElementById('orderModal')?.classList.add('active');
  }

  function closeModal() {
    document.getElementById('orderModal')?.classList.remove('active');
    const badge = document.getElementById('modalStatusBadge');
    if (badge) { badge.textContent = ''; badge.style.background = ''; badge.style.color = ''; badge.style.borderColor = ''; }
  }

  document.addEventListener('click', (e) => {
    const row = (e.target as Element).closest('.clickable-row') as HTMLElement | null;
    if (!row) return;
    const orderId = row.dataset.orderId;
    if (orderId) openModal(orderId);
  });

  document.getElementById('closeOrderModalBtn')?.addEventListener('click', closeModal);
  document.getElementById('closeOrderModalBtn2')?.addEventListener('click', closeModal);
  document.getElementById('orderModal')?.addEventListener('click', (e) => {
    if ((e.target as Element).classList.contains('modal-overlay')) closeModal();
  });

  loadDashboardOrders();
</script>

<style>
.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.upcoming-orders {
  background: white;
  border-radius: 1rem;
  border: 1px solid #e2e8f0;
  padding: 1.5rem;
  margin-bottom: 2rem;
}

.upcoming-cards {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.upcoming-card {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem;
  border: 1px solid #f1f5f9;
  border-radius: 0.75rem;
  text-decoration: none;
  transition: all 0.15s;
}

.upcoming-card:hover {
  border-color: #e8788a;
  background: #fef8f8;
}

.upcoming-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 2.5rem;
}

.date-day {
  font-size: 1.5rem;
  font-weight: 700;
  color: #e8788a;
  line-height: 1;
}

.date-month {
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  color: #94a3b8;
}

.upcoming-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.upcoming-info strong {
  font-size: 0.9rem;
  color: #1e293b;
}

.upcoming-info span {
  font-size: 0.8rem;
  color: #64748b;
}

.upcoming-total {
  font-weight: 600;
  font-size: 0.9rem;
  color: #1e293b;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #e8788a;
  color: white;
  font-size: 0.7rem;
  font-weight: 700;
  border-radius: 9999px;
  min-width: 1.25rem;
  height: 1.25rem;
  padding: 0 0.4rem;
  margin-left: 0.5rem;
  vertical-align: middle;
}

.recent-orders {
  background: white;
  border-radius: 1rem;
  border: 1px solid #e2e8f0;
  padding: 1.5rem;
  margin-bottom: 2rem;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.section-header h2 {
  font-size: 1.125rem;
  font-weight: 600;
  color: #0f172a;
  margin: 0;
}

.view-all {
  font-size: 0.875rem;
  font-weight: 500;
  color: #e11d48;
  text-decoration: none;
}

.view-all:hover {
  text-decoration: underline;
}

.orders-table {
  width: 100%;
  border-collapse: collapse;
}

.orders-table th {
  text-align: left;
  padding: 0.75rem 1rem;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #64748b;
  border-bottom: 1px solid #e2e8f0;
}

.orders-table td {
  padding: 1rem;
  border-bottom: 1px solid #f1f5f9;
  color: #334155;
  font-size: 0.875rem;
}

.orders-table tbody tr:last-child td {
  border-bottom: none;
}

.orders-table tbody tr:hover {
  background: #f8fafc;
}

.clickable-row {
  cursor: pointer;
}

.clickable-row:hover td {
  background: #fdf2f4;
}

.order-id {
  font-family: monospace;
  font-weight: 600;
  color: #64748b;
}

.order-total {
  font-weight: 600;
  color: #0f172a;
}

.quick-actions h2 {
  font-size: 1.125rem;
  font-weight: 600;
  color: #0f172a;
  margin: 0 0 1rem 0;
}

.actions-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1rem;
}

.action-card {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.25rem;
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
  text-decoration: none;
  transition: all 0.2s;
}

.action-card:hover {
  border-color: #e11d48;
  box-shadow: 0 4px 12px rgba(225, 29, 72, 0.1);
  transform: translateY(-2px);
}

.action-icon {
  width: 3rem;
  height: 3rem;
  border-radius: 0.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon.pink {
  background: #fce7f3;
  color: #db2777;
}

.action-icon.blue {
  background: #dbeafe;
  color: #2563eb;
}

.action-icon.green {
  background: #dcfce7;
  color: #16a34a;
}

.action-card span {
  font-weight: 500;
  color: #1e293b;
}
</style>
