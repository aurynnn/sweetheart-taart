---
import AdminLayout from '../../layouts/admin/AdminLayout.astro';
import OrderModal from '../../components/admin/orders/OrderModal.astro';
import { d1Query } from '../../lib/d1';
import { customerNameSql } from '../../lib/schema';
import { getAvailability, toLocalDateStr } from '../../lib/availability';
import { formatEuro, parseEuro, productName, PRODUCTS, itemSummary } from '../../lib/catalog';
import { STATUS_CONFIG } from '../../lib/orders';
import { reviewStats } from '../../lib/reviews';

interface Row {
  id: string; date: string; time: string | null; status: string; total: number;
  createdAt: string; customer: string; email: string; phone: string; products: string[]; summary: string;
  items: any[]; allergies: string[]; hasPhoto: boolean;
}

let orders: Row[] = [];
let capacity: Array<{ date: string; orders: number; maxOrders: number; available: boolean; reason?: string }> = [];
let loadError = false;

const today = new Date();
today.setHours(0, 0, 0, 0);
const todayStr = toLocalDateStr(today);
const in14 = new Date(today); in14.setDate(in14.getDate() + 13);
const in7 = new Date(today); in7.setDate(in7.getDate() + 6);

try {
  const name = await customerNameSql('c');
  const [ordersRes, itemsRes, avail] = await Promise.all([
    d1Query(`
      SELECT o.id, o.date, o.time, o.status, o.total, o.created_at, o.message, ${name.full} as customer, c.email, c.phone
      FROM orders o JOIN customers c ON o.customer_id = c.id
      ORDER BY o.created_at DESC
    `),
    d1Query('SELECT * FROM order_items ORDER BY id'),
    getAvailability(todayStr, toLocalDateStr(in14)),
  ]);
  const itemsByOrder = new Map<string, any[]>();
  for (const it of itemsRes.results || []) {
    itemsByOrder.set(it.order_id, [...(itemsByOrder.get(it.order_id) ?? []), it]);
  }
  orders = (ordersRes.results || []).map((r: any) => {
    const items = itemsByOrder.get(r.id) ?? [];
    return {
      id: r.id,
      date: r.date,
      time: r.time,
      status: r.status,
      total: parseEuro(r.total),
      createdAt: r.created_at,
      customer: (r.customer || '').trim() || 'Onbekend',
      email: r.email || '',
      phone: r.phone || '',
      items,
      allergies: items.map((i) => (i.allergies || '').trim()).filter(Boolean),
      hasPhoto: items.some((i) => i.image) || /\/admin\/api\/upload\?key=/.test(r.message || ''),
      products: items.map((i) => i.product),
      summary: items.map((i) => {
        const detail = itemSummary({ ...i, quantity: i.product === 'feesttaart' ? undefined : i.quantity, miniType: i.mini_type });
        return `${productName(i.product)}${detail ? ` (${detail})` : ''}`;
      }).join(', ') || '—',
    };
  });
  capacity = avail.availability;
} catch (e) {
  console.error('[admin] dashboard data failed:', e);
  loadError = true;
}

// ── KPIs ────────────────────────────────────────────────────────────────
const active = orders.filter((o) => o.status !== 'cancelled');
const pending = orders.filter((o) => o.status === 'pending').sort((a, b) => a.date.localeCompare(b.date));
const upcoming = orders
  .filter((o) => o.date >= todayStr && o.date <= toLocalDateStr(in14) && (o.status === 'approved' || o.status === 'pending'))
  .sort((a, b) => (a.date + (a.time ?? '')).localeCompare(b.date + (b.time ?? '')));
const thisWeek = upcoming.filter((o) => o.date <= toLocalDateStr(in7) && o.status === 'approved');
const todayPickups = upcoming.filter((o) => o.date === todayStr);

const monthKey = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
const MONTHS = ['jan', 'feb', 'mrt', 'apr', 'mei', 'jun', 'jul', 'aug', 'sep', 'okt', 'nov', 'dec'];
const months = Array.from({ length: 6 }, (_, i) => {
  const d = new Date(today.getFullYear(), today.getMonth() - 5 + i, 1);
  const key = monthKey(d);
  const inMonth = active.filter((o) => o.date?.startsWith(key));
  return { key, label: MONTHS[d.getMonth()], year: d.getFullYear(), revenue: inMonth.reduce((s, o) => s + o.total, 0), count: inMonth.length };
});
const thisMonth = months[5];
const lastMonth = months[4];
const revenueDelta = lastMonth.revenue > 0 ? Math.round(((thisMonth.revenue - lastMonth.revenue) / lastMonth.revenue) * 100) : null;
const avgValue = active.length ? active.reduce((s, o) => s + o.total, 0) / active.length : 0;
const maxRevenue = Math.max(...months.map((m) => m.revenue), 1);

// Product mix (all non-cancelled items)
const mix = PRODUCTS.map((p) => ({
  id: p.id,
  name: p.name,
  count: active.reduce((s, o) => s + o.products.filter((x) => x === p.id).length, 0),
}));
const maxMix = Math.max(...mix.map((m) => m.count), 1);

// Bakplanning: what has to be ready on each of the next 7 days (approved + pending)
const bakeDays = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(today); d.setDate(d.getDate() + i);
  const iso = toLocalDateStr(d);
  const dayOrders = upcoming.filter((o) => o.date === iso);
  const lines = dayOrders.flatMap((o) => o.items.map((it: any) => ({
    order: o.id,
    customer: o.customer,
    time: o.time,
    pending: o.status === 'pending',
    label: `${it.product === 'feesttaart' ? '' : `${it.quantity ?? ''}× `}${productName(it.product)}`,
    detail: itemSummary({ ...it, quantity: undefined }),
    allergy: (it.allergies || '').trim(),
  })));
  return { iso, date: d, lines };
});
const bakeTotal = bakeDays.reduce((s, d) => s + d.lines.length, 0);

// Status mix (all time) and customer stats
const statusMix = (['pending', 'approved', 'completed', 'cancelled'] as const).map((k) => ({
  key: k, label: STATUS_CONFIG[k].label, color: STATUS_CONFIG[k].dot, count: orders.filter((o) => o.status === k).length,
}));
const customerKeys = orders.map((o) => (o.email || o.phone || o.customer).toLowerCase());
const uniqueCustomers = new Set(customerKeys).size;
const returning = [...new Set(customerKeys)].filter((k) => customerKeys.filter((x) => x === k).length > 1).length;
const newThisWeek = orders.filter((o) => (Date.now() - new Date(o.createdAt.replace(' ', 'T') + 'Z').getTime()) < 7 * 86400000).length;

let reviews = { count: 0, average: 0, sent: 0, recent: [] as Awaited<ReturnType<typeof reviewStats>>['recent'] };
try { reviews = await reviewStats(); } catch (e) { console.warn('[admin] review stats unavailable:', e); }
const stars = (n: number) => '★'.repeat(Math.round(n)) + '☆'.repeat(5 - Math.round(n));

const maxCap = Math.max(...capacity.map((c) => Math.max(c.maxOrders, c.orders)), 1);

const fmtDay = (iso: string, opts: Intl.DateTimeFormatOptions = { weekday: 'short', day: 'numeric', month: 'short' }) =>
  new Date(iso + 'T00:00:00').toLocaleDateString('nl-BE', opts);
const relDay = (iso: string) => {
  const diff = Math.round((new Date(iso + 'T00:00:00').getTime() - today.getTime()) / 86400000);
  if (diff === 0) return 'Vandaag';
  if (diff === 1) return 'Morgen';
  if (diff < 7) return `Over ${diff} dagen`;
  return fmtDay(iso);
};
const hour = new Date().getHours();
const greeting = hour < 12 ? 'Goeiemorgen' : hour < 18 ? 'Goeiemiddag' : 'Goeienavond';
---

<AdminLayout title="Dashboard">
  {loadError && (
    <div class="alert-error" role="alert">
      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
      De gegevens konden niet geladen worden. Controleer de databaseverbinding (CLOUDFLARE_API_TOKEN).
    </div>
  )}

  <section class="welcome reveal">
    <div>
      <h2>{greeting} Nathalie 👋</h2>
      <p>
        {todayPickups.length > 0
          ? `Vandaag ${todayPickups.length === 1 ? 'komt 1 klant' : `komen ${todayPickups.length} klanten`} iets ophalen.`
          : pending.length > 0
            ? `Er ${pending.length === 1 ? 'wacht 1 nieuwe aanvraag' : `wachten ${pending.length} nieuwe aanvragen`} op je antwoord.`
            : 'Alles is bijgewerkt. Tijd voor een koffie ☕'}
      </p>
    </div>
    <div class="welcome-actions">
      <a href="/admin/orders" class="btn-pill primary"><i class="fa-solid fa-inbox" aria-hidden="true"></i> Alle aanvragen</a>
      <a href="/admin/calendar" class="btn-pill"><i class="fa-regular fa-calendar" aria-hidden="true"></i> Beschikbaarheid</a>
      <a href="/admin/calendar#ophaal" class="btn-pill"><i class="fa-regular fa-clock" aria-hidden="true"></i> Ophaalmomenten</a>
    </div>
  </section>

  <!-- KPI tiles -->
  <section class="kpis" aria-label="Kerncijfers">
    <a href="#te-bevestigen" class="kpi reveal" style="--d: 0">
      <span class="kpi-icon amber"><i class="fa-solid fa-bell" aria-hidden="true"></i></span>
      <span class="kpi-label">Te bevestigen</span>
      <strong class="kpi-value" data-count={pending.length}>{pending.length}</strong>
      <span class="kpi-sub">{pending.length ? 'wachten op je antwoord' : 'niets openstaand'}</span>
    </a>
    <a href="#komend" class="kpi reveal" style="--d: 1">
      <span class="kpi-icon blue"><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i></span>
      <span class="kpi-label">Ophalen deze week</span>
      <strong class="kpi-value" data-count={thisWeek.length}>{thisWeek.length}</strong>
      <span class="kpi-sub">{todayPickups.length} vandaag</span>
    </a>
    <div class="kpi reveal" style="--d: 2">
      <span class="kpi-icon pink"><i class="fa-solid fa-euro-sign" aria-hidden="true"></i></span>
      <span class="kpi-label">Omzet {MONTHS[today.getMonth()]}</span>
      <strong class="kpi-value" data-count={thisMonth.revenue} data-euro>{formatEuro(thisMonth.revenue)}</strong>
      <span class="kpi-sub">
        {revenueDelta === null
          ? `${thisMonth.count} aanvragen · indicatief`
          : <span class={revenueDelta >= 0 ? 'delta up' : 'delta down'}>{revenueDelta >= 0 ? '▲' : '▼'} {Math.abs(revenueDelta)}% t.o.v. {lastMonth.label}</span>}
      </span>
    </div>
    <div class="kpi reveal" style="--d: 3">
      <span class="kpi-icon green"><i class="fa-solid fa-receipt" aria-hidden="true"></i></span>
      <span class="kpi-label">Gem. waarde</span>
      <strong class="kpi-value" data-count={avgValue} data-euro>{formatEuro(avgValue)}</strong>
      <span class="kpi-sub">over {active.length} aanvragen</span>
    </div>
  </section>

  <div class="grid-main">
    <!-- Pending approvals -->
    <section id="te-bevestigen" class="panel reveal" aria-labelledby="pending-title">
      <header class="panel-head">
        <h2 id="pending-title">Te bevestigen <span class="count">{pending.length}</span></h2>
        <a href="/admin/orders" class="link">Alles bekijken →</a>
      </header>
      {pending.length === 0 ? (
        <div class="empty"><i class="fa-regular fa-face-smile" aria-hidden="true"></i><p>Geen openstaande aanvragen.</p></div>
      ) : (
        <ul class="pending-list">
          {pending.slice(0, 6).map((o) => (
            <li class="pending-item" data-order-row={o.id}>
              <button type="button" class="pending-main" data-open-order={o.id}>
                <span class="avatar">{o.customer.charAt(0).toUpperCase()}</span>
                <span class="pending-info">
                  <strong>{o.customer}</strong>
                  <span>{o.summary}</span>
                  <small><i class="fa-regular fa-calendar" aria-hidden="true"></i> {fmtDay(o.date)}{o.time ? ` · ${o.time}` : ''} · {formatEuro(o.total)}</small>
                  {(o.allergies.length > 0 || o.hasPhoto) && (
                    <span class="flags">
                      {o.allergies.length > 0 && <em class="flag allergy" title={o.allergies.join(' · ')}><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> allergie</em>}
                      {o.hasPhoto && <em class="flag photo"><i class="fa-solid fa-image" aria-hidden="true"></i> foto</em>}
                    </span>
                  )}
                </span>
              </button>
              <div class="pending-actions">
                <button type="button" class="act approve" data-status-action="approved" data-order-id={o.id} title="Goedkeuren" aria-label={`Aanvraag ${o.id} goedkeuren`}>
                  <i class="fa-solid fa-check" aria-hidden="true"></i>
                </button>
                <button type="button" class="act cancel" data-status-action="cancelled" data-order-id={o.id} title="Weigeren" aria-label={`Aanvraag ${o.id} weigeren`}>
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>

    <!-- Upcoming pickups timeline -->
    <section id="komend" class="panel reveal" aria-labelledby="upcoming-title">
      <header class="panel-head">
        <h2 id="upcoming-title">Komende 14 dagen</h2>
        <a href="/admin/todo" class="link">Te maken →</a>
      </header>
      {upcoming.length === 0 ? (
        <div class="empty"><i class="fa-regular fa-calendar" aria-hidden="true"></i><p>Nog niets gepland.</p></div>
      ) : (
        <ol class="timeline">
          {upcoming.slice(0, 8).map((o) => {
            const sc = STATUS_CONFIG[o.status] ?? STATUS_CONFIG.pending;
            return (
              <li>
                <button type="button" class="tl-item" data-open-order={o.id}>
                  <span class="tl-date">
                    <b>{new Date(o.date + 'T00:00:00').getDate()}</b>
                    <small>{MONTHS[new Date(o.date + 'T00:00:00').getMonth()]}</small>
                  </span>
                  <span class="tl-body">
                    <strong>{o.customer}</strong>
                    <span>{relDay(o.date)}{o.time ? ` · ${o.time}` : ''} · {o.summary}</span>
                  </span>
                  <span class="status" style={`background:${sc.bg};color:${sc.color}`}>
                    <span class="dot" style={`background:${sc.dot}`}></span>{sc.label}
                  </span>
                </button>
              </li>
            );
          })}
        </ol>
      )}
    </section>
  </div>

  <!-- Bakplanning: what needs to be ready, day by day -->
  <section class="panel reveal bake" aria-labelledby="bake-title">
    <header class="panel-head">
      <h2 id="bake-title">Bakplanning <small>komende 7 dagen · {bakeTotal} product{bakeTotal === 1 ? '' : 'en'}</small></h2>
      <button type="button" class="link as-btn" id="printBake"><i class="fa-solid fa-print" aria-hidden="true"></i> Afdrukken</button>
    </header>
    <div class="bake-days">
      {bakeDays.map((d) => (
        <div class="bake-day" class:list={[{ empty: d.lines.length === 0, today: d.iso === todayStr }]}>
          <div class="bake-date">
            <span>{d.date.toLocaleDateString('nl-BE', { weekday: 'short' })}</span>
            <b>{d.date.getDate()}</b>
          </div>
          {d.lines.length === 0 ? (
            <p class="bake-free">vrij</p>
          ) : (
            <ul>
              {d.lines.map((l) => (
                <li class:list={[{ pending: l.pending }]}>
                  <button type="button" data-open-order={l.order}>
                    <strong>{l.label}</strong>
                    {l.detail && <span>{l.detail}</span>}
                    <small>{l.time ? `${l.time} · ` : ''}{l.customer}{l.pending ? ' · nog te bevestigen' : ''}</small>
                    {l.allergy && <em class="flag allergy"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {l.allergy}</em>}
                  </button>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </section>

  <div class="grid-charts">
    <!-- Revenue per month: single series → one hue, no legend -->
    <section class="panel reveal" aria-labelledby="rev-title">
      <header class="panel-head">
        <h2 id="rev-title">Omzet per maand <small>indicatief, excl. geannuleerd</small></h2>
      </header>
      <div class="bars" role="img" aria-label={`Omzet laatste 6 maanden: ${months.map((m) => `${m.label} ${formatEuro(m.revenue)}`).join(', ')}`}>
        {months.map((m, i) => (
          <div class="bar-col" data-tip={`${m.label} ${m.year}: ${formatEuro(m.revenue)} · ${m.count} aanvra${m.count === 1 ? 'ag' : 'gen'}`}>
            <span class="bar-value">{m.revenue ? `€${Math.round(m.revenue)}` : ''}</span>
            <span class="bar-track">
              <span class="bar" class:list={[{ current: i === 5 }]} style={`--h: ${(m.revenue / maxRevenue) * 100}%; --i: ${i}`}></span>
            </span>
            <span class="bar-label">{m.label}</span>
          </div>
        ))}
      </div>
      <details class="table-view">
        <summary>Toon als tabel</summary>
        <table>
          <thead><tr><th>Maand</th><th>Aanvragen</th><th>Omzet</th></tr></thead>
          <tbody>{months.map((m) => <tr><td>{m.label} {m.year}</td><td>{m.count}</td><td>{formatEuro(m.revenue)}</td></tr>)}</tbody>
        </table>
      </details>
    </section>

    <!-- Capacity: orders vs daily max for the next 14 days -->
    <section class="panel reveal" aria-labelledby="cap-title">
      <header class="panel-head">
        <h2 id="cap-title">Bezetting <small>volgende 14 dagen</small></h2>
        <a href="/admin/calendar" class="link">Aanpassen →</a>
      </header>
      <div class="cap" role="img" aria-label="Aantal aanvragen per dag ten opzichte van de maximale capaciteit">
        {capacity.map((c, i) => {
          const closed = !c.available && c.orders < c.maxOrders;
          return (
            <div class="cap-col" data-tip={`${fmtDay(c.date, { weekday: 'long', day: 'numeric', month: 'long' })}: ${c.orders}/${c.maxOrders}${c.reason ? ` · ${c.reason}` : ''}`}>
              <span class="cap-track" class:list={[{ closed }]} style={`--cap: ${(c.maxOrders / maxCap) * 100}%`}>
                <span class="cap-fill" class:list={[{ full: c.orders >= c.maxOrders }]} style={`--h: ${(c.orders / maxCap) * 100}%; --i: ${i}`}></span>
              </span>
              <span class="cap-label" class:list={[{ today: c.date === todayStr }]}>{fmtDay(c.date, { weekday: 'narrow' })}<br />{new Date(c.date + 'T00:00:00').getDate()}</span>
            </div>
          );
        })}
      </div>
      <p class="cap-legend">
        <span><i class="sw fill"></i> aanvragen</span>
        <span><i class="sw track"></i> capaciteit</span>
        <span><i class="sw closed"></i> gesloten</span>
        <span><i class="fa-solid fa-circle-exclamation" style="color:#b45309" aria-hidden="true"></i> vol</span>
      </p>
    </section>

    <!-- Product mix: single hue horizontal bars -->
    <section class="panel reveal" aria-labelledby="mix-title">
      <header class="panel-head"><h2 id="mix-title">Populairste producten</h2></header>
      <ul class="mix">
        {mix.map((m, i) => (
          <li data-tip={`${m.name}: ${m.count}× aangevraagd`}>
            <span class="mix-name">{m.name}</span>
            <span class="mix-track"><span class="mix-bar" style={`--w: ${(m.count / maxMix) * 100}%; --i: ${i}`}></span></span>
            <span class="mix-count">{m.count}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section class="panel reveal status-panel" aria-labelledby="status-title">
    <header class="panel-head"><h2 id="status-title">Aanvragen & klanten</h2></header>
    <div class="status-bar" role="img" aria-label={statusMix.map((m) => `${m.label}: ${m.count}`).join(', ')}>
      {statusMix.filter((m) => m.count > 0).map((m, i) => (
        <span style={`flex:${m.count};background:${m.color};--i:${i}`} data-tip={`${m.label}: ${m.count}`}></span>
      ))}
    </div>
    <ul class="status-legend">
      {statusMix.map((m) => <li><i style={`background:${m.color}`}></i>{m.label} <b>{m.count}</b></li>)}
    </ul>
    <div class="cust-stats">
      <div><b data-count={uniqueCustomers}>{uniqueCustomers}</b><span>klanten</span></div>
      <div><b data-count={returning}>{returning}</b><span>terugkerend</span></div>
      <div><b data-count={newThisWeek}>{newThisWeek}</b><span>nieuw deze week</span></div>
    </div>
  </section>

  <section class="panel reveal reviews-panel" aria-labelledby="reviews-title">
    <header class="panel-head">
      <h2 id="reviews-title">Klantbeoordelingen <small>via de review-mail na het ophalen</small></h2>
      <a href="/admin/settings" class="link">Instellingen →</a>
    </header>
    <div class="rv-top">
      <div class="rv-score">
        <b>{reviews.count ? reviews.average.toFixed(1) : '–'}</b>
        <span class="rv-stars" aria-label={`Gemiddeld ${reviews.average.toFixed(1)} op 5`}>{stars(reviews.average)}</span>
        <small>{reviews.count} beoordeling{reviews.count === 1 ? '' : 'en'} · {reviews.sent} mail{reviews.sent === 1 ? '' : 's'} verstuurd</small>
      </div>
      <p class="rv-note">5 sterren gaan meteen door naar Google. Bij 4 of minder vraagt de website wat beter kon — dat lees je hier.</p>
    </div>
    {reviews.recent.length === 0 ? (
      <p class="empty-small">Nog geen beoordelingen ontvangen.</p>
    ) : (
      <ul class="rv-list">
        {reviews.recent.map((r) => (
          <li>
            <button type="button" data-open-order={r.order_id}>
              <span class="rv-row-stars">{stars(r.rating ?? 0)}</span>
              <span class="rv-text">
                {r.feedback ? `“${r.feedback}”` : r.rating === 5 ? 'Doorgestuurd naar Google' : 'Nog geen toelichting'}
                {r.liked && <small>{r.liked}</small>}
              </span>
              <span class="rv-id">#{r.order_id}</span>
            </button>
          </li>
        ))}
      </ul>
    )}
  </section>

  <div id="chart-tip" class="chart-tip" role="tooltip" hidden></div>
  <div id="live-banner" class="live-banner" hidden>
    <i class="fa-solid fa-bell" aria-hidden="true"></i>
    <span id="live-text">Nieuwe aanvraag binnen!</span>
    <button type="button" onclick="location.reload()">Vernieuwen</button>
  </div>
</AdminLayout>

<OrderModal />

<script>
  import { initOrderModal, openOrderModal } from '../../scripts/admin/orderModal';
  import { updateStatus } from '../../scripts/admin/toast';

  let allOrders: any[] = [];
  const ordersReady = fetch('/api/orders').then((r) => r.json()).then((d) => (allOrders = d)).catch(() => []);

  // ── Order detail modal (shared with the Todo page) ─────────────────
  initOrderModal({ onStatusChanged: () => setTimeout(() => location.reload(), 800) });
  async function openModal(orderId: string) {
    await ordersReady;
    const order = allOrders.find((o: any) => o.id === orderId);
    if (order) openOrderModal(order);
  }

  document.addEventListener('click', async (e) => {
    const target = e.target as Element;
    const open = target.closest<HTMLElement>('[data-open-order]');
    if (open) { openModal(open.dataset.openOrder!); return; }

    // ── Quick approve / decline ──────────────────────────────────────
    const act = target.closest<HTMLButtonElement>('[data-status-action]');
    if (!act) return;
    const orderId = act.dataset.orderId!;
    const status = act.dataset.statusAction!;
    const row = document.querySelector<HTMLElement>(`[data-order-row="${CSS.escape(orderId)}"]`);
    act.disabled = true;
    if (await updateStatus(orderId, status)) {
      row?.classList.add(status === 'approved' ? 'leaving-ok' : 'leaving-no');
      setTimeout(() => {
        row?.remove();
        document.querySelectorAll('.count').forEach((el) => { el.textContent = String(Math.max(0, Number(el.textContent) - 1)); });
      }, 450);
    } else {
      act.disabled = false;
    }
  });

  // ── Chart tooltips (hover + keyboard focus) ─────────────────────────
  const tip = document.getElementById('chart-tip')!;
  document.querySelectorAll<HTMLElement>('[data-tip]').forEach((el) => {
    el.tabIndex = 0;
    const show = () => {
      tip.textContent = el.dataset.tip!;
      tip.hidden = false;
      const r = el.getBoundingClientRect();
      const tr = tip.getBoundingClientRect();
      tip.style.left = `${Math.min(window.innerWidth - tr.width - 8, Math.max(8, r.left + r.width / 2 - tr.width / 2))}px`;
      tip.style.top = `${r.top - tr.height - 8}px`;
      el.classList.add('is-hover');
    };
    const hide = () => { tip.hidden = true; el.classList.remove('is-hover'); };
    el.addEventListener('pointerenter', show);
    el.addEventListener('pointerleave', hide);
    el.addEventListener('focus', show);
    el.addEventListener('blur', hide);
  });

  // ── Live: check for new aanvragen every minute ──────────────────────
  const knownIds = new Set<string>();
  ordersReady.then(() => allOrders.forEach((o: any) => knownIds.add(o.id)));
  setInterval(async () => {
    if (document.hidden) return;
    try {
      const fresh: any[] = await (await fetch('/api/orders')).json();
      const added = fresh.filter((o) => !knownIds.has(o.id));
      if (!added.length || !knownIds.size) return;
      added.forEach((o) => knownIds.add(o.id));
      allOrders = fresh;
      const first = added[0];
      const who = [first.customer?.firstname, first.customer?.lastname].filter(Boolean).join(' ');
      const banner = document.getElementById('live-banner')!;
      document.getElementById('live-text')!.textContent = added.length === 1
        ? `Nieuwe aanvraag van ${who || 'een klant'}!`
        : `${added.length} nieuwe aanvragen binnen!`;
      banner.hidden = false;
      document.title = `(${added.length}) Dashboard | Admin`;
    } catch { /* offline — try again next minute */ }
  }, 60_000);

  document.getElementById('printBake')?.addEventListener('click', () => {
    document.body.classList.add('print-bake');
    window.print();
    setTimeout(() => document.body.classList.remove('print-bake'), 500);
  });

  // ── Count-up KPI values ──────────────────────────────────────────────
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const to = Number(el.dataset.count);
      const euro = el.hasAttribute('data-euro');
      const start = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - start) / 1100);
        const v = to * (1 - Math.pow(1 - p, 3));
        el.textContent = euro ? `€${v.toFixed(2)}` : String(Math.round(v));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }
</script>

