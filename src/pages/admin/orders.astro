---
import AdminLayout from '../../layouts/admin/AdminLayout.astro';
import StatsBar from '../../components/admin/orders/StatsBar.astro';
import OrderFilters from '../../components/admin/orders/OrderFilters.astro';
import OrderModal from '../../components/admin/orders/OrderModal.astro';
import NewOrderModal from '../../components/admin/orders/NewOrderModal.astro';
---

<AdminLayout title="Bestellingen">

  <!-- Page Header -->
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">Bestellingen</h1>
      <p class="page-subtitle">Beheer alle bestellingen</p>
    </div>
    <div class="header-actions">
      <button class="btn btn-secondary" id="exportBtn">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Exporteren
      </button>
      <button class="btn btn-primary" id="newOrderBtn">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Nieuwe Bestelling
      </button>
    </div>
  </div>

  <!-- Stats -->
  <div class="stats-section">
    <StatsBar total={0} pending={0} approved={0} completed={0} cancelled={0} />
  </div>

  <!-- Filters -->
  <div class="filters-section">
    <OrderFilters />
  </div>

  <!-- Orders Grid -->
  <div class="orders-grid" id="ordersGrid">
    <div class="empty-state" id="emptyState">
      <div class="empty-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
          <rect x="9" y="3" width="6" height="4" rx="1"/>
        </svg>
      </div>
      <p class="empty-title">Geen bestellingen</p>
      <p class="empty-sub">Bestellingen verschijnen hier wanneer klanten bestellen.</p>
    </div>
  </div>

  <!-- Modals -->
  <OrderModal />
  <NewOrderModal />

</AdminLayout>

<script>
  import { getOrders, setOrders, setCurrentOrderId, STATUS_CONFIG } from '../../lib/orders';
  import { renderOrderDetail } from '../../lib/orders';

  // ── DOM refs ───────────────────────────────────────────────────────────────

  const grid       = document.getElementById('ordersGrid')!;
  const emptyState = document.getElementById('emptyState')!;
  const statsEl    = document.querySelector('.stats-bar') as HTMLElement | null;

  // ── Fetch ─────────────────────────────────────────────────────────────────

  async function loadOrders() {
    try {
      const res = await fetch('/api/orders');
      if (!res.ok) throw new Error('Failed to load');
      const data = await res.json();
      setOrders(Array.isArray(data) ? data : []);
      renderGrid();
      updateStats();
    } catch (e) {
      console.error('Load orders failed:', e);
    }
  }

  // ── Render ────────────────────────────────────────────────────────────────

  function renderGrid() {
    const orders = getOrders();
    if (orders.length === 0) {
      grid.innerHTML = '';
      grid.appendChild(emptyState);
      emptyState.style.display = '';
      return;
    }
    emptyState.style.display = 'none';
    grid.innerHTML = orders.map(renderCard).join('');
  }

  function renderCard(order: any): string {
    const c = order.customer || {};
    const name = c.name || 'Onbekend';
    const first = order.items?.[0];
    const itemsCount = order.items?.length || 0;
    const sc = STATUS_CONFIG[order.status] || STATUS_CONFIG.pending;

    return `
      <div class="order-card" data-order-id="${order.id}" data-status="${order.status}">
        <div class="card-header">
          <div class="card-meta">
            <span class="order-id">#${order.id}</span>
            <span class="order-date">${order.date || '—'}</span>
          </div>
          <span class="status-badge" style="background:${sc.bg};color:${sc.color}">
            <span class="status-dot" style="background:${sc.dot}"></span>
            ${sc.label}
          </span>
        </div>
        <div class="card-body">
          <div class="customer-block">
            <div class="customer-avatar">${name.charAt(0).toUpperCase()}</div>
            <div class="customer-info">
              <span class="customer-name">${name}</span>
              <span class="customer-contact">${c.email || '—'}</span>
            </div>
          </div>
          <div class="product-block">
            <span class="product-name">${first?.product || '—'}</span>
            ${first?.event ? `<span class="product-event">${first.event}</span>` : ''}
            ${itemsCount > 1 ? `<span class="product-more">+ ${itemsCount - 1} meer item${itemsCount > 2 ? 's' : ''}</span>` : ''}
          </div>
          <div class="info-chips">
            ${first?.persons ? `<span class="chip">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              ${first.persons} personen</span>` : ''}
            ${first?.flavor ? `<span class="chip">
              <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10H12V2z"/></svg>
              ${first.flavor}</span>` : ''}
          </div>
        </div>
        <div class="card-footer">
          <span class="order-total">${order.total || '—'}</span>
          <div class="card-actions">
            <button class="btn-icon" data-action="view" data-order-id="${order.id}" title="Bekijk">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
            ${order.status === 'pending' ? `
              <button class="btn-icon btn-approve" data-action="approve" data-order-id="${order.id}" title="Goedkeur">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
              <button class="btn-icon btn-cancel" data-action="cancel" data-order-id="${order.id}" title="Annuleer">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>` : ''}
            ${order.status === 'approved' ? `
              <button class="btn-icon btn-complete" data-action="complete" data-order-id="${order.id}" title="Voltooid">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              </button>` : ''}
          </div>
        </div>
      </div>`;
  }

  // ── Stats ─────────────────────────────────────────────────────────────────

  function updateStats() {
    const orders = getOrders();
    const counts = { total: 0, pending: 0, approved: 0, completed: 0, cancelled: 0 };
    orders.forEach(o => {
      if (o.status === 'pending') counts.pending++;
      else if (o.status === 'approved') counts.approved++;
      else if (o.status === 'completed') counts.completed++;
      else if (o.status === 'cancelled') counts.cancelled++;
    });
    counts.total = orders.length;

    if (statsEl) {
      const vals = statsEl.querySelectorAll('.pill-value');
      if (vals[0]) vals[0].textContent = String(counts.total);
      if (vals[1]) vals[1].textContent = String(counts.pending);
      if (vals[2]) vals[2].textContent = String(counts.approved);
      if (vals[3]) vals[3].textContent = String(counts.completed);
      if (vals[4]) vals[4].textContent = String(counts.cancelled);
    }
  }

  // ── Modal helpers ─────────────────────────────────────────────────────────

  function openModal(orderId: string) {
    const order = getOrders().find((o: any) => o.id === orderId);
    if (!order) return;
    setCurrentOrderId(orderId);

    const subtitle = document.getElementById('modalOrderId');
    if (subtitle) subtitle.textContent = `#${order.id} · ${order.date || '—'}`;

    const body = document.getElementById('orderModalBody');
    if (body) body.innerHTML = renderOrderDetail(order);

    document.getElementById('orderModal')?.classList.add('active');
  }

  function closeModal() {
    document.getElementById('orderModal')?.classList.remove('active');
    setCurrentOrderId(null);
  }

  // ── Status update ──────────────────────────────────────────────────────────

  async function patchStatus(orderId: string, status: string) {
    try {
      await fetch('/api/orders', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId, status }),
      });
      const orders = getOrders();
      const o = orders.find((x: any) => x.id === orderId);
      if (o) (o as any).status = status;
      renderGrid();
      updateStats();
    } catch (e) {
      console.error('Status update failed:', e);
    }
  }

  // ── Search & Filter ───────────────────────────────────────────────────────

  function applyFilters() {
    const query = (document.getElementById('searchInput') as HTMLInputElement)?.value.toLowerCase() || '';
    const status = (document.getElementById('statusFilter') as HTMLSelectElement)?.value || '';
    const dateVal = (document.getElementById('dateFilter') as HTMLSelectElement)?.value || '';
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const startOfWeek = new Date(today); startOfWeek.setDate(today.getDate() - today.getDay());
    const startOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);

    const cards = grid.querySelectorAll('.order-card');
    let visible = 0;
    cards.forEach(card => {
      const el = card as HTMLElement;
      const text = el.textContent?.toLowerCase() || '';
      const cardStatus = el.dataset.status || '';
      const cardDate = el.querySelector('.order-date')?.textContent || '';

      let dateMatch = !dateVal;
      if (dateVal) {
        const d = new Date(cardDate + 'T00:00:00');
        if (dateVal === 'today') dateMatch = d >= today;
        else if (dateVal === 'week') dateMatch = d >= startOfWeek;
        else if (dateVal === 'month') dateMatch = d >= startOfMonth;
      }

      const show = text.includes(query) && (!status || cardStatus === status) && dateMatch;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    const countEl = document.getElementById('resultsCount');
    if (countEl) {
      countEl.textContent = visible > 0 ? `${visible} van ${cards.length} bestellingen` : '';
    }

    // Toggle clear button
    const clearBtn = document.getElementById('searchClearBtn') as HTMLButtonElement | null;
    if (clearBtn) clearBtn.style.display = query ? '' : 'none';
  }

  // ── Event delegation ───────────────────────────────────────────────────────

  document.addEventListener('click', e => {
    const btn = (e.target as Element).closest('[data-action]') as HTMLElement | null;
    if (!btn) return;
    const action = btn.dataset.action;
    const orderId = btn.dataset.orderId;

    if (action === 'view' && orderId) openModal(orderId);
    else if (action === 'approve' && orderId) patchStatus(orderId, 'approved');
    else if (action === 'cancel' && orderId) {
      if (confirm('Deze bestelling annuleren?')) patchStatus(orderId, 'cancelled');
    }
    else if (action === 'complete' && orderId) patchStatus(orderId, 'completed');
    else if (action === 'close') closeModal();
  });

  // Filter inputs
  document.getElementById('searchInput')?.addEventListener('input', applyFilters);
  document.getElementById('statusFilter')?.addEventListener('change', applyFilters);
  document.getElementById('dateFilter')?.addEventListener('change', applyFilters);

  // Clear search
  document.getElementById('searchClearBtn')?.addEventListener('click', () => {
    const inp = document.getElementById('searchInput') as HTMLInputElement;
    if (inp) { inp.value = ''; applyFilters(); }
  });

  // Update status from modal
  document.getElementById('updateStatusBtn')?.addEventListener('click', async () => {
    const sel = document.getElementById('orderStatusAction') as HTMLSelectElement;
    const id = sel?.value;
    const { getCurrentOrderId } = await import('../../lib/orders');
    const orderId = getCurrentOrderId();
    if (id && orderId) {
      await patchStatus(orderId, id);
      closeModal();
    }
  });

  // Modal close buttons
  document.getElementById('closeOrderModalBtn')?.addEventListener('click', closeModal);
  document.getElementById('closeOrderModalBtn2')?.addEventListener('click', closeModal);

  // Overlay click closes modal
  document.getElementById('orderModal')?.addEventListener('click', e => {
    if ((e.target as Element).classList.contains('modal-overlay')) closeModal();
  });

  // ── New order modal ────────────────────────────────────────────────────────

  document.getElementById('newOrderBtn')?.addEventListener('click', () => {
    document.getElementById('new-order-form')?.reset();
    document.getElementById('new-order-modal')?.classList.add('active');
  });

  document.getElementById('closeNewOrderModalBtn')?.addEventListener('click', () =>
    document.getElementById('new-order-modal')?.classList.remove('active'));
  document.getElementById('closeNewOrderModalBtn2')?.addEventListener('click', () =>
    document.getElementById('new-order-modal')?.classList.remove('active'));

  document.getElementById('new-order-modal')?.addEventListener('click', e => {
    if ((e.target as Element).classList.contains('modal-overlay'))
      document.getElementById('new-order-modal')?.classList.remove('active');
  });

  document.getElementById('submitNewOrderBtn')?.addEventListener('click', async () => {
    const fd = new FormData(document.getElementById('new-order-form') as HTMLFormElement);
    const get = (n: string) => String(fd.get(n) || '').trim();

    const name = get('name'), email = get('email'), phone = get('phone');
    const product = get('product'), event = get('event');
    const persons = get('persons'), flavor = get('flavor');
    const priceStr = get('price'), allergies = get('allergies');

    if (!name && !email && !phone) {
      alert('Vul minstens naam, e-mail of telefoon in.');
      return;
    }

    const items = product ? [{ product, event, persons, flavor, allergies, price: priceStr ? parseFloat(priceStr) : 0 }] : [];
    const total = priceStr ? `€${parseFloat(priceStr).toFixed(2)}` : '€0,00';

    try {
      const res = await fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ customer: { name, email, phone }, items, total, isAdmin: true }),
      });
      if (!res.ok) {
        const err = await res.json();
        alert(err.error || 'Aanmaak mislukt.');
        return;
      }
      document.getElementById('new-order-modal')?.classList.remove('active');
      await loadOrders();
    } catch {
      alert('Aanmaak mislukt.');
    }
  });

  // ── Boot ──────────────────────────────────────────────────────────────────
  loadOrders();
</script>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1.5rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .header-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .page-title {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.2;
  }

  .page-subtitle {
    margin: 0;
    font-size: 0.875rem;
    color: #64748b;
  }

  .header-actions {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    flex-shrink: 0;
  }

  .stats-section {
    margin-bottom: 1rem;
  }

  .filters-section {
    margin-bottom: 1.25rem;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: all 0.15s;
    white-space: nowrap;
  }

  .btn-primary {
    background: #E8788A;
    color: white;
  }
  .btn-primary:hover {
    background: #d66b7a;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(232, 120, 138, 0.35);
  }

  .btn-secondary {
    background: white;
    color: #334155;
    border: 1px solid #e2e8f0;
  }
  .btn-secondary:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
  }

  /* Orders grid */
  .orders-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    align-content: start;
    min-height: 200px;
  }

  /* Empty state */
  .empty-state {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
  }

  .empty-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 1rem;
    background: #fdf2f4;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #E8788A;
    margin-bottom: 1rem;
  }

  .empty-title {
    margin: 0 0 0.375rem;
    font-size: 1rem;
    font-weight: 600;
    color: #1e293b;
  }

  .empty-sub {
    margin: 0;
    font-size: 0.875rem;
    color: #94a3b8;
  }

  /* Order card styles (inlined for now, shared via OrderCard component would be ideal) */
  .order-card {
    background: white;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.15s, transform 0.15s, border-color 0.15s;
  }

  .order-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
    border-color: #fda4af;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #f1f5f9;
    gap: 0.5rem;
  }

  .card-meta {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .order-id {
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-size: 0.75rem;
    font-weight: 700;
    color: #1e293b;
    letter-spacing: -0.02em;
  }

  .order-date {
    font-size: 0.6875rem;
    color: #94a3b8;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    font-weight: 600;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .card-body {
    padding: 0.875rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .customer-block {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .customer-avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: linear-gradient(135deg, #E8788A, #fda4af);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .customer-info {
    display: flex;
    flex-direction: column;
    gap: 0.0625rem;
    min-width: 0;
  }

  .customer-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1e293b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .customer-contact {
    font-size: 0.6875rem;
    color: #94a3b8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .product-block {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 0.75rem;
    background: #f8fafc;
    border-radius: 0.5rem;
    border-left: 3px solid #E8788A;
  }

  .product-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #1e293b;
  }

  .product-event {
    font-size: 0.6875rem;
    color: #db2777;
    font-weight: 500;
  }

  .product-more {
    font-size: 0.6875rem;
    color: #64748b;
    margin-top: 0.0625rem;
  }

  .info-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 0.375rem;
    font-size: 0.6875rem;
    color: #475569;
    font-weight: 500;
  }

  .chip svg { opacity: 0.6; }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.625rem 1rem;
    border-top: 1px solid #f1f5f9;
    background: #f8fafc;
  }

  .order-total {
    font-size: 1.0625rem;
    font-weight: 700;
    color: #1e293b;
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .btn-icon {
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    border: 1px solid #e2e8f0;
    background: white;
    color: #64748b;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s;
    padding: 0;
  }

  .btn-icon:hover { background: #f1f5f9; color: #1e293b; }
  .btn-icon.btn-approve { color: #16a34a; border-color: #bbf7d0; background: #f0fdf4; }
  .btn-icon.btn-approve:hover { background: #dcfce7; }
  .btn-icon.btn-cancel { color: #dc2626; border-color: #fecaca; background: #fef2f2; }
  .btn-icon.btn-cancel:hover { background: #fee2e2; }
  .btn-icon.btn-complete { color: #16a34a; border-color: #bbf7d0; background: #f0fdf4; }
  .btn-icon.btn-complete:hover { background: #dcfce7; }

  @media (max-width: 768px) {
    .orders-grid { grid-template-columns: 1fr; }
    .page-header { flex-direction: column; }
  }
</style>
