}

.order-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.625rem 0.875rem;
  gap: 0.5rem;
}

.order-id-date {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 0.625rem;
}

.order-card .order-id {
  font-family: monospace;
  font-size: 0.8125rem;
  font-weight: 700;
