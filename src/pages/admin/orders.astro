    product: 'Mini-gebak (12 stuks)',
    items: [
      { product: 'Mini-gebak', flavor: 'Chocolade', quantity: '12', date: '2026-04-03', colors: 'Wit & Goud', box: 'Luxebox', allergies: 'Gluten', delivery: 'Bezorgen' }
    ],
    date: '2026-03-30',
    notes: 'Bezorgen tussen 14:00 en 16:00.',
    address: 'Kerkstraat 45, 3000 Leuven',
    total: '€18.00',
    status: 'completed'
  },
  {
    id: 'ORD-003',
    customer: 'Lisa Mertens',
    email: 'lisa.mertens@outlook.com',
    phone: '+32 471 34 56 78',
    product: 'Koekjes - Chocolade',
    items: [
      { product: 'Koekjes', flavor: 'Chocolade', quantity: '24', date: '2026-04-02', shape: 'Hartjes', packaging: 'Cadeauverpakking', allergies: 'Geen', delivery: 'Ophalen' }
    ],
    date: '2026-03-30',
    notes: '',
    total: '€12.00',
    status: 'completed'
  },
  {
    id: 'ORD-004',
    customer: 'Marie Jacobs',
    email: 'marie.jacobs@skynet.be',
    phone: '+32 495 45 67 89',
    product: 'Feesttaart - Huwelijk',
    items: [
      { product: 'Feesttaart', event: 'Huwelijk', persons: '40', flavor: 'Vanie', date: '2026-04-10', size: 'Groot (30cm)', filling: 'Vanille met aardbeien', decoration: 'Witte versiering met bloemen', text: 'Marie & Jan', allergies: 'Geen', delivery: 'Bezorgen' }
    ],
    date: '2026-03-29',
    notes: 'Bruiloftstaart - graag elegant design. Kleuren: wit en zacht roze.',
    address: 'Feestlocatie Kasteel van Horst, 2860 Sint-Katelijne-Waver',
    total: '€85.00',
    status: 'pending'
  },
  {
    id: 'ORD-005',
    customer: 'Anne de Smedt',
    email: 'anne.smedt@telenet.be',
    phone: '+32 472 56 78 90',
    product: 'Mini-gebak (6 stuks)',
    items: [
      { product: 'Mini-gebak', flavor: 'Vanille', quantity: '6', date: '2026-04-01', colors: 'Pastelkleuren', box: 'Standaard', allergies: 'Geen', delivery: 'Ophalen' }
    ],
    date: '2026-03-29',
    notes: '',
    total: '€9.00',
    status: 'completed'
  },
  {
    id: 'ORD-006',
    customer: 'Thomas Claus',
    email: 'thomas.claus@yahoo.com',
    phone: '+32 473 67 89 01',
    product: 'Koekjes - Mixed',
    items: [
      { product: 'Koekjes', flavor: 'Aardbei & Framboos', quantity: '36', date: '2026-04-04', shape: 'Mixed', packaging: 'Cadeauzak', allergies: 'Noten', delivery: 'Ophalen' }
    ],
    date: '2026-03-28',
    notes: 'Let op: notenallergie!',
    total: '€18.00',
    status: 'cancelled'
  }
];
  
  // Search functionality
  document.getElementById('searchInput')?.addEventListener('input', (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    const rows = document.querySelectorAll('#ordersTableBody tr');
    rows.forEach(row => {
      const text = row.textContent?.toLowerCase() || '';
      (row as HTMLElement).style.display = text.includes(query) ? '' : 'none';
    });
  });
  
  // Status filter
  document.getElementById('statusFilter')?.addEventListener('change', (e) => {
    const status = (e.target as HTMLSelectElement).value;
    const rows = document.querySelectorAll('#ordersTableBody tr');
    rows.forEach(row => {
      const rowStatus = (row as HTMLElement).dataset.status;
      (row as HTMLElement).style.display = !status || rowStatus === status ? '' : 'none';
    });
  });
  
  // View order
  window['viewOrder'] = function(orderId: string) {
    const order = orders.find((o: any) => o.id === orderId);
    if (!order) return;
    
    const itemsList = order.items.map((item: any) => `
      <div class="order-item-detail">
        <div class="item-header">
          <strong>${item.product}</strong>
          ${item.event ? `<span class="event-badge">${item.event}</span>` : ''}
        </div>
        <div class="item-grid">
          ${item.event ? `<div class="item-field"><label>Type evenement</label><span>${item.event}</span></div>` : ''}
          ${item.persons ? `<div class="item-field"><label>Aantal personen</label><span>${item.persons}</span></div>` : ''}
          ${item.filling ? `<div class="item-field"><label>Vulling</label><span>${item.filling}</span></div>` : ''}
          ${item.flavor ? `<div class="item-field"><label>Smaak</label><span>${item.flavor}</span></div>` : ''}
          ${item.size ? `<div class="item-field"><label>Formaat</label><span>${item.size}</span></div>` : ''}
          ${item.quantity ? `<div class="item-field"><label>Aantal</label><span>${item.quantity} stuks</span></div>` : ''}
          ${item.colors ? `<div class="item-field"><label>Kleuren</label><span>${item.colors}</span></div>` : ''}
          ${item.decoration ? `<div class="item-field"><label>Versiering</label><span>${item.decoration}</span></div>` : ''}
          ${item.text ? `<div class="item-field"><label>Tekst op taart</label><span>"${item.text}"</span></div>` : ''}
          ${item.shape ? `<div class="item-field"><label>Vorm</label><span>${item.shape}</span></div>` : ''}
          ${item.packaging ? `<div class="item-field"><label>Verpakking</label><span>${item.packaging}</span></div>` : ''}
          ${item.box ? `<div class="item-field"><label>Doos</label><span>${item.box}</span></div>` : ''}
          <div class="item-field"><label>Leverdatum</label><span>${item.date}</span></div>
          <div class="item-field"><label>Levering</label><span>${item.delivery}</span></div>
          ${item.allergies && item.allergies !== 'Geen' ? `<div class="item-field allergy"><label>Allergieën</label><span>⚠️ ${item.allergies}</span></div>` : ''}
        </div>
      </div>
    `).join('');
    
    const statusLabels: Record<string, string> = {
      pending: 'In afwachting',
      approved: 'Goedgekeurd',
      completed: 'Voltooid',
      cancelled: 'Geannuleerd'
    };
    
    document.getElementById('orderModalBody')!.innerHTML = `
      <div class="order-detail-section">
        <h4>📋 Contactgegevens</h4>
        <div class="order-detail-grid">
          <div class="detail-row">
            <span class="detail-label">Naam</span>
            <span class="detail-value">${order.customer}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">E-mail</span>
            <span class="detail-value">${order.email}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Telefoon</span>
            <span class="detail-value">${order.phone}</span>
          </div>
          ${order.address ? `
          <div class="detail-row full-width">
            <span class="detail-label">Adres</span>
            <span class="detail-value">${order.address}</span>
          </div>
          ` : ''}
        </div>
      </div>
      
      <div class="order-detail-section">
        <h4>📦 Bestelling</h4>
        <div class="order-detail-grid">
          <div class="detail-row">
            <span class="detail-label">Order ID</span>
            <span class="detail-value font-mono">${order.id}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Besteldatum</span>
            <span class="detail-value">${order.date}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Status</span>
            <span class="detail-value status-${order.status}">${statusLabels[order.status] || order.status}</span>
          </div>
          ${order.notes ? `
          <div class="detail-row full-width">
            <span class="detail-label">Notities</span>
            <span class="detail-value notes">${order.notes}</span>
          </div>
          ` : ''}
        </div>
      </div>
      
      <div class="order-detail-section">
        <h4>🎂 Producten</h4>
        ${itemsList}
      </div>
      
      <div class="order-total-row">
        <span>Totaal</span>
        <span class="total-price">${order.total}</span>
      </div>
    `;
    
    window['currentOrderId'] = orderId;
    document.getElementById('orderModal')?.classList.add('active');
  };
  
  window['closeOrderModal'] = function() {
    document.getElementById('orderModal')?.classList.remove('active');
  };
  
  window['approveOrder'] = function(orderId: string) {
    updateOrderRow(orderId, 'approved');
  };
  
  window['cancelOrder'] = function(orderId: string) {
    if (confirm('Weet je zeker dat je deze bestelling wilt annuleren?')) {
      updateOrderRow(orderId, 'cancelled');
    }
  };
  
  window['completeOrder'] = function(orderId: string) {
    updateOrderRow(orderId, 'completed');
  };
  
  function updateOrderRow(orderId: string, newStatus: string) {
    const row = document.querySelector(`tr[data-order-id="${orderId}"]`) as HTMLElement;
    if (!row) return;
    
    row.dataset.status = newStatus;
    
    // Update status badge
    const statusCell = row.querySelector('td:nth-child(6)');
    if (statusCell) {
      const badges: Record<string, string> = {
        pending: '<span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: #fef3c7; color: #92400e;">In afwachting</span>',
        approved: '<span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: #dbeafe; color: #1e40af;">Goedgekeurd</span>',
        completed: '<span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: #dcfce7; color: #166534;">Voltooid</span>',
        cancelled: '<span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: #fee2e2; color: #991b1b;">Geannuleerd</span>'
      };
      statusCell.innerHTML = badges[newStatus] || badges.pending;
    }
    
    // Update actions
    const actionsCell = row.querySelector('.actions-cell');
    if (actionsCell) {
      actionsCell.innerHTML = actionButtons(newStatus, orderId);
    }
    
    // Update stats
    updateStats();
    
    console.log('Order', orderId, 'updated to', newStatus);
  }
  
  function updateStats() {
    const rows = document.querySelectorAll('#ordersTableBody tr');
    let pending = 0, approved = 0, completed = 0, cancelled = 0;
    rows.forEach(row => {
      const status = (row as HTMLElement).dataset.status;
      if (status === 'pending') pending++;
      else if (status === 'approved') approved++;
      else if (status === 'completed') completed++;
      else if (status === 'cancelled') cancelled++;
    });
    
    const total = pending + approved + completed + cancelled;
    const statValues = document.querySelectorAll('.stat-value');
    if (statValues[0]) statValues[0].textContent = String(total);
    if (statValues[1]) statValues[1].textContent = String(pending);
    if (statValues[2]) statValues[2].textContent = String(approved + completed);
    if (statValues[3]) statValues[3].textContent = String(cancelled);
  }
  
  window['updateOrderStatus'] = function() {
    const select = document.getElementById('orderStatusAction') as HTMLSelectElement;
    const newStatus = select.value;
    if (!newStatus || !window['currentOrderId']) return;
    
    // In production, this would call your API
    console.log('Updating order', window['currentOrderId'], 'to', newStatus);
    
    // Update UI
    const row = document.querySelector(`tr[data-order-id="${window['currentOrderId']}"]`) as HTMLElement;
    if (row) {
      row.dataset.status = newStatus;
      const statusCell = row.querySelector('td:nth-child(6)');
      if (statusCell) {
        const badges: Record<string, string> = {
          pending: '<span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: #fef3c7; color: #92400e;">In afwachting</span>',
          completed: '<span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: #dcfce7; color: #166534;">Voltooid</span>',
          cancelled: '<span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; background: #fee2e2; color: #991b1b;">Geannuleerd</span>'
        };
        statusCell.innerHTML = badges[newStatus] || badges.pending;
      }
    }
    
    closeOrderModal();
  };
</script>

<style>
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.header-subtitle {
  margin: 0;
  color: #64748b;
  font-size: 0.875rem;
}

.header-actions {
  display: flex;
  gap: 0.75rem;
}

.stats-row {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.stat-item {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 0.75rem;
  padding: 1rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: 100px;
}

.stat-item.pending {
  border-left: 4px solid #f59e0b;
