      { product: 'Mini-gebak', flavor: 'Chocolade', quantity: '12', date: '2026-04-03' }
    ],
    date: '2026-03-30',
    total: '€18.00',
    status: 'completed'
  },
  {
    id: 'ORD-003',
    customer: 'Lisa Mertens',
    email: 'lisa@email.be',
    phone: '+32 xxx xx xx xx',
    product: 'Koekjes - Chocolade',
    items: [
      { product: 'Koekjes', flavor: 'Chocolade', quantity: '24', date: '2026-04-02' }
    ],
    date: '2026-03-30',
    total: '€12.00',
    status: 'completed'
  },
  {
    id: 'ORD-004',
    customer: 'Marie Jacobs',
    email: 'marie@email.be',
    phone: '+32 xxx xx xx xx',
    product: 'Feesttaart - Huwelijk',
    items: [
      { product: 'Feesttaart', event: 'Huwelijk', persons: '40', flavor: 'Vanie', date: '2026-04-10' }
    ],
    date: '2026-03-29',
    total: '€85.00',
    status: 'pending'
  },
  {
    id: 'ORD-005',
    customer: 'Anne de Smedt',
    email: 'anne@email.be',
    phone: '+32 xxx xx xx xx',
    product: 'Mini-gebak (6 stuks)',
    items: [
      { product: 'Mini-gebak', flavor: 'Vanille', quantity: '6', date: '2026-04-01' }
    ],
    date: '2026-03-29',
    total: '€9.00',
    status: 'completed'
  },
  {
    id: 'ORD-006',
    customer: 'Thomas Claus',
    email: 'thomas@email.be',
    phone: '+32 xxx xx xx xx',
    product: 'Koekjes - Mixed',
    items: [
      { product: 'Koekjes', flavor: 'Aardbei & Framboos', quantity: '36', date: '2026-04-04' }
    ],
    date: '2026-03-28',
    total: '€18.00',
    status: 'cancelled'
  }
];

const statusBadge = (status: string) => {
  const styles: Record<string, string> = {
    pending: 'background: #fef3c7; color: #92400e;',
    approved: 'background: #dbeafe; color: #1e40af;',
    completed: 'background: #dcfce7; color: #166534;',
    cancelled: 'background: #fee2e2; color: #991b1b;'
  };
  const labels: Record<string, string> = {
    pending: 'In afwachting',
    approved: 'Goedgekeurd',
    completed: 'Voltooid',
    cancelled: 'Geannuleerd'
  };
  return `<span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; ${styles[status] || styles.pending}">${labels[status] || status}</span>`;
};

const actionButtons = (status: string, orderId: string) => {
  if (status === 'pending') {
    return `
      <button class="btn btn-sm btn-approve" onclick="approveOrder('${orderId}')">Goedkeur</button>
      <button class="btn btn-sm btn-cancel" onclick="cancelOrder('${orderId}')">Annuleer</button>
    `;
  }
  if (status === 'approved') {
    return `
      <button class="btn btn-sm btn-primary" onclick="completeOrder('${orderId}')">Voltooid</button>
    `;
  }
  return `<button class="btn btn-sm btn-secondary" onclick="viewOrder('${orderId}')">Bekijk</button>`;
};

const columns = [
  { key: 'id', label: 'Order ID', class: 'font-mono text-gray-500' },
  { key: 'customer', label: 'Klant' },
  { key: 'product', label: 'Product' },
  { key: 'date', label: 'Datum' },
  { key: 'total', label: 'Totaal', class: 'font-semibold' },
  { 
    key: 'status', 
    label: 'Status',
    render: (val: string) => statusBadge(val)
  },
  { 
    key: 'actions', 
    label: '',
    render: (_: any, row: any) => `<button onclick="viewOrder('${row.id}')" class="btn btn-sm btn-secondary">Bekijk</button>`
  }
];

// Stats
const stats = {
  total: orders.length,
  pending: orders.filter(o => o.status === 'pending').length,
  approved: orders.filter(o => o.status === 'approved').length,
  completed: orders.filter(o => o.status === 'completed').length,
  cancelled: orders.filter(o => o.status === 'cancelled').length
};
---

<AdminLayout title="Bestellingen">
  <div class="page-header">
    <div class="header-left">
      <p class="header-subtitle">Beheer alle bestellingen</p>
    </div>
    <div class="header-actions">
      <button class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Exporteren
      </button>
    </div>
  </div>

  <!-- Stats Row -->
  <div class="stats-row">
    <div class="stat-item">
      <span class="stat-value">{stats.total}</span>
      <span class="stat-label">Totaal</span>
    </div>
    <div class="stat-item pending">
      <span class="stat-value">{stats.pending}</span>
      <span class="stat-label">In afwachting</span>
    </div>
    <div class="stat-item approved">
      <span class="stat-value">{stats.approved}</span>
      <span class="stat-label">Goedgekeurd</span>
    </div>
    <div class="stat-item completed">
      <span class="stat-value">{stats.completed}</span>
      <span class="stat-label">Voltooid</span>
    </div>
    <div class="stat-item cancelled">
      <span class="stat-value">{stats.cancelled}</span>
      <span class="stat-label">Geannuleerd</span>
    </div>
  </div>

  <!-- Filters -->
  <div class="filters-row">
    <div class="filter-group">
      <input type="text" placeholder="Zoek op klant of order ID..." class="search-input" id="searchInput">
    </div>
    <div class="filter-group">
      <select class="filter-select" id="statusFilter">
        <option value="">Alle statussen</option>
        <option value="pending">In afwachting</option>
        <option value="completed">Voltooid</option>
        <option value="cancelled">Geannuleerd</option>
      </select>
    </div>
    <div class="filter-group">
      <select class="filter-select" id="dateFilter">
        <option value="">Alle data</option>
        <option value="today">Vandaag</option>
        <option value="week">Deze week</option>
        <option value="month">Deze maand</option>
      </select>
    </div>
  </div>

  <!-- Orders Table -->
  <div class="table-container">
    <table class="data-table" id="ordersTable">
      <thead>
        <tr>
          <th>Order ID</th>
          <th>Klant</th>
          <th>Product</th>
          <th>Datum</th>
          <th>Totaal</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="ordersTableBody">
        {orders.map(order => (
          <tr data-order-id={order.id} data-status={order.status}>
            <td class="order-id">{order.id}</td>
            <td>
              <div class="customer-cell">
                <strong>{order.customer}</strong>
                <span>{order.email}</span>
              </div>
            </td>
            <td>{order.product}</td>
            <td>{order.date}</td>
            <td class="order-total">{order.total}</td>
            <td><Fragment set:html={statusBadge(order.status)} /></td>
            <td class="actions-cell">
              <Fragment set:html={actionButtons(order.status, order.id)} />
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Order Detail Modal -->
  <div class="modal-overlay" id="orderModal">
    <div class="modal">
      <div class="modal-header">
        <h3 class="modal-title">Bestelling Details</h3>
        <button class="modal-close" onclick="closeOrderModal()">&times;</button>
      </div>
      <div class="modal-body" id="orderModalBody">
        <!-- Filled dynamically -->
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeOrderModal()">Sluiten</button>
        <select class="action-select" id="orderStatusAction">
          <option value="">Status wijzigen...</option>
          <option value="approved">Goedkeur</option>
          <option value="completed">Markeer als voltooid</option>
          <option value="cancelled">Markeer als geannuleerd</option>
          <option value="pending">Zet terug naar in afwachting</option>
        </select>
        <button class="btn btn-primary" onclick="updateOrderStatus()">Opslaan</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // Orders data - in production this would be fetched from API
  const orders = [
  {
