<!-- New Order Modal -->
<div id="new-order-modal" class="modal-overlay">
  <div class="modal-card" style="max-width:560px">
    <div class="modal-header">
      <h3>Nieuwe Bestelling</h3>
      <button class="modal-close" onclick="closeNewOrderModal()" type="button">✕</button>
    </div>
    <div class="modal-body">
      <form id="new-order-form" class="new-order-form">
        <div class="form-section">
          <h4>Contactgegevens</h4>
          <div class="form-grid">
            <div class="form-field">
              <label>Naam</label>
              <input type="text" name="name" placeholder="Klant naam" />
            </div>
            <div class="form-field">
              <label>E-mail</label>
              <input type="email" name="email" placeholder="klant@email.be" />
            </div>
            <div class="form-field">
              <label>Telefoon</label>
              <input type="tel" name="phone" placeholder="+32 xxx xx xx xx" />
            </div>
          </div>
        </div>

        <div class="form-section">
          <h4>Bestelling</h4>
          <div class="form-grid">
            <div class="form-field">
              <label>Product</label>
              <select name="product" id="modal-product-select">
                <option value="">— selecteer —</option>
                <option value="feesttaart">Feesttaart</option>
                <option value="koekjes">Koekjes</option>
                <option value="mini-gebak">Mini-gebak</option>
              </select>
            </div>
            <div class="form-field">
              <label>Gelegelheid</label>
              <input type="text" name="event" placeholder="Bijv. Verjaardag, Bruiloft" />
            </div>
            <div class="form-field">
              <label>Aantal personen</label>
              <input type="text" name="persons" placeholder="Bijv. 15-25" />
            </div>
            <div class="form-field">
              <label>Smaak</label>
              <input type="text" name="flavor" placeholder="Bijv. Aardbei, Choco" />
            </div>
            <div class="form-field">
              <label>Prijs</label>
              <input type="text" name="price" placeholder="Bijv. 45.00" />
            </div>
            <div class="form-field form-field--full">
              <label>Allergieën / Opmerkingen</label>
              <textarea name="allergies" rows="2" placeholder="Allergieën of opmerkingen (optioneel)"></textarea>
            </div>
          </div>
        </div>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeNewOrderModal()" type="button">Annuleer</button>
      <button class="btn btn-primary" onclick="submitNewOrder()" type="button">Bestelling Aanmaken</button>
    </div>
  </div>
</div>

