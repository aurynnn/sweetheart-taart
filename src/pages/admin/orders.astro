---
import AdminLayout from '../../layouts/admin/AdminLayout.astro';

// Orders are loaded client-side from /api/orders
const orders: any[] = [];

// Stats
const stats = {
  total: orders.length,
  pending: orders.filter(o => o.status === 'pending').length,
  approved: orders.filter(o => o.status === 'approved').length,
  completed: orders.filter(o => o.status === 'completed').length,
  cancelled: orders.filter(o => o.status === 'cancelled').length
};
---

<AdminLayout title="Bestellingen">
  <div class="page-header">
    <div class="header-left">
      <p class="header-subtitle">Beheer alle bestellingen</p>
    </div>
    <div class="header-actions">
      <button class="btn btn-secondary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        Exporteren
      </button>
      <button class="btn btn-primary" onclick="openNewOrderModal()">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Nieuwe Bestelling
      </button>
    </div>
  </div>

  <!-- Stats Row -->
  <div class="stats-row">
    <div class="stat-item">
      <span class="stat-value">{stats.total}</span>
      <span class="stat-label">Totaal</span>
    </div>
    <div class="stat-item pending">
      <span class="stat-value">{stats.pending}</span>
      <span class="stat-label">In afwachting</span>
    </div>
    <div class="stat-item approved">
      <span class="stat-value">{stats.approved}</span>
      <span class="stat-label">Goedgekeurd</span>
    </div>
    <div class="stat-item completed">
      <span class="stat-value">{stats.completed}</span>
      <span class="stat-label">Voltooid</span>
    </div>
    <div class="stat-item cancelled">
      <span class="stat-value">{stats.cancelled}</span>
      <span class="stat-label">Geannuleerd</span>
    </div>
  </div>

  <!-- Filters -->
  <div class="filters-row">
    <div class="filter-group">
      <input type="text" placeholder="Zoek op klant of order ID..." class="search-input" id="searchInput">
    </div>
    <div class="filter-group">
      <select class="filter-select" id="statusFilter">
        <option value="">Alle statussen</option>
        <option value="pending">In afwachting</option>
        <option value="completed">Voltooid</option>
        <option value="cancelled">Geannuleerd</option>
      </select>
    </div>
    <div class="filter-group">
      <select class="filter-select" id="dateFilter">
        <option value="">Alle data</option>
        <option value="today">Vandaag</option>
        <option value="week">Deze week</option>
        <option value="month">Deze maand</option>
      </select>
    </div>
  </div>

  <!-- Orders Grid -->
  <div class="orders-grid" id="ordersGrid">
    <!-- Orders loaded dynamically via /api/orders -->
  </div>

  <!-- Order Detail Modal -->
  <div class="modal-overlay" id="orderModal">
    <div class="modal modal-wide">
      <div class="modal-header">
        <h3 class="modal-title">Bestelling Details</h3>
        <button class="modal-close" data-action="close">&times;</button>
      </div>
      <div class="modal-body" id="orderModalBody">
        <!-- Filled dynamically -->
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-action="close">Sluiten</button>
        <select class="action-select" id="orderStatusAction">
          <option value="">Status wijzigen...</option>
          <option value="approved">Goedkeur</option>
          <option value="completed">Markeer als voltooid</option>
          <option value="cancelled">Markeer als geannuleerd</option>
          <option value="pending">Zet terug naar in afwachting</option>
        </select>
        <button class="btn btn-primary" id="updateStatusBtn">Opslaan</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline>
  // Orders loaded from /api/orders
  let orders = [];
  let currentOrderId = null;

  const statusBadge = (status) => {
    const styles = {
      pending: 'background: #fef3c7; color: #92400e;',
      approved: 'background: #dbeafe; color: #1e40af;',
      completed: 'background: #dcfce7; color: #166534;',
      cancelled: 'background: #fee2e2; color: #991b1b;'
    };
    const labels = {
      pending: 'In afwachting',
      approved: 'Goedgekeurd',
      completed: 'Voltooid',
      cancelled: 'Geannuleerd'
    };
    return `<span style="display: inline-block; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; ${styles[status] || styles.pending}">${labels[status] || status}</span>`;
  };

  const actionButtons = (status, orderId) => {
    let btns = `<button class="btn btn-sm btn-secondary" data-action="view" data-order-id="${orderId}">Bekijk</button>`;
    if (status === 'pending') {
      btns += `
        <button class="btn btn-sm btn-approve" data-action="approve" data-order-id="${orderId}">Goedkeur</button>
        <button class="btn btn-sm btn-cancel" data-action="cancel" data-order-id="${orderId}">Annuleer</button>
      `;
    }
    if (status === 'approved') {
      btns += `
        <button class="btn btn-sm btn-primary" data-action="complete" data-order-id="${orderId}">Voltooid</button>
      `;
    }
    return btns;
  };

  async function initOrders() {
    try {
      const res = await fetch('/api/orders');
      if (!res.ok) throw new Error('Failed to load orders');
      orders = await res.json();
      renderOrdersGrid();
      updateStats();
    } catch (err) {
      console.error('Error loading orders:', err);
    }
  }

  function renderOrdersGrid() {
    const grid = document.getElementById('ordersGrid');
    if (!grid) return;
    if (orders.length === 0) {
      grid.innerHTML = '<div class="empty-state"><p>Geen bestellingen gevonden.</p></div>';
      return;
    }
    grid.innerHTML = orders.map(order => {
      const customerName = order.customer?.name || 'Onbekend';
      const customerEmail = order.customer?.email || '';
      const customerPhone = order.customer?.phone || '';
      const firstItem = order.items?.[0];
      const productLabel = firstItem ? firstItem.product : '—';
      const eventLabel = firstItem?.event || '';
      const itemsCount = order.items?.length || 0;
      const statusColors = {
        pending: { bg: '#fef3c7', color: '#92400e', label: 'In afwachting' },
        approved: { bg: '#dbeafe', color: '#1e40af', label: 'Goedgekeurd' },
        completed: { bg: '#dcfce7', color: '#166534', label: 'Voltooid' },
        cancelled: { bg: '#fee2e2', color: '#991b1b', label: 'Geannuleerd' }
      };
      const sc = statusColors[order.status] || statusColors.pending;
      const actionBtns = actionButtons(order.status, order.id);
      return `
        <div class="order-card" data-order-id="${order.id}" data-status="${order.status}">
          <div class="order-card-header">
            <div class="order-id-date">
              <span class="order-id">${order.id}</span>
              <span class="order-date">${order.date || '—'}</span>
            </div>
            <span class="order-status-badge" style="background:${sc.bg};color:${sc.color}">${sc.label}</span>
          </div>
          <div class="order-card-body">
            <div class="order-customer">
              <strong>${customerName}</strong>
              <span>${customerEmail}</span>
              ${customerPhone ? `<span>${customerPhone}</span>` : ''}
            </div>
            <div class="order-products">
              <div class="product-main">${productLabel}</div>
              ${eventLabel ? `<div class="product-event">${eventLabel}</div>` : ''}
              ${itemsCount > 1 ? `<div class="product-more">+ ${itemsCount - 1} meer item${itemsCount > 2 ? 's' : ''}</div>` : ''}
            </div>
            <div class="order-meta">
              ${order.items?.[0]?.persons ? `<span>👥 ${order.items[0].persons} personen</span>` : ''}
              ${order.items?.[0]?.flavor ? `<span>🍰 ${order.items[0].flavor}</span>` : ''}
            </div>
          </div>
          <div class="order-card-footer">
            <div class="order-total">${order.total || '—'}</div>
            <div class="order-actions">
              ${actionBtns}
            </div>
          </div>
        </div>
      `;
    }).join('');
  }

  function getStats() {
    let total = orders.length;
    let pending = 0, approved = 0, completed = 0, cancelled = 0;
    orders.forEach(o => {
      if (o.status === 'pending') pending++;
      else if (o.status === 'approved') approved++;
      else if (o.status === 'completed') completed++;
      else if (o.status === 'cancelled') cancelled++;
    });
    return { total, pending, approved, completed, cancelled };
  }

  // Init on page load
  initOrders();

  // Event delegation for action buttons
  document.addEventListener('click', (e) => {
    const btn = (e.target ).closest('[data-action]')  ;
    if (!btn) return;
    const action = btn.dataset.action;
    const orderId = btn.dataset.orderId;
    if (!action || !orderId) return;

    if (action === 'view') viewOrder(orderId);
    else if (action === 'approve') updateOrderRow(orderId, 'approved');
    else if (action === 'cancel') {
      if (confirm('Weet je zeker dat je deze bestelling wilt annuleren?')) {
        updateOrderRow(orderId, 'cancelled');
      }
    }
    else if (action === 'complete') updateOrderRow(orderId, 'completed');
    else if (action === 'close') closeOrderModal();
  });

  
  // Search functionality
  document.getElementById('searchInput')?.addEventListener('input', (e) => {
    const query = (e.target ).value.toLowerCase();
    const rows = document.querySelectorAll('.order-card');
    rows.forEach(row => {
      const text = row.textContent?.toLowerCase() || '';
      (row ).style.display = text.includes(query) ? '' : 'none';
    });
  });
  
  // Status filter
  document.getElementById('statusFilter')?.addEventListener('change', (e) => {
    const status = (e.target ).value;
    const rows = document.querySelectorAll('.order-card');
    rows.forEach(row => {
      const rowStatus = (row ).dataset.status;
      (row ).style.display = !status || rowStatus === status ? '' : 'none';
    });
  });
  
  // View order
  window['viewOrder'] = function(orderId) {
    const order = orders.find((o) => o.id === orderId);
    if (!order) return;
    
    const itemsList = order.items.map((item) => `
      <div class="order-item-detail">
        <div class="item-header">
          <strong>${item.product}</strong>
          ${item.event ? `<span class="event-badge">${item.event}</span>` : ''}
        </div>
        <div class="item-grid">
          ${item.miniType ? `<div class="item-field"><label>Type</label><span>${item.miniType === 'cupcakes' ? 'Cupcakes' : 'Mini-cupcakes'}</span></div>` : ''}
          ${item.quantity ? `<div class="item-field"><label>Aantal</label><span>${item.quantity} stuks</span></div>` : ''}
          ${item.event ? `<div class="item-field"><label>Gelegenheid</label><span>${item.event}</span></div>` : ''}
          ${item.persons ? `<div class="item-field"><label>Personen</label><span>${item.persons}</span></div>` : ''}
          ${item.flavor ? `<div class="item-field"><label>Smaak</label><span>${item.flavor}</span></div>` : ''}
          ${item.allergies ? `<div class="item-field allergy"><label>Allergieën</label><span>⚠️ ${item.allergies}</span></div>` : ''}
          ${item.message ? `<div class="item-field full-width"><label>Opmerkingen</label><span>${item.message}</span></div>` : ''}
        </div>
      </div>
    `).join('');
    
    const statusLabels = {
      pending: 'In afwachting',
      approved: 'Goedgekeurd',
      completed: 'Voltooid',
      cancelled: 'Geannuleerd'
    };
    
    const el = document.getElementById('orderModalBody'); if (el) el.innerHTML = `
      <div class="order-detail-section">
        <h4>📋 Contactgegevens</h4>
        <div class="order-detail-grid">
          <div class="detail-row">
            <span class="detail-label">Naam</span>
            <span class="detail-value">${order.customer?.name || 'Onbekend'}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">E-mail</span>
            <span class="detail-value">${order.customer?.email || '—'}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Telefoon</span>
            <span class="detail-value">${order.customer?.phone || '—'}</span>
          </div>
        </div>
      </div>
      
      <div class="order-detail-section">
        <h4>📦 Bestelling</h4>
        <div class="order-detail-grid">
          <div class="detail-row">
            <span class="detail-label">Order ID</span>
            <span class="detail-value font-mono">${order.id}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Datum</span>
            <span class="detail-value">${order.date}</span>
          </div>
          <div class="detail-row">
            <span class="detail-label">Status</span>
            <span class="detail-value status-${order.status}">${statusLabels[order.status] || order.status}</span>
          </div>
          ${order.message ? `
          <div class="detail-row full-width">
            <span class="detail-label">Notities</span>
            <span class="detail-value notes">${order.message}</span>
          </div>
          ` : ''}
        </div>
      </div>
      
      <div class="order-detail-section">
        <h4>🎂 Producten</h4>
        ${itemsList}
      </div>
      
      <div class="order-total-row">
        <span>Totaal</span>
        <span class="total-price">${order.total || '—'}</span>
      </div>
    `;
    
    currentOrderId = orderId;
    document.getElementById('orderModal')?.classList.add('active');
  };
  
  function closeOrderModal() {
    document.getElementById('orderModal')?.classList.remove('active');
    currentOrderId = null;
  }
  
  async function updateOrderRow(orderId, newStatus) {
    try {
      const res = await fetch('/api/orders', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId, status: newStatus }),
      });
      if (!res.ok) throw new Error('API error');
    } catch (err) {
      console.error('Failed to update order status:', err);
      return;
    }

    // Re-render the whole grid to reflect status changes
    renderOrdersGrid();

    // Sync local state
    const order = orders.find(o => o.id === orderId);
    if (order) order.status = newStatus;
    updateStats();
  }

  function updateStats() {
    const { total, pending, approved, completed, cancelled } = getStats();
    const statValues = document.querySelectorAll('.stat-value');
    if (statValues[0]) statValues[0].textContent = String(total);
    if (statValues[1]) statValues[1].textContent = String(pending);
    if (statValues[2]) statValues[2].textContent = String(approved + completed);
    if (statValues[3]) statValues[3].textContent = String(cancelled);
  }

  document.getElementById('updateStatusBtn')?.addEventListener('click', async () => {
    const select = document.getElementById('orderStatusAction') ;
    const newStatus = select.value;
    if (!newStatus || !currentOrderId) return;
    await updateOrderRow(currentOrderId, newStatus);
    closeOrderModal();
  });

  // --- New Order Modal ---
  window.openNewOrderModal = function() {
    document.getElementById('new-order-form')?.reset();
    const m = document.getElementById('new-order-modal');
    if (m) m.classList.add('active');
  };

  window.closeNewOrderModal = function() {
    const m = document.getElementById('new-order-modal');
    if (m) m.classList.remove('active');
  };

  window.submitNewOrder = async function() {
    const form = document.getElementById('new-order-form');
    if (!form) return;
    const fd = new FormData(form);

    const name = String(fd.get('name') || '').trim();
    const email = String(fd.get('email') || '').trim();
    const phone = String(fd.get('phone') || '').trim();
    const product = String(fd.get('product') || '').trim();
    const event = String(fd.get('event') || '').trim();
    const persons = String(fd.get('persons') || '').trim();
    const flavor = String(fd.get('flavor') || '').trim();
    const priceVal = String(fd.get('price') || '').trim();
    const allergies = String(fd.get('allergies') || '').trim();

    if (!name && !email && !phone && !product) {
      alert('Vul minstens één veld in.');
      return;
    }

    // Build customer object (API handles find-or-create)
    const customer = (name || email || phone) ? { name, email, phone } : null;

    // Build items
    const items = [];
    if (product) {
      items.push({ product, event, persons, flavor, allergies, price: priceVal ? parseFloat(priceVal) : 0 });
    }

    // Format total as euro string
    const total = priceVal ? `€${parseFloat(priceVal).toFixed(2)}` : '€0.00';

    try {
      const res = await fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ customer, items, total, isAdmin: true })
      });
      if (!res.ok) {
        const err = await res.json();
        alert(err.error || 'Kon bestelling niet aanmaken.');
        return;
      }
      closeNewOrderModal();
      await initOrders();
    } catch {
      alert('Kon bestelling niet aanmaken.');
    }
  };
</script>

<style>
.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.header-subtitle {
  margin: 0;
  color: #64748b;
  font-size: 0.875rem;
}

.header-actions {
  display: flex;
  gap: 0.75rem;
}

.stats-row {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.stat-item {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 0.75rem;
  padding: 1rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  min-width: 100px;
}

.stat-item.pending {
  border-left: 4px solid #f59e0b;
}

.stat-item.approved {
  border-left: 4px solid #3b82f6;
}

.stat-item.completed {
  border-left: 4px solid #22c55e;
}

.stat-item.cancelled {
  border-left: 4px solid #ef4444;
}

.stat-value {
  font-size: 1.5rem;
  font-weight: 700;
  color: #0f172a;
}

.stat-label {
  font-size: 0.75rem;
  color: #64748b;
}

.filters-row {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.filter-group {
  flex: 1;
}

.search-input,
.filter-select {
  width: 100%;
  padding: 0.625rem 0.875rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  background: white;
}

.search-input:focus,
.filter-select:focus {
  outline: none;
  border-color: #e11d48;
  box-shadow: 0 0 0 3px rgba(225, 29, 72, 0.1);
}

.table-container {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
  overflow: hidden;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
}

.data-table th {
  text-align: left;
  padding: 1rem 1.5rem;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #64748b;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}

.data-table td {
  padding: 1rem 1.5rem;
  border-bottom: 1px solid #f1f5f9;
  font-size: 0.875rem;
  color: #334155;
}

.data-table tbody tr:last-child td {
  border-bottom: none;
}

.data-table tbody tr:hover {
  background: #f8fafc;
}

.order-id {
  font-family: monospace;
  color: #64748b;
}

.customer-cell {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.customer-cell strong {
  font-weight: 600;
  color: #1e293b;
}

.customer-cell span {
  font-size: 0.75rem;
  color: #64748b;
}

.order-total {
  font-weight: 600;
  color: #0f172a;
}

/* Modal */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s;
  padding: 2rem;
}

.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.modal {
  background: white;
  border-radius: 1.25rem;
  width: 100%;
  max-width: 800px;
  max-height: 90vh;
  overflow-y: auto;
  transform: scale(0.95) translateY(20px);
  transition: transform 0.3s;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
}

.modal-overlay.active .modal {
  transform: scale(1) translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem 2rem;
  border-bottom: 1px solid #e2e8f0;
  position: sticky;
  top: 0;
  background: white;
  z-index: 10;
}

.modal-title {
  font-size: 1.25rem;
  font-weight: 700;
  margin: 0;
  color: #0f172a;
}

.modal-close {
  background: #f1f5f9;
  border: none;
  font-size: 1.5rem;
  color: #64748b;
  cursor: pointer;
  padding: 0;
  line-height: 1;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.modal-close:hover {
  background: #e2e8f0;
  color: #1e293b;
}

.modal-body {
  padding: 2rem;
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 0.75rem;
  padding: 1.5rem 2rem;
  border-top: 1px solid #e2e8f0;
  position: sticky;
  bottom: 0;
  background: white;
  z-index: 10;
}

.order-detail-grid {
  display: grid;
  gap: 0.75rem;
  margin-bottom: 1.5rem;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 0.5rem 0;
  border-bottom: 1px solid #f1f5f9;
}

.detail-row.total {
  border-bottom: none;
  padding-top: 1rem;
  margin-top: 0.5rem;
  border-top: 2px solid #e2e8f0;
}

.detail-row.total .detail-value {
  font-size: 1.25rem;
  font-weight: 700;
  color: #0f172a;
}

.detail-label {
  color: #64748b;
  font-size: 0.875rem;
}

.detail-value {
  font-weight: 500;
  color: #1e293b;
}

.order-item-detail {
  background: #f8fafc;
  padding: 1.25rem;
  border-radius: 1rem;
  margin-bottom: 1rem;
  border: 1px solid #e2e8f0;
}

.item-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid #e2e8f0;
}

.item-header strong {
