---
import AdminLayout from '../../layouts/admin/AdminLayout.astro';
import StatsBar from '../../components/admin/orders/StatsBar.astro';
import OrderFilters from '../../components/admin/orders/OrderFilters.astro';
import OrderModal from '../../components/admin/orders/OrderModal.astro';
import NewOrderModal from '../../components/admin/orders/NewOrderModal.astro';
---

<AdminLayout title="Bestellingen">

  <!-- Page Header -->
  <div class="page-header">
    <div class="header-left">
      <h1 class="page-title">Bestellingen</h1>
      <p class="page-subtitle">Beheer alle bestellingen</p>
    </div>
    <div class="header-actions">
      <button class="btn btn-secondary" id="exportBtn">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        Exporteren
      </button>
      <button class="btn btn-primary" id="newOrderBtn">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="12" y1="5" x2="12" y2="19"/>
          <line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Nieuwe Bestelling
      </button>
    </div>
  </div>

  <!-- Stats -->
  <div class="stats-section">
    <StatsBar total={0} pending={0} approved={0} completed={0} cancelled={0} />
  </div>

  <!-- Filters -->
  <div class="filters-section">
    <OrderFilters />
  </div>

  <!-- Orders Table -->
  <div class="orders-table-wrap">
    <table class="orders-table" id="ordersTable">
      <thead>
        <tr>
          <th class="sortable" data-sort="id">
            <div class="th-inner">
              #
              <svg class="sort-icon" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
            </div>
          </th>
          <th class="sortable" data-sort="date">
            <div class="th-inner">
              Datum
              <svg class="sort-icon" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
            </div>
          </th>
          <th>Klant</th>
          <th>Product</th>
          <th class="sortable" data-sort="total">
            <div class="th-inner">
              Totaal
              <svg class="sort-icon" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
            </div>
          </th>
          <th>Status</th>
          <th style="text-align:right">Acties</th>
        </tr>
      </thead>
      <tbody id="ordersTbody">
        <!-- Filled by JS -->
      </tbody>
    </table>

    <!-- Empty state -->
    <div class="table-empty" id="tableEmpty" style="display:none">
      <div class="empty-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
          <rect x="9" y="3" width="6" height="4" rx="1"/>
        </svg>
      </div>
      <p class="empty-title">Geen bestellingen</p>
      <p class="empty-sub">Bestellingen verschijnen hier wanneer klanten bestellen.</p>
    </div>

    <!-- Pagination -->
    <div class="pagination-bar" id="paginationBar">
      <span class="pagination-info" id="paginationInfo"></span>
      <div class="pagination-controls" id="paginationControls"></div>
    </div>
  </div>

  <!-- Modals -->
  <OrderModal />
  <NewOrderModal />

</AdminLayout>

<style>
  /* Page layout — scoped to static HTML elements */
  .page-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1.5rem; gap:1rem; flex-wrap:wrap; }
  .header-left { display:flex; flex-direction:column; gap:0.25rem; }
  .page-title { margin:0; font-size:1.375rem; font-weight:700; color:#0f172a; line-height:1.2; }
  .page-subtitle { margin:0; font-size:0.875rem; color:#64748b; }
  .header-actions { display:flex; gap:0.625rem; align-items:center; flex-shrink:0; }
  .stats-section { margin-bottom:1rem; }
  .filters-section { margin-bottom:1.25rem; }
  /* Buttons used in static HTML */
  .btn { display:inline-flex; align-items:center; gap:0.375rem; padding:0.5rem 1rem; border-radius:0.5rem; font-size:0.875rem; font-weight:600; cursor:pointer; border:none; transition:all 0.15s; white-space:nowrap; }
  .btn-primary { background:#E8788A; color:white; }
  .btn-primary:hover { background:#d66b7a; transform:translateY(-1px); box-shadow:0 4px 12px rgba(232,120,138,0.35); }
  .btn-secondary { background:white; color:#334155; border:1px solid #e2e8f0; }
  .btn-secondary:hover { background:#f8fafc; border-color:#cbd5e1; }
  /* Table empty state */
  .table-empty { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:4rem 2rem; text-align:center; }
  .empty-icon { width:4rem; height:4rem; border-radius:1rem; background:#fdf2f4; display:flex; align-items:center; justify-content:center; color:#E8788A; margin-bottom:1rem; }
  .empty-title { margin:0 0 0.375rem; font-size:1rem; font-weight:600; color:#1e293b; }
  .empty-sub { margin:0; font-size:0.875rem; color:#94a3b8; }
  @media (max-width:768px) { .page-header { flex-direction:column; } }
</style>

<script>
  import { getOrders, setOrders, setCurrentOrderId, STATUS_CONFIG, renderOrderDetail } from '../../lib/orders';

  // ── Config ─────────────────────────────────────────────────────────────────
  const PER_PAGE = 20;

  // ── State ─────────────────────────────────────────────────────────────────
  let currentPage = 1;
  let sortKey: string = 'date';
  let sortDir: 'asc' | 'desc' = 'desc';
  let filterQuery = '';
  let filterStatus = '';
  let filterDate = '';

  // ── DOM refs ───────────────────────────────────────────────────────────────
  const tbody      = document.getElementById('ordersTbody')!;
  const tableEmpty = document.getElementById('tableEmpty')!;
  const table      = document.getElementById('ordersTable') as HTMLTableElement;
  const pagInfo    = document.getElementById('paginationInfo')!;
  const pagCtrls   = document.getElementById('paginationControls')!;

  // ── Fetch ─────────────────────────────────────────────────────────────────
  async function loadOrders() {
    try {
      const res = await fetch('/api/orders');
      if (!res.ok) throw new Error('Failed to load');
      const data: any[] = Array.isArray(res) ? res : await res.json();
      setOrders(data);
      // Auto-complete orders past their pickup date
      const today = new Date(); today.setHours(0, 0, 0, 0);
      for (const order of data) {
        if (order.status === 'approved' && order.pickup_date) {
          const d = new Date(order.pickup_date + 'T00:00:00');
          if (d < today) {
            await patchStatus(order.id, 'completed', true); // silent patch, no toast
          }
        }
      }
      updateStats();
      renderPage();
    } catch (e) {
      console.error('Load orders failed:', e);
    }
  }

  // ── Filter + sort ─────────────────────────────────────────────────────────
  function getFiltered(): any[] {
    const q = filterQuery.toLowerCase();
    return getOrders().filter(o => {
      if (filterStatus && o.status !== filterStatus) return false;
      if (q) {
        const name = o.customer?.name?.toLowerCase() || '';
        const email = o.customer?.email?.toLowerCase() || '';
        const id = o.id.toLowerCase();
        if (!name.includes(q) && !email.includes(q) && !id.includes(q)) return false;
      }
      if (filterDate) {
        const today = new Date(); today.setHours(0,0,0,0);
        const d = new Date((o.date || '') + 'T00:00:00');
        const startOfWeek = new Date(today); startOfWeek.setDate(today.getDate() - today.getDay());
        const startOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
        if (filterDate === 'today' && d < today) return false;
        if (filterDate === 'week' && d < startOfWeek) return false;
        if (filterDate === 'month' && d < startOfMonth) return false;
      }
      return true;
    }).sort((a, b) => {
      let av: string = '', bv: string = '';
      if (sortKey === 'id')      { av = a.id;      bv = b.id; }
      else if (sortKey === 'date') { av = a.date || ''; bv = b.date || ''; }
      else if (sortKey === 'total') { av = a.total || ''; bv = b.total || ''; }
      const cmp = av.localeCompare(bv, undefined, { numeric: true, sensitivity: 'base' });
      return sortDir === 'asc' ? cmp : -cmp;
    });
  }

  function getPaged(filtered: any[]) {
    const start = (currentPage - 1) * PER_PAGE;
    return filtered.slice(start, start + PER_PAGE);
  }

  function totalPages(filtered: number) {
    return Math.max(1, Math.ceil(filtered / PER_PAGE));
  }

  // ── Render ────────────────────────────────────────────────────────────────
  function renderPage() {
    const filtered = getFiltered();
    const paged = getPaged(filtered);

    // Sync sort indicators
    document.querySelectorAll('.orders-table th.sortable').forEach(th => {
      const key = (th as HTMLElement).dataset.sort;
      th.classList.toggle('sort-active', key === sortKey);
      th.classList.toggle('sort-asc', key === sortKey && sortDir === 'asc');
      th.classList.toggle('sort-desc', key === sortKey && sortDir === 'desc');
    });

    if (paged.length === 0) {
      table.style.display = 'none';
      tableEmpty.style.display = 'flex';
      pagInfo.innerHTML = '';
      pagCtrls.innerHTML = '';
      return;
    }

    table.style.display = '';
    tableEmpty.style.display = 'none';
    tbody.innerHTML = paged.map(renderRow).join('');
    renderPagination(filtered.length);
  }

  function renderRow(order: any): string {
    const c = order.customer || {};
    const name = c.name || 'Onbekend';
    const first = order.items?.[0];
    const sc = STATUS_CONFIG[order.status] || STATUS_CONFIG.pending;

    return `
      <tr data-order-id="${order.id}" data-status="${order.status}">
        <td class="td-id">#${order.id}</td>
        <td class="td-date">${order.date || '—'}</td>
        <td>
          <div class="td-customer">
            <div class="td-avatar">${name.charAt(0).toUpperCase()}</div>
            <div class="td-customer-info">
              <span class="td-customer-name">${escHtml(name)}</span>
              <span class="td-customer-email">${escHtml(c.email || '—')}</span>
            </div>
          </div>
        </td>
        <td class="td-product">
          <span class="td-product-name">${first?.product || '—'}</span>
          ${first?.event ? `<span class="td-product-event">${escHtml(first.event)}</span>` : ''}
        </td>
        <td class="td-total">${order.total || '—'}</td>
        <td class="td-status">
          <span class="status-badge" style="background:${sc.bg};color:${sc.color}">
            <span class="status-dot" style="background:${sc.dot}"></span>
            ${sc.label}
          </span>
        </td>
        <td class="td-actions">
          <div class="row-actions">
            <button class="btn-icon" data-action="view" data-order-id="${order.id}" title="Bekijk">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
            ${order.status === 'pending' ? `
              <button class="btn-icon btn-approve" data-action="approve" data-order-id="${order.id}" title="Goedkeur">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              </button>
              <button class="btn-icon btn-cancel" data-action="cancel" data-order-id="${order.id}" title="Annuleer">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>` : ''}
            ${order.status === 'approved' ? `
              <button class="btn-icon btn-complete" data-action="complete" data-order-id="${order.id}" title="Voltooid">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
              </button>` : ''}
          </div>
        </td>
      </tr>`;
  }

  function escHtml(s: string): string {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  // ── Pagination ────────────────────────────────────────────────────────────
  function renderPagination(total: number) {
    const tp = totalPages(total);
    const start = (currentPage - 1) * PER_PAGE + 1;
    const end = Math.min(currentPage * PER_PAGE, total);

    pagInfo.innerHTML = total === 0
      ? ''
      : `<strong>${start}–${end}</strong> van <strong>${total}</strong> bestellingen`;

    const pages: (number|'...')[] = [];
    if (tp <= 7) {
      for (let i = 1; i <= tp; i++) pages.push(i);
    } else {
      pages.push(1);
      if (currentPage > 3) pages.push('...');
      for (let i = Math.max(2, currentPage - 1); i <= Math.min(tp - 1, currentPage + 1); i++) pages.push(i);
      if (currentPage < tp - 2) pages.push('...');
      pages.push(tp);
    }

    const btn = (n: number, label?: string, disabled = false, active = false) =>
      `<button class="pagination-btn${active?' active':''}" ${disabled?'disabled':''} data-page="${n}">${label || String(n)}</button>`;

    let html = btn(currentPage - 1, '‹', currentPage <= 1);
    pages.forEach(p => {
      if (p === '...') html += `<span class="pagination-ellipsis">…</span>`;
      else html += btn(p, undefined, false, p === currentPage);
    });
    html += btn(currentPage + 1, '›', currentPage >= tp);

    pagCtrls.innerHTML = html;
  }

  // ── Stats ─────────────────────────────────────────────────────────────────
  function updateStats() {
    const orders = getOrders();
    const counts = { total: 0, pending: 0, approved: 0, completed: 0, cancelled: 0 };
    orders.forEach(o => {
      if (o.status === 'pending') counts.pending++;
      else if (o.status === 'approved') counts.approved++;
      else if (o.status === 'completed') counts.completed++;
      else if (o.status === 'cancelled') counts.cancelled++;
    });
    counts.total = orders.length;
    const vals = document.querySelectorAll('.pill-value');
    if (vals[0]) vals[0].textContent = String(counts.total);
    if (vals[1]) vals[1].textContent = String(counts.pending);
    if (vals[2]) vals[2].textContent = String(counts.approved);
    if (vals[3]) vals[3].textContent = String(counts.completed);
    if (vals[4]) vals[4].textContent = String(counts.cancelled);
  }

  // ── Modal helpers ─────────────────────────────────────────────────────────
  function openModal(orderId: string) {
    const order = getOrders().find((o: any) => o.id === orderId);
    if (!order) return;
    setCurrentOrderId(orderId);
    const subtitle = document.getElementById('modalOrderId');
    if (subtitle) {
      const d = order.date ? new Date(order.date + 'T00:00:00') : null;
      if (d && !isNaN(d.getTime())) {
        const formatted = d.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
        subtitle.textContent = `#${order.id} · Ophaaldatum: ${formatted}`;
      } else if (order.createdAt) {
        // Fallback to createdAt when pickup date is empty
        const created = new Date(order.createdAt);
        const createdStr = created.toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' });
        subtitle.textContent = `#${order.id} · Geplaatst: ${createdStr}`;
      } else {
        subtitle.textContent = `#${order.id}`;
      }
    }
    const badge = document.getElementById('modalStatusBadge');
    if (badge) {
      const sc = (window as any).STATUS_CONFIG?.[order.status] || (window as any).STATUS_CONFIG?.pending;
      if (sc) {
        const hexToRgba = (hex: string, alpha: number) => {
          const r = parseInt(hex.slice(1,3), 16);
          const g = parseInt(hex.slice(3,5), 16);
          const b = parseInt(hex.slice(5,7), 16);
          return `rgba(${r}, ${g}, ${b}, ${alpha})`;
        };
        badge.innerHTML = `<span class="dot" style="background:${sc.dot}"></span>${sc.label}`;
        badge.style.background = hexToRgba(sc.bg, 0.25);
        badge.style.color = sc.color;
        badge.style.borderColor = hexToRgba(sc.color, 0.4);
      } else {
        badge.textContent = order.status;
      }
    }
    const body = document.getElementById('orderModalBody');
    if (body) body.innerHTML = renderOrderDetail(order);
    document.getElementById('orderModal')?.classList.add('active');
  }

  function closeModal() {
    document.getElementById('orderModal')?.classList.remove('active');
    const badge = document.getElementById('modalStatusBadge');
    if (badge) { badge.textContent = ''; badge.style.background = ''; badge.style.color = ''; badge.style.borderColor = ''; }
    setCurrentOrderId(null);
  }

  async function patchStatus(orderId: string, status: string, silent = false) {
    try {
      await fetch('/api/orders', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId, status }),
      });
      const orders = getOrders();
      const o = orders.find((x: any) => x.id === orderId);
      if (o) (o as any).status = status;
      renderPage();
      updateStats();
    } catch (e) {
      if (!silent) console.error('Status update failed:', e);
    }
  }

  // ── Event delegation ───────────────────────────────────────────────────────
  document.addEventListener('click', e => {
    const btn = (e.target as Element).closest('[data-action]') as HTMLElement | null;
    if (!btn) return;
    const action = btn.dataset.action;
    const orderId = btn.dataset.orderId;

    if (action === 'view' && orderId) openModal(orderId);
    else if (action === 'approve' && orderId) patchStatus(orderId, 'approved');
    else if (action === 'cancel' && orderId) {
      if (confirm('Deze bestelling annuleren?')) patchStatus(orderId, 'cancelled');
    }
    else if (action === 'complete' && orderId) patchStatus(orderId, 'completed');
  });

  // Table row click → open modal
  tbody.addEventListener('click', e => {
    const row = (e.target as Element).closest('tr');
    if (!row) return;
    if ((e.target as Element).closest('[data-action]')) return; // let buttons handle
    const orderId = (row as HTMLElement).dataset.orderId;
    if (orderId) openModal(orderId);
  });

  // Sort headers
  document.querySelectorAll('.orders-table th.sortable').forEach(th => {
    th.addEventListener('click', () => {
      const key = (th as HTMLElement).dataset.sort!;
      if (sortKey === key) sortDir = sortDir === 'asc' ? 'desc' : 'asc';
      else { sortKey = key; sortDir = 'asc'; }
      currentPage = 1;
      renderPage();
    });
  });

  // Pagination
  pagCtrls.addEventListener('click', e => {
    const btn = (e.target as Element).closest('[data-page]') as HTMLElement | null;
    if (!btn || btn.disabled) return;
    const p = parseInt(btn.dataset.page!, 10);
    if (!isNaN(p)) { currentPage = p; renderPage(); }
  });

  // Filters
  document.getElementById('searchInput')?.addEventListener('input', e => {
    filterQuery = (e.target as HTMLInputElement).value;
    currentPage = 1;
    renderPage();
    const clearBtn = document.getElementById('searchClearBtn') as HTMLButtonElement | null;
    if (clearBtn) clearBtn.style.display = filterQuery ? '' : 'none';
  });

  document.getElementById('statusFilter')?.addEventListener('change', e => {
    filterStatus = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    renderPage();
  });

  document.getElementById('dateFilter')?.addEventListener('change', e => {
    filterDate = (e.target as HTMLSelectElement).value;
    currentPage = 1;
    renderPage();
  });

  document.getElementById('searchClearBtn')?.addEventListener('click', () => {
    const inp = document.getElementById('searchInput') as HTMLInputElement;
    if (inp) { inp.value = ''; filterQuery = ''; renderPage(); }
  });

  // Update status from modal
  document.getElementById('updateStatusBtn')?.addEventListener('click', async () => {
    const sel = document.getElementById('orderStatusAction') as HTMLSelectElement;
    const id = sel?.value;
    const { getCurrentOrderId } = await import('../../lib/orders');
    const orderId = getCurrentOrderId();
    if (id && orderId) {
      await patchStatus(orderId, id);
      closeModal();
    }
  });

  // Modal close
  document.getElementById('closeOrderModalBtn')?.addEventListener('click', closeModal);
  document.getElementById('closeOrderModalBtn2')?.addEventListener('click', closeModal);
  document.getElementById('orderModal')?.addEventListener('click', e => {
    if ((e.target as Element).classList.contains('modal-overlay')) closeModal();
  });

  // New order modal
  document.getElementById('newOrderBtn')?.addEventListener('click', () => {
    document.getElementById('new-order-form')?.reset();
    document.getElementById('new-order-modal')?.classList.add('active');
  });
  document.getElementById('closeNewOrderModalBtn')?.addEventListener('click', () =>
    document.getElementById('new-order-modal')?.classList.remove('active'));
  document.getElementById('closeNewOrderModalBtn2')?.addEventListener('click', () =>
    document.getElementById('new-order-modal')?.classList.remove('active'));
  document.getElementById('new-order-modal')?.addEventListener('click', e => {
    if ((e.target as Element).classList.contains('modal-overlay'))
      document.getElementById('new-order-modal')?.classList.remove('active');
  });

  document.getElementById('submitNewOrderBtn')?.addEventListener('click', async () => {
    const fd = new FormData(document.getElementById('new-order-form') as HTMLFormElement);
    const get = (n: string) => String(fd.get(n) || '').trim();
    const name = get('name'), email = get('email'), phone = get('phone');
    const product = get('product'), event = get('event');
    const persons = get('persons'), flavor = get('flavor');
    const priceStr = get('price'), allergies = get('allergies');
    if (!name && !email && !phone) { alert('Vul minstens naam, e-mail of telefoon in.'); return; }
    const date = get('date');
    const items = product ? [{ product, event, persons, flavor, allergies, price: priceStr ? parseFloat(priceStr) : 0 }] : [];
    const total = priceStr ? `€${parseFloat(priceStr).toFixed(2)}` : '€0,00';
    if (!date) { alert('Kies een ophaaldatum.'); return; }
    try {
      const res = await fetch('/api/orders', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ date, customer: { name, email, phone }, items, total, isAdmin: true }),
      });
      if (!res.ok) { const err = await res.json(); alert(err.error || 'Aanmaak mislukt.'); return; }
      document.getElementById('new-order-modal')?.classList.remove('active');
      await loadOrders();
    } catch { alert('Aanmaak mislukt.'); }
  });

  // ── Boot ──────────────────────────────────────────────────────────────────
  loadOrders();
</script>
