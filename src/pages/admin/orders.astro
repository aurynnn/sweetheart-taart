}

.order-card .order-date {
  font-size: 0.6875rem;
  color: #94a3b8;
}

.order-status-badge {
  display: inline-block;
  padding: 0.2rem 0.625rem;
  border-radius: 9999px;
  font-size: 0.6875rem;
  font-weight: 600;
  white-space: nowrap;
}

.order-card-body {
  padding: 0.5rem 0.875rem 0.625rem;
  border-top: 1px solid #f1f5f9;
  flex: 1;
}

.order-customer {
  display: flex;
  flex-direction: column;
  gap: 0.0625rem;
  margin-bottom: 0.5rem;
}

.order-customer strong {
  font-size: 0.875rem;
  color: #1e293b;
}

.order-customer span {
  font-size: 0.75rem;
  color: #64748b;
}

.order-products {
  margin-bottom: 0.375rem;
}

.product-main {
  font-size: 0.8125rem;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 0.0625rem;
}

.product-event {
  font-size: 0.75rem;
  color: #db2777;
  font-weight: 500;
}

.product-more {
  font-size: 0.6875rem;
  color: #64748b;
  margin-top: 0.0625rem;
}

.order-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem;
}

.order-meta span {
  font-size: 0.6875rem;
  color: #475569;
  background: #f8fafc;
  padding: 0.125rem 0.4375rem;
  border-radius: 0.25rem;
}

.order-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.5rem 0.875rem;
  border-top: 1px solid #f1f5f9;
  background: #f8fafc;
}

.order-total {
  font-size: 1rem;
  font-weight: 700;
  color: #1e293b;
}

.order-actions {
  display: flex;
  gap: 0.375rem;
  align-items: center;
}

.order-actions .btn {
  padding: 0.3125rem 0.625rem;
  font-size: 0.75rem;
}

/* Wide Modal */
.modal-wide {
  max-width: 680px;
}

/* Empty state */
.empty-state {
  grid-column: 1 / -1;
  text-align: center;
  padding: 4rem 2rem;
  color: #64748b;
}

.empty-state p {
  font-size: 1rem;
  margin: 0;
}

@media (max-width: 768px) {
  .orders-grid {
    grid-template-columns: 1fr;
  }
}
