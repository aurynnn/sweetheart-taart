  align-items: center;
  gap: 0.5rem;
  padding-bottom: 0.75rem;
  border-bottom: 2px solid #f1f5f9;
}

.order-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.75rem 2rem;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  padding: 0.5rem 0;
  border-bottom: 1px solid #f8fafc;
}

.detail-row.full-width {
  grid-column: 1 / -1;
  flex-direction: column;
  gap: 0.25rem;
  background: #fef9c3;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  margin-top: 0.5rem;
}

.detail-label {
  color: #64748b;
  font-size: 0.875rem;
}

.detail-value {
  font-weight: 600;
  color: #1e293b;
  font-size: 0.875rem;
  text-align: right;
}

.detail-value.notes {
  text-align: left;
  font-style: italic;
  background: none;
  padding: 0;
  font-weight: 400;
}

.status-pending { color: #92400e; }
.status-approved { color: #1e40af; }
.status-completed { color: #166534; }
.status-cancelled { color: #991b1b; }

.order-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 1.5rem;
  background: linear-gradient(135deg, #E8788A, #d66b7a);
  color: white;
  border-radius: 1rem;
  margin-top: 1.5rem;
  box-shadow: 0 4px 12px rgba(232, 120, 138, 0.3);
}

.order-total-row span:first-child {
  font-weight: 600;
  font-size: 1rem;
}

.total-price {
  font-size: 1.5rem;
  font-weight: 700;
}

.modal-body h4 {
  margin: 0 0 0.75rem 0;
  font-size: 0.875rem;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.action-select {
  padding: 0.5rem 0.75rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  background: white;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 1rem;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s;
  cursor: pointer;
  border: none;
}

.btn-sm {
  padding: 0.375rem 0.75rem;
  font-size: 0.75rem;
}

.btn-primary {
  background: #e11d48;
  color: white;
}

.btn-primary:hover {
  background: #be123c;
}

.btn-secondary {
  background: #f1f5f9;
  color: #334155;
}

.btn-secondary:hover {
  background: #e2e8f0;
}

.btn-approve {
  background: #22c55e;
  color: white;
}

.btn-approve:hover {
