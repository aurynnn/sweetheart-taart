  letter-spacing: 0.05em;
  color: #94a3b8;
  font-weight: 600;
}

.item-field span {
  font-size: 0.9375rem;
  color: #1e293b;
  font-weight: 500;
}

.item-field.allergy {
  background: #fef2f2;
  padding: 0.5rem 0.75rem;
  border-radius: 0.5rem;
  margin: -0.25rem;
}

.item-field.allergy span {
  color: #dc2626;
  font-weight: 600;
}

.order-detail-section {
  margin-bottom: 2rem;
}

.order-detail-section:last-child {
  margin-bottom: 0;
}

.order-detail-section h4 {
  margin: 0 0 1rem 0;
  font-size: 1rem;
  font-weight: 600;
  color: #0f172a;
