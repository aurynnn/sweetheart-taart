---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import CollectionCard from '../components/CollectionCard.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import SprinkleField from '../components/SprinkleField.astro';

import collectionsData from '../data/collections.json';
import testimonialsData from '../data/testimonials.json';

const collections = collectionsData.collections.filter(c => c.id !== 'vaste-collectie' && c.id !== 'afternoon-tea');
const testimonials = testimonialsData.testimonials;

const customerPhotos: Record<string, string> = {
  'Sofie Missiaen': '/images/mini-collectie/sofie.jpg',
  'Vanessa Anaïs Verkempynck': '/images/mini-collectie/vanessa.jpg',
};

const occasions = ['Verjaardag', 'Communie', 'Huwelijk', 'Doopsel', 'Baby shower', 'Jubileum', 'Lentefeest', 'Gewoon omdat het kan'];

const steps = [
  {
    title: 'Kies je lekkers',
    text: 'Feesttaart, koekjes of mini-gebak — combineer gerust. Kies gelegenheid, aantal personen en smaak.',
    icon: 'fa-cake-candles',
    image: '/images/trouwtaart.png',
  },
  {
    title: 'Maak het persoonlijk',
    text: 'Een thema, een naam, een figuurtje of een allergie? Vertel het ons, alles kan op maat.',
    icon: 'fa-wand-magic-sparkles',
    image: '/images/koekjes.png',
  },
  {
    title: 'Prik een datum',
    text: 'De kalender toont live welke dagen nog vrij zijn. Kies je dag en ophaalmoment.',
    icon: 'fa-calendar-check',
    image: '/images/cupcakes.png',
  },
  {
    title: 'Nathalie bevestigt',
    text: 'Je krijgt snel een bevestiging met de definitieve prijs. Daarna is het aftellen tot het feest!',
    icon: 'fa-heart',
    image: '/images/nathalie-e1542633374448.jpg',
  },
];
---

<Layout title="Home">
  <Header />

  <main id="home-main">
    <Hero id="home-hero" />

    <!-- Occasions marquee — speeds up with scroll velocity -->
    <section id="home-marquee" class="marquee" aria-label="Gelegenheden">
      <div class="marquee-track" data-marquee data-marquee-duration="40">
        {occasions.map((o) => (
          <span class="marquee-item" data-marquee-item>{o}<i class="fa-solid fa-heart" aria-hidden="true"></i></span>
        ))}
      </div>
    </section>

    <!-- Introduction Section -->
    <section id="home-intro" class="section intro">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div id="home-intro-text">
            <span class="eyebrow animate-on-scroll">Even voorstellen</span>
            <h2 id="home-intro-title" class="font-heading text-4xl md:text-5xl lg:text-6xl font-semibold text-[var(--color-text)] mb-6" data-split>
              Hoi! Mijn naam is Nathalie
            </h2>
            <div id="home-intro-content" class="space-y-4 text-[var(--color-text-muted)] leading-relaxed text-lg">
              <p class="animate-on-scroll stagger-1">
                Mijn passie… bakken. Steeds weer vind ik het magisch hoe je met een paar simpele ingrediënten, de lekkerste taarten uit de oven kan toveren.
              </p>
              <p class="animate-on-scroll stagger-2">
                Vandaar dat ik enkele jaren terug besloot om daar ook effectief iets mee te gaan doen. Zo maakte ons tuinhuis net voor de zomer van 2018 plaats voor een bakatelier waar ik me naar hartelust kan uitleven.
              </p>
              <p class="animate-on-scroll stagger-3">
                Ik werk met kwaliteitsvolle ingrediënten zoals speltbloem en bio-eitjes, en hou rekening met allergieën en dieetwensen. Lactose-intolerantie of glutenallergie? Geen probleem!
              </p>
            </div>

            <dl class="stats animate-on-scroll stagger-4">
              <div><dt>Bakatelier sinds</dt><dd data-counter="2018" data-counter-from="2000">2018</dd></div>
              <div><dt>Handgemaakt</dt><dd data-counter="100" data-counter-suffix="%">100%</dd></div>
              <div><dt>Collecties</dt><dd data-counter={collections.length}>{collections.length}</dd></div>
            </dl>
          </div>

          <div class="intro-visual">
            <div class="intro-frame" data-unveil>
              <img
                src="/images/nathalie-e1542633374448.jpg"
                alt="Nathalie in haar bakatelier"
                id="home-intro-img"
                class="intro-img"
                data-parallax="0.12"
                loading="lazy"
              />
            </div>
            <div class="intro-badge" data-parallax="-0.35" aria-hidden="true">
              <i class="fa-solid fa-heart"></i>
              <span>met liefde<br />gebakken</span>
            </div>
            <div class="intro-blob" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Collections Grid -->
    <section id="home-collections" class="section collections bg-[var(--color-surface)]">
      <div class="container">
        <div id="home-collections-header" class="text-center mb-14">
          <span class="eyebrow animate-on-scroll">Ontdek</span>
          <h2 id="home-collections-title" class="section-title" data-split>de collecties</h2>
          <p id="home-collections-subtitle" class="section-subtitle mx-auto animate-on-scroll stagger-1">
            Ontdek onze heerlijke selectie van taarten, koekjes en gebak, elk met dezelfde liefde en zorg gemaakt.
          </p>
        </div>

        <div id="home-collections-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
          {collections.slice(0, 3).map((collection, index) => (
            <div id={`home-collection-card-${collection.id}`} class={`animate-on-scroll stagger-${index + 1} flex`}>
              <div class="tilt-wrap" data-tilt="7">
                <CollectionCard
                  title={collection.title}
                  description={collection.description}
                  href={collection.href}
                  badge={collection.badge}
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works — pinned scroll story over the 3D sprinkle field -->
    <section id="home-steps" class="steps grain" data-scroll-steps aria-labelledby="home-steps-title">
      <div class="steps-pin" data-step-pin>
        <SprinkleField cupcakes={7} hearts={22} seed={3} mask="left" />
        <div class="container steps-inner">
          <div class="steps-copy">
            <span class="eyebrow eyebrow-light">Zo werkt het</span>
            <h2 id="home-steps-title" class="steps-title" data-split>Van idee tot taart in 4 stappen</h2>

            <div class="steps-listwrap">
            <div class="steps-rail" aria-hidden="true"><div class="steps-fill" data-step-fill></div></div>
            <ol class="steps-list">
              {steps.map((s, i) => (
                <li class="step" data-step>
                  <span class="step-dot" data-step-dot><i class={`fa-solid ${s.icon}`} aria-hidden="true"></i></span>
                  <div>
                    <h3>{i + 1}. {s.title}</h3>
                    <p>{s.text}</p>
                  </div>
                </li>
              ))}
            </ol>
            </div>

            <a href="/aanvraag" class="btn steps-cta btn-shine" data-magnetic="0.2">
              Start je aanvraag <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
          </div>

          <div class="steps-visual" aria-hidden="true">
            {steps.map((s, i) => (
              <figure class="step-card" data-step-visual>
                <img src={s.image} alt="" loading="lazy" />
                <figcaption><span>{i + 1}</span>{s.title}</figcaption>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section id="home-testimonials" class="section bg-grain">
      <div class="container">
        <div id="home-testimonials-header" class="text-center mb-12">
          <span id="home-testimonials-label" class="eyebrow animate-on-scroll">Tevreden klanten</span>
          <h2 id="home-testimonials-title" class="section-title" data-split>Wat onze klanten zeggen</h2>
        </div>

        <div id="home-testimonials-grid" class="grid md:grid-cols-3 gap-8 items-start">
          {testimonials.map((testimonial, index) => (
            <div id={`home-testimonial-${index + 1}`} class={`animate-on-scroll stagger-${index + 1}`} data-parallax={index === 1 ? '0.08' : undefined}>
              <TestimonialCard
                quote={testimonial.quote}
                author={testimonial.author}
                role={testimonial.role}
                authorImage={customerPhotos[testimonial.author]}
              />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Info Section -->
    <section id="home-info" class="section bg-[var(--color-surface)]">
      <div class="container">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
          <!-- Opening Hours -->
          <div id="home-opening-hours" class="animate-on-scroll">
            <div id="home-opening-hours-card" class="card p-8 h-full">
              <div id="home-opening-hours-header" class="flex items-start gap-4 mb-6">
                <div id="home-opening-hours-icon" class="info-icon w-12 h-12 rounded-lg bg-[var(--color-secondary)] flex items-center justify-center flex-shrink-0">
                  <svg id="home-opening-hours-icon-svg" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[var(--color-primary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <h3 id="home-opening-hours-title" class="font-heading text-xl font-semibold text-[var(--color-text)] mb-2">Openingsuren</h3>
                  <p id="home-opening-hours-subtitle" class="text-sm text-[var(--color-text-muted)]">
                    Kom langs om jouw taart te bespreken
                  </p>
                </div>
              </div>

              <div id="home-opening-hours-details" class="space-y-3">
                <div id="home-opening-hours-row" class="flex justify-between items-center py-2 border-b border-[var(--color-border-light)]">
                  <span id="home-opening-hours-day" class="text-[var(--color-text)]">Donderdag</span>
                  <span id="home-opening-hours-time" class="font-medium text-[var(--color-primary)]">17u - 20u</span>
                </div>
                <p id="home-opening-hours-note" class="text-sm text-[var(--color-text-muted)] italic">
                  * Niet tijdens schoolvakanties
                </p>
                <p id="home-opening-hours-extra" class="text-sm text-[var(--color-text-muted)]">
                  Andere momenten zijn mogelijk op afspraak. Mail of bel gerust!
                </p>
              </div>
            </div>
          </div>

          <!-- Allergies Info -->
          <div id="home-allergies" class="animate-on-scroll stagger-2">
            <div id="home-allergies-card" class="card p-8 h-full">
              <div id="home-allergies-header" class="flex items-start gap-4 mb-6">
                <div id="home-allergies-icon" class="info-icon w-12 h-12 rounded-lg bg-[var(--color-accent)]/10 flex items-center justify-center flex-shrink-0">
                  <svg id="home-allergies-icon-svg" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
                  </svg>
                </div>
                <div>
                  <h3 id="home-allergies-title" class="font-heading text-xl font-semibold text-[var(--color-text)] mb-2">Allergieën? Geen probleem!</h3>
                  <p id="home-allergies-subtitle" class="text-sm text-[var(--color-text-muted)]">
                    We denken graag mee
                  </p>
                </div>
              </div>

              <p id="home-allergies-text" class="text-[var(--color-text-muted)] leading-relaxed">
                Ik heb ervaring met het aanpassen van recepten voor diverse dieetwensen en allergieën. Lactose-intolerantie, glutenallergie, diabetes... neem gerust contact op om de mogelijkheden te bespreken.
              </p>

              <ul id="home-allergies-list" class="mt-4 space-y-2">
                {['Lactose-intolerantie', 'Glutenallergie', 'Diabetes'].map((item, i) => (
                  <li id={`home-allergies-item-${i + 1}`} class="flex items-center gap-2 text-sm text-[var(--color-text-muted)]">
                    <svg id={`home-allergies-check-${i + 1}`} xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[var(--color-accent)]" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ContactCTA id="home-contact-cta" />
  </main>

  <Footer id="home-footer" />
</Layout>

<style>
  .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.9rem;
  }
  .eyebrow-light { color: #fff; opacity: 0.9; }

  /* Marquee */
  .marquee {
    overflow: hidden;
    background: var(--color-primary);
    color: white;
    padding: 1.1rem 0;
    transform: rotate(-1.2deg) scale(1.02);
    margin: -1.5rem 0 0;
    position: relative;
    z-index: 5;
    box-shadow: 0 20px 40px -20px rgba(212, 90, 106, 0.6);
  }
  .marquee-track { display: flex; width: max-content; will-change: transform; }
  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 700;
    white-space: nowrap;
  }
  .marquee-item i { font-size: 0.9rem; opacity: 0.8; }

  /* Intro */
  .intro { overflow: hidden; }
  .intro-visual { position: relative; }
  .intro-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 40px 80px -30px rgba(74, 58, 61, 0.45);
    z-index: 1;
  }
  .intro-img { width: 100%; height: 118%; object-fit: cover; margin-top: -9%; }
  .intro-badge {
    position: absolute;
    left: -1.5rem;
    bottom: 12%;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 40px -16px rgba(212, 90, 106, 0.5);
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: 1.05;
    color: var(--color-text);
  }
  .intro-badge i { color: var(--color-primary); font-size: 1.5rem; animation: beat 1.6s ease-in-out infinite; }
  @keyframes beat { 0%, 100% { transform: scale(1); } 15% { transform: scale(1.25); } 30% { transform: scale(1); } 45% { transform: scale(1.15); } }
  .intro-blob {
    position: absolute;
    inset: 8% -8% -6% 12%;
    border-radius: 42% 58% 60% 40% / 45% 40% 60% 55%;
    background: linear-gradient(135deg, #FDEEF0, #F2A0AA);
    filter: blur(2px);
    animation: morph 14s ease-in-out infinite;
  }
  @keyframes morph {
    0%, 100% { border-radius: 42% 58% 60% 40% / 45% 40% 60% 55%; transform: rotate(0deg); }
    50% { border-radius: 58% 42% 40% 60% / 55% 60% 40% 45%; transform: rotate(8deg); }
  }

  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin: 2.5rem 0 0; }
  .stats div { padding: 1rem; border-radius: 1rem; background: var(--color-secondary); text-align: center; }
  .stats dt { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
  .stats dd { margin: 0.2rem 0 0; font-family: var(--font-heading); font-size: 2.4rem; font-weight: 700; color: var(--color-primary-dark); line-height: 1; font-variant-numeric: tabular-nums; }

  /* Collections */
  .tilt-wrap { display: flex; width: 100%; border-radius: var(--radius-xl); }
  .tilt-wrap :global(.card) { width: 100%; }
  .tilt-wrap :global(.card:hover) { transform: none; box-shadow: 0 30px 60px -25px rgba(212, 90, 106, 0.45); }

  /* Steps (scrollytelling) */
  .steps {
    position: relative;
    color: white;
    background:
      radial-gradient(70% 60% at 80% 20%, rgba(255, 214, 165, 0.35), transparent 60%),
      radial-gradient(60% 70% at 10% 90%, rgba(205, 180, 245, 0.35), transparent 60%),
      linear-gradient(160deg, #E8788A 0%, #D45A6A 55%, #b8475a 100%);
    overflow: hidden;
  }
  .steps-pin { position: relative; min-height: 100vh; display: flex; align-items: center; padding: 6rem 0; }
  .steps-inner { position: relative; z-index: 2; display: grid; grid-template-columns: 1.05fr 1fr; gap: 4rem; align-items: center; }
  .steps-title {
    font-family: var(--font-heading);
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.05;
    margin: 0 0 2.5rem;
    color: #fff !important;
  }
  .steps-listwrap { position: relative; margin: 0 0 2.5rem; }
  .steps-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.6rem; }
  .steps-rail { position: absolute; left: 1.35rem; top: 1rem; bottom: 1rem; width: 2px; background: rgba(255, 255, 255, 0.25); border-radius: 2px; }
  .steps-fill { height: 100%; background: white; transform-origin: top; transform: scaleY(0); box-shadow: 0 0 12px white; }
  .step { position: relative; display: flex; gap: 1.25rem; align-items: flex-start; opacity: 0.45; transition: opacity 500ms ease, transform 500ms var(--ease-out-expo); }
  .step.is-active { opacity: 1; transform: translateX(6px); }
  .step-dot {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.15);
    border: 2px solid rgba(255, 255, 255, 0.5);
    transition: all 500ms var(--ease-spring);
    z-index: 1;
  }
  .step-dot:global(.is-active) { background: white; color: var(--color-primary-dark); border-color: white; transform: scale(1.1); box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.15); }
  .step h3 { font-family: var(--font-body); font-size: 1.15rem; font-weight: 800; margin: 0.35rem 0 0.25rem; color: #fff !important; }
  .step p { margin: 0; color: rgba(255, 255, 255, 0.85); line-height: 1.6; }
  .steps-cta { background: white; color: var(--color-primary-dark) !important; border-radius: 999px; padding: 1rem 1.9rem; box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.35); }
  .steps-cta:hover { transform: translateY(-2px); }

  .steps-visual { position: relative; aspect-ratio: 4 / 5; max-height: 72vh; justify-self: center; width: 100%; max-width: 30rem; }
  .step-card {
    position: absolute;
    inset: 0;
    margin: 0;
    border-radius: 1.75rem;
    overflow: hidden;
    background: white;
    box-shadow: 0 50px 100px -40px rgba(60, 10, 20, 0.6);
    opacity: 0;
    transform: translateY(40px) rotate(4deg) scale(0.92);
    transition: opacity 700ms var(--ease-out-expo), transform 900ms var(--ease-out-expo);
  }
  .step-card:global(.is-active) { opacity: 1; transform: none; }
  .step-card img { width: 100%; height: 100%; object-fit: cover; }
  .step-card figcaption {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(10px);
    color: var(--color-text);
    font-weight: 800;
  }
  .step-card figcaption span { width: 2rem; height: 2rem; border-radius: 50%; display: grid; place-items: center; background: var(--color-primary); color: white; }

  .info-icon { transition: transform 500ms var(--ease-spring); }
  .card:hover .info-icon { transform: rotate(-8deg) scale(1.1); }

  #home-steps h2, #home-steps h3 { text-shadow: none !important; }

  @media (max-width: 1023px) {
    .steps-inner { grid-template-columns: 1fr; gap: 3rem; }
    .steps-visual { display: none; }
    .step { opacity: 1; }
  }
  @media (max-width: 640px) {
    .intro-badge { left: 0.5rem; }
    .stats dd { font-size: 1.9rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro-blob, .intro-badge i { animation: none; }
  }
</style>
