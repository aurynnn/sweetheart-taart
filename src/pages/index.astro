---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Marquee from '../components/ui/Marquee.astro';
import HomeIntro from '../components/home/HomeIntro.astro';
import HomeCollections from '../components/home/HomeCollections.astro';
import HomeSteps from '../components/home/HomeSteps.astro';
import HomeTestimonials from '../components/home/HomeTestimonials.astro';
import HomeInfo from '../components/home/HomeInfo.astro';

import collectionsData from '../data/collections.json';
import { OCCASIONS } from '../data/home';

const collections = collectionsData.collections
  .filter((c) => c.id !== 'vaste-collectie' && c.id !== 'afternoon-tea')
  .slice(0, 3);
---

<Layout title="Home">
  <Header />

  <main id="home-main">
    <Hero id="home-hero" />
    <Marquee items={OCCASIONS} label="Gelegenheden" />
    <HomeIntro collectionCount={collections.length} />
    <HomeCollections collections={collections} />
    <HomeSteps />
    <HomeTestimonials />
    <HomeInfo />
    <ContactCTA id="home-contact-cta" />
  </main>

  <Footer id="home-footer" />
</Layout>

<style is:global>
  #home-main .eyebrow { font-size: 0.8rem; letter-spacing: 0.18em; margin-bottom: 0.9rem; }
</style>
