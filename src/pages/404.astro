---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Pagina niet gevonden">
  <Header />

  <main class="min-h-screen flex items-center justify-center">
    <div class="container">
      <div class="max-w-lg mx-auto text-center">
        <!-- Decorative -->
        <div class="mb-8">
          <div class="w-24 h-24 mx-auto rounded-full bg-[var(--color-secondary)] flex items-center justify-center mb-6">
            <span class="font-heading text-5xl text-[var(--color-primary)]">?</span>
          </div>
          <span class="text-8xl font-bold text-[var(--color-border)]">404</span>
        </div>

        <!-- Content -->
        <h1 class="font-heading text-3xl font-semibold text-[var(--color-text)] mb-4">
          Pagina niet gevonden
        </h1>
        <p class="text-[var(--color-text-muted)] mb-8">
          Looks like you have taken a wrong turn.....<br />
          Don't worry... it happens to the best of us.
        </p>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/" class="btn btn-primary">
            Terug naar home
          </a>
          <a href="/bestellen" class="btn btn-secondary">
            Bestellen
          </a>
        </div>

        <!-- Quick Links -->
        <div class="mt-12 pt-8 border-t border-[var(--color-border)]">
          <p class="text-sm text-[var(--color-text-muted)] mb-4">Of bekijk een van onze collecties:</p>
          <div class="flex flex-wrap justify-center gap-3">
            <a href="/feestcollectie" class="px-4 py-2 bg-[var(--color-secondary)] text-[var(--color-primary)] rounded-full text-sm hover:bg-[var(--color-primary)] hover:text-white transition-colors">
              Feestcollectie
            </a>
            <a href="/mini-collectie" class="px-4 py-2 bg-[var(--color-secondary)] text-[var(--color-primary)] rounded-full text-sm hover:bg-[var(--color-primary)] hover:text-white transition-colors">
              Mini-collectie
            </a>
            <a href="/koekjescollectie" class="px-4 py-2 bg-[var(--color-secondary)] text-[var(--color-primary)] rounded-full text-sm hover:bg-[var(--color-primary)] hover:text-white transition-colors">
              Koekjes
            </a>
            <a href="/afternoon-tea" class="px-4 py-2 bg-[var(--color-secondary)] text-[var(--color-primary)] rounded-full text-sm hover:bg-[var(--color-primary)] hover:text-white transition-colors">
              Afternoon Tea
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
