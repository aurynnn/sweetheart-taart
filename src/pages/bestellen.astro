---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Bestellen" description="Bestel uw feesttaart of mini-gebak bij Sweetheart Taart. Neem contact op voor een vrijblijvende aanvraag.">
  <Header />

  <main id="bestellen-main">
    <!-- Hero Section -->
    <section id="bestellen-hero" class="pt-32 pb-16 bg-gradient-to-b from-[var(--color-secondary)] to-[var(--color-background)]">
      <div id="bestellen-hero-content" class="container">
        <div id="bestellen-hero-inner" class="max-w-3xl mx-auto text-center">
          <span id="bestellen-badge" class="inline-block px-4 py-1 text-sm font-semibold bg-[var(--color-primary)] text-white rounded-full mb-4">
            Bestellen
          </span>
          <h1 id="bestellen-title" class="font-heading text-4xl md:text-5xl lg:text-6xl font-semibold text-[var(--color-text)] mb-6 animate-on-scroll">
            Bestel uw taart
          </h1>
          <p id="bestellen-subtitle" class="text-lg text-[var(--color-text-muted)] animate-on-scroll stagger-1">
            Momenteel kunnen enkel feesttaarten online besteld worden. Voor andere producten, neem gerust contact op.
          </p>
        </div>
      </div>
    </section>

    <!-- Order Form Section -->
    <section id="bestellen-form-section" class="section">
      <div id="bestellen-form-container" class="container">
        <div id="bestellen-form-wrapper" class="max-w-2xl mx-auto">
          <div id="bestellen-form-card" class="card p-8 md:p-12 animate-on-scroll">
            <form id="order-form" class="space-y-6">
              <!-- Product Type Cards -->
              <div id="product-type-cards" class="grid grid-cols-3 gap-4 mb-8">
                <button type="button" class="product-card selected" data-product="feesttaart">
                  <span class="product-icon">
                    <i class="fa-solid fa-cake-candles"></i>
                  </span>
                  <span class="product-name">Feesttaarten</span>
                </button>
                <button type="button" class="product-card" data-product="koekjes">
                  <span class="product-icon">
                    <i class="fa-solid fa-cookie-bite"></i>
                  </span>
                  <span class="product-name">Koekjes</span>
                </button>
                <button type="button" class="product-card" data-product="mini-gebak">
                  <span class="product-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m10.09 22.5-.95-7.64a2.87 2.87 0 0 0-5.73 0l2.86 7.64h11.46l2.86-7.64a2.87 2.87 0 0 0-5.73 0l-.95 7.64"/>
                      <path d="M10.09 4.36h.26"/>
                      <path d="M13.91 4.36h-.26a3.82 3.82 0 0 1 3.82 3.82"/>
                      <path d="M14.81 15.46a4 4 0 0 0 0-.59 1 1 0 0 0-5.72 0 4 4 0 0 0 0 .59h0"/>
                      <path d="M17.73 8.18v.17a2.86 2.86 0 0 1 1.91 2.7V13"/>
                      <path d="M4.36 13v-1.9a2.86 2.86 0 0 1 1.91-2.7A3.82 3.82 0 0 1 10 4.18"/>
                      <circle cx="12" cy="3.41" r="1.91"/>
                    </svg>
                  </span>
                  <span class="product-name">Mini-gebak</span>
                </button>
              </div>

              <input type="hidden" id="product-type" name="productType" value="feesttaart" />

              <!-- Name -->
              <div>
                <label for="name" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                  <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                  </svg>
                  Naam *
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder-[var(--color-text-light)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all"
                  placeholder="Uw volledige naam"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                  <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"/>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                  E-mail *
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder-[var(--color-text-light)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all"
                  placeholder="uw@email.be"
                />
              </div>

              <!-- Phone -->
              <div>
                <label for="phone" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                  <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  Telefoon *
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder-[var(--color-text-light)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all"
                  placeholder="+32 xxx xx xx xx"
                />
              </div>

              <!-- Event Type -->
              <div id="feesttaart-fields">
                <label for="event" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                  <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                  Type gelegenheid
                </label>
                <select
                  id="event"
                  name="event"
                  class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all"
                >
                  <option value="">Selecteer een optie</option>
                  <option value="verjaardag">Verjaardag</option>
                  <option value="jubileum">Jubileum</option>
                  <option value="huwelijk">Huwelijk</option>
                  <option value="communie">Communie</option>
                  <option value="doopsel">Doopsel</option>
                  <option value="babyshower">Baby shower</option>
                  <option value="anders">Anders</option>
                </select>
              </div>

              <!-- Date -->
              <div>
                <label for="date" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                  <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                  Gewenste datum ophaling *
                </label>
                <input
                  type="date"
                  id="date"
                  name="date"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all"
                />
              </div>

              <!-- Persons -->
              <div id="feesttaart-persons">
                <label for="persons" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                  <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                  Aantal personen
                </label>
                <select
                  id="persons"
                  name="persons"
                  class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all"
                >
                  <option value="">Selecteer aantal</option>
                  <option value="8-14">8-14 personen (1 laag)</option>
                  <option value="15-25">15-25 personen (2 lagen)</option>
                  <option value="25-40">25-40 personen (3 lagen)</option>
                  <option value="40+">40+ personen (meerlagen)</option>
                </select>
              </div>

              <!-- Flavor -->
              <div id="feesttaart-flavor">
                <label for="flavor" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                  <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8h1a4 4 0 0 1 0 8h-1"/>
                    <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
                    <line x1="6" y1="1" x2="6" y2="4"/>
                    <line x1="10" y1="1" x2="10" y2="4"/>
                    <line x1="14" y1="1" x2="14" y2="4"/>
                  </svg>
                  Smaak voorkeur (vulling)
                </label>
                <select
                  id="flavor"
                  name="flavor"
                  class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all"
                >
                  <option value="">Geen voorkeur (ik adviseer)</option>
                  <option value="aardbei">Aardbei</option>
                  <option value="framboos">Framboos</option>
                  <option value="banaan">Banaan</option>
                  <option value="bosvruchten">Bosvruchten</option>
                  <option value="chocolade">Chocolade</option>
                  <option value="anders">Anders (specificeer hieronder)</option>
                </select>
              </div>

              <!-- Image Upload -->
              <div>
                <label for="image" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                  <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                  Voorbeeld afbeelding (optioneel)
                </label>
                <div id="image-upload-area" class="image-upload-area">
                  <input
                    type="file"
                    id="image"
                    name="image"
                    accept="image/*"
                    class="hidden"
                  />
                  <div id="upload-placeholder" class="upload-placeholder">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                      <polyline points="17 8 12 3 7 8"/>
                      <line x1="12" y1="3" x2="12" y2="15"/>
                    </svg>
                    <p>Klik of sleep een afbeelding hier</p>
                    <p class="text-xs opacity-60">PNG, JPG tot 5MB</p>
                  </div>
                  <img id="preview-image" class="preview-image hidden" alt="Voorbeeld" />
                </div>
              </div>

              <!-- Allergies -->
              <div>
                <label for="allergies" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                  <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                    <line x1="12" y1="9" x2="12" y2="13"/>
                    <line x1="12" y1="17" x2="12.01" y2="17"/>
                  </svg>
                  Allergieën of dieetwensen
                </label>
                <textarea
                  id="allergies"
                  name="allergies"
                  rows="2"
                  class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder-[var(--color-text-light)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all resize-none"
                  placeholder="Bijv. lactose-intolerantie, glutenallergie, diabetes..."
                ></textarea>
              </div>

              <!-- Message -->
              <div>
                <label for="message" class="block text-sm font-medium text-[var(--color-text)] mb-2">
                  <svg class="label-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                  </svg>
                  Bijkomende opmerkingen
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="3"
                  class="w-full px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder-[var(--color-text-light)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] focus:border-transparent transition-all resize-none"
                  placeholder="Vertel ons meer over uw wensen..."
                ></textarea>
              </div>

              <!-- Submit -->
              <div class="pt-4">
                <button
                  type="submit"
                  class="btn btn-primary w-full justify-center text-lg py-4"
                >
                  Verstuur bestelling
                </button>
                <p class="text-center text-sm text-[var(--color-text-muted)] mt-4">
                  U ontvangt een bevestigingsmail na verzending. We nemen spoedig contact op.
                </p>
              </div>
            </form>

            <!-- Success Message (hidden by default) -->
            <div id="success-message" class="hidden text-center py-12">
              <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-[var(--color-accent)]/20 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </div>
              <h3 class="font-heading text-2xl font-semibold text-[var(--color-text)] mb-2">
                Bedankt voor uw bestelling!
              </h3>
              <p class="text-[var(--color-text-muted)]">
                We hebben uw aanvraag ontvangen en nemen snel contact met u op.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Alternative Contact -->
    <section id="bestellen-alt-contact" class="section bg-[var(--color-surface)]">
      <div id="bestellen-alt-contact-content" class="container">
        <div id="bestellen-alt-contact-inner" class="max-w-2xl mx-auto text-center">
          <h2 id="bestellen-alt-contact-title" class="font-heading text-2xl font-semibold text-[var(--color-text)] mb-4">
            Liever telefonisch bestellen?
          </h2>
          <p id="bestellen-alt-contact-text" class="text-[var(--color-text-muted)] mb-6">
            Bel gerust naar Nathalie voor een vrijblijvend gesprek over uw wensen.
          </p>
          <a id="bestellen-phone-link" href="tel:+32486953210" class="inline-flex items-center gap-2 text-xl font-semibold text-[var(--color-primary)] hover:text-[var(--color-primary-dark)] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            +32 486 95 32 10
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const form = document.getElementById('order-form') as HTMLFormElement;
  const successMessage = document.getElementById('success-message');
  const productCards = document.querySelectorAll('.product-card');
  const productTypeInput = document.getElementById('product-type') as HTMLInputElement;
  const feesttaartFields = document.getElementById('feesttaart-fields');
  const feesttaartPersons = document.getElementById('feesttaart-persons');
  const feesttaartFlavor = document.getElementById('feesttaart-flavor');
  const imageInput = document.getElementById('image') as HTMLInputElement;
  const uploadArea = document.getElementById('image-upload-area');
  const uploadPlaceholder = document.getElementById('upload-placeholder');
  const previewImage = document.getElementById('preview-image') as HTMLImageElement;

  // Image upload handling
  if (uploadArea && imageInput) {
    uploadArea.addEventListener('click', () => imageInput.click());
    uploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadArea.classList.add('dragover');
    });
    uploadArea.addEventListener('dragleave', () => {
      uploadArea.classList.remove('dragover');
    });
    uploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadArea.classList.remove('dragover');
      const files = e.dataTransfer?.files;
      if (files?.length) {
        imageInput.files = files;
        handleImagePreview(files[0]);
      }
    });
    imageInput.addEventListener('change', () => {
      if (imageInput.files?.length) {
        handleImagePreview(imageInput.files[0]);
      }
    });
  }

  function handleImagePreview(file: File) {
    if (file && file.type.startsWith('image/')) {
      const reader = new FileReader();
      reader.onload = (e) => {
        if (previewImage) {
          previewImage.src = e.target?.result as string;
          previewImage.classList.remove('hidden');
        }
        if (uploadPlaceholder) {
          uploadPlaceholder.classList.add('hidden');
        }
      };
      reader.readAsDataURL(file);
    }
  }

  // Product card selection
  productCards.forEach(card => {
    card.addEventListener('click', () => {
      productCards.forEach(c => c.classList.remove('selected'));
      card.classList.add('selected');
      const product = (card as HTMLElement).dataset.product;
      if (productTypeInput) {
        productTypeInput.value = product || 'feesttaart';
      }
      const isFeesttaart = product === 'feesttaart';
      if (feesttaartFields) feesttaartFields.style.display = isFeesttaart ? 'block' : 'none';
      if (feesttaartPersons) feesttaartPersons.style.display = isFeesttaart ? 'block' : 'none';
      if (feesttaartFlavor) feesttaartFlavor.style.display = isFeesttaart ? 'block' : 'none';
    });
  });

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.classList.add('hidden');
      if (successMessage) {
        successMessage.classList.remove('hidden');
      }
      const formData = new FormData(form);
      console.log('Bestelling verzonden:', Object.fromEntries(formData));
    });
  }

  const dateInput = document.getElementById('date') as HTMLInputElement;
  if (dateInput) {
    const today = new Date().toISOString().split('T')[0];
    dateInput.setAttribute('min', today);
  }
</script>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem 1rem;
    background: white;
    border: 2px solid #F0E0E2;
    border-radius: 1rem;
    cursor: pointer;
    transition: all 300ms ease;
  }

  .product-card:hover {
    border-color: #E8788A;
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(232, 120, 138, 0.2);
  }

  .product-card.selected {
    background: linear-gradient(135deg, #E8788A 0%, #F2A0AA 100%);
    border-color: #E8788A;
    color: white;
  }

  .product-icon {
    width: 3rem;
    height: 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-icon i {
    font-size: 2.5rem;
    line-height: 1;
  }

  .product-icon svg {
    width: 2.5rem;
    height: 2.5rem;
  }

  .product-name {
    font-weight: 600;
    font-size: 0.875rem;
    text-align: center;
  }

  .label-icon {
    width: 1.25rem;
    height: 1.25rem;
    margin-right: 0.5rem;
    vertical-align: middle;
    flex-shrink: 0;
  }

  .image-upload-area {
    position: relative;
    border: 2px dashed #E0E0E0;
    border-radius: 0.75rem;
    overflow: hidden;
    cursor: pointer;
    transition: all 200ms ease;
    background: var(--color-surface);
  }

  .image-upload-area:hover,
  .image-upload-area.dragover {
    border-color: #E8788A;
    background: #FDEEF0;
  }

  .upload-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    color: #888;
    text-align: center;
  }

  .upload-placeholder svg {
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.75rem;
    opacity: 0.5;
  }

  .upload-placeholder p {
    margin: 0;
    font-size: 0.875rem;
  }

  .preview-image {
    width: 100%;
    max-height: 12rem;
    object-fit: cover;
    display: block;
  }

  .image-upload-area input[type="file"] {
    display: none;
  }
</style>
