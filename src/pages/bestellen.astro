---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Bestellen" description="Bestel uw feesttaart of mini-gebak bij Sweetheart Taart. Neem contact op voor een vrijblijvende aanvraag.">
  <Header />

  <main id="bestellen-main">
    <!-- Hero Section -->
    <section id="bestellen-hero" class="pt-32 pb-16 bg-gradient-to-b from-[var(--color-secondary)] to-[var(--color-background)]">
      <div id="bestellen-hero-content" class="container">
        <div id="bestellen-hero-inner" class="max-w-3xl mx-auto text-center">
          <span id="bestellen-badge" class="inline-block px-4 py-1 text-sm font-semibold bg-[var(--color-primary)] text-white rounded-full mb-4">
            Bestellen
          </span>
          <h1 id="bestellen-title" class="font-heading text-4xl md:text-5xl lg:text-6xl font-semibold text-[var(--color-text)] mb-6 animate-on-scroll">
            Bestel uw taart
          </h1>
          <p id="bestellen-subtitle" class="text-lg text-[var(--color-text-muted)] animate-on-scroll stagger-1">
            Na de aanvraag nemen we contact op
          </p>
        </div>
      </div>
    </section>

    <!-- Order Form Section -->
    <section id="bestellen-form-section" class="section">
      <div id="bestellen-form-container" class="container">
        <div id="bestellen-form-wrapper" class="max-w-2xl mx-auto">
          <div id="bestellen-form-card" class="card p-8 md:p-12 animate-on-scroll">
            
            <form id="order-form" class="space-y-6">
              
              <!-- Product Type Cards -->
              <div id="product-selection" class="product-type-cards grid grid-cols-3 gap-4 mb-6">
                <button type="button" class="product-card" data-product="feesttaart">
                  <span class="product-icon">
                    <i class="fa-solid fa-cake-candles"></i>
                  </span>
                  <span class="product-name">Feesttaarten</span>
                </button>
                <button type="button" class="product-card" data-product="koekjes">
                  <span class="product-icon">
                    <i class="fa-solid fa-cookie-bite"></i>
                  </span>
                  <span class="product-name">Koekjes</span>
                </button>
                <button type="button" class="product-card" data-product="mini-gebak">
                  <span class="product-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m10.09 22.5-.95-7.64a2.87 2.87 0 0 0-5.73 0l2.86 7.64h11.46l2.86-7.64a2.87 2.87 0 0 0-5.73 0l-.95 7.64"/>
                      <path d="M10.09 4.36h.26"/>
                      <path d="M13.91 4.36h-.26a3.82 3.82 0 0 1 3.82 3.82"/>
                      <path d="M14.81 15.46a4 4 0 0 0 0-.59 1 1 0 0 0-5.72 0 4 4 0 0 0 0 .59h0"/>
                      <path d="M17.73 8.18v.17a2.86 2.86 0 0 1 1.91 2.7V13"/>
                      <path d="M4.36 13v-1.9a2.86 2.86 0 0 1 1.91-2.7A3.82 3.82 0 0 1 10 4.18"/>
                      <circle cx="12" cy="3.41" r="1.91"/>
                    </svg>
                  </span>
                  <span class="product-name">Mini-gebak</span>
                </button>
              </div>

              <!-- Order Info Section (filled once) -->
              <div id="order-info-section">
                <!-- Name -->
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-[#FDEEF0] flex items-center justify-center text-[#E8788A] flex-shrink-0">
                    <i class="fa-solid fa-user"></i>
                  </div>
                  <input type="text" name="name" required placeholder="Uw naam" class="flex-1 px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder-[var(--color-text-light)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all" />
                </div>
                <!-- Email -->
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-[#FDEEF0] flex items-center justify-center text-[#E8788A] flex-shrink-0">
                    <i class="fa-solid fa-envelope"></i>
                  </div>
                  <input type="email" name="email" required placeholder="uw@email.be" class="flex-1 px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder-[var(--color-text-light)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all" />
                </div>
                <!-- Phone -->
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-[#FDEEF0] flex items-center justify-center text-[#E8788A] flex-shrink-0">
                    <i class="fa-solid fa-phone"></i>
                  </div>
                  <input type="tel" name="phone" required placeholder="+32 xxx xx xx xx" class="flex-1 px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder-[var(--color-text-light)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all" />
                </div>
                <!-- Date -->
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-[#FDEEF0] flex items-center justify-center text-[#E8788A] flex-shrink-0">
                    <i class="fa-solid fa-calendar"></i>
                  </div>
                  <input type="date" id="date-input" name="date" required class="flex-1 px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all" />
                </div>
              </div>

              <!-- Item Details Section (per item) -->
              <div id="item-details-section">
                <!-- Event Type (feesttaart only) -->
                <div id="feesttaart-fields" class="feesttaart-only">
                  <label class="block text-sm font-medium text-[var(--color-text)] mb-2 ml-14">Type gelegenheid</label>
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-[#FDEEF0] flex items-center justify-center text-[#E8788A] flex-shrink-0">
                      <i class="fa-solid fa-star"></i>
                    </div>
                    <select id="event-select" class="flex-1 px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all">
                      <option value="">Selecteer een optie</option>
                      <option value="verjaardag">Verjaardag</option>
                      <option value="jubileum">Jubileum</option>
                      <option value="huwelijk">Huwelijk</option>
                      <option value="communie">Communie</option>
                      <option value="doopsel">Doopsel</option>
                      <option value="babyshower">Baby shower</option>
                      <option value="anders">Anders</option>
                    </select>
                  </div>
                </div>

                <!-- Persons (feesttaart only) -->
                <div id="feesttaart-persons" class="feesttaart-only">
                  <label class="block text-sm font-medium text-[var(--color-text)] mb-2 ml-14">Aantal personen</label>
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-[#FDEEF0] flex items-center justify-center text-[#E8788A] flex-shrink-0">
                      <i class="fa-solid fa-users"></i>
                    </div>
                    <select id="persons-select" class="flex-1 px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all">
                      <option value="">Selecteer aantal</option>
                      <option value="8-14">8-14 personen (1 laag)</option>
                      <option value="15-25">15-25 personen (2 lagen)</option>
                      <option value="25-40">25-40 personen (3 lagen)</option>
                      <option value="40+">40+ personen (meerlagen)</option>
                    </select>
                  </div>
                </div>

                <!-- Flavor -->
                <div>
                  <label class="block text-sm font-medium text-[var(--color-text)] mb-2 ml-14">Smaak voorkeur (vulling)</label>
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-[#FDEEF0] flex items-center justify-center text-[#E8788A] flex-shrink-0">
                      <i class="fa-solid fa-wine-glass"></i>
                    </div>
                    <select id="flavor-select" class="flex-1 px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] transition-all">
                      <option value="">Geen voorkeur (ik adviseer)</option>
                      <option value="aardbei">Aardbei</option>
                      <option value="framboos">Framboos</option>
                      <option value="banaan">Banaan</option>
                      <option value="bosvruchten">Bosvruchten</option>
                      <option value="chocolade">Chocolade</option>
                      <option value="anders">Anders (specificeer hieronder)</option>
                    </select>
                  </div>
                </div>

                <!-- Image Upload -->
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 rounded-full bg-[#FDEEF0] flex items-center justify-center text-[#E8788A] flex-shrink-0 mt-1">
                    <i class="fa-solid fa-image"></i>
                  </div>
                  <div id="image-upload-area" class="image-upload-area flex-1">
                    <input type="file" id="image-input" accept="image/*" class="hidden" />
                    <div id="upload-placeholder" class="upload-placeholder">
                      <i class="fa-solid fa-cloud-arrow-up text-2xl text-[var(--color-text-muted)] mb-1"></i>
                      <p class="text-xs text-[var(--color-text-muted)]">Voeg een voorbeeld toe</p>
                    </div>
                    <img id="preview-image" class="preview-image hidden" alt="Upload preview" />
                  </div>
                </div>

                <!-- Allergies -->
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 rounded-full bg-[#FDEEF0] flex items-center justify-center text-[#E8788A] flex-shrink-0 mt-1">
                    <i class="fa-solid fa-exclamation-circle"></i>
                  </div>
                  <textarea id="allergies-input" rows="2" placeholder="Allergieën (optioneel)" class="flex-1 px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder-[var(--color-text-light)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] resize-none transition-all"></textarea>
                </div>

                <!-- Opmerkingen -->
                <div class="flex items-start gap-3">
                  <div class="w-10 h-10 rounded-full bg-[#FDEEF0] flex items-center justify-center text-[#E8788A] flex-shrink-0 mt-1">
                    <i class="fa-solid fa-comment"></i>
                  </div>
                  <textarea id="message-input" rows="2" placeholder="Opmerkingen (optioneel)" class="flex-1 px-4 py-3 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text)] placeholder-[var(--color-text-light)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] resize-none transition-all"></textarea>
                </div>
              </div>

              <!-- Added Items Summary -->
              <div id="items-summary" class="hidden mb-4 p-4 bg-[var(--color-surface)] rounded-xl border border-[var(--color-border)]">
                <h4 class="text-sm font-medium text-[var(--color-text-muted)] mb-3">Uw items:</h4>
                <div id="items-summary-list" class="space-y-2">
                  <!-- Filled items will appear here -->
                </div>
              </div>

              <!-- Add Item Button -->
              <button type="button" id="add-item-btn" class="btn btn-secondary w-full justify-center text-lg py-4 flex items-center gap-2 hidden">
                <i class="fa-solid fa-plus"></i>
                Voeg nog een item toe
              </button>

              <!-- Submit -->
              <button type="button" id="review-btn" class="btn btn-primary w-full justify-center text-lg py-4">
                Bestelling controleren
              </button>
              <p class="text-center text-sm text-[var(--color-text-muted)]">
                U ontvangt een bevestigingsmail na verzending. We nemen spoedig contact op.
              </p>
            </form>

            <!-- Success Message -->
            <div id="success-message" class="hidden text-center py-12">
              <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-[var(--color-accent)]/20 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
              </div>
              <h3 class="font-heading text-2xl font-semibold text-[var(--color-text)] mb-2">
                Bedankt voor uw bestelling!
              </h3>
              <p class="text-[var(--color-text-muted)]">
                We hebben uw aanvraag ontvangen en nemen snel contact met u op.
              </p>
            </div>

            <!-- Order Review Section -->
            <div id="order-review" class="hidden">
              <h3 class="font-heading text-2xl font-semibold text-[var(--color-text)] mb-6 text-center">
                Uw bestelling
              </h3>
              
              <div class="bg-[var(--color-surface)] rounded-xl p-6 mb-6">
                <h4 class="font-semibold text-[var(--color-text)] mb-3 flex items-center gap-2">
                  <i class="fa-solid fa-user text-[#E8788A]"></i> Contactgegevens
                </h4>
                <div class="grid grid-cols-2 gap-4 text-sm">
                  <div><span class="text-[var(--color-text-muted)]">Naam:</span> <span id="review-name" class="text-[var(--color-text)]"></span></div>
                  <div><span class="text-[var(--color-text-muted)]">Email:</span> <span id="review-email" class="text-[var(--color-text)]"></span></div>
                  <div><span class="text-[var(--color-text-muted)]">Telefoon:</span> <span id="review-phone" class="text-[var(--color-text)]"></span></div>
                  <div><span class="text-[var(--color-text-muted)]">Datum:</span> <span id="review-date" class="text-[var(--color-text)]"></span></div>
                </div>
              </div>

              <div id="review-items" class="space-y-4 mb-6"></div>

              <div class="flex gap-3">
                <button type="button" id="back-btn" class="btn btn-secondary flex-1 justify-center text-lg py-4">
                  <i class="fa-solid fa-arrow-left mr-2"></i> Terug
                </button>
                <button type="submit" id="submit-btn-final" class="btn btn-primary flex-1 justify-center text-lg py-4">
                  <i class="fa-solid fa-paper-plane mr-2"></i> Verstuur bestelling
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Alternative Contact -->
    <section id="bestellen-alt-contact" class="section bg-[var(--color-surface)]">
      <div class="container">
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="font-heading text-2xl font-semibold text-[var(--color-text)] mb-4">
            Liever telefonisch bestellen?
          </h2>
          <p class="text-[var(--color-text-muted)] mb-6">
            Bel gerust naar Nathalie voor een vrijblijvend gesprek over uw wensen.
          </p>
          <a href="tel:+32486953210" class="inline-flex items-center gap-2 text-xl font-semibold text-[var(--color-primary)] hover:text-[var(--color-primary-dark)] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            +32 486 95 32 10
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // State
    const addedItems = [];
    let currentProduct = null;
    let editingIndex = null;
    let orderInfoFilled = false; // Track if order-info has been filled with valid data

    // Elements
    const productSelection = document.getElementById('product-selection');
    const orderInfoSection = document.getElementById('order-info-section');
    const itemDetailsSection = document.getElementById('item-details-section');
    const addItemBtn = document.getElementById('add-item-btn');
    const itemsSummary = document.getElementById('items-summary');
    const productCards = productSelection.querySelectorAll('.product-card');
    const feesttaartFields = document.querySelectorAll('.feesttaart-only');

    // Product icons mapping
    const productIcons = {
      'feesttaart': '<i class="fa-solid fa-cake-candles"></i>',
      'koekjes': '<i class="fa-solid fa-cookie-bite"></i>',
      'mini-gebak': '<i class="fa-solid fa-cookie"></i>'
    };

    const productNames = {
      'feesttaart': 'Feesttaart',
      'koekjes': 'Koekjes',
      'mini-gebak': 'Mini-gebak'
    };

    // Product card selection - switches product in summary
    productCards.forEach(card => {
      card.addEventListener('click', () => {
        var product = card.getAttribute('data-product');
        
        productCards.forEach(function(c) { c.classList.remove('selected'); });
        card.classList.add('selected');
        currentProduct = product;
        updateFeesttaartFields();
        itemDetailsSection.classList.remove('hidden');
        addItemBtn.classList.remove('hidden');
        editingIndex = null;
        
        // If items exist, switch the first one to this product (not edit, just switch)
        if (addedItems.length > 0) {
          addedItems[0] = { product: product, event: '', persons: '', flavor: '', allergies: '', message: '' };
          renderItemsSummary();
        } else {
          // First ever selection - add to summary but keep order-info visible
          // (order-info will only be hidden after it's filled AND first item is added)
          var itemData = { product: product, event: '', persons: '', flavor: '', allergies: '', message: '' };
          addedItems.push(itemData);
          // Keep orderInfoSection visible for first product - will hide after order-info is filled
          renderItemsSummary();
        }
        
        // Always show "Voeg nog een item toe" when switching products
        addItemBtn.innerHTML = '<i class="fa-solid fa-plus"></i> Voeg nog een item toe';
      });
    });

    // Update feesttaart fields visibility
    function updateFeesttaartFields() {
      feesttaartFields.forEach(field => {
        field.style.display = currentProduct === 'feesttaart' ? '' : 'none';
      });
    }

    // Initialize - no product selected, item details hidden
    updateFeesttaartFields();
    itemDetailsSection.classList.add('hidden');
    addItemBtn.classList.add('hidden');

    // Set min date
    const dateInput = document.getElementById('date-input');
    if (dateInput) {
      dateInput.setAttribute('min', new Date().toISOString().split('T')[0]);
    }

    // Add item button - adds current product as new item to summary
    addItemBtn.addEventListener('click', () => {
      if (!currentProduct) return;
      
      // Check if order-info is filled before allowing first item
      if (!orderInfoFilled) {
        var name = document.querySelector('[name="name"]').value.trim();
        var email = document.querySelector('[name="email"]').value.trim();
        var phone = document.querySelector('[name="phone"]').value.trim();
        var date = document.getElementById('date-input').value;
        
        if (!name || !email || !phone || !date) {
          alert('Vul alstublieft alle contactgegevens (naam, email, telefoon en datum) in voordat u een item toevoegt.');
          return;
        }
        
        // Mark order-info as filled - from now on it stays hidden for new items
        orderInfoFilled = true;
        orderInfoSection.style.display = 'none';
      }
      
      var itemData = {
        product: currentProduct,
        event: document.getElementById('event-select').value,
        persons: document.getElementById('persons-select').value,
        flavor: document.getElementById('flavor-select').value,
        allergies: document.getElementById('allergies-input').value,
        message: document.getElementById('message-input').value
      };
      
      if (editingIndex !== null) {
        // Update existing item (when editing via summary)
        addedItems[editingIndex] = itemData;
        editingIndex = null;
      } else {
        // Add as new item
        addedItems.push(itemData);
      }
      
      renderItemsSummary();
      resetItemDetails();
    });

    // Render all items in summary
    function renderItemsSummary() {
      const summaryList = document.getElementById('items-summary-list');
      if (addedItems.length > 0) {
        itemsSummary.classList.remove('hidden');
      } else {
        itemsSummary.classList.add('hidden');
      }
      summaryList.innerHTML = '';
      for (var i = 0; i < addedItems.length; i++) {
        var item = addedItems[i];
        var div = document.createElement('div');
        div.className = 'flex items-center justify-between p-3 bg-white rounded-lg border border-[var(--color-border)]';
        div.innerHTML = '<div class="flex items-center gap-3 flex-1"><span class="text-xl">' + productIcons[item.product] + '</span><div><div class="font-medium text-[var(--color-text)]">' + productNames[item.product] + '</div><div class="text-xs text-[var(--color-text-muted)]">' + (item.event || item.flavor || '') + '</div></div></div><div class="flex gap-2"><button type="button" class="edit-item-btn p-2 text-[#E8788A] hover:bg-[#FDEEF0] rounded-lg transition" data-index="' + i + '"><i class="fa-solid fa-pen"></i></button><button type="button" class="delete-item-btn p-2 text-red-400 hover:bg-red-50 rounded-lg transition" data-index="' + i + '"><i class="fa-solid fa-trash-can"></i></button></div>';
        summaryList.appendChild(div);
      }
      // Add event listeners
      summaryList.querySelectorAll('.edit-item-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          loadItemIntoForm(parseInt(this.getAttribute('data-index')));
        });
      });
      summaryList.querySelectorAll('.delete-item-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var idx = parseInt(this.getAttribute('data-index'));
          addedItems.splice(idx, 1);
          renderItemsSummary();
          if (addedItems.length === 0) {
            itemsSummary.classList.add('hidden');
            orderInfoSection.style.display = '';
            orderInfoFilled = false; // Reset so order-info shows for new first item
          }
          productCards.forEach(function(c) { c.classList.remove('selected'); });
          currentProduct = null;
          editingIndex = null;
          itemDetailsSection.classList.add('hidden');
          addItemBtn.classList.add('hidden');
        });
      });
    }

    // Load item into form for editing
    function loadItemIntoForm(index) {
      var item = addedItems[index];
      if (!item) return;
      editingIndex = index;
      currentProduct = item.product;
      productCards.forEach(function(c) { c.classList.remove('selected'); });
      productSelection.querySelector('[data-product="' + item.product + '"]').classList.add('selected');
      updateFeesttaartFields();
      itemDetailsSection.classList.remove('hidden');
      addItemBtn.innerHTML = '<i class="fa-solid fa-check"></i> Bewerking Opslaan';
      addItemBtn.classList.remove('hidden');
      document.getElementById('event-select').value = item.event || '';
      document.getElementById('persons-select').value = item.persons || '';
      document.getElementById('flavor-select').value = item.flavor || '';
      document.getElementById('allergies-input').value = item.allergies || '';
      document.getElementById('message-input').value = item.message || '';
    }

    // Reset item details section (not order info or product cards)
    function resetItemDetails() {
      // Clear product selection
      productCards.forEach(c => c.classList.remove('selected'));
      currentProduct = null;
      updateFeesttaartFields();
      itemDetailsSection.classList.add('hidden');

      // Clear item details inputs only
      document.getElementById('event-select').selectedIndex = 0;
      document.getElementById('persons-select').selectedIndex = 0;
      document.getElementById('flavor-select').selectedIndex = 0;
      document.getElementById('allergies-input').value = '';
      document.getElementById('message-input').value = '';

      // Reset image
      document.getElementById('preview-image').classList.add('hidden');
      document.getElementById('upload-placeholder').classList.remove('hidden');

      // Reset button and editing state
      addItemBtn.innerHTML = '<i class="fa-solid fa-plus"></i> Voeg nog een item toe';
      addItemBtn.classList.add('hidden');
      editingIndex = null;
    }

    // Image upload
    const imageUploadArea = document.getElementById('image-upload-area');
    const imageInput = document.getElementById('image-input');
    const previewImage = document.getElementById('preview-image');
    const uploadPlaceholder = document.getElementById('upload-placeholder');

    imageUploadArea.addEventListener('click', () => imageInput.click());
    imageUploadArea.addEventListener('dragover', (e) => {
      e.preventDefault();
      imageUploadArea.classList.add('dragover');
    });
    imageUploadArea.addEventListener('dragleave', () => imageUploadArea.classList.remove('dragover'));
    imageUploadArea.addEventListener('drop', (e) => {
      e.preventDefault();
      imageUploadArea.classList.remove('dragover');
      if (e.dataTransfer.files[0]) handleImage(e.dataTransfer.files[0]);
    });
    imageInput.addEventListener('change', () => {
      if (imageInput.files[0]) handleImage(imageInput.files[0]);
    });

    function handleImage(file) {
      if (!file.type.startsWith('image/')) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        previewImage.src = e.target.result;
        previewImage.classList.remove('hidden');
        uploadPlaceholder.classList.add('hidden');
      };
      reader.readAsDataURL(file);
    }

    // Form submission
    const form = document.getElementById('order-form');
    const successMessage = document.getElementById('success-message');
    const reviewSection = document.getElementById('order-review');
    const reviewBtn = document.getElementById('review-btn');
    const backBtn = document.getElementById('back-btn');
    const submitBtnFinal = document.getElementById('submit-btn-final');

    reviewBtn.addEventListener('click', function() {
      if (editingIndex !== null) {
        addItemBtn.click();
      }
      var name = document.querySelector('[name="name"]').value;
      var email = document.querySelector('[name="email"]').value;
      var phone = document.querySelector('[name="phone"]').value;
      var date = document.getElementById('date-input').value;
      if (!name || !email || !phone) {
        alert('Vul alstublieft alle contactgegevens in');
        return;
      }
      if (!date) {
        alert('Vul alstublieft een datum in');
        return;
      }
      if (addedItems.length === 0) {
        alert('Voeg alstublieft minimaal één item toe');
        return;
      }
      document.getElementById('review-name').textContent = name;
      document.getElementById('review-email').textContent = email;
      document.getElementById('review-phone').textContent = phone;
      document.getElementById('review-date').textContent = date;
      var reviewItems = document.getElementById('review-items');
      var html = '';
      for (var i = 0; i < addedItems.length; i++) {
        var item = addedItems[i];
        html = html + '<div class="bg-[var(--color-surface)] rounded-xl p-4 border border-[var(--color-border)] mb-4">';
        html = html + '<div class="flex items-center gap-2 mb-2"><span class="text-xl">' + productIcons[item.product] + '</span><span class="font-semibold text-[var(--color-text)]">' + productNames[item.product] + '</span></div>';
        html = html + '<div class="text-sm text-[var(--color-text-muted)]">';
        if (item.event) { html = html + '<div><span class="font-medium">Gelegenheid:</span> ' + item.event + '</div>'; }
        if (item.persons) { html = html + '<div><span class="font-medium">Personen:</span> ' + item.persons + '</div>'; }
        if (item.flavor) { html = html + '<div><span class="font-medium">Smaak:</span> ' + item.flavor + '</div>'; }
        if (item.allergies) { html = html + '<div><span class="font-medium">Allergieën:</span> ' + item.allergies + '</div>'; }
        if (item.message) { html = html + '<div><span class="font-medium">Opmerkingen:</span> ' + item.message + '</div>'; }
        html = html + '</div></div>';
      }
      reviewItems.innerHTML = html;
      form.classList.add('hidden');
      reviewSection.classList.remove('hidden');
    });

    backBtn.addEventListener('click', function() {
      reviewSection.classList.add('hidden');
      form.classList.remove('hidden');
    });

    submitBtnFinal.addEventListener('click', function() {
      var formData = new FormData(form);
      formData.append('items', JSON.stringify(addedItems));
      console.log('Order:', Object.fromEntries(formData));
      reviewSection.classList.add('hidden');
      successMessage.classList.remove('hidden');
    });
  </script>

  <style>
    .product-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding: 1.5rem 1rem;
      background: white;
      border: 2px solid #F0E0E2;
      border-radius: 1rem;
      cursor: pointer;
      transition: all 300ms ease;
    }

    .product-card:hover {
      border-color: #E8788A;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(232, 120, 138, 0.2);
    }

    .product-card.selected {
      border-color: #E8788A;
      background: #FDEEF0;
    }

    .product-icon {
      font-size: 2rem;
      color: #E8788A;
    }

    .product-name {
      font-size: 0.875rem;
      text-align: center;
    }

    #order-info-section > div {
      margin-bottom: 0.75rem;
    }

    #order-info-section > div:last-child {
      margin-bottom: 0;
    }

    #item-details-section > div {
      margin-bottom: 0.75rem;
    }

    #item-details-section > div:last-child {
      margin-bottom: 0;
    }

    .image-upload-area {
      position: relative;
      border: 2px dashed #E0E0E0;
      border-radius: 0.75rem;
      overflow: hidden;
      cursor: pointer;
      transition: all 200ms ease;
      background: var(--color-surface);
    }

    .image-upload-area:hover,
    .image-upload-area.dragover {
      border-color: #E8788A;
      background: #FDEEF0;
    }

    .upload-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1rem;
      color: #888;
    }

    .preview-image {
      width: auto;
      max-height: 8rem;
      max-width: 100%;
      object-fit: contain;
      display: block;
      margin: 0 auto;
    }

    .btn-secondary {
      background: white;
      color: var(--color-primary);
      border: 2px solid var(--color-primary);
    }

    .btn-secondary:hover {
      background: var(--color-secondary);
    }
  </style>
</Layout>
