---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactCTA from '../components/ContactCTA.astro';
import GalleryModal from '../components/GalleryModal.svelte';
import CollectionHero from '../components/collection/CollectionHero.astro';
import FeatureCard from '../components/collection/FeatureCard.astro';
import { listMedia } from '../lib/r2';

const R2 = (import.meta.env.PUBLIC_R2_BASE_URL || '').replace(/\/$/, '');
const img = (key: string) => `${R2}/koekjescollectie/images/${key}`;

const galleryImages = await listMedia('koekjescollectie');

const presentations = [
  { title: 'Op stok', text: 'Perfect als attentie, bedankje of in een mooi potje als blikvanger.', icon: 'fa-gift', image: img('koek_geel.jpg') },
  { title: 'In zakje', text: 'Mooi verpakt met lint — handig om uit te delen aan de gasten.', icon: 'fa-bag-shopping', image: img('sweetheart.taart_1557306314_2039155620111759877_8631104567.jpg') },
  { title: 'Op schaaltje', text: 'Elegant gepresenteerd voor op de dessert- of sweet table.', icon: 'fa-plate-wheat', image: img('koek_wit_thumb.jpg') },
];

const occasions = [
  { icon: 'fa-baby', label: 'Geboorte' },
  { icon: 'fa-cake-candles', label: 'Verjaardag' },
  { icon: 'fa-seedling', label: 'Lentefeest' },
  { icon: 'fa-dove', label: 'Communie' },
  { icon: 'fa-ring', label: 'Huwelijk' },
  { icon: 'fa-briefcase', label: 'Bedrijfsevent' },
];

const priceFactors = [
  { icon: 'fa-palette', label: 'Afwerking en versiering' },
  { icon: 'fa-box-open', label: 'Verpakkingskeuze' },
  { icon: 'fa-hashtag', label: 'Aantal koekjes' },
  { icon: 'fa-wheat-awn', label: 'Gebruikte ingrediënten' },
];
---

<Layout title="Koekjescollectie" description="Knap knapperig en prachtig versierd! Speltkoekjes op stok, in zakjes of op schaaltjes. Perfect voor geboorte, verjaardag, communie of trouw." bodyClass="collection-page">
  <Header />

  <main id="koekjes-main" class="collection">
    <CollectionHero
      id="koekjes-hero"
      badge="Koekjescollectie"
      title="Knap knapperig"
      subtitle="Koekjes op stok, in een zakje of op een schaaltje… een heerlijke traktatie voor geboorte, verjaardag, lentefeest, communie, huwelijk en meer."
      product="koekjes"
      ctaLabel="Bestellen"
      photos={[img('koekejs.png'), img('sweetheart.taart_1641141988_2742420221900333997_8631104567.jpg'), img('sweetheart.taart_1557306214_2039154781586553919_8631104567.jpg')]}
      highlights={[{ icon: 'fa-wheat-awn', label: 'Speltkoekjes' }, { icon: 'fa-paintbrush', label: 'Versierd naar wens' }, { icon: 'fa-euro-sign', label: 'Vanaf €2 per koekje' }]}
    />

    <!-- Presentations -->
    <section id="koekjes-presentaties" class="section c-section">
      <div class="container">
        <header class="c-head">
          <span class="eyebrow animate-on-scroll">Presentatie</span>
          <h2 class="section-title" data-split>Hoe wil je ze?</h2>
          <p class="section-subtitle mx-auto animate-on-scroll stagger-1">
            Deze speltkoekjes worden versierd naar wens — elke koek een klein kunstwerkje.
          </p>
        </header>
        <div class="c-grid-3">
          {presentations.map((p, i) => <FeatureCard {...p} index={i} />)}
        </div>
      </div>
    </section>

    <!-- Occasions marquee -->
    <section class="c-occasions" aria-label="Gelegenheden">
      <div class="c-occasions-track" data-marquee data-marquee-duration="32">
        {occasions.map((o) => (
          <span class="c-occasion" data-marquee-item><i class={`fa-solid ${o.icon}`} aria-hidden="true"></i>{o.label}</span>
        ))}
      </div>
    </section>

    <!-- Gallery -->
    <section id="creaties" class="section c-section c-gallery">
      <div class="container">
        <header class="c-head">
          <span class="eyebrow animate-on-scroll">Inspiratie</span>
          <h2 class="section-title" data-split>Onze koekjes</h2>
        </header>
        <div class="animate-on-scroll">
          <GalleryModal client:visible images={galleryImages} />
        </div>
      </div>
    </section>

    <!-- Price -->
    <section id="koekjes-prijs" class="section c-section">
      <div class="container">
        <div class="c-price-card animate-on-scroll" data-tilt="3">
          <div class="c-price">
            <span class="c-price-label">Vanaf</span>
            <span class="c-price-amount">€<span data-counter="2" data-counter-from="0">2</span></span>
            <span class="c-price-unit">per koekje</span>
            <small>(niet op stok en niet verpakt)</small>
          </div>
          <div class="c-price-body">
            <h3>De prijs hangt af van</h3>
            <ul class="c-factors">
              {priceFactors.map((f, i) => (
                <li class={`animate-on-scroll stagger-${i + 1}`}><span><i class={`fa-solid ${f.icon}`} aria-hidden="true"></i></span>{f.label}</li>
              ))}
            </ul>
            <a href="/aanvraag?product=koekjes" class="btn btn-primary btn-shine c-cta-wide" data-magnetic="0.15">
              Vraag je koekjes aan <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
            </a>
            <p class="c-small">Vrijblijvend — Nathalie bevestigt je aanvraag met de definitieve prijs.</p>
          </div>
        </div>
      </div>
    </section>

    <ContactCTA id="koekjes-contact" />
  </main>

  <Footer id="koekjes-footer" />
</Layout>
