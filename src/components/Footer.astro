---
import { SITE } from '../config/site';
const currentYear = new Date().getFullYear();

const socialLinks = [
  { href: SITE.social.facebook, label: 'Facebook', icon: 'facebook' },
  { href: SITE.social.instagram, label: 'Instagram', icon: 'instagram' },
];

const quickLinks = [
  { href: '/', label: 'Home' },
  { href: '/feestcollectie', label: 'Feestcollectie' },
  { href: '/mini-collectie', label: 'Mini-collectie' },
  { href: '/koekjescollectie', label: 'Koekjes' },
  { href: '/aanvraag', label: 'Aanvraag indienen' },
];

const infoLinks = [
  { href: '/tips#ophalen', label: 'Ophaalinfo' },
  { href: '/tips#bewaren', label: 'Bewaren & tips' },
  { href: '/algemene-voorwaarden', label: 'Algemene voorwaarden' },
];

function getSocialIcon(icon: string) {
  if (icon === 'facebook') {
    return `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`;
  }
  if (icon === 'instagram') {
    return `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>`;
  }
  return '';
}
---

<footer class="bg-[var(--color-secondary)] mt-auto">
  <div class="container py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full bg-[var(--color-primary)] flex items-center justify-center text-white font-heading text-xl font-bold">
            S
          </div>
          <div>
            <span class="font-heading text-xl font-semibold text-[var(--color-primary)]">Sweetheart</span>
            <span class="block text-xs text-[var(--color-text-muted)] -mt-1">Koekjes, Cake & Taart</span>
          </div>
        </a>
        <p class="text-sm text-[var(--color-text-muted)] mt-4">
          Ambachtelijke taarten en gebak, met liefde gebakken in Oostende.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-heading text-lg font-semibold text-[var(--color-text)] mb-4">Navigatie</h4>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link text-sm text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>

        <h4 class="font-heading text-lg font-semibold text-[var(--color-text)] mb-4 mt-8">Info</h4>
        <ul class="space-y-2">
          {infoLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link text-sm text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="font-heading text-lg font-semibold text-[var(--color-text)] mb-4">Contact</h4>
        <address class="not-italic text-sm text-[var(--color-text-muted)] space-y-3">
          <p>
            <strong>Adres:</strong><br />
            {SITE.address.street}<br />
            {SITE.address.postalCode} {SITE.address.city}
          </p>
          <p>
            <strong>Telefoon:</strong><br />
            <a href={SITE.phone.href} class="hover:text-[var(--color-primary)] transition-colors">
              {SITE.phone.international}
            </a>
          </p>
          <p>
            <strong>Email:</strong><br />
            <a href={`mailto:${SITE.email}`} class="hover:text-[var(--color-primary)] transition-colors">
              {SITE.email}
            </a>
          </p>
        </address>
      </div>

      <!-- Opening Hours & Social -->
      <div>
        <h4 class="font-heading text-lg font-semibold text-[var(--color-text)] mb-4">Openingsuren</h4>
        <p class="text-sm text-[var(--color-text-muted)] mb-4">
          Geen winkel, enkel een bakatelier.<br />
          Kom langs om uw taart te bespreken:
        </p>
        <p class="text-sm font-medium text-[var(--color-text)] mb-6">
          Donderdag: 17u - 20u<br />
          <span class="text-[var(--color-text-muted)]">(niet tijdens schoolvakanties)</span>
        </p>

        <!-- Social Links -->
        <div class="flex gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-full bg-[var(--color-surface)] flex items-center justify-center text-[var(--color-text-muted)] hover:bg-[var(--color-primary)] hover:text-white transition-all"
              aria-label={social.label}
              set:html={getSocialIcon(social.icon)}
            />
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-[var(--color-border)] flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-[var(--color-text-muted)]">
        &copy; {currentYear} Sweetheart Taart. Alle rechten voorbehouden.
      </p>
      <p class="text-sm text-[var(--color-text-muted)] flex flex-wrap gap-x-4 gap-y-1 justify-center">
        <a href="/algemene-voorwaarden" class="hover:text-[var(--color-primary)] transition-colors">Algemene voorwaarden</a>
        <a href="/tips" class="hover:text-[var(--color-primary)] transition-colors">Ophaalinfo & tips</a>
        <span class="text-[var(--color-text-light)]">Met liefde gemaakt in Oostende</span>
      </p>
    </div>
  </div>
</footer>
