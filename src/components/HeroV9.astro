---
// HeroV9.astro — "Bold Outline"
// Giant outlined text — white fill + dark stroke
// Ultra modern, striking, completely different from everything else
interface Props {
  title?: string;
  subtitle?: string;
  showCTA?: boolean;
}
const {
  title = "De prachtigste taarten...",
  subtitle = "fijnste koekjes en heerlijkste cake, met liefde gebakken in Oostende",
  showCTA = true
} = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background video -->
  <div class="absolute inset-0 z-0">
    <video class="w-full h-full object-cover" autoplay muted loop playsinline>
      <source src="/videos/hero-pie.mp4" type="video/mp4" />
    </video>
    <!-- Medium overlay -->
    <div class="absolute inset-0 bg-black/35"></div>
  </div>

  <!-- Content -->
  <div class="container relative z-10 text-center py-32 px-4">

    <!-- Label -->
    <div class="outline-label animate-on-scroll">
      <span class="outline-label-dot"></span>
      Oostende · Bakkerij · Sinds 2018
    </div>

    <!-- Main title — outlined stroke effect -->
    <h1 class="outline-title animate-on-scroll stagger-2">
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="outline-subtitle animate-on-scroll stagger-3">
      {subtitle}
    </p>

    <!-- CTAs -->
    {showCTA && (
      <div class="outline-actions animate-on-scroll stagger-4">
        <a href="/feestcollectie" class="outline-btn-primary">
          Bekijk collecties
        </a>
        <a href="/bestellen" class="outline-btn-outline">
          Bestel nu
        </a>
      </div>
    )}

    <!-- Bottom decor -->
    <div class="outline-decor animate-on-scroll stagger-4">
      <div class="outline-decor-line"></div>
      <span class="outline-decor-heart">♥</span>
      <div class="outline-decor-line"></div>
    </div>
  </div>

  <!-- Scroll -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </div>
</section>

<style>
  /* ── Label ──────────────────────────────────────────────────────────────── */
  .outline-label {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 2rem;
  }

  .outline-label-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #E8788A;
    box-shadow: 0 0 8px #E8788A;
    flex-shrink: 0;
  }

  /* ── Title with text stroke (outline effect) ─────────────────────────────── */
  .outline-title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(3rem, 10vw, 9rem);
    font-weight: 800;
    color: #ffffff;
    line-height: 1.0;
    letter-spacing: -0.03em;
    margin: 0 auto 1.75rem;
    /* Outlined/stroked text effect */
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.9);
    paint-order: stroke fill;
    /* Subtle fill to make it readable */
    text-shadow:
      0 0 30px rgba(255, 255, 255, 0.15),
      0 0 60px rgba(255, 255, 255, 0.08);
    filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.4));
  }

  /* ── Subtitle ──────────────────────────────────────────────────────────── */
  .outline-subtitle {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin: 0 auto 2.5rem;
    max-width: 500px;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.5);
  }

  /* ── Buttons ────────────────────────────────────────────────────────────── */
  .outline-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .outline-btn-primary {
    background: #ffffff;
    color: #0a0a0a;
    border-radius: 0.5rem;
    padding: 0.875rem 2.25rem;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.2s;
    letter-spacing: 0.01em;
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.3),
      0 2px 6px rgba(0, 0, 0, 0.2);
  }

  .outline-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }

  .outline-btn-outline {
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.5);
    color: #ffffff;
    border-radius: 0.5rem;
    padding: 0.875rem 2.25rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.2s;
  }

  .outline-btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.8);
    transform: translateY(-2px);
  }

  /* ── Heart divider ──────────────────────────────────────────────────────── */
  .outline-decor {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: 3rem;
  }

  .outline-decor-line {
    width: 3rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
  }

  .outline-decor-heart {
    font-size: 1rem;
    color: #E8788A;
    filter: drop-shadow(0 0 6px rgba(232, 120, 138, 0.6));
  }

  @media (max-width: 640px) {
    .outline-title {
      -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.9);
    }
  }
</style>
