---
// HeroV1.astro — "Dark Panel"
// Heavy dark overlay + bold white text, maximum contrast over video
interface Props {
  title?: string;
  subtitle?: string;
  showCTA?: boolean;
}
const {
  title = "De prachtigste taarten...",
  subtitle = "fijnste koekjes en heerlijkste cake, met liefde gebakken in Oostende",
  showCTA = true
} = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background video -->
  <div class="absolute inset-0 z-0">
    <video class="w-full h-full object-cover" autoplay muted loop playsinline>
      <source src="/videos/hero-pie.mp4" type="video/mp4" />
    </video>
    <!-- Heavy dark overlay for max text contrast -->
    <div class="absolute inset-0 bg-black/65"></div>
  </div>

  <!-- Hero content -->
  <div class="container relative z-10 text-center py-32 px-4">
    <!-- Decorative top line -->
    <div class="flex items-center justify-center gap-3 mb-8 animate-on-scroll">
      <div class="h-px w-12 bg-white/40"></div>
      <span class="text-white/60 text-xs uppercase tracking-[0.2em] font-medium">Oostende</span>
      <div class="h-px w-12 bg-white/40"></div>
    </div>

    <!-- Main heading -->
    <h1 class="font-heading text-5xl md:text-6xl lg:text-8xl font-bold text-white mb-6 animate-on-scroll text-balance leading-[1.05]"
        style="text-shadow: 0 2px 30px rgba(0,0,0,0.5);">
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-white/80 max-w-2xl mx-auto mb-12 animate-on-scroll stagger-2 leading-relaxed">
      {subtitle}
    </p>

    <!-- CTA -->
    {showCTA && (
      <div class="flex justify-center gap-4 animate-on-scroll stagger-3">
        <a href="/feestcollectie" class="btn btn-primary text-base px-10 py-4">
          Bekijk collecties
        </a>
        <a href="/bestellen" class="btn btn-secondary-light text-base px-10 py-4">
          Bestel nu
        </a>
      </div>
    )}

    <!-- Decorative bottom badge -->
    <div class="mt-16 animate-on-scroll stagger-4">
      <div class="inline-flex items-center gap-2 text-white/50 text-xs uppercase tracking-widest">
        <span class="w-1.5 h-1.5 rounded-full bg-[#E8788A]"></span>
        Vers gebakken met liefde
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-on-scroll stagger-4">
    <div class="flex flex-col items-center text-white/40">
      <span class="text-[10px] uppercase tracking-[0.2em] mb-2">Ontdek</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>
</section>

<style>
  .btn-secondary-light {
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.3);
    color: white;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .btn-secondary-light:hover {
    background: rgba(255,255,255,0.2);
    border-color: rgba(255,255,255,0.5);
  }
</style>
