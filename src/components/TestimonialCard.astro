---
interface Props {
  quote: string;
  author: string;
  role?: string;
  authorImage?: string;
}

const { quote, author, role, authorImage } = Astro.props;
---

<figure class="relative bg-white rounded-xl p-8 shadow-sm">
  <!-- Quote mark decoration -->
  <svg class="absolute -top-4 -left-4 w-10 h-10 text-[var(--color-secondary)]/30" fill="currentColor" viewBox="0 0 24 24">
    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
  </svg>

  <blockquote class="relative z-10">
    <p class="text-[var(--color-text)] leading-relaxed mb-6 italic">
      "{quote}"
    </p>
    <figcaption class="flex items-center gap-4">
      {authorImage ? (
        <img 
          src={authorImage} 
          alt={author}
          class="w-14 h-14 rounded-full object-cover border-2 border-[var(--color-secondary)]"
        />
      ) : (
        <div class="w-14 h-14 rounded-full bg-[var(--color-primary)] flex items-center justify-center text-white font-semibold text-xl">
          {author.charAt(0)}
        </div>
      )}
      <div>
        <cite class="not-italic font-semibold text-[var(--color-text)]">{author}</cite>
        {role && <p class="text-sm text-[var(--color-text-muted)]">{role}</p>}
      </div>
    </figcaption>
  </blockquote>
</figure>