---
// Decorative interactive 3D layer with floating cupcakes and hearts (see src/scripts/sprinkles/).
// Place inside a `position: relative` section; it fills it and sits behind content.
interface Props {
  cupcakes?: number;
  hearts?: number;
  seed?: number;
  /** Fade the 3D scene out where text sits so copy stays readable */
  mask?: 'none' | 'left' | 'center';
  class?: string;
}

const { cupcakes = 7, hearts = 18, seed = 7, mask = 'none', class: className = '' } = Astro.props;
---

<canvas
  class:list={['sprinkle-field', `mask-${mask}`, className]}
  data-cupcakes={cupcakes}
  data-hearts={hearts}
  data-seed={seed}
  aria-hidden="true"
></canvas>

<script>
  import '../scripts/sprinkles/index';
</script>

<style>
  .sprinkle-field {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .sprinkle-field:global(.is-ready) {
    opacity: 1;
  }
  .mask-left {
    -webkit-mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.25) 42%, #000 62%);
    mask-image: linear-gradient(90deg, rgba(0, 0, 0, 0.18) 0%, rgba(0, 0, 0, 0.25) 42%, #000 62%);
  }
  .mask-center {
    -webkit-mask-image: radial-gradient(ellipse 42% 38% at 50% 48%, rgba(0, 0, 0, 0.2), #000 100%);
    mask-image: radial-gradient(ellipse 42% 38% at 50% 48%, rgba(0, 0, 0, 0.2), #000 100%);
  }
  @media (max-width: 1023px) {
    .mask-left {
      -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.2) 25%, rgba(0, 0, 0, 0.2) 100%);
      mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.2) 25%, rgba(0, 0, 0, 0.2) 100%);
    }
  }
</style>
