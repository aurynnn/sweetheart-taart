---
interface Props {
  id: string;
  name: string;
  minDate?: string;
  maxDate?: string;
}

const { id, name, minDate } = Astro.props;

const today = new Date().toISOString().split('T')[0];
const min = minDate || today;
---

<div class="agenda-picker" id={`${id}-container`}>
  <input type="hidden" id={id} name={name} value="" />
  
  <!-- Month Navigation -->
  <div class="agenda-nav">
    <button type="button" class="nav-btn" id={`${id}-prev`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <h3 class="month-title" id={`${id}-title`}></h3>
    <button type="button" class="nav-btn" id={`${id}-next`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
  
  <!-- Calendar Grid -->
  <div class="agenda-grid" id={`${id}-grid`}>
    <!-- Day headers -->
    <div class="day-header">Ma</div>
    <div class="day-header">Di</div>
    <div class="day-header">Wo</div>
    <div class="day-header">Do</div>
    <div class="day-header">Vr</div>
    <div class="day-header">Za</div>
    <div class="day-header">Zo</div>
    <!-- Date cells will be injected here -->
  </div>
  
  <!-- Selected Info -->
  <div class="selected-info" id={`${id}-selected`}>
    <span class="no-date">Selecteer een beschikbare datum</span>
  </div>
</div>

<script define:vars={{ id, minDate: min }}>
  const grid = document.getElementById(`${id}-grid`);
  const title = document.getElementById(`${id}-title`);
  const prevBtn = document.getElementById(`${id}-prev`);
  const nextBtn = document.getElementById(`${id}-next`);
  const hiddenInput = document.getElementById(id);
  const selectedInfo = document.getElementById(`${id}-selected`);
  
  let currentDate = new Date();
  let availabilityData = {};
  let selectedValue = null;
  
  // Day names in Dutch
  const dayNames = ['Zondag', 'Maandag', 'Dinsdag', 'Woensdag', 'Donderdag', 'Vrijdag', 'Zaterdag'];
  const monthNames = ['Januari', 'Februari', 'Maart', 'April', 'Mei', 'Juni', 'Juli', 'Augustus', 'September', 'Oktober', 'November', 'December'];
  
  async function fetchAvailability() {
    try {
      const today = new Date().toISOString().split('T')[0];
      const future = new Date();
      future.setDate(future.getDate() + 90);
      const endDate = future.toISOString().split('T')[0];
      
      const response = await fetch(`/api/availability?startDate=${today}&endDate=${endDate}`);
      const data = await response.json();
      
      if (data.availability) {
        data.availability.forEach(slot => {
          availabilityData[slot.date] = slot;
        });
      }
      
      renderCalendar();
    } catch (err) {
      console.log('Could not fetch availability:', err);
      renderCalendar();
    }
  }
  
  function renderCalendar() {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    
    // Update title
    title.textContent = `${monthNames[month]} ${year}`;
    
    // Clear existing date cells (keep headers)
    const headers = grid.querySelectorAll('.day-header');
    grid.innerHTML = '';
    headers.forEach(h => grid.appendChild(h));
    
    // Get first day of month and number of days
    const firstDay = new Date(year, month, 1);
    const lastDay = new Date(year, month + 1, 0);
    const daysInMonth = lastDay.getDate();
    
    // Get day of week for first day (0 = Sunday, convert to Monday = 0)
    let startDay = firstDay.getDay() - 1;
    if (startDay < 0) startDay = 6;
    
    // Add empty cells before first day
    for (let i = 0; i < startDay; i++) {
      const empty = document.createElement('div');
      empty.className = 'date-cell empty';
      grid.appendChild(empty);
    }
    
    // Add day cells
    const todayStr = new Date().toISOString().split('T')[0];
    
    for (let day = 1; day <= daysInMonth; day++) {
      const dateObj = new Date(year, month, day);
      const dateStr = dateObj.toISOString().split('T')[0];
      const dayOfWeek = dateObj.getDay();
      
      const cell = document.createElement('button');
      cell.type = 'button';
      cell.className = 'date-cell';
      cell.textContent = day;
      cell.dataset.date = dateStr;
      
      const slot = availabilityData[dateStr];
      const isPast = dateStr < todayStr;
      const isSunday = dayOfWeek === 0;
      const isSaturday = dayOfWeek === 6;
      
      if (isPast) {
        cell.classList.add('past');
      } else if (slot && !slot.available) {
        cell.classList.add('unavailable');
        cell.title = slot.reason || 'Niet beschikbaar';
      } else if (isSunday) {
        cell.classList.add('unavailable');
        cell.title = 'Gesloten op zondag';
      } else if (isSaturday) {
        cell.classList.add('saturday');
        cell.addEventListener('click', () => selectDate(dateStr, cell));
      } else {
        cell.classList.add('available');
        
        // Show remaining if limited
        if (slot && slot.remaining <= 2) {
          cell.classList.add('limited');
          cell.title = `${slot.remaining} plaats over`;
        }
        
        cell.addEventListener('click', () => selectDate(dateStr, cell));
      }
      
      grid.appendChild(cell);
    }
    
    // Disable prev if current month
    const currentMonth = new Date().getMonth();
    const currentYear = new Date().getFullYear();
    prevBtn.disabled = (month === currentMonth && year === currentYear);
  }
  
  function selectDate(dateStr, cell) {
    // Remove previous selection
    document.querySelectorAll('.date-cell.selected').forEach(el => el.classList.remove('selected'));
    
    // Select new
    cell.classList.add('selected');
    selectedValue = dateStr;
    hiddenInput.value = dateStr;
    
    const slot = availabilityData[dateStr];
    const date = new Date(dateStr + 'T00:00:00');
    const formatted = `${dayNames[date.getDay()]} ${date.getDate()} ${monthNames[date.getMonth()]} ${date.getFullYear()}`;
    
    selectedInfo.innerHTML = `
      <span class="date-text">${formatted}</span>
      <span class="slots-text ${slot?.available ? 'available' : 'unavailable'}">
        ${slot?.available ? `${slot.remaining} plaats over` : (slot?.reason || 'Niet beschikbaar')}
      </span>
    `;
    
    hiddenInput.dispatchEvent(new Event('change'));
  }
  
  prevBtn.addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
  });
  
  nextBtn.addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
  });
  
  // Initial render
  renderCalendar();
  fetchAvailability();
</script>

<style>
.agenda-picker {
  background: white;
  border-radius: 1rem;
  padding: 1rem;
  border: 1px solid #F0E0E2;
  font-family: inherit;
  max-width: 280px;
}

.agenda-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.75rem;
}

.nav-btn {
  width: 1.75rem;
  height: 1.75rem;
  border: none;
  background: #FDEEF0;
  border-radius: 0.5rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #E8788A;
  transition: all 0.2s;
  padding: 0;
}

.nav-btn:hover:not(:disabled) {
  background: #fce7f3;
}

.nav-btn:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.month-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: #1e293b;
  margin: 0;
}

.agenda-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0.25rem;
}

.day-header {
  text-align: center;
  font-size: 0.625rem;
  font-weight: 600;
  color: #94a3b8;
  padding: 0.25rem 0;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.date-cell {
  aspect-ratio: 1;
  border: none;
  background: transparent;
  border-radius: 0.5rem;
  font-size: 0.75rem;
  font-weight: 500;
  color: #334155;
  cursor: pointer;
  transition: all 0.15s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-cell.empty {
  cursor: default;
}

.date-cell.available {
  background: #FDEEF0;
  color: #E8788A;
}

.date-cell.available:hover {
  background: #fce7f3;
  transform: scale(1.05);
}

.date-cell.past {
  color: #cbd5e1;
  cursor: not-allowed;
  text-decoration: line-through;
}

.date-cell.unavailable {
  background: #f1f5f9;
  color: #cbd5e1;
  cursor: not-allowed;
}

.date-cell.limited {
  background: #fef3c7;
  color: #92400e;
}

.date-cell.saturday {
  background: #fef9c3;
  color: #a16207;
}

.date-cell.saturday:hover {
  background: #fef08a;
}

.date-cell.selected {
  background: #E8788A !important;
  color: white !important;
  transform: scale(1.1);
  box-shadow: 0 2px 8px rgba(232, 120, 138, 0.3);
}

.selected-info {
  margin-top: 0.75rem;
  padding: 0.625rem 0.75rem;
  background: #FDEEF0;
  border-radius: 0.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.selected-info .no-date {
  font-size: 0.75rem;
  color: #64748b;
}

.selected-info .date-text {
  font-weight: 600;
  color: #1e293b;
  font-size: 0.8125rem;
}

.selected-info .slots-text {
  font-size: 0.6875rem;
  font-weight: 500;
}

.selected-info .slots-text.available {
  color: #16a34a;
}

.selected-info .slots-text.unavailable {
  color: #dc2626;
}
</style>
