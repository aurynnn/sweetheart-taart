---
interface Props {
  id: string;
  name: string;
  minDate?: string;
  maxDate?: string;
}

const { id, name, minDate } = Astro.props;
function toLocalDateStr(d) {
  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
}
const today = toLocalDateStr(new Date());
const min = minDate || today;
---

<div class="agenda-picker" id={`${id}-container`}>
  <input type="hidden" id={id} name={name} value="" />
  
  <div class="agenda-nav">
    <button type="button" class="nav-btn" id={`${id}-prev`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>
    <h3 class="month-title" id={`${id}-title`}></h3>
    <button type="button" class="nav-btn" id={`${id}-next`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>
  </div>
  
  <div class="agenda-grid" id={`${id}-grid`}>
    <div class="day-header">Ma</div>
    <div class="day-header">Di</div>
    <div class="day-header">Wo</div>
    <div class="day-header">Do</div>
    <div class="day-header">Vr</div>
    <div class="day-header">Za</div>
    <div class="day-header">Zo</div>
  </div>
  
  <div class="selected-info" id={`${id}-selected`}>
    <span class="no-date">Selecteer een beschikbare datum</span>
  </div>
</div>

<script define:vars={{ id, minDate: min }}>
  function toLocalDateStr(d) {
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }

  const grid = document.getElementById(`${id}-grid`);
  const title = document.getElementById(`${id}-title`);
  const prevBtn = document.getElementById(`${id}-prev`);
  const nextBtn = document.getElementById(`${id}-next`);
  const hiddenInput = document.getElementById(id);
  const selectedInfo = document.getElementById(`${id}-selected`);
  
  let currentDate = new Date();
  let availabilityData = {};
  let selectedDates = new Set();
  
  const dayNames = ['Zondag', 'Maandag', 'Dinsdag', 'Woensdag', 'Donderdag', 'Vrijdag', 'Zaterdag'];
  const monthNames = ['Januari', 'Februari', 'Maart', 'April', 'Mei', 'Juni', 'Juli', 'Augustus', 'September', 'Oktober', 'November', 'December'];
  
  async function fetchAvailability() {
    try {
      const today = toLocalDateStr(new Date());
      const future = new Date();
      future.setDate(future.getDate() + 90);
      const endDate = toLocalDateStr(future);
      
      const response = await fetch(`/api/availability?startDate=${today}&endDate=${endDate}`);
      const data = await response.json();
      
      if (data.availability) {
        data.availability.forEach(slot => {
          availabilityData[slot.date] = slot;
        });
      }
      renderCalendar();
    } catch (err) {
      renderCalendar();
    }
  }
  
  function renderCalendar() {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();
    title.textContent = `${monthNames[month]} ${year}`;
    
    // Remove old day cells (keep day-header elements in place)
    grid.querySelectorAll('.date-cell').forEach(el => el.remove());
    
    const firstDay = new Date(year, month, 1);
    const lastDay = new Date(year, month + 1, 0);
    const daysInMonth = lastDay.getDate();
    
    let startDay = firstDay.getDay() - 1;
    if (startDay < 0) startDay = 6;
    
    for (let i = 0; i < startDay; i++) {
      const empty = document.createElement('div');
      empty.className = 'date-cell empty';
      grid.appendChild(empty);
    }
    
    const todayStr = toLocalDateStr(new Date());
    
    for (let day = 1; day <= daysInMonth; day++) {
      const dateObj = new Date(year, month, day);
      const dateStr = dateObj.getFullYear() + '-' + String(dateObj.getMonth() + 1).padStart(2, '0') + '-' + String(dateObj.getDate()).padStart(2, '0');
      const dayOfWeek = dateObj.getDay();
      
      const cell = document.createElement('button');
      cell.type = 'button';
      cell.className = 'date-cell';
      cell.textContent = day;
      cell.dataset.date = dateStr;
      
      const slot = availabilityData[dateStr];
      const isPast = dateStr < todayStr;
      const isSunday = dayOfWeek === 0;
      
      if (isPast) {
        cell.classList.add('past');
      } else if (isSunday) {
        cell.classList.add('unavailable');
      } else if (slot && !slot.available) {
        cell.classList.add('unavailable');
      } else if (slot && slot.remaining <= 2) {
        cell.classList.add('limited');
        cell.addEventListener('click', () => selectDate(dateStr, cell));
      } else {
        cell.classList.add('available');
        cell.addEventListener('click', () => selectDate(dateStr, cell));
      }
      
      grid.appendChild(cell);
    }
    
    const currentMonth = new Date().getMonth();
    const currentYear = new Date().getFullYear();
    prevBtn.disabled = (month === currentMonth && year === currentYear);
  }
  
  function selectDate(dateStr, cell) {
    if (selectedDates.has(dateStr)) {
      selectedDates.delete(dateStr);
      cell.classList.remove('selected');
    } else {
      selectedDates.add(dateStr);
      cell.classList.add('selected');
    }
    hiddenInput.value = JSON.stringify([...selectedDates]);

    if (selectedDates.size === 0) {
      selectedInfo.innerHTML = '<span class="no-date">Selecteer een beschikbare datum</span>';
    } else if (selectedDates.size === 1) {
      const slot = availabilityData[[...selectedDates][0]];
      const d = new Date([...selectedDates][0] + 'T00:00:00');
      const formatted = `${dayNames[d.getDay()]} ${d.getDate()} ${monthNames[d.getMonth()]} ${d.getFullYear()}`;
      selectedInfo.innerHTML = `
        <span class="date-text">${formatted}</span>
        <span class="slots-text ${slot?.available ? 'available' : 'unavailable'}">
          ${slot?.available ? `${slot.remaining} plaats over` : (slot?.reason || 'Niet beschikbaar')}
        </span>
      `;
    } else {
      const dates = [...selectedDates].sort().map(ds => {
        const d = new Date(ds + 'T00:00:00');
        return `${d.getDate()} ${monthNames[d.getMonth()]}`;
      });
      selectedInfo.innerHTML = `
        <span class="date-text">${dates.join(', ')}</span>
        <span class="slots-text">${selectedDates.size} datums geselecteerd</span>
      `;
    }

    hiddenInput.dispatchEvent(new Event('change'));
  }
  
  prevBtn.addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() - 1);
    renderCalendar();
  });
  
  nextBtn.addEventListener('click', () => {
    currentDate.setMonth(currentDate.getMonth() + 1);
    renderCalendar();
  });
  
  renderCalendar();
  fetchAvailability();
</script>

<style is:global>
.agenda-picker {
  background: white;
  border-radius: 0.75rem;
  padding: 0.75rem;
  border: 1px solid #F0E0E2;
  font-family: inherit;
  max-width: 360px;
}

.agenda-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.5rem;
}

.nav-btn {
  width: 1.25rem;
  height: 1.25rem;
  border: none;
  background: #FDF2F4;
  border-radius: 0.25rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #E8788A;
  transition: all 0.1s;
  padding: 0;
}

.nav-btn:hover:not(:disabled) {
  background: #FDEEF0;
}

.nav-btn:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.month-title {
  font-size: 0.75rem;
  font-weight: 600;
  color: #1e293b;
  margin: 0;
}

.agenda-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 0.2rem;
}

.day-header {
  text-align: center;
  font-size: 0.5rem;
  font-weight: 600;
  color: #B0B0B0;
  padding: 0.2rem 0;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.date-cell {
  aspect-ratio: 1;
  border: none;
  border-radius: 0.25rem;
  font-size: 0.5625rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.1s;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  min-height: 22px;
}

.date-cell.empty {
  cursor: default;
  background: transparent !important;
}

.date-cell.available {
  background: #E8788A;
  color: white;
}

.date-cell.available:hover {
  background: #D66B7A;
  transform: scale(1.05);
}

.date-cell.past {
  background: #FDF2F4;
  color: #E0E0E0;
  cursor: not-allowed;
}

.date-cell.unavailable {
  background: #FDF2F4;
  color: #D0D0D0;
  cursor: not-allowed;
}

.date-cell.limited {
  background: #FEF3C7;
  color: #B45309;
}

.date-cell.limited:hover {
  background: #FDE68A;
}

.date-cell.selected {
  background: white !important;
  color: #E8788A !important;
  border: 2px solid #E8788A;
  transform: scale(1.05);
}

.selected-info {
  margin-top: 0.625rem;
  padding: 0.5rem 0.625rem;
  background: #FDF2F4;
  border-radius: 0.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}

.selected-info .no-date {
  font-size: 0.6875rem;
  color: #94A3B8;
}

.selected-info .date-text {
  font-weight: 600;
  color: #1E293B;
  font-size: 0.75rem;
}

.selected-info .slots-text {
  font-size: 0.625rem;
  font-weight: 500;
}

.selected-info .slots-text.available {
  color: #16A34A;
}

.selected-info .slots-text.unavailable {
  color: #DC2626;
}
</style>
