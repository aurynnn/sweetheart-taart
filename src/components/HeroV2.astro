---
// HeroV2.astro — "Frosted Glass"
// Glassmorphism card behind text — text floats on semi-transparent panel
interface Props {
  title?: string;
  subtitle?: string;
  showCTA?: boolean;
}
const {
  title = "De prachtigste taarten...",
  subtitle = "fijnste koekjes en heerlijkste cake, met liefde gebakken in Oostende",
  showCTA = true
} = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background video -->
  <div class="absolute inset-0 z-0">
    <video class="w-full h-full object-cover" autoplay muted loop playsinline>
      <source src="/videos/hero-pie.mp4" type="video/mp4" />
    </video>
    <!-- Light overlay so glass panel stands out -->
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  <!-- Frosted glass card -->
  <div class="relative z-10 w-full max-w-2xl mx-auto px-6 py-32">
    <div class="frosted-card animate-on-scroll">
      <!-- Eyebrow -->
      <div class="frosted-eyebrow">
        <span class="frosted-dot"></span>
        Ambachtelijke bakkerij · Oostende
      </div>

      <!-- Heading -->
      <h1 class="frosted-title">
        {title}
      </h1>

      <!-- Subtitle -->
      <p class="frosted-subtitle">
        {subtitle}
      </p>

      <!-- CTAs -->
      {showCTA && (
        <div class="flex flex-wrap gap-3 justify-center frosted-actions">
          <a href="/feestcollectie" class="btn btn-primary px-8 py-3.5 text-base">
            Bekijk collecties
          </a>
          <a href="/bestellen" class="btn btn-ghost-white px-8 py-3.5 text-base">
            Bestel nu
          </a>
        </div>
      )}

      <!-- Stats row -->
      <div class="frosted-stats">
        <div class="frosted-stat">
          <span class="frosted-stat-num">2018</span>
          <span class="frosted-stat-label">Opgericht</span>
        </div>
        <div class="frosted-stat-divider"></div>
        <div class="frosted-stat">
          <span class="frosted-stat-num">100%</span>
          <span class="frosted-stat-label">Vers &amp; Lokaal</span>
        </div>
        <div class="frosted-stat-divider"></div>
        <div class="frosted-stat">
          <span class="frosted-stat-num">♥</span>
          <span class="frosted-stat-label">Met liefde</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10">
    <div class="flex flex-col items-center text-white/50 gap-1.5 animate-bounce">
      <span class="text-[10px] uppercase tracking-[0.2em]">Scroll</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>
</section>

<style>
  .frosted-card {
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 1.5rem;
    padding: 3rem 2.5rem;
    text-align: center;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .frosted-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 1.25rem;
  }

  .frosted-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #E8788A;
    box-shadow: 0 0 8px #E8788A;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  .frosted-title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.08;
    margin: 0 0 1rem;
    text-shadow: 0 4px 20px rgba(0,0,0,0.3);
    letter-spacing: -0.02em;
  }

  .frosted-subtitle {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin: 0 0 2rem;
    max-width: 420px;
    margin-left: auto;
    margin-right: auto;
  }

  .frosted-actions {
    margin-bottom: 2.5rem;
  }

  .btn-ghost-white {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.3);
    color: white;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .btn-ghost-white:hover {
    background: rgba(255,255,255,0.16);
    border-color: rgba(255,255,255,0.5);
    transform: translateY(-1px);
  }

  .frosted-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255,255,255,0.15);
  }

  .frosted-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
  }

  .frosted-stat-num {
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    line-height: 1;
  }

  .frosted-stat-label {
    font-size: 0.625rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.55);
  }

  .frosted-stat-divider {
    width: 1px;
    height: 2rem;
    background: rgba(255,255,255,0.2);
  }

  @media (max-width: 480px) {
    .frosted-card {
      padding: 2rem 1.5rem;
    }
    .frosted-stats {
      gap: 1rem;
    }
  }
</style>
