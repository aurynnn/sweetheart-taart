---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/feestcollectie', label: 'Feestcollectie' },
  { href: '/mini-collectie', label: 'Mini-collectie' },
  { href: '/koekjescollectie', label: 'Koekjes' },
];
---

<header id="main-header">
  <div class="container">
    <nav class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-full bg-[var(--color-primary)] flex items-center justify-center text-white font-heading text-xl font-bold transition-transform group-hover:scale-105">
          S
        </div>
        <div class="hidden sm:block">
          <span class="font-heading text-xl font-semibold text-[var(--color-primary)]">Sweetheart</span>
          <span class="block text-xs text-[var(--color-text-muted)] -mt-1">Koekjes, Cake & Taart</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="relative text-sm font-medium transition-colors hover:text-[var(--color-primary)] desktop-nav-link"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA Button (Desktop) -->
      <a href="/bestellen" class="hidden lg:flex btn btn-primary text-sm">
        Bestel nu
      </a>

      <!-- Mobile Menu Toggle -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden p-2 -mr-2 text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors"
        aria-label="Menu openen"
      >
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-[var(--z-overlay)] lg:hidden hidden">
  <!-- Backdrop -->
  <button
    type="button"
    id="mobile-menu-backdrop"
    class="absolute inset-0 bg-black/30 backdrop-blur-sm"
    aria-label="Menu sluiten"
  ></button>

  <!-- Menu Panel -->
  <div class="absolute top-0 right-0 bottom-0 w-80 max-w-[85vw] bg-[var(--color-surface)] shadow-2xl overflow-y-auto">
    <div class="p-6">
      <!-- Close Button -->
      <div class="flex justify-end mb-8">
        <button
          type="button"
          id="mobile-menu-close"
          class="p-2 -m-2 text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
          aria-label="Menu sluiten"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Nav Links -->
      <nav class="space-y-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="block px-4 py-3 rounded-lg text-lg font-medium transition-colors hover:bg-[var(--color-secondary)] mobile-nav-link"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA -->
      <div class="mt-8 pt-8 border-t border-[var(--color-border)]">
        <a href="/bestellen" class="btn btn-primary w-full">
          Bestel nu
        </a>
      </div>

      <!-- Contact Info -->
      <div class="mt-8 space-y-3 text-sm text-[var(--color-text-muted)]">
        <p>
          <a href="tel:+32486953210" class="hover:text-[var(--color-primary)] transition-colors">
            +32 486 95 32 10
          </a>
        </p>
        <p>
          <a href="mailto:nathalie@sweetheart-taart.com" class="hover:text-[var(--color-primary)] transition-colors">
            nathalie@sweetheart-taart.com
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  // Mobile menu functionality
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuBackdrop = document.getElementById('mobile-menu-backdrop');
  const menuClose = document.getElementById('mobile-menu-close');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const header = document.getElementById('main-header');

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
    menuIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
    menuIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('hidden')) {
      openMenu();
    } else {
      closeMenu();
    }
  });

  menuBackdrop?.addEventListener('click', closeMenu);
  menuClose?.addEventListener('click', closeMenu);

  // Close menu when clicking nav links
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Header scroll effect
  const handleScroll = () => {
    if (header) {
      if (window.scrollY > 20) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Set active nav link
  const currentPath = window.location.pathname;
  document.querySelectorAll('.desktop-nav-link').forEach(link => {
    if ((link as HTMLAnchorElement).href === window.location.href) {
      link.classList.add('active');
    }
  });
</script>

<style>
  #main-header {
    background-color: transparent;
    transition: background-color 300ms ease, box-shadow 300ms ease;
  }

  #main-header.scrolled {
    background-color: rgba(253, 248, 245, 0.95);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-sm);
  }

  :global(.desktop-nav-link) {
    color: var(--color-text);
  }

  :global(.desktop-nav-link:hover) {
    color: var(--color-primary);
  }

  :global(.desktop-nav-link.active) {
    color: var(--color-primary);
  }

  :global(.desktop-nav-link.active::after) {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 1px;
  }
</style>
