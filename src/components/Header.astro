---
import { SITE } from '../config/site';
import { NAV_LINKS, isCurrent } from '../config/navigation';
import Logo from './ui/Logo.astro';
import MobileMenu from './MobileMenu.astro';

const pathname = Astro.url.pathname;
---

<header id="main-header">
  <div class="container">
    <nav class="flex items-center justify-between h-20" aria-label="Hoofdmenu">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group" aria-label="Sweetheart — naar de homepagina">
        <Logo class="header-logo w-16 h-16 sm:w-20 sm:h-20 transition-transform group-hover:scale-105" />
        <div class="hidden sm:block">
          <span class="font-heading text-3xl font-bold header-logo-text">Sweetheart</span>
          <span class="block text-sm opacity-70 -mt-0.5 header-logo-text">Koekjes, Cake & Taart</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        {NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={['relative text-base font-semibold transition-colors hover:text-[var(--color-primary)] desktop-nav-link', { active: isCurrent(link.href, pathname) }]}
            aria-current={isCurrent(link.href, pathname) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))}
        <a href={SITE.reviewUrl} target="_blank" rel="noopener" class="review-star" aria-label="Laat een Google-review achter" data-tooltip="Laat een review achter">
          <i class="fa-solid fa-star" aria-hidden="true"></i>
        </a>
      </div>

      <!-- CTA (Desktop) -->
      <a href="/aanvraag" class="hidden lg:flex btn btn-primary text-sm btn-shine" data-magnetic="0.25" title="Vrijblijvende aanvraag — je betaalt pas na bevestiging">
        Bestellen
      </a>

      <!-- Mobile Menu Toggle -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="menu-toggle lg:hidden"
        aria-label="Menu openen"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<MobileMenu />

<style>
  /* ── Transparent header over hero video ─────────────────────────────── */
  #main-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top, 0px);
    background-color: transparent !important;
    box-shadow: none !important;
  }

  /* ── Nav links: normal font + white glow on dark hero ───────────── */
  :global(.desktop-nav-link) {
    font-family: var(--font-body);
    color: rgba(255, 255, 255, 0.92);
    transition: color 300ms ease;
    text-shadow:
      0.75px 0.75px 0px #ffcce0,
      -0.25px -0.25px 0px #ffcce0,
      0.25px -0.25px 0px #ffcce0,
      -0.25px 0.25px 0px #ffcce0,
      0px 0px 8px #ffccd5,
      0px 0px 16px #ffd9e6;
  }

  :global(.desktop-nav-link:hover),
  :global(.desktop-nav-link.active) {
    color: #ffffff;
  }

  :global(.desktop-nav-link.active::after) {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #ffffff;
    border-radius: 1px;
    box-shadow: 0 0 8px #ffcce0;
  }

  /* ── Scrolled state nav links — dark, no glow ──────────────────────── */
  #main-header.scrolled :global(.desktop-nav-link),
  #main-header.scrolled :global(.desktop-nav-link:hover),
  #main-header.scrolled :global(.desktop-nav-link.active) {
    color: var(--color-text);
    text-shadow: none;
  }

  #main-header.scrolled :global(.desktop-nav-link.active::after) {
    background-color: var(--color-primary);
    box-shadow: none;
  }

  /* ── Logo text: Caveat + full glow, same as hero title ───────────────── */
  :global(.header-logo-text) {
    font-family: var(--font-heading);
    font-weight: 900;
    color: #ffffff;
    transition: color 300ms ease;
    text-shadow:
      1.5px 1.5px 0px #ffcce0,
      -0.5px -0.5px 0px #ffcce0,
      0.5px -0.5px 0px #ffcce0,
      -0.5px 0.5px 0px #ffcce0,
      0px 0px 10px #ffccd5,
      0px 0px 20px #ffd9e6,
      0px 0px 40px #ffe4ed,
      0px 0px 60px #fff0f5;
  }

  #main-header.scrolled :global(.header-logo-text) {
    color: var(--color-primary);
    text-shadow: none;
  }

  /* ── CTA button over hero ──────────────────────────────────────────── */
  #main-header .btn.btn-primary {
    background: rgba(232, 120, 138, 0.85);
    backdrop-filter: blur(4px);
    transition: background 300ms ease, transform 150ms ease, box-shadow 150ms ease;
  }

  #main-header .btn.btn-primary:hover {
    background: #E8788A;
    box-shadow: 0 4px 16px rgba(232, 120, 138, 0.5);
  }

  #main-header.scrolled .btn.btn-primary {
    background: var(--color-primary);
  }

  /* ── Mobile menu toggle: 44px frosted button, readable on every hero ── */
  .menu-toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: -0.25rem;
    border-radius: 999px;
    color: #fff;
    background: rgba(255, 255, 255, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(6px);
    filter: drop-shadow(0 0 6px rgba(212, 90, 106, 0.35));
    transition: background 200ms ease, transform 150ms ease;
  }
  .menu-toggle:active { transform: scale(0.94); background: rgba(255, 255, 255, 0.4); }
  @media (min-width: 1024px) { .menu-toggle { display: none; } }

  /* ── Review star: small, glowing like the nav, tooltip on hover ─────── */
  .review-star {
    position: relative; width: 2.2rem; height: 2.2rem; margin-left: -1rem; border-radius: 50%; display: grid; place-items: center; font-size: 0.9rem;
    color: #fff; background: rgba(255, 255, 255, 0.18); backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.45);
    filter: drop-shadow(0 0 6px #ffcce0);
    transition: transform 300ms var(--ease-spring), background 250ms ease, color 250ms ease;
  }
  .review-star:hover, .review-star:focus-visible { background: #fff; color: #F5B83D; transform: scale(1.08); }
  .review-star:hover i { rotate: -14deg; transition: rotate 300ms var(--ease-spring); }
  .review-star i { animation: twinkle 5s ease-in-out infinite; }
  @keyframes twinkle { 0%, 88%, 100% { transform: none; } 92% { transform: scale(1.3) rotate(20deg); } 96% { transform: scale(0.95); } }
  .review-star::after {
    content: attr(data-tooltip); position: absolute; top: calc(100% + 0.5rem); left: 50%; translate: -50% -4px;
    padding: 0.35rem 0.7rem; border-radius: 0.5rem; background: #fff; color: var(--color-text);
    font-size: 0.75rem; font-weight: 600; white-space: nowrap; box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    opacity: 0; pointer-events: none; transition: opacity 200ms ease, translate 200ms ease;
  }
  .review-star:hover::after, .review-star:focus-visible::after { opacity: 1; translate: -50% 0; }
  @media (prefers-reduced-motion: reduce) { .review-star i { animation: none; } }
</style>
