---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/feestcollectie', label: 'Feestcollectie' },
  { href: '/mini-collectie', label: 'Mini-collectie' },
  { href: '/koekjescollectie', label: 'Koekjes' },
  { href: '/tips', label: 'Tips' },
];
---

<header id="main-header">
  <div class="container">
    <nav class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img src="/favicon.svg" alt="Sweetheart Taart" class="w-14 h-14 transition-transform group-hover:scale-105" />
        <div class="hidden sm:block">
          <span class="font-heading text-3xl font-bold header-logo-text">Sweetheart</span>
          <span class="block text-sm opacity-70 -mt-0.5 header-logo-text">Koekjes, Cake & Taart</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="relative text-sm font-medium transition-colors hover:text-[var(--color-primary)] desktop-nav-link"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- CTA Button (Desktop) -->
      <a href="/bestellen" class="hidden lg:flex btn btn-primary text-sm">
        Bestel nu
      </a>

      <!-- Mobile Menu Toggle -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="lg:hidden p-2 -mr-2 text-[var(--color-text)] hover:text-[var(--color-primary)] transition-colors"
        aria-label="Menu openen"
      >
        <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-[var(--z-overlay)] lg:hidden hidden">
  <!-- Backdrop -->
  <button
    type="button"
    id="mobile-menu-backdrop"
    class="absolute inset-0 bg-black/30 backdrop-blur-sm"
    aria-label="Menu sluiten"
  ></button>

  <!-- Menu Panel -->
  <div class="absolute top-0 right-0 bottom-0 w-80 max-w-[85vw] bg-[var(--color-surface)] shadow-2xl overflow-y-auto">
    <div class="p-6">
      <!-- Close Button -->
      <div class="flex justify-end mb-8">
        <button
          type="button"
          id="mobile-menu-close"
          class="p-2 -m-2 text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
          aria-label="Menu sluiten"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Nav Links -->
      <nav class="space-y-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="block px-4 py-3 rounded-lg text-lg font-medium transition-colors hover:bg-[var(--color-secondary)] mobile-nav-link"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA -->
      <div class="mt-8 pt-8 border-t border-[var(--color-border)]">
        <a href="/bestellen" class="btn btn-primary w-full">
          Bestel nu
        </a>
      </div>

      <!-- Contact Info -->
      <div class="mt-8 space-y-3 text-sm text-[var(--color-text-muted)]">
        <p>
          <a href="tel:+32486953210" class="hover:text-[var(--color-primary)] transition-colors">
            +32 486 95 32 10
          </a>
        </p>
        <p>
          <a href="mailto:nathalie@sweetheart-taart.com" class="hover:text-[var(--color-primary)] transition-colors">
            nathalie@sweetheart-taart.com
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  // Mobile menu functionality
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuBackdrop = document.getElementById('mobile-menu-backdrop');
  const menuClose = document.getElementById('mobile-menu-close');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');
  const header = document.getElementById('main-header');

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
    menuIcon?.classList.add('hidden');
    closeIcon?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
    menuIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  menuToggle?.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('hidden')) {
      openMenu();
    } else {
      closeMenu();
    }
  });

  menuBackdrop?.addEventListener('click', closeMenu);
  menuClose?.addEventListener('click', closeMenu);

  // Close menu when clicking nav links
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  // Header scroll effect
  const handleScroll = () => {
    if (header) {
      if (window.scrollY > 20) {
        header.classList.add('scrolled');
      } else {
        header.classList.remove('scrolled');
      }
    }
  };

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Set active nav link
  const currentPath = window.location.pathname;
  document.querySelectorAll('.desktop-nav-link').forEach(link => {
    if ((link as HTMLAnchorElement).href === window.location.href) {
      link.classList.add('active');
    }
  });
</script>

<style>
  /* ── Transparent header over hero video ─────────────────────────────── */
  #main-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background-color: transparent !important;
    box-shadow: none !important;
  }

  /* Scrolled → white frosted glass */
  #main-header.scrolled {
    position: absolute;
    background-color: rgba(253, 248, 245, 0.92) !important;
    backdrop-filter: blur(12px);
    box-shadow: none !important;
  }

  /* ── Nav links: normal font + white glow on dark hero ───────────── */
  :global(.desktop-nav-link) {
    font-family: var(--font-body);
    color: rgba(255, 255, 255, 0.92);
    transition: color 300ms ease;
    text-shadow:
      0.75px 0.75px 0px #ffcce0,
      -0.25px -0.25px 0px #ffcce0,
      0.25px -0.25px 0px #ffcce0,
      -0.25px 0.25px 0px #ffcce0,
      0px 0px 8px #ffccd5,
      0px 0px 16px #ffd9e6;
  }

  :global(.desktop-nav-link:hover),
  :global(.desktop-nav-link.active) {
    color: #ffffff;
  }

  :global(.desktop-nav-link.active::after) {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #ffffff;
    border-radius: 1px;
    box-shadow: 0 0 8px #ffcce0;
  }

  /* ── Scrolled state nav links — dark, no glow ──────────────────────── */
  #main-header.scrolled :global(.desktop-nav-link),
  #main-header.scrolled :global(.desktop-nav-link:hover),
  #main-header.scrolled :global(.desktop-nav-link.active) {
    color: var(--color-text);
    text-shadow: none;
  }

  #main-header.scrolled :global(.desktop-nav-link.active::after) {
    background-color: var(--color-primary);
    box-shadow: none;
  }

  /* ── Logo text: Caveat + full glow, same as hero title ───────────────── */
  :global(.header-logo-text) {
    font-family: var(--font-heading);
    font-weight: 900;
    color: #ffffff;
    transition: color 300ms ease;
    text-shadow:
      1.5px 1.5px 0px #ffcce0,
      -0.5px -0.5px 0px #ffcce0,
      0.5px -0.5px 0px #ffcce0,
      -0.5px 0.5px 0px #ffcce0,
      0px 0px 10px #ffccd5,
      0px 0px 20px #ffd9e6,
      0px 0px 40px #ffe4ed,
      0px 0px 60px #fff0f5;
  }

  #main-header.scrolled :global(.header-logo-text) {
    color: var(--color-primary);
    text-shadow: none;
  }

  /* ── CTA button over hero ──────────────────────────────────────────── */
  #main-header .btn.btn-primary {
    background: rgba(232, 120, 138, 0.85);
    backdrop-filter: blur(4px);
    transition: background 300ms ease, transform 150ms ease, box-shadow 150ms ease;
  }

  #main-header .btn.btn-primary:hover {
    background: #E8788A;
    box-shadow: 0 4px 16px rgba(232, 120, 138, 0.5);
  }

  #main-header.scrolled .btn.btn-primary {
    background: var(--color-primary);
  }

  /* ── Mobile menu stays readable ────────────────────────────────────── */
  #mobile-menu {
    background-color: var(--color-surface);
  }
</style>
