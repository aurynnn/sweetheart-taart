---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/feestcollectie', label: 'Feestcollectie' },
  { href: '/mini-collectie', label: 'Mini-collectie' },
  { href: '/koekjescollectie', label: 'Koekjes' },
  { href: '/tips', label: 'Tips' },
];
---

