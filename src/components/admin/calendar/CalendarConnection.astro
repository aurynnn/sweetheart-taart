---
// CalendarConnection.astro — Google Calendar connect / disconnect card

const { googleConnected = false } = Astro.props;
---

<div class="connection-card">
  <div class="connection-info">
    <div class={`connection-icon ${googleConnected ? 'connected' : ''}`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
    </div>
    <div>
      <strong>Google Agenda {googleConnected ? 'verbonden' : 'niet verbonden'}</strong>
      <p>{googleConnected ? 'Je agenda wordt automatisch gesynchroniseerd.' : 'Verbind om events automatisch te blokkeren.'}</p>
    </div>
  </div>
  <div class="connection-actions">
    {googleConnected ? (
      <form method="POST" action="/admin/api/calendar/disconnect">
        <button type="submit" class="btn btn-secondary">Ontkoppelen</button>
      </form>
    ) : (
      <a href="/admin/api/calendar/connect" class="btn btn-primary">Verbinden</a>
    )}
  </div>
</div>
