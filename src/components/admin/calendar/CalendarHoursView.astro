---
// CalendarHoursView.astro — Tab 3: Werkuren (composes WorkDays + MaxOrders)
import CalendarWorkDaysView from './CalendarWorkDaysView.astro';
import CalendarLeadTimeView from './CalendarLeadTimeView.astro';
import CalendarMaxOrdersView from './CalendarMaxOrdersView.astro';

const { maxOrdersPerDay = 3, availableDays = [1, 2, 3, 4, 5, 6], leadTimeDays = 0 } = Astro.props;
---

<div class="tab-content" id="tab-uren">
  <div class="hours-layout">
    <CalendarWorkDaysView availableDays={availableDays} />
    <CalendarLeadTimeView leadTimeDays={leadTimeDays} />
    <CalendarMaxOrdersView maxOrdersPerDay={maxOrdersPerDay} />
  </div>
</div>

<style>
  .hours-layout {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
</style>
