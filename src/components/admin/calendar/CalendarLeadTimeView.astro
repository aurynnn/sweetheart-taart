---
// CalendarLeadTimeView.astro — Werkuren tab: lead-time buffer stepper
const { leadTimeDays = 0 } = Astro.props;
---

<div class="lead-time-section">
  <div class="section-header">
    <h3>Minimale doorlooptijd</h3>
    <p>Klanten kunnen pas bestellen vanaf dit aantal dagen vantevoren.</p>
  </div>

  <div class="stepper-row">
    <button class="stepper-btn minus" onclick="changeLeadTime(-1)" aria-label="Verlagen">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>

    <div class="stepper-display">
      <input
        type="number"
        id="leadTimeDays"
        value={leadTimeDays}
        min="0"
        max="60"
        onchange="syncLeadTimeDisplay()"
      />
      <span class="stepper-label">dagen</span>
    </div>

    <button class="stepper-btn plus" onclick="changeLeadTime(1)" aria-label="Verhogen">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
  </div>

  <p class="lead-time-hint" id="leadTimeHint">
    {leadTimeDays === 0
      ? 'Uitgeschakeld — klanten kunnen voor elke datum bestellen.'
      : `De eerstvolgende beschikbare datum is over ${leadTimeDays} dag${leadTimeDays === 1 ? '' : 'en'}.`}
  </p>
</div>

<script is:inline>
  function changeLeadTime(delta) {
    var input = document.getElementById('leadTimeDays');
    if (!input) return;
    var val = parseInt(input.value) || 0;
    var newVal = Math.min(60, Math.max(0, val + delta));
    input.value = String(newVal);
    syncLeadTimeDisplay();
  }

  function syncLeadTimeDisplay() {
    var input = document.getElementById('leadTimeDays');
    if (!input) return;
    var val = parseInt(input.value) || 0;
    var hint = document.getElementById('leadTimeHint');
    if (!hint) return;
    if (val === 0) {
      hint.textContent = 'Uitgeschakeld — klanten kunnen voor elke datum bestellen.';
    } else {
      hint.textContent = 'De eerstvolgende beschikbare datum is over ' + val + ' dag' + (val === 1 ? '' : 'en') + '.';
    }
  }

  // Sync display on page load
  syncLeadTimeDisplay();
</script>

<style>
  .lead-time-section {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 1rem;
    padding: 1.25rem;
  }

  .section-header {
    margin-bottom: 0.25rem;
  }

  .section-header h3 {
    margin: 0 0 0.25rem 0;
    font-size: 1rem;
    font-weight: 600;
    color: #1e293b;
  }

  .section-header p {
    margin: 0;
    font-size: 0.8rem;
    color: #64748b;
  }

  .stepper-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 1rem 0 0.75rem;
  }

  .stepper-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid #e2e8f0;
    background: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    color: #334155;
  }

  .stepper-btn:hover {
    background: #E8788A;
    border-color: #E8788A;
    color: white;
    transform: scale(1.05);
  }

  .stepper-btn:active {
    transform: scale(0.95);
  }

  .stepper-btn.minus:hover {
    background: #64748b;
    border-color: #64748b;
  }

  .stepper-display {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    min-width: 80px;
  }

  .stepper-display input {
    width: 72px;
    height: 60px;
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
    color: #1e293b;
    border: 2px solid #e2e8f0;
    border-radius: 0.75rem;
    background: white;
    font-family: inherit;
    -moz-appearance: textfield;
  }

  .stepper-display input::-webkit-inner-spin-button,
  .stepper-display input::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }

  .stepper-display input:focus {
    outline: none;
    border-color: #E8788A;
  }

  .stepper-label {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 500;
  }

  .lead-time-hint {
    font-size: 0.8125rem;
    color: #64748b;
    margin: 0;
    line-height: 1.5;
    background: #f8fafc;
    border-radius: 0.5rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid #e2e8f0;
  }
</style>
