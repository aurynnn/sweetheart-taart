---
// CalendarMaxOrdersView.astro — Werkuren tab, part 2: max orders per day stepper
const { maxOrdersPerDay = 3 } = Astro.props;
---

<div class="max-orders-section">
  <div class="section-header">
    <h3>Maximale bestellingen per dag</h3>
    <p>Hoeveel bestellingen kun je per dag verwerken?</p>
  </div>

  <div class="stepper-row">
    <button class="stepper-btn minus" onclick="changeMaxOrders(-1)" aria-label="Verlagen">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>

    <div class="stepper-display">
      <input
        type="number"
        id="maxOrders"
        value={maxOrdersPerDay}
        min="1"
        max="20"
        onchange="syncMaxOrdersDisplay()"
      />
      <span class="stepper-label">per dag</span>
    </div>

    <button class="stepper-btn plus" onclick="changeMaxOrders(1)" aria-label="Verhogen">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
    </button>
  </div>

  <div class="order-indicators" id="order-indicators">
    <!-- filled dynamically -->
  </div>
</div>

<script is:inline>
  function changeMaxOrders(delta) {
    var input = document.getElementById('maxOrders');
    if (!input) return;
    var val = parseInt(input.value);
    var newVal = Math.min(20, Math.max(1, val + delta));
    input.value = String(newVal);
    syncMaxOrdersDisplay();
  }

  function syncMaxOrdersDisplay() {
    var input = document.getElementById('maxOrders');
    if (!input) return;
    var val = parseInt(input.value);
    var indicators = document.getElementById('order-indicators');
    if (!indicators) return;
    indicators.innerHTML = '';
    for (var i = 0; i < 20; i++) {
      var dot = document.createElement('div');
      dot.className = 'order-dot' + (i < val ? ' filled' : '');
      indicators.appendChild(dot);
    }
  }
  syncMaxOrdersDisplay();
</script>

<style>
  .max-orders-section {
    margin-bottom: 1rem;
  }

  .stepper-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 1.25rem 0;
  }

  .stepper-btn {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 2px solid #e2e8f0;
    background: white;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    color: #334155;
  }

  .stepper-btn:hover {
    background: #E8788A;
    border-color: #E8788A;
    color: white;
    transform: scale(1.05);
  }

  .stepper-btn:active {
    transform: scale(0.95);
  }

  .stepper-btn.minus:hover {
    background: #64748b;
    border-color: #64748b;
  }

  .stepper-display {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    min-width: 80px;
  }

  .stepper-display input {
    width: 72px;
    height: 60px;
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
    color: #1e293b;
    border: 2px solid #e2e8f0;
    border-radius: 0.75rem;
    background: white;
    font-family: inherit;
    -moz-appearance: textfield;
  }

  .stepper-display input::-webkit-inner-spin-button,
  .stepper-display input::-webkit-outer-spin-button {
    -webkit-appearance: none;
  }

  .stepper-display input:focus {
    outline: none;
    border-color: #E8788A;
  }

  .stepper-label {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 500;
  }

  .order-indicators {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    max-width: 340px;
  }

  .order-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #e2e8f0;
    transition: background 0.2s, transform 0.15s;
  }

  .order-dot.filled {
    background: #E8788A;
    transform: scale(1.1);
  }
</style>
