---
// OrderModal.astro — Full order detail view (shown in modal)
---

<div class="modal-overlay" id="orderModal">
  <div class="modal">
    <!-- Header -->
    <div class="modal-header">
      <div class="modal-title-group">
        <h2 class="modal-title">Bestelling Details</h2>
        <span class="modal-subtitle" id="modalOrderId"></span>
      </div>
      <button class="modal-close" id="closeOrderModalBtn" aria-label="Sluiten">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"/>
          <line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="modal-body" id="orderModalBody">
      <!-- Filled by JS -->
    </div>

    <!-- Footer -->
    <div class="modal-footer">
      <div class="footer-left">
        <select id="orderStatusAction" class="status-select">
          <option value="">Status wijzigen...</option>
          <option value="pending">In afwachting</option>
          <option value="approved">Goedkeur</option>
          <option value="completed">Markeer als voltooid</option>
          <option value="cancelled">Annuleer</option>
        </select>
      </div>
      <div class="footer-right">
        <button class="btn btn-ghost" id="closeOrderModalBtn2">Sluiten</button>
        <button class="btn btn-primary" id="updateStatusBtn">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          Opslaan
        </button>
      </div>
    </div>
  </div>
</div>

<style>
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s, visibility 0.2s;
  padding: 1.5rem;
}

.modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.modal {
  background: white;
  border-radius: 1.25rem;
  width: 100%;
  max-width: 680px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24px 48px rgba(0, 0, 0, 0.18);
  transform: translateY(12px) scale(0.98);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
}

.modal-overlay.active .modal {
  transform: translateY(0) scale(1);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 1.5rem 1.75rem 1.25rem;
  border-bottom: 1px solid #f1f5f9;
  flex-shrink: 0;
}

.modal-title-group {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.modal-title {
  font-size: 1.125rem;
  font-weight: 700;
  color: #0f172a;
  margin: 0;
  line-height: 1.2;
}

.modal-subtitle {
  font-family: 'SF Mono', 'Fira Code', monospace;
  font-size: 0.6875rem;
  color: #94a3b8;
}

.modal-close {
  width: 2rem;
  height: 2rem;
  border-radius: 0.5rem;
  border: 1px solid #e2e8f0;
  background: white;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.15s;
  padding: 0;
  flex-shrink: 0;
}

.modal-close:hover {
  background: #fef2f2;
  border-color: #fecaca;
  color: #dc2626;
}

.modal-body {
  padding: 1.5rem 1.75rem;
  overflow-y: auto;
  flex: 1;
  min-height: 0;
}

.modal-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 1rem 1.75rem;
  border-top: 1px solid #f1f5f9;
  background: #f8fafc;
  flex-shrink: 0;
  flex-wrap: wrap;
}

.footer-left {
  flex: 1;
  min-width: 160px;
}

.footer-right {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.status-select {
  width: 100%;
  padding: 0.5rem 0.75rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.5rem;
  font-size: 0.8125rem;
  background: white;
  color: #334155;
  cursor: pointer;
  transition: border-color 0.15s;
}

.status-select:focus {
  outline: none;
  border-color: #E8788A;
  box-shadow: 0 0 0 3px rgba(232, 120, 138, 0.1);
}

/* Order Detail Sections */
.detail-section {
  margin-bottom: 1.5rem;
}

.detail-section:last-child {
  margin-bottom: 0;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 0.875rem;
  padding-bottom: 0.625rem;
  border-bottom: 1px solid #f1f5f9;
}

.section-header h4 {
  margin: 0;
  font-size: 0.75rem;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.section-icon {
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 0.375rem;
  background: #fdf2f4;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #E8788A;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0.5rem;
}

.info-row {
  display: flex;
  flex-direction: column;
  gap: 0.1875rem;
  padding: 0.625rem 0.75rem;
  background: #f8fafc;
  border-radius: 0.5rem;
}

.info-row.full-width {
  grid-column: 1 / -1;
}

.info-label {
  font-size: 0.625rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #94a3b8;
}

.info-value {
  font-size: 0.875rem;
  font-weight: 500;
  color: #1e293b;
  word-break: break-word;
}

.info-value.mono {
  font-family: 'SF Mono', 'Fira Code', monospace;
  font-size: 0.8125rem;
}

.status-badge-lg {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.3125rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.8125rem;
  font-weight: 600;
  width: fit-content;
}

.notes-row {
  grid-column: 1 / -1;
  padding: 0.75rem 1rem;
  background: #fffbeb;
  border-radius: 0.5rem;
  border-left: 3px solid #f59e0b;
}

.notes-row .info-value {
  font-size: 0.8125rem;
  font-style: italic;
  color: #78350f;
}

/* Order Items */
.order-items-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.order-item-card {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 0.75rem;
  overflow: hidden;
}

.item-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1rem;
  background: #f8fafc;
  border-bottom: 1px solid #e2e8f0;
}

.item-product-name {
  font-size: 0.9375rem;
  font-weight: 700;
  color: #0f172a;
}

.event-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  padding: 0.1875rem 0.5rem;
  background: #E8788A;
  color: white;
  border-radius: 9999px;
  font-size: 0.625rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.item-card-body {
  padding: 0.875rem 1rem;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
  gap: 0.75rem;
}

.item-field {
  display: flex;
  flex-direction: column;
  gap: 0.1875rem;
}

.item-field label {
  font-size: 0.625rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #94a3b8;
}

.item-field span {
  font-size: 0.875rem;
  font-weight: 500;
  color: #1e293b;
}

.allergy-field {
  grid-column: 1 / -1;
  padding: 0.5rem 0.75rem;
  background: #fef2f2;
  border-radius: 0.375rem;
  border-left: 3px solid #ef4444;
}

.allergy-field span {
  color: #dc2626;
  font-weight: 600;
  font-size: 0.8125rem;
}

/* Total Row */
.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 1.25rem;
  background: linear-gradient(135deg, #E8788A 0%, #fda4af 100%);
  border-radius: 0.75rem;
  margin-top: 1rem;
  box-shadow: 0 4px 12px rgba(232, 120, 138, 0.3);
}

.total-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.total-amount {
  font-size: 1.5rem;
  font-weight: 800;
  color: white;
  letter-spacing: -0.02em;
}

/* Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.5rem 1rem;
  border-radius: 0.5rem;
  font-size: 0.8125rem;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: all 0.15s;
  white-space: nowrap;
}

.btn-primary {
  background: #E8788A;
  color: white;
}

.btn-primary:hover {
  background: #d66b7a;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(232, 120, 138, 0.35);
}

.btn-ghost {
  background: transparent;
  color: #64748b;
  border: 1px solid #e2e8f0;
}

.btn-ghost:hover {
  background: #f1f5f9;
  color: #1e293b;
}
</style>
