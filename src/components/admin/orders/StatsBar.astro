---
interface Props {
  total: number;
  pending: number;
  approved: number;
  completed: number;
  cancelled: number;
}

const { total, pending, approved, completed, cancelled } = Astro.props;
---

<div class="stats-bar">
  <div class="stat-pill stat-pill--total">
    <span class="pill-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/>
        <rect x="9" y="3" width="6" height="4" rx="1"/>
      </svg>
    </span>
    <span class="pill-value">{total}</span>
    <span class="pill-label">Totaal</span>
  </div>

  <div class="stat-pill stat-pill--pending">
    <span class="pill-dot"></span>
    <span class="pill-value">{pending}</span>
    <span class="pill-label">In afwachting</span>
  </div>

  <div class="stat-pill stat-pill--approved">
    <span class="pill-dot"></span>
    <span class="pill-value">{approved}</span>
    <span class="pill-label">Goedgekeurd</span>
  </div>

  <div class="stat-pill stat-pill--completed">
    <span class="pill-dot"></span>
    <span class="pill-value">{completed}</span>
    <span class="pill-label">Voltooid</span>
  </div>

  <div class="stat-pill stat-pill--cancelled">
    <span class="pill-dot"></span>
    <span class="pill-value">{cancelled}</span>
    <span class="pill-label">Geannuleerd</span>
  </div>
</div>

<style>
.stats-bar {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.stat-pill {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.375rem 0.75rem;
  border-radius: 9999px;
  font-size: 0.8125rem;
  border: 1px solid transparent;
}

.pill-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  flex-shrink: 0;
}

.pill-icon {
  display: flex;
  align-items: center;
  opacity: 0.8;
}

.pill-value {
  font-weight: 700;
  font-size: 0.9375rem;
  line-height: 1;
}

.pill-label {
  font-weight: 400;
  opacity: 0.8;
  font-size: 0.8125rem;
}

.stat-pill--total {
  background: #f8fafc;
  color: #1e293b;
  border-color: #e2e8f0;
}

.stat-pill--pending {
  background: #fffbeb;
  color: #92400e;
}
.stat-pill--pending .pill-dot { background: #f59e0b; }

.stat-pill--approved {
  background: #eff6ff;
  color: #1e40af;
}
.stat-pill--approved .pill-dot { background: #3b82f6; }

.stat-pill--completed {
  background: #f0fdf4;
  color: #166534;
}
.stat-pill--completed .pill-dot { background: #22c55e; }

.stat-pill--cancelled {
  background: #fef2f2;
  color: #991b1b;
}
.stat-pill--cancelled .pill-dot { background: #ef4444; }
</style>
