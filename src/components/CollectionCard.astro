---
import { env } from '../lib/env';
interface Props {
  title: string;
  description: string;
  href: string;
  image?: string;
  imageAlt?: string;
  badge?: string;
}

const { title, description, href, image, imageAlt = '', badge } = Astro.props;

// R2 bucket base URL from env
const R2_BASE = env('PUBLIC_R2_BASE_URL') || '';

// Card images: small WebP versions of the collection photos (public/images/cards/,
// 640px and 1100px wide, made from the 2089px PNGs in public/images/)
const cardImages: Record<string, string> = {
  'feestcollectie': 'trouwtaart',
  'mini-collectie': 'cupcakes',
  'koekjescollectie': 'koekjes',
  'afternoon-tea': 'cupcakes',
  'vaste-collectie': 'trouwtaart',
};

const card = cardImages[href.replace('/', '')];
const displayImage = image || (card ? `/images/cards/${card}-640.webp` : null);
const srcset = !image && card ? `/images/cards/${card}-640.webp 640w, /images/cards/${card}-1100.webp 1100w` : undefined;
---

<a href={href} class="card group block overflow-hidden h-full flex flex-col">
  <!-- Image -->
  <div class="aspect-[4/3] overflow-hidden relative">
    {displayImage ? (
      <img
        src={displayImage}
        srcset={srcset}
        sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 380px"
        alt={imageAlt || title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-[var(--color-secondary)] to-[var(--color-primary)] flex items-center justify-center">
        <span class="text-white/50 text-4xl font-heading">{title.charAt(0)}</span>
      </div>
    )}
    
    <!-- Hover overlay -->
    <div class="absolute inset-0 bg-[var(--color-primary)]/0 group-hover:bg-[var(--color-primary)]/10 transition-colors duration-300"></div>
  </div>

  <!-- Content -->
  <div class="p-5 sm:p-6 bg-white flex-grow flex flex-col justify-between">
    <h3 class="font-heading text-2xl font-semibold text-[var(--color-text)] mb-2 group-hover:text-[var(--color-primary)] transition-colors">
      {title}
    </h3>
    <p class="text-[var(--color-text-muted)] text-sm leading-relaxed flex-grow">
      {description}
    </p>

    <!-- Arrow indicator -->
    <div class="mt-4 flex items-center gap-2 text-[var(--color-primary)] font-medium text-sm">
      <span>Ontdek meer</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </div>
  </div>
</a>