---
import TestimonialCard from '../TestimonialCard.astro';
import testimonialsData from '../../data/testimonials.json';
import { TESTIMONIAL_PHOTOS } from '../../data/home';
import { SITE } from '../../config/site';

const testimonials = testimonialsData.testimonials;
---

<section id="home-testimonials" class="section testimonials">
  <div class="container">
    <header class="text-center mb-12">
      <span class="eyebrow animate-on-scroll">Tevreden klanten</span>
      <h2 class="section-title" data-split>Wat onze klanten zeggen</h2>
    </header>

    <div class="t-grid" role="list" aria-label="Klantenreviews" tabindex="0" data-carousel>
      {testimonials.map((t, i) => (
        <div class={`t-item animate-on-scroll stagger-${i + 1}`} role="listitem">
          <TestimonialCard quote={t.quote} author={t.author} role={t.role} authorImage={TESTIMONIAL_PHOTOS[t.author]} />
        </div>
      ))}
    </div>

    <!-- Swipe position (phones & tablets only, where the grid becomes a carousel) -->
    <div class="t-dots" data-carousel-dots>
      {testimonials.map((t, i) => (
        <button type="button" class:list={['t-dot', { active: i === 0 }]} aria-label={`Toon review ${i + 1} van ${testimonials.length}`} aria-current={i === 0 ? 'true' : undefined}></button>
      ))}
    </div>

    <!-- Review invitation: visible, but part of the section rather than a pop-up -->
    <div class="review-pill animate-on-scroll stagger-2">
      <span class="review-stars" aria-hidden="true">
        {Array.from({ length: 5 }, () => <i class="fa-solid fa-star"></i>)}
      </span>
      <span class="review-copy">Ook genoten van een creatie van {SITE.name}? <strong>Je review helpt enorm!</strong></span>
      <a href={SITE.reviewUrl} target="_blank" rel="noopener" class="review-link">
        <i class="fa-brands fa-google" aria-hidden="true"></i> Laat een review achter
        <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
      </a>
    </div>
  </div>
</section>

<script>
  // Keeps the dots in sync with the swiped card and lets a dot jump to its card
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((track) => {
    const dots = Array.from(track.parentElement?.querySelectorAll<HTMLButtonElement>('[data-carousel-dots] button') ?? []);
    const items = Array.from(track.children) as HTMLElement[];
    if (!dots.length) return;

    const setActive = (index: number) => dots.forEach((d, i) => {
      d.classList.toggle('active', i === index);
      d.toggleAttribute('aria-current', i === index);
    });

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) setActive(items.indexOf(e.target as HTMLElement)); });
    }, { root: track, threshold: 0.6 });
    items.forEach((item) => io.observe(item));

    dots.forEach((dot, i) => dot.addEventListener('click', () => {
      const item = items[i];
      track.scrollTo({ left: item.offsetLeft - (track.clientWidth - item.offsetWidth) / 2, behavior: 'smooth' });
    }));
  });
</script>

<style>
  .testimonials {
    position: relative;
    background:
      radial-gradient(50% 40% at 10% 10%, rgba(253, 238, 240, 0.9), transparent 70%),
      radial-gradient(40% 40% at 95% 90%, rgba(253, 238, 240, 0.9), transparent 70%),
      var(--color-background);
  }
  .t-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; align-items: stretch; }
  .t-item:nth-child(2) { margin-top: 2.5rem; }

  .review-pill {
    display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 0.75rem 1.25rem;
    width: fit-content; max-width: 100%; margin: 3.5rem auto 0; padding: 0.8rem 0.8rem 0.8rem 1.4rem;
    border-radius: 999px; background: #fff; border: 1px solid var(--color-border);
    box-shadow: 0 16px 40px -24px rgba(212, 90, 106, 0.55);
  }
  .review-stars { display: inline-flex; gap: 0.15rem; color: #F5B83D; font-size: 0.95rem; }
  .review-copy { color: var(--color-text-muted); font-size: 0.95rem; }
  .review-copy strong { color: var(--color-text); }
  .review-link {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.65rem 1.2rem; border-radius: 999px;
    background: var(--color-secondary); color: var(--color-primary-dark); font-weight: 700; font-size: 0.92rem;
    transition: background 250ms ease, color 250ms ease, transform 300ms var(--ease-spring);
  }
  @media (hover: hover) {
    .review-link:hover { background: var(--color-primary); color: #fff; transform: translateY(-2px); }
  }
  .review-link:active { transform: scale(0.97); }
  .review-link .fa-arrow-up-right-from-square { font-size: 0.7rem; opacity: 0.7; }

  @media (max-width: 900px) {
    /* Swipeable cards on phones & tablets */
    .t-grid {
      grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: min(85%, 24rem);
      overflow-x: auto; scroll-snap-type: x mandatory; padding: 1.5rem 1rem 1.5rem; margin-inline: -1rem;
      scrollbar-width: none;
    }
    .t-grid::-webkit-scrollbar { display: none; }
    .t-grid { overscroll-behavior-x: contain; scroll-padding-inline: 1rem; }
    .t-grid:focus-visible { outline-offset: -2px; }
    .t-item { scroll-snap-align: center; }
    .t-item:nth-child(2) { margin-top: 0; }
    .review-pill { border-radius: 1.5rem; text-align: center; padding: 1.1rem; margin-top: 2rem; }
  }

  .t-dots { display: none; }
  @media (max-width: 900px) {
    .t-dots { display: flex; justify-content: center; gap: 0.25rem; margin-top: 0.25rem; }
    /* 32px tap area around an 8px dot */
    .t-dot { width: 2rem; height: 2rem; display: grid; place-items: center; border: 0; background: none; padding: 0; cursor: pointer; }
    .t-dot::before { content: ''; width: 0.5rem; height: 0.5rem; border-radius: 999px; background: var(--color-border); transition: width 300ms var(--ease-out-expo), background 300ms ease; }
    .t-dot.active::before { width: 1.5rem; background: var(--color-primary); }
  }
</style>
