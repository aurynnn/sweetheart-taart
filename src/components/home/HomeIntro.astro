---
import { INTRO_STATS } from '../../data/home';
import { SITE } from '../../config/site';

interface Props { collectionCount: number }
const { collectionCount } = Astro.props;

const stats = [...INTRO_STATS, { label: 'Collecties', value: collectionCount, from: 0, suffix: '' }];

// Small, slow-floating doodles around the photo — decoration only
const doodles = [
  { icon: 'fa-cake-candles', top: '-4%', left: '-6%', size: 2.1, delay: 0 },
  { icon: 'fa-cookie-bite', top: '14%', right: '-7%', size: 1.7, delay: 1.5 },
  { icon: 'fa-heart', bottom: '30%', right: '-5%', size: 1.2, delay: 3 },
  { icon: 'fa-ice-cream', bottom: '-5%', left: '30%', size: 1.6, delay: 2.2 },
  { icon: 'fa-cookie', top: '46%', left: '-8%', size: 1.3, delay: 4 },
];
const pos = (d: (typeof doodles)[number]) =>
  ['top', 'right', 'bottom', 'left'].filter((k) => (d as any)[k]).map((k) => `${k}:${(d as any)[k]}`).join(';');
---

<section id="home-intro" class="section intro">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div>
        <span class="eyebrow animate-on-scroll">Even voorstellen</span>
        <h2 id="home-intro-title" class="font-heading text-4xl md:text-5xl lg:text-6xl font-semibold text-[var(--color-text)] mb-6" data-split>
          Hoi! Mijn naam is {SITE.owner}
        </h2>
        <div class="space-y-4 text-[var(--color-text-muted)] leading-relaxed text-lg">
          <p class="animate-on-scroll stagger-1">
            Mijn passie… bakken. Steeds weer vind ik het magisch hoe je met een paar simpele ingrediënten, de lekkerste taarten uit de oven kan toveren.
          </p>
          <p class="animate-on-scroll stagger-2">
            Vandaar dat ik enkele jaren terug besloot om daar ook effectief iets mee te gaan doen. Zo maakte ons tuinhuis net voor de zomer van 2018 plaats voor een bakatelier waar ik me naar hartelust kan uitleven.
          </p>
          <p class="animate-on-scroll stagger-3">
            Ik werk met kwaliteitsvolle ingrediënten zoals speltbloem en bio-eitjes, en hou rekening met allergieën en dieetwensen. Lactose-intolerantie of glutenallergie? Geen probleem!
          </p>
        </div>

        <dl class="stats animate-on-scroll stagger-4">
          {stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd data-counter={s.value} data-counter-from={s.from} data-counter-suffix={s.suffix}>{s.value}{s.suffix}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="intro-visual">
        {doodles.map((d) => (
          <i
            class={`doodle fa-solid ${d.icon}`}
            style={`${pos(d)};font-size:${d.size}rem;animation-delay:-${d.delay}s`}
            aria-hidden="true"
          ></i>
        ))}
        <div class="intro-frame" data-unveil>
          <img
            src="/images/nathalie-portret.jpg"
            srcset="/images/nathalie-portret.jpg 640w, /images/nathalie-portret-896.jpg 896w"
            sizes="(max-width: 900px) 90vw, 440px"
            alt={`${SITE.owner} in haar bakatelier`}
            class="intro-img"
            data-parallax="0.12"
            loading="lazy"
          />
        </div>
        <div class="intro-badge" data-parallax="-0.35" aria-hidden="true">
          <i class="fa-solid fa-heart"></i>
          <span>met liefde<br />gebakken</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .intro { overflow: hidden; }
  .intro-visual { position: relative; padding: 1.5rem; }
  .intro-frame {
    position: relative; aspect-ratio: 4 / 5; border-radius: 1rem; overflow: hidden; z-index: 1;
    box-shadow: 0 40px 80px -30px rgba(74, 58, 61, 0.45);
  }
  .intro-img { width: 100%; height: 118%; object-fit: cover; margin-top: -9%; }
  .intro-badge {
    position: absolute; left: -0.5rem; bottom: 14%; z-index: 2;
    display: flex; align-items: center; gap: 0.75rem; padding: 1rem 1.25rem; border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(10px);
    box-shadow: 0 20px 40px -16px rgba(212, 90, 106, 0.5);
    font-family: var(--font-heading); font-size: 1.35rem; line-height: 1.05; color: var(--color-text);
  }
  .intro-badge i { color: var(--color-primary); font-size: 1.5rem; }

  .doodle {
    position: absolute; z-index: 0; color: var(--color-primary-light); opacity: 0.55;
    animation: doodle 11s ease-in-out infinite;
  }
  @keyframes doodle {
    0%, 100% { transform: translateY(0) rotate(-6deg); }
    50% { transform: translateY(-12px) rotate(6deg); }
  }

  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin: 2.5rem 0 0; }
  .stats div { padding: 1rem; border-radius: 1rem; background: var(--color-secondary); text-align: center; }
  .stats dt { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-text-muted); }
  .stats dd { margin: 0.2rem 0 0; font-family: var(--font-heading); font-size: 2.4rem; font-weight: 700; color: var(--color-primary-dark); line-height: 1; font-variant-numeric: tabular-nums; }

  @media (max-width: 640px) {
    /* Three stat tiles must fit a 320px screen: smaller label, less padding */
    .stats { gap: 0.5rem; margin-top: 2rem; }
    .stats div { padding: 0.8rem 0.35rem; }
    .stats dt { font-size: 0.6rem; letter-spacing: 0.04em; overflow-wrap: anywhere; }
    .stats dd { font-size: 1.9rem; }
    .intro-visual { padding: 1rem 0.5rem; }
    .intro-badge { left: -0.25rem; padding: 0.75rem 1rem; font-size: 1.15rem; }
    .doodle { opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .doodle { animation: none; }
  }
</style>
