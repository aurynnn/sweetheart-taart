---
import SprinkleField from '../SprinkleField.astro';
import { STEPS } from '../../data/home';

const STEP_SECONDS = 5;
---

<section id="home-steps" class="steps grain" data-steps aria-labelledby="home-steps-title" style={`--step-duration:${STEP_SECONDS}s`}>
  <SprinkleField cupcakes={7} hearts={22} seed={3} mask="left" />
  <div class="container steps-inner">
    <div class="steps-copy">
      <span class="eyebrow-light animate-on-scroll">Zo werkt het</span>
      <h2 id="home-steps-title" class="steps-title" data-split>Van idee tot taart in 4 stappen</h2>

      <div class="steps-list animate-on-scroll stagger-1" role="tablist" aria-label="Stappen" aria-orientation="vertical" data-step-list>
        {STEPS.map((s, i) => (
          <button
            type="button"
            class="step"
            role="tab"
            id={`step-tab-${i}`}
            aria-controls={`step-visual-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-step
          >
            <span class="step-dot"><i class={`fa-solid ${s.icon}`} aria-hidden="true"></i></span>
            <span class="step-body">
              <span class="step-title">{i + 1}. {s.title}</span>
              <span class="step-text">{s.text}</span>
              <span class="step-progress" aria-hidden="true"><span data-step-progress></span></span>
            </span>
          </button>
        ))}
      </div>

      <a href="/aanvraag" class="btn steps-cta btn-shine" data-magnetic="0.2">
        Start je aanvraag <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
    </div>

    <div class="steps-visual">
      {STEPS.map((s, i) => (
        <figure class="step-card" id={`step-visual-${i}`} role="tabpanel" aria-labelledby={`step-tab-${i}`} data-step-visual>
          <img src={s.image} alt="" loading="lazy" />
          <figcaption><span>{i + 1}</span>{s.title}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  import '../../scripts/steps';
</script>

<style>
  .steps {
    position: relative; overflow: hidden; color: #fff; padding: 6rem 0;
    background:
      radial-gradient(70% 60% at 80% 20%, rgba(255, 214, 165, 0.35), transparent 60%),
      radial-gradient(60% 70% at 10% 90%, rgba(205, 180, 245, 0.35), transparent 60%),
      linear-gradient(160deg, #E8788A 0%, #D45A6A 55%, #b8475a 100%);
  }
  .steps-inner { position: relative; z-index: 2; display: grid; grid-template-columns: 1.05fr 1fr; gap: 4rem; align-items: center; }
  .eyebrow-light { display: inline-block; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.9; margin-bottom: 0.9rem; }
  .steps-title { font-family: var(--font-heading); font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.05; margin: 0 0 2rem; color: #fff !important; text-shadow: none !important; }

  .steps-list { display: grid; gap: 0.5rem; margin: 0 0 2.25rem; }
  .step {
    display: flex; gap: 1.1rem; align-items: flex-start; width: 100%; padding: 0.9rem 1rem; text-align: left;
    border: 0; border-radius: 1.1rem; background: transparent; color: inherit; font: inherit; cursor: pointer;
    transition: background 400ms ease, transform 400ms var(--ease-out-expo);
  }
  .step:hover, .step.is-active { background: rgba(255, 255, 255, 0.12); }
  .step.is-active { transform: translateX(6px); }
  .step:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .step-dot {
    flex-shrink: 0; width: 2.75rem; height: 2.75rem; border-radius: 50%; display: grid; place-items: center;
    background: rgba(255, 255, 255, 0.15); border: 2px solid rgba(255, 255, 255, 0.5);
    transition: all 500ms var(--ease-spring);
  }
  .step.is-active .step-dot, .step.is-done .step-dot { background: #fff; color: var(--color-primary-dark); border-color: #fff; }
  .step.is-active .step-dot { transform: scale(1.1); box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.15); }
  .step-body { display: grid; gap: 0.25rem; flex: 1; min-width: 0; }
  .step-title { font-weight: 800; font-size: 1.1rem; opacity: 0.75; transition: opacity 300ms; }
  .step-text { color: rgba(255, 255, 255, 0.85); line-height: 1.6; max-height: 0; opacity: 0; overflow: hidden; transition: max-height 500ms var(--ease-out-expo), opacity 400ms ease; }
  .step.is-active .step-title { opacity: 1; }
  .step.is-active .step-text { max-height: 6rem; opacity: 1; }

  /* Progress bar: drives the autoplay (see scripts/steps.ts) */
  .step-progress { display: block; height: 3px; margin-top: 0.5rem; border-radius: 3px; background: rgba(255, 255, 255, 0.2); overflow: hidden; opacity: 0; transition: opacity 300ms; }
  .step-progress > span { display: block; height: 100%; width: 100%; background: #fff; transform-origin: left; transform: scaleX(0); }
  .steps.is-playing .step.is-active .step-progress { opacity: 1; }
  .steps.is-playing .step.is-active .step-progress > span { animation: stepFill var(--step-duration) linear forwards; }
  .steps.is-paused .step.is-active .step-progress > span { animation-play-state: paused; }
  @keyframes stepFill { to { transform: scaleX(1); } }

  .steps-cta { background: #fff; color: var(--color-primary-dark) !important; border-radius: 999px; padding: 1rem 1.9rem; box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.35); }
  .steps-cta:hover { transform: translateY(-2px); }

  .steps-visual { position: relative; aspect-ratio: 4 / 5; max-height: 36rem; justify-self: center; width: 100%; max-width: 30rem; }
  .step-card {
    position: absolute; inset: 0; margin: 0; border-radius: 1.75rem; overflow: hidden; background: #fff;
    box-shadow: 0 50px 100px -40px rgba(60, 10, 20, 0.6);
    opacity: 0; transform: translateY(30px) rotate(4deg) scale(0.94);
    transition: opacity 700ms var(--ease-out-expo), transform 900ms var(--ease-out-expo);
  }
  .step-card:global(.is-active) { opacity: 1; transform: none; }
  .step-card img { width: 100%; height: 100%; object-fit: cover; }
  .step-card figcaption {
    position: absolute; left: 1rem; right: 1rem; bottom: 1rem; display: flex; align-items: center; gap: 0.75rem;
    padding: 0.8rem 1rem; border-radius: 1rem; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px);
    color: var(--color-text); font-weight: 800;
  }
  .step-card figcaption span { width: 2rem; height: 2rem; border-radius: 50%; display: grid; place-items: center; background: var(--color-primary); color: #fff; }

  @media (max-width: 1023px) {
    .steps { padding: 4.5rem 0; }
    .steps-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .steps-visual { order: -1; aspect-ratio: 4 / 3; max-width: 26rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .step-text { max-height: none; opacity: 1; }
  }
</style>
