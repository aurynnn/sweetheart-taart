---
// "Zo werkt het": all steps visible at once as a path. When the section scrolls into
// view (.visible from the motion system) the connecting line draws and the steps
// appear one after another, ending on the highlighted last step. No autoplay/looping.
// On phones the steps stack vertically, so each step reveals when it scrolls into view
// itself (every .stop is its own .animate-on-scroll trigger).
import SprinkleField from '../SprinkleField.astro';
import { STEPS } from '../../data/home';

const last = STEPS.length - 1;
---

<section id="home-steps" class="steps grain" aria-labelledby="home-steps-title">
  <SprinkleField cupcakes={7} hearts={22} seed={3} mask="center" />
  <div class="container steps-inner">
    <header class="steps-head">
      <span class="eyebrow-light animate-on-scroll">Zo werkt het</span>
      <h2 id="home-steps-title" class="steps-title" data-split>Van idee tot taart in {STEPS.length} stappen</h2>
    </header>

    <ol class="journey animate-on-scroll" style={`--count:${STEPS.length}`}>
      <span class="path" aria-hidden="true"></span>
      {STEPS.map((s, i) => (
        <li class:list={['stop', 'animate-on-scroll', { final: i === last }]} style={`--i:${i}`}>
          <div class="bubble">
            <img src={s.image} alt="" loading="lazy" />
            <span class="badge">{i === last ? <i class="fa-solid fa-check" aria-hidden="true"></i> : i + 1}</span>
          </div>
          <div class="stop-card">
            <h3><i class={`fa-solid ${s.icon}`} aria-hidden="true"></i> {s.title}</h3>
            <p>{s.text}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="steps-cta-wrap animate-on-scroll stagger-3">
      <a href="/aanvraag" class="btn steps-cta btn-shine" data-magnetic="0.2">
        Start je aanvraag <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </a>
      <span class="steps-note">Vrijblijvend · je betaalt pas na bevestiging</span>
    </div>
  </div>
</section>

<style>
  .steps {
    position: relative; overflow: hidden; color: #fff; padding: 6rem 0;
    background:
      radial-gradient(70% 60% at 80% 20%, rgba(255, 214, 165, 0.35), transparent 60%),
      radial-gradient(60% 70% at 10% 90%, rgba(205, 180, 245, 0.35), transparent 60%),
      linear-gradient(160deg, #E8788A 0%, #D45A6A 55%, #b8475a 100%);
  }
  .steps-inner { position: relative; z-index: 2; }
  .steps-head { text-align: center; margin-bottom: 3.5rem; }
  .eyebrow-light { display: inline-block; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.9; margin-bottom: 0.9rem; }
  .steps-title { font-family: var(--font-heading); font-size: clamp(2.4rem, 5vw, 4rem); line-height: 1.05; margin: 0; color: #fff !important; text-shadow: none !important; }

  /* The journey: the list itself doesn't move, its children animate in sequence */
  .journey { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--count), 1fr); gap: 1.5rem; }
  .journey:global(.animate-on-scroll),
  .stop:global(.animate-on-scroll) { opacity: 1; transform: none; filter: none; transition: none; }
  .path {
    position: absolute; z-index: 0; top: 3.5rem; left: 12.5%; width: 75%; height: 0;
    border-top: 3px dotted rgba(255, 255, 255, 0.75);
    clip-path: inset(0 100% 0 0); transition: clip-path 1.6s cubic-bezier(0.65, 0, 0.35, 1) 200ms;
  }
  .journey:global(.visible) .path { clip-path: inset(0 0 0 0); }

  .stop { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 1rem; }
  .stop > * { opacity: 0; transform: translateY(24px) scale(0.96); transition: opacity 700ms ease, transform 800ms var(--ease-out-expo); transition-delay: calc(var(--i) * 350ms + 250ms); }
  .journey:global(.visible) .stop > * { opacity: 1; transform: none; }

  .bubble { position: relative; width: 7rem; height: 7rem; border-radius: 50%; padding: 0.35rem; background: rgba(255, 255, 255, 0.25); backdrop-filter: blur(4px); box-shadow: 0 20px 40px -20px rgba(60, 10, 20, 0.6); }
  .bubble img { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 3px solid #fff; transition: transform 500ms var(--ease-spring); }
  @media (hover: hover) {
    .stop:hover .bubble img { transform: scale(1.06) rotate(-3deg); }
      }
  .badge { position: absolute; right: -0.2rem; top: -0.2rem; width: 2.2rem; height: 2.2rem; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--color-primary-dark); font-weight: 800; box-shadow: 0 6px 14px -6px rgba(0, 0, 0, 0.4); }

  .stop-card { width: 100%; padding: 1.1rem 1.1rem 1.2rem; border-radius: 1.25rem; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.22); transition: background 300ms ease, transform 400ms var(--ease-spring); }
  .stop-card h3 { font-family: var(--font-body); font-size: 1.05rem; font-weight: 800; margin: 0 0 0.4rem; color: #fff !important; text-shadow: none !important; }
  .stop-card h3 i { margin-right: 0.3rem; opacity: 0.85; }
  .stop-card p { margin: 0; font-size: 0.92rem; line-height: 1.6; color: rgba(255, 255, 255, 0.88); }

  /* The destination: Nathalie confirms — emphasised */
  .final .bubble { background: #fff; box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.18), 0 24px 50px -20px rgba(60, 10, 20, 0.7); }
  .final .badge { background: #22c55e; color: #fff; }
  .final .stop-card { background: #fff; border-color: #fff; }
  .final .stop-card h3 { color: var(--color-primary-dark) !important; }
  .final .stop-card p { color: var(--color-text-muted); }
  .journey:global(.visible) .final .badge { animation: pop 600ms var(--ease-spring) calc(var(--i) * 350ms + 900ms) both; }
  @keyframes pop { from { transform: scale(0); } }

  .steps-cta-wrap { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; margin-top: 3rem; }
  .steps-cta { background: #fff; color: var(--color-primary-dark) !important; border-radius: 999px; padding: 1rem 1.9rem; box-shadow: 0 16px 40px -12px rgba(0, 0, 0, 0.35); }
  .steps-note { font-size: 0.85rem; opacity: 0.85; }

  @media (max-width: 900px) {
    .steps { padding: 4.5rem 0; }
    .steps-head { margin-bottom: 2.5rem; }
    /* Vertical timeline on phones */
    .journey { grid-template-columns: 1fr; gap: 1.25rem; max-width: 30rem; margin: 0 auto; }
    .path { top: 2.4rem; bottom: 2.4rem; left: 2.3rem; width: 0; height: auto; border-top: 0; border-left: 3px dotted rgba(255, 255, 255, 0.75); clip-path: inset(0 0 100% 0); }
    .stop { flex-direction: row; text-align: left; align-items: center; }
    .bubble { width: 4.8rem; height: 4.8rem; flex-shrink: 0; }
    .badge { width: 1.8rem; height: 1.8rem; font-size: 0.85rem; }
    .stop-card { padding: 0.95rem 1rem 1rem; }

    /* Each step waits for its own .visible, with only a short bubble → card offset */
    .journey:global(.visible) .stop:not(:global(.visible)) > * { opacity: 0; transform: translateX(16px); }
    .stop > * { transform: translateX(16px); transition-delay: 0ms; }
    .stop > .stop-card { transition-delay: 120ms; }
    .path { transition-duration: 2.4s; }
    .journey:global(.visible) .final .badge { animation: none; }
    .journey:global(.visible) .final:global(.visible) .badge { animation: pop 600ms var(--ease-spring) 500ms both; }
    .steps-cta-wrap { margin-top: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stop > *, .path { transition: none; opacity: 1; transform: none; clip-path: none; }
  }
</style>
