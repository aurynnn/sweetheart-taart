---
interface Props {
  title?: string;
  subtitle?: string;
  showCTA?: boolean;
}

const {
  title = "De prachtigste taarten...",
  subtitle = "fijnste koekjes en heerlijkste cake, met liefde gebakken in Oostende",
  showCTA = true
} = Astro.props;

const R2_BASE = import.meta.env.PUBLIC_R2_BASE_URL || '';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0 z-0">
    <img 
      src={`${R2_BASE}/feestcollectie/images/trouwtaargeknipt-e1668952116982.png`}
      alt="Prachtige taart" 
      class="w-full h-full object-cover object-center"
    />
    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-bg)]/80 via-[var(--color-bg)]/60 to-[var(--color-bg)]/90"></div>
  </div>

  <div class="container relative z-10 text-center py-32 px-4">
    <!-- Main heading -->
    <h1 class="font-heading text-5xl md:text-6xl lg:text-7xl font-semibold text-white mb-6 animate-on-scroll text-balance drop-shadow-lg">
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl text-white/90 max-w-2xl mx-auto mb-10 animate-on-scroll stagger-2 drop-shadow-md">
      {subtitle}
    </p>

    <!-- CTA Buttons -->
    {showCTA && (
      <div class="flex flex-col sm:flex-row gap-4 justify-center animate-on-scroll stagger-3">
        <a href="/feestcollectie" class="btn btn-primary text-lg px-8 py-4">
          Bekijk collecties
        </a>
        <a href="/bestellen" class="btn btn-secondary text-lg px-8 py-4 bg-white/20 text-white border border-white/30 hover:bg-white/30">
          Bestel nu
        </a>
      </div>
    )}
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-on-scroll stagger-4">
    <div class="flex flex-col items-center text-white/70">
      <span class="text-xs uppercase tracking-widest mb-2">Ontdek meer</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>
</section>