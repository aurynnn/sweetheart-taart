---
interface Props {
  title?: string;
  subtitle?: string;
  showCTA?: boolean;
}

const {
  title = "De prachtigste taarten...",
  subtitle = "fijnste koekjes en heerlijkste cake, met liefde gebakken in Oostende",
  showCTA = true
} = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background video -->
  <div class="absolute inset-0 z-0">
    <video
      class="w-full h-full object-cover"
      autoplay
      muted
      loop
      playsinline
      poster="/videos/hero-pie-poster.jpg"
    >
      <source src="/videos/hero-pie.mp4" type="video/mp4" />
    </video>
    <!-- Dark overlay so text remains readable -->
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-bg)]/70 via-[var(--color-bg)]/50 to-[var(--color-bg)]/85"></div>
  </div>

  <!-- Content -->
  <div class="container relative z-10 text-center py-32 px-4">
    <!-- Main heading -->
    <h1
      class="mb-6 animate-on-scroll text-balance"
      style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.2; color: #ffffff; text-shadow: 1.5px 1.5px 0px #ffcce0, -0.5px -0.5px 0px #ffcce0, 0.5px -0.5px 0px #ffcce0, -0.5px 0.5px 0px #ffcce0, 0px 0px 10px #ffccd5, 0px 0px 20px #ffd9e6, 0px 0px 40px #ffe4ed, 0px 0px 60px #fff0f5;"
    >
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl max-w-2xl mx-auto mb-10 animate-on-scroll stagger-2 glow-subtitle">
      {subtitle}
    </p>

    <!-- CTA Buttons -->
    {showCTA && (
      <div class="flex justify-center animate-on-scroll stagger-3">
        <a href="/feestcollectie" class="btn btn-primary text-lg px-8 py-4">
          Bekijk collecties
        </a>
      </div>
    )}
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-on-scroll stagger-4">
    <div class="flex flex-col items-center text-white/70">
      <span class="text-xs uppercase tracking-widest mb-2">Ontdek meer</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>
</section>
