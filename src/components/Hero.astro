---
interface Props {
  id?: string;
  title?: string;
  subtitle?: string;
  showCTA?: boolean;
}

const {
  id,
  title = "De prachtigste taarten...",
  subtitle = "fijnste koekjes en heerlijkste cake, met liefde gebakken in Oostende",
  showCTA = true
} = Astro.props;
---

<!-- svh: fills the screen on phones without jumping when the address bar hides -->
<section id={id} class="hero relative min-h-svh flex items-center justify-center overflow-hidden">
  <!-- Background video (trim/loop/pause logic: src/scripts/heroVideo.ts) -->
  <div class="absolute inset-0 z-0">
    <video
      id="heroVideo"
      class="w-full h-full object-cover"
      autoplay
      muted
      loop
      playsinline
      disablepictureinpicture
      disableremoteplayback
      aria-hidden="true"
      poster="/videos/hero-pie-poster.jpg"
    >
      <source src="/videos/hero-pie.mp4" type="video/mp4" />
    </video>
    <!-- Dark overlay so text remains readable -->
    <div class="absolute inset-0 bg-gradient-to-b from-[var(--color-bg)]/70 via-[var(--color-bg)]/50 to-[var(--color-bg)]/85"></div>
  </div>

  <!-- Content: CSS load animation, visible without waiting for any script -->
  <div class="container relative z-10 text-center py-28 sm:py-32 px-4">
    <!-- Main heading -->
    <h1 class="hero-title mb-6 animate-on-load text-balance">
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="text-lg md:text-xl max-w-2xl mx-auto mb-10 animate-on-load stagger-2 glow-subtitle text-balance">
      {subtitle}
    </p>

    <!-- CTA Buttons -->
    {showCTA && (
      <div class="flex justify-center animate-on-load stagger-3">
        <a href="/feestcollectie" class="btn btn-primary text-lg px-8 py-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          Bestellen
        </a>
      </div>
    )}
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-hint absolute left-1/2 -translate-x-1/2 animate-on-load stagger-5" aria-hidden="true">
    <div class="flex flex-col items-center text-white/70">
      <span class="text-xs uppercase tracking-widest mb-2">Ontdek meer</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>
</section>

<script>
  import '../scripts/heroVideo';
</script>

<style>
  .hero-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.2;
    color: #ffffff;
    text-shadow: 1.5px 1.5px 0px #ffcce0, -0.5px -0.5px 0px #ffcce0, 0.5px -0.5px 0px #ffcce0, -0.5px 0.5px 0px #ffcce0, 0px 0px 10px #ffccd5, 0px 0px 20px #ffd9e6, 0px 0px 40px #ffe4ed, 0px 0px 60px #fff0f5;
  }
  .scroll-hint { bottom: calc(2rem + env(safe-area-inset-bottom, 0px)); }
  /* Short screens (landscape phones): the hint would collide with the CTA */
  @media (max-height: 560px) { .scroll-hint { display: none; } }
  @media (prefers-reduced-motion: reduce) { .scroll-hint svg { animation: none; } }
</style>
