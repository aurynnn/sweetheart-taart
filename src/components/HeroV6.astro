---
// HeroV6.astro — "Light Panel"
// Inverted from V1: soft white/cream panel behind text, dark readable text
// No dark overlay — panel handles all contrast
interface Props {
  title?: string;
  subtitle?: string;
  showCTA?: boolean;
}
const {
  title = "De prachtigste taarten...",
  subtitle = "fijnste koekjes en heerlijkste cake, met liefde gebakken in Oostende",
  showCTA = true
} = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background video -->
  <div class="absolute inset-0 z-0">
    <video class="w-full h-full object-cover" autoplay muted loop playsinline>
      <source src="/videos/hero-pie.mp4" type="video/mp4" />
    </video>
    <!-- NO heavy overlay — light panel handles contrast -->
    <div class="absolute inset-0 bg-black/20"></div>
  </div>

  <!-- Light frosted panel — all contrast from this -->
  <div class="relative z-10 w-full max-w-3xl mx-auto px-6">
    <div class="light-panel animate-on-scroll">
      <!-- Decorative accent -->
      <div class="light-accent-line"></div>

      <!-- Eyebrow -->
      <div class="light-eyebrow">
        <span class="light-eyebrow-dot"></span>
        Ambachtelijke Bakkerij · Oostende
      </div>

      <!-- Title -->
      <h1 class="light-title">
        {title}
      </h1>

      <!-- Subtitle -->
      <p class="light-subtitle">
        {subtitle}
      </p>

      <!-- CTAs -->
      {showCTA && (
        <div class="light-actions">
          <a href="/feestcollectie" class="light-btn-primary">
            Bekijk collecties
          </a>
          <a href="/bestellen" class="light-btn-ghost">
            Bestel nu
          </a>
        </div>
      )}

      <!-- Bottom tagline -->
      <div class="light-tagline-row">
        <span class="light-tagline-dot"></span>
        Vers gebakken met liefde · Sinds 2018
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <div class="flex flex-col items-center text-black/40">
      <span class="text-[10px] uppercase tracking-[0.2em] mb-1.5">Ontdek</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>
</section>

<style>
  .light-panel {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: 1.5rem;
    padding: 3rem 2.5rem;
    text-align: center;
    box-shadow:
      0 4px 40px rgba(0, 0, 0, 0.12),
      0 1px 0 rgba(255, 255, 255, 0.8) inset;
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .light-accent-line {
    width: 3rem;
    height: 3px;
    background: linear-gradient(to right, #E8788A, #fda4af);
    border-radius: 2px;
    margin: 0 auto 1.5rem;
  }

  .light-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #E8788A;
    margin-bottom: 1.25rem;
  }

  .light-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #E8788A;
    flex-shrink: 0;
  }

  .light-title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
  }

  .light-subtitle {
    font-size: 1.0625rem;
    color: #5a5a5a;
    line-height: 1.65;
    margin: 0 auto 2rem;
    max-width: 480px;
  }

  .light-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .light-btn-primary {
    background: #E8788A;
    color: white;
    border-radius: 0.5rem;
    padding: 0.75rem 2rem;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.2s;
    letter-spacing: 0.01em;
  }

  .light-btn-primary:hover {
    background: #d66b7a;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(232, 120, 138, 0.4);
  }

  .light-btn-ghost {
    background: transparent;
    color: #444;
    border: 1.5px solid #d1d5db;
    border-radius: 0.5rem;
    padding: 0.75rem 2rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.2s;
  }

  .light-btn-ghost:hover {
    border-color: #E8788A;
    color: #E8788A;
  }

  .light-tagline-row {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #9a9a9a;
    margin-top: 0.5rem;
  }

  .light-tagline-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #E8788A;
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .light-panel { padding: 2rem 1.5rem; }
    .light-actions { flex-direction: column; }
    .light-btn-primary, .light-btn-ghost { text-align: center; justify-content: center; }
  }
</style>
