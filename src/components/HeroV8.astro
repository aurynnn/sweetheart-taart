---
// HeroV8.astro — "Soft Cream Panel"
// Warm cream panel floats over video — cozy, bakery-feel
// Dark warm text, very readable
interface Props {
  title?: string;
  subtitle?: string;
  showCTA?: boolean;
}
const {
  title = "De prachtigste taarten...",
  subtitle = "fijnste koekjes en heerlijkste cake, met liefde gebakken in Oostende",
  showCTA = true
} = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background video -->
  <div class="absolute inset-0 z-0">
    <video class="w-full h-full object-cover" autoplay muted loop playsinline>
      <source src="/videos/hero-pie.mp4" type="video/mp4" />
    </video>
    <!-- Warm dark tint -->
    <div class="absolute inset-0 bg-black/30"></div>
  </div>

  <!-- Content centered -->
  <div class="relative z-10 w-full max-w-2xl mx-auto px-6 py-32">
    <!-- Cream panel -->
    <div class="cream-panel animate-on-scroll">

      <!-- Label -->
      <div class="cream-label">
        <span class="cream-label-icon">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        </span>
        Ambachtelijke Bakkerij · Oostende
      </div>

      <!-- Heading -->
      <h1 class="cream-title">
        {title}
      </h1>

      <!-- Subtitle -->
      <p class="cream-subtitle">
        {subtitle}
      </p>

      <!-- CTAs -->
      {showCTA && (
        <div class="cream-actions">
          <a href="/feestcollectie" class="cream-btn-primary">
            Bekijk collecties
          </a>
          <a href="/bestellen" class="cream-btn-secondary">
            Bestel nu
          </a>
        </div>
      )}

      <!-- Info strip -->
      <div class="cream-info">
        <div class="cream-info-item">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/>
          </svg>
          Allergievriendelijk
        </div>
        <div class="cream-info-sep">·</div>
        <div class="cream-info-item">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Donderdag 17u–20u
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-black/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
    </svg>
  </div>
</section>

<style>
  /* ── Cream panel ──────────────────────────────────────────────────────── */
  .cream-panel {
    background: rgba(255, 251, 247, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 2rem;
    padding: 3rem 2.5rem;
    text-align: center;
    box-shadow:
      0 8px 60px rgba(0, 0, 0, 0.15),
      0 2px 8px rgba(0, 0, 0, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.8);
  }

  /* ── Label ────────────────────────────────────────────────────────────── */
  .cream-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #E8788A;
    margin-bottom: 1.25rem;
  }

  .cream-label-icon {
    color: #E8788A;
    display: flex;
  }

  /* ── Title ─────────────────────────────────────────────────────────────── */
  .cream-title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(2.25rem, 6vw, 4.25rem);
    font-weight: 700;
    color: #2d1b0e;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1.25rem;
  }

  /* ── Subtitle ──────────────────────────────────────────────────────────── */
  .cream-subtitle {
    font-size: 1rem;
    color: #6b5344;
    line-height: 1.7;
    margin: 0 auto 2rem;
    max-width: 420px;
    font-style: italic;
  }

  /* ── Actions ───────────────────────────────────────────────────────────── */
  .cream-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .cream-btn-primary {
    background: #E8788A;
    color: white;
    border-radius: 999px;
    padding: 0.75rem 2rem;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.2s;
    letter-spacing: 0.01em;
    box-shadow: 0 4px 16px rgba(232, 120, 138, 0.35);
  }

  .cream-btn-primary:hover {
    background: #d66b7a;
    transform: translateY(-1px);
    box-shadow: 0 6px 24px rgba(232, 120, 138, 0.45);
  }

  .cream-btn-secondary {
    background: #2d1b0e;
    color: #fff8f0;
    border-radius: 999px;
    padding: 0.75rem 2rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.2s;
  }

  .cream-btn-secondary:hover {
    background: #4a2f1a;
    transform: translateY(-1px);
  }

  /* ── Info strip ───────────────────────────────────────────────────────── */
  .cream-info {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(45, 27, 14, 0.1);
  }

  .cream-info-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: #6b5344;
  }

  .cream-info-sep {
    color: #c4a882;
    font-size: 1rem;
  }

  @media (max-width: 480px) {
    .cream-panel { padding: 2rem 1.5rem; border-radius: 1.5rem; }
    .cream-actions { flex-direction: column; }
  }
</style>
