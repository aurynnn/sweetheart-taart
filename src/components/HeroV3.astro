---
// HeroV3.astro — "Split Screen"
// Left: dark text panel | Right: video bleeds full height
// Clean physical separation = maximum readability
interface Props {
  title?: string;
  subtitle?: string;
  showCTA?: boolean;
}
const {
  title = "De prachtigste taarten...",
  subtitle = "fijnste koekjes en heerlijkste cake, met liefde gebakken in Oostende",
  showCTA = true
} = Astro.props;
---

<section class="relative min-h-screen flex overflow-hidden">
  <!-- Left panel: text content -->
  <div class="relative z-10 flex flex-col justify-center w-full lg:w-1/2 py-24 px-8 md:px-16 lg:px-20 bg-gradient-to-br from-[#0f0f0f]/95 via-[#1a1a1a]/90 to-transparent">
    <!-- Accent line -->
    <div class="split-accent-line animate-on-scroll"></div>

    <!-- Eyebrow -->
    <div class="animate-on-scroll stagger-1">
      <span class="split-eyebrow">Bakkerij · Oostende</span>
    </div>

    <!-- Title -->
    <h1 class="split-title animate-on-scroll stagger-2">
      {title}
    </h1>

    <!-- Subtitle -->
    <p class="split-subtitle animate-on-scroll stagger-3">
      {subtitle}
    </p>

    <!-- CTAs -->
    {showCTA && (
      <div class="flex flex-wrap gap-3 mt-2 animate-on-scroll stagger-4">
        <a href="/feestcollectie" class="btn btn-primary text-base px-8 py-3.5">
          Bekijk collecties
        </a>
        <a href="/bestellen" class="btn btn-outline-white text-base px-8 py-3.5">
          Bestel nu
        </a>
      </div>
    )}

    <!-- Trust signals -->
    <div class="split-trust animate-on-scroll stagger-4">
      <div class="split-trust-item">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#E8788A]" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
        </svg>
        <span>5+ jaar ervaring</span>
      </div>
      <div class="split-trust-item">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#E8788A]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/>
        </svg>
        <span>Allergievriendelijk</span>
      </div>
    </div>
  </div>

  <!-- Right: full-height video -->
  <div class="hidden lg:block absolute right-0 top-0 bottom-0 w-1/2 z-0">
    <video class="w-full h-full object-cover" autoplay muted loop playsinline>
      <source src="/videos/hero-pie.mp4" type="video/mp4" />
    </video>
    <!-- Soft edge blend -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#0f0f0f]/40 to-transparent"></div>
  </div>
</section>

<style>
  .split-accent-line {
    width: 3rem;
    height: 3px;
    background: linear-gradient(to right, #E8788A, #fda4af);
    border-radius: 2px;
    margin-bottom: 1.5rem;
  }

  .split-eyebrow {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #E8788A;
    display: block;
    margin-bottom: 1rem;
  }

  .split-title {
    font-family: var(--font-heading, inherit);
    font-size: clamp(2.75rem, 6vw, 5rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.05;
    margin: 0 0 1.25rem;
    letter-spacing: -0.02em;
  }

  .split-subtitle {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.65;
    margin: 0 0 2rem;
    max-width: 440px;
  }

  .btn-outline-white {
    background: transparent;
    border: 1.5px solid rgba(255,255,255,0.35);
    color: white;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .btn-outline-white:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.6);
  }

  .split-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .split-trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255,255,255,0.6);
  }

  @media (max-width: 1024px) {
    .split-title {
      font-size: clamp(2.25rem, 8vw, 3.5rem);
    }
  }
</style>
