---
import '../styles/global.css';
import FloatingCta from '../components/FloatingCta.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description = "Sweetheart – Koekjes, Cake en Taart. Ambachtelijke Belgische bakkerij in Oostende. Feesttaarten, koekjes, mini-gebak en meer.", bodyClass = "" } = Astro.props;
const showFloatingCta = !Astro.url.pathname.startsWith('/aanvraag');
// Always the public domain (not localhost or a tunnel), without query string or trailing slash
const canonical = SITE.url + (Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, ''));
const ogImage = `${SITE.url}/images/trouwtaart.png`;
// Lets Google show the bakery with address, phone and price range (home page only)
const isHome = Astro.url.pathname === '/';
const businessLd = {
  '@context': 'https://schema.org',
  '@type': 'Bakery',
  name: `${SITE.name} – ${SITE.tagline}`,
  url: SITE.url,
  image: ogImage,
  telephone: SITE.phone.international,
  email: SITE.email,
  priceRange: '€€',
  address: { '@type': 'PostalAddress', streetAddress: SITE.address.street, postalCode: SITE.address.postalCode, addressLocality: SITE.address.city, addressCountry: 'BE' },
  sameAs: [SITE.social.facebook, SITE.social.instagram],
};
---

<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- Before first paint: lets CSS hide scroll-reveal content only when JS can reveal it -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E8788A" />
    <meta property="og:title" content={`${title} | Sweetheart Taart`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Sweetheart Taart" />
    <meta property="og:locale" content="nl_BE" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(businessLd)} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Caveat is self-hosted (public/fonts): no visitor IP addresses go to Google -->
    <link rel="preload" href="/fonts/caveat-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title} | Sweetheart Taart</title>
  </head>
  <body class={`min-h-screen flex flex-col ${bodyClass}`}>
    <div id="scroll-progress" aria-hidden="true"></div>
    <div id="toast-container"></div>
    <slot />
    {showFloatingCta && <FloatingCta />}
    <script>
      import '../scripts/motion/index';
    </script>
  </body>
</html>
