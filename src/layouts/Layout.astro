---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}

const { title, description = "Sweetheart – Koekjes, Cake en Taart. Ambachtelijke Belgische bakkerij in Oostende. Feesttaarten, koekjes, mini-gebak en meer.", bodyClass = "" } = Astro.props;
const showFloatingCta = !Astro.url.pathname.startsWith('/aanvraag');
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#E8788A" />
    <meta property="og:title" content={`${title} | Sweetheart Taart`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL("/images/trouwtaart.png", Astro.url).href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700;900&display=swap" rel="stylesheet" />
    <title>{title} | Sweetheart Taart</title>
  </head>
  <body class={`min-h-screen flex flex-col ${bodyClass}`}>
    <div id="scroll-progress" aria-hidden="true"></div>
    <div id="toast-container"></div>
    <slot />
    {showFloatingCta && (
      <a href="/aanvraag" id="floating-cta" class="floating-cta btn-shine" aria-label="Start je aanvraag">
        <i class="fa-solid fa-cake-candles" aria-hidden="true"></i>
        <span>Start je aanvraag</span>
      </a>
    )}
    <script>
      import '../scripts/motion';

      // Floating aanvraag button: appears once the visitor scrolls past the first screen,
      // hides again near the footer so it never covers the contact details.
      const cta = document.getElementById('floating-cta');
      if (cta) {
        const update = () => {
          const pastHero = window.scrollY > window.innerHeight * 0.7;
          const nearEnd = window.innerHeight + window.scrollY > document.documentElement.scrollHeight - 280;
          cta.classList.toggle('is-visible', pastHero && !nearEnd);
        };
        window.addEventListener('scroll', update, { passive: true });
        update();
      }
    </script>
  </body>
</html>

<style is:global>
  .floating-cta {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: 70;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.4rem;
    border-radius: 999px;
    font-weight: 700;
    color: #fff !important;
    background: linear-gradient(135deg, #F2A0AA, #E8788A 55%, #D45A6A);
    box-shadow: 0 12px 30px -8px rgba(212, 90, 106, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transform: translateY(140%) scale(0.9);
    opacity: 0;
    transition: transform 600ms var(--ease-spring), opacity 300ms ease, box-shadow 300ms ease;
    pointer-events: none;
  }
  .floating-cta.is-visible { transform: none; opacity: 1; pointer-events: auto; }
  .floating-cta:hover { box-shadow: 0 16px 40px -8px rgba(212, 90, 106, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.35); }
  .floating-cta i { animation: wiggle 3s ease-in-out infinite; }
  @keyframes wiggle { 0%, 85%, 100% { transform: rotate(0); } 90% { transform: rotate(-12deg); } 95% { transform: rotate(10deg); } }
  @media (prefers-reduced-motion: reduce) { .floating-cta i { animation: none; } .floating-cta { transition: opacity 200ms ease; } }
</style>


