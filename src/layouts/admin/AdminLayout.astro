---
import '../../styles/tokens.css';
import '../../styles/admin.css';
import { d1Query } from '../../lib/d1';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Admin Panel' } = Astro.props;
const currentPath = Astro.url.pathname;
const adminUser = (Astro.locals as any).admin?.username as string | undefined;

// Badge on "Aanvragen" so new requests are visible from every admin page
let pendingCount = 0;
try {
  const res = await d1Query("SELECT COUNT(*) as cnt FROM orders WHERE status = 'pending'");
  pendingCount = (res.results?.[0]?.cnt as number) ?? 0;
} catch { /* D1 unavailable — no badge */ }
---

<!DOCTYPE html>
<html lang="nl-BE">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | Admin</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <meta name="robots" content="noindex, nofollow">
</head>
<body>
  <div class="admin-layout">
    <!-- Mobile top bar -->
    <div class="mobile-bar">
      <button type="button" id="sidebarToggle" class="mobile-toggle" aria-label="Menu openen" aria-controls="adminSidebar" aria-expanded="false">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
      <span class="mobile-title">🎂 Sweetheart</span>
      {pendingCount > 0 && <a href="/admin/orders" class="mobile-pending">{pendingCount} nieuw</a>}
    </div>
    <div class="sidebar-backdrop" id="sidebarBackdrop" hidden></div>

    <!-- Sidebar -->
    <aside class="sidebar" id="adminSidebar">
      <div class="sidebar-header">
        <a href="/admin" class="sidebar-logo">
          <span class="logo-icon">🎂</span>
          <span class="logo-text">Sweetheart Admin</span>
        </a>
      </div>
      
      <nav class="sidebar-nav">
        <a href="/admin" class={`nav-item ${currentPath === '/admin' ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          <span>Dashboard</span>
        </a>
        
        <a href="/admin/orders" class={`nav-item ${currentPath.includes('/admin/orders') ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span>Aanvragen</span>
          {pendingCount > 0 && <span class="nav-badge">{pendingCount}</span>}
        </a>

        <a href="/admin/todo" class={`nav-item ${currentPath === '/admin/todo' ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 11l3 3L22 4"></path>
            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
          </svg>
          <span>Te maken</span>
        </a>
        
        <a href="/admin/klanten" class={`nav-item ${currentPath.startsWith('/admin/klanten') ? 'active' : ''}`}>
          <i class="fa-solid fa-user-group nav-fa" aria-hidden="true"></i>
          <span>Klanten</span>
        </a>

        <a href="/admin/herinneringen" class={`nav-item ${currentPath.startsWith('/admin/herinneringen') ? 'active' : ''}`}>
          <i class="fa-regular fa-bell nav-fa" aria-hidden="true"></i>
          <span>Herinneringen</span>
        </a>

        <a href="/admin/calendar" class={`nav-item ${currentPath.includes('/admin/calendar') ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          <span>Beschikbaarheid</span>
        </a>
        
        <a href="/admin/settings" class={`nav-item ${currentPath.includes('/admin/settings') ? 'active' : ''}`}>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          <span>Instellingen</span>
        </a>
      </nav>
      
      <div class="sidebar-footer">
        <form method="post" action="/admin/logout" class="logout-form">
          <button type="submit" class="nav-item logout-btn" title="Uitloggen">
            <i class="fa-solid fa-right-from-bracket nav-fa" aria-hidden="true"></i>
            <span>Uitloggen{adminUser && <small class="who">{adminUser}</small>}</span>
          </button>
        </form>
        <a href="/" class="nav-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          <span>Naar de website</span>
        </a>
      </div>
    </aside>
    
    <!-- Main Content -->
    <main class="main-content">
      <header class="content-header">
        <h1>{title}</h1>
        <slot name="header-actions" />
      </header>
      
      <div class="content-body">
        <slot />
      </div>
    </main>
  </div>
  <div id="toast-container"></div>
  <script>
    const sidebar = document.getElementById('adminSidebar');
    const toggle = document.getElementById('sidebarToggle');
    const backdrop = document.getElementById('sidebarBackdrop');
    const setOpen = (open: boolean) => {
      sidebar?.classList.toggle('open', open);
      if (backdrop) backdrop.hidden = !open;
      toggle?.setAttribute('aria-expanded', String(open));
    };
    toggle?.addEventListener('click', () => setOpen(!sidebar?.classList.contains('open')));
    backdrop?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
  </script>
</body>
</html>

<style>
.admin-layout {
  display: flex;
  min-height: 100vh;
  background: #f8fafc;
}

.sidebar {
  width: 260px;
  background: white;
  border-right: 1px solid #e2e8f0;
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  z-index: 100;
}

.sidebar-header {
  padding: 1.5rem;
  border-bottom: 1px solid #e2e8f0;
}

.sidebar-logo {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  text-decoration: none;
  color: #1e293b;
}

.logo-icon {
  font-size: 1.5rem;
}

.logo-text {
  font-weight: 600;
  font-size: 1.125rem;
}

.sidebar-nav {
  flex: 1;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  border-radius: 0.5rem;
  color: #64748b;
  text-decoration: none;
  font-weight: 500;
  transition: all 0.2s;
}

.nav-item:hover {
  background: #f1f5f9;
  color: #1e293b;
}

.nav-item.active {
  background: #fef2f2;
  color: #e11d48;
}

.nav-item svg {
  flex-shrink: 0;
}

.logout-form { margin: 0 0 0.25rem; }
.logout-btn { width: 100%; border: 0; background: none; font: inherit; cursor: pointer; text-align: left; }
.logout-btn:hover { background: #fef2f2; color: #b91c1c; }
.logout-btn .who { display: block; font-size: 0.72rem; color: #94a3b8; font-weight: 500; }

.nav-fa {
  width: 20px;
  text-align: center;
  font-size: 1rem;
  flex-shrink: 0;
}

.sidebar-footer {
  padding: 1rem;
  border-top: 1px solid #e2e8f0;
}

.main-content {
  flex: 1;
  margin-left: 260px;
  min-height: 100vh;
}

.content-header {
  background: white;
  padding: 1.5rem 2rem;
  border-bottom: 1px solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 50;
}

.content-header h1 {
  font-size: 1.5rem;
  font-weight: 600;
  color: #0f172a;
  margin: 0;
}

.content-body {
  padding: 2rem;
}

.nav-badge {
  margin-left: auto;
  min-width: 1.4rem;
  height: 1.4rem;
  padding: 0 0.4rem;
  border-radius: 999px;
  background: #e8788a;
  color: white;
  font-size: 0.72rem;
  font-weight: 700;
  display: inline-grid;
  place-items: center;
  animation: badgePulse 2.4s ease-in-out infinite;
}
@keyframes badgePulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(232,120,138,0.5); } 50% { box-shadow: 0 0 0 6px rgba(232,120,138,0); } }

/* No animation on .content-body: an animated opacity/transform there turns it into its own
   stacking layer, which traps the order pop-ups underneath the sticky header. */

.mobile-bar, .sidebar-backdrop { display: none; }

@media (max-width: 768px) {
  .sidebar {
    transform: translateX(-100%);
    transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 200;
  }
  .sidebar.open { transform: none; box-shadow: 20px 0 60px rgba(15, 23, 42, 0.2); }
  .admin-layout { flex-direction: column; }
  .sidebar-backdrop { display: block; position: fixed; inset: 0; background: rgba(15, 23, 42, 0.35); z-index: 150; }
  .sidebar-backdrop[hidden] { display: none; }
  .main-content {
    margin-left: 0;
  }
  .mobile-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: sticky;
    top: 0;
    z-index: 120;
    padding: 0.75rem 1rem;
    background: white;
    border-bottom: 1px solid #e2e8f0;
  }
  .mobile-toggle { width: 2.5rem; height: 2.5rem; border: 0; border-radius: 0.6rem; background: #f1f5f9; color: #1e293b; cursor: pointer; }
  .mobile-title { font-weight: 700; color: #1e293b; }
  .mobile-pending { margin-left: auto; padding: 0.3rem 0.7rem; border-radius: 999px; background: #fef2f2; color: #e11d48; font-weight: 700; font-size: 0.8rem; text-decoration: none; }
  .content-header { position: static; padding: 1rem; }
  .content-body { padding: 1rem; }
}
@media (prefers-reduced-motion: reduce) {
  .nav-badge { animation: none; }
}

/* Toast Notifications — globally available */
#toast-container {
  position: fixed;
  top: 1.5rem;
  right: 1.5rem;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  pointer-events: none;
}

.toast {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  padding: 0.75rem 1rem;
  border-radius: 0.75rem;
  font-size: 0.875rem;
  font-weight: 500;
  box-shadow: 0 4px 20px rgba(0,0,0,0.15);
  pointer-events: all;
  animation: toastIn 0.2s ease;
  min-width: 180px;
  max-width: 300px;
  background: #E8788A;
  color: white;
  border: none;
}

.toast-icon {
  font-size: 1rem;
  flex-shrink: 0;
}

@keyframes toastIn {
  from { opacity: 0; transform: translateY(-8px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes toastOut {
  from { opacity: 1; transform: translateY(0); }
  to   { opacity: 0; transform: translateY(-8px); }
}

/* Danger button */
.btn-danger {
  background: #ef4444;
  color: white;
  border: none;
}

.btn-danger:hover {
  background: #dc2626;
}
</style>
